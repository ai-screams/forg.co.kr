{
  "name": "forg-archive",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pagefind --site out --force-language ko && node scripts/postbuild/strip-rsc-payloads.mjs && node scripts/postbuild/separate-search-bundle.mjs",
    "deploy:search": "node scripts/deploy/upload-search-to-r2.mjs",
    "deploy:img": "node scripts/deploy/upload-images-to-r2.mjs",
    "img:pull": "node scripts/deploy/pull-images-from-r2.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "size": "size-limit",
    "secret": "secretlint --secretlintignore .secretlintignore '**/*'",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@secretlint/secretlint-rule-preset-recommend": "^12.3.1",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "aws4fetch": "^1.0.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.10.0",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "puppeteer-core": "24.22.0",
    "secretlint": "^12.3.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write",
      "secretlint"
    ],
    "*.{json,css,html,yml,yaml}": [
      "prettier --write",
      "secretlint"
    ],
    "*.{md,mdx}": [
      "prettier --write",
      "markdownlint-cli2 --fix",
      "secretlint"
    ],
    "*.{env,env.local,env.example}": [
      "secretlint"
    ]
  }
}
