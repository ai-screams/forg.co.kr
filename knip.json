{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "scripts/**/*.mjs",
    "functions/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "functions/**/*.ts"],
  "ignoreDependencies": [
    "tailwindcss",
    "postcss",
    "@commitlint/types",
    "@secretlint/secretlint-rule-preset-recommend"
  ]
}
