  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_3.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_alchemy/\"><img alt=\"연금술[포션제작]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_a.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_poisoning/\"><img alt=\"독바르기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_p.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_taste/\"><img alt=\"맛감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tid.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_blacksmith/\"><img alt=\"대장장이\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_b.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_mining/\"><img alt=\"광부\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_m.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tailor/\"><img alt=\"재단사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ta.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_thinker/\"><img alt=\"팅거링[기계공]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_bow/\"><img alt=\"활제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_bow.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_car/\"><img alt=\"목공\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_c.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_begging/\"><img alt=\"구걸\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_be.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_cooking/\"><img alt=\"요리사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cook.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_ins/\"><img alt=\"마법스크롤제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_i.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anit/\"><img alt=\"동물길들이기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ani.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anil/\"><img alt=\"동물지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_al.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_vet/\"><img alt=\"수의학\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_v.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_carto/\"><img alt=\"보물사냥꾼\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_car.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lock/\"><img alt=\"자물쇠열기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lock.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_fishing/\"><img alt=\"낚시\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_f.gif\" width=\"110\"></a><a href=\"/site/skill/uo_jobs_ss/\"><img alt=\"심령술[죽은자와대화]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_sp.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_camping/\"><img alt=\"야영\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cam.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lumber/\"><img alt=\"나무패기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lum.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_detect/\"><img alt=\"숨은물체찿기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_d.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tracking/\"><img alt=\"추적\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tra.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_armslore/\"><img alt=\"장비지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_arm.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_item/\"><img alt=\"아이템감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_id.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/j_line.gif\" width=\"110\"></font></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;Jobs_Skill</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><table align=\"center\" border=\"1\" bordercolor=\"silver\" cellpadding=\"1\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#E7E4E4\" colspan=\"2\" height=\"40\" width=\"544\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아이템감정의 \n                            스킬은 감정 지팡이의 존재로 인하여많은 사람들이 \n                            올리지 않는 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">스킬중의 \n                            하나입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">하지만 \n                            스킬이 30정도만 되도 그아이템의 성능을 알아 볼 수 \n                            있다는 메리트가 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"115\" width=\"150\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"120\" src=\"/img/posts/site/skill/images/uojobs/itemid/id_1.gif\" width=\"170\"></font></p>\n</td>\n<td height=\"115\" width=\"390\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">좌측글씨에 \n                            substantial은 무기류에</font><font color=\"#333333\" face=\"돋움\" size=\"2\">+10 to item HP내구력</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">accurate는무기류에 \n                            +5.0 to Tactics</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">ruin은 +1 damage \n                            의 효과를 주는 axe로 판정이 나옵니다</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">p.s \n                : 맨밑에 78골드는 아이템을 벤더에게 팔앗을대 나오는 수치이지만 \n                스킬이</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">낮을 \n                때는 정확하지 않습니다 일반적으로 낮게 나옵니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999999\" bordercolordark=\"#999999\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"503\">\n<tbody><tr>\n<td bgcolor=\"silver\" colspan=\"4\" width=\"498\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>감정 \n                            지팡이</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"100\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/itemid/id_2.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"146\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.리치등을 \n                            잡으면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마법완드를 \n                            획득할 수</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">있습니다. \n                            </font></p>\n</td>\n<td width=\"94\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/itemid/wand_1.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"153\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.완드를 \n                            손에 든채</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">더블클릭하여</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">자신의 \n                            캐릭터를 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">클릭해서 \n                            자신의 이름이</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">나오는 \n                            것이 감정지팡이</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;p.s : 하나씩 순서대로 놓으실 때는 탁자다리에다 놓아줍니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">손쉽게 아이템들을 놓을 수 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<div align=\"center\"><table border=\"\" bordercolor=\"#999999\" bordercolordark=\"#999999\" bordercolorlight=\"#999999\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"484\">\n<tbody><tr>\n<td align=\"center\" colspan=\"2\" width=\"478\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>갑옷류</b></font></p></td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" width=\"237\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>접두사</b></font></p></td>\n<td align=\"center\" bgcolor=\"silver\" width=\"237\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>효과</b></font></p></td>\n</tr>\n<tr>\n<td width=\"237\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">Durable</font></p></td>\n<td align=\"center\" width=\"237\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">+5 to item HP</fo