kill/uo_jobs_anil/\"><img alt=\"동물지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_al.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_vet/\"><img alt=\"수의학\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_v.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_carto/\"><img alt=\"보물사냥꾼\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_car.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lock/\"><img alt=\"자물쇠열기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lock.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_fishing/\"><img alt=\"낚시\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_f.gif\" width=\"110\"></a><a href=\"/site/skill/uo_jobs_ss/\"><img alt=\"심령술[죽은자와대화]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_sp.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_camping/\"><img alt=\"야영\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cam.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lumber/\"><img alt=\"나무패기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lum.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_detect/\"><img alt=\"숨은물체찿기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_d.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tracking/\"><img alt=\"추적\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tra.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_armslore/\"><img alt=\"장비지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_arm.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_item/\"><img alt=\"아이템감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_id.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/j_line.gif\" width=\"110\"></font></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;광부</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" cellpadding=\"1\" cellspacing=\"1\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"499\">\n<tbody><tr>\n<td bgcolor=\"#E4E4E4\" colspan=\"2\" height=\"30\" width=\"491\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>마이닝 \n                            기초</b></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#E4E4E4\" colspan=\"2\" width=\"491\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/mining/m_logo.gif\" width=\"200\"></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"60\" src=\"/img/posts/site/skill/images/uojobs/mining/m_1.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">땅을 \n                            팔려면 삽자루나 곡괭이같은 도구가 필요합니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이러한 \n                            도구들은 팅거스킬이나 도구점에서 얻을 수 있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">좌측에 \n                            곡갱이는 약102번 삽자루는 51번을 캘 수 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"60\" src=\"/img/posts/site/skill/images/uojobs/mining/m_3.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">삽자루를 \n                            더블클릭후 타겟이 뜨면 원하시는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">땅을 \n                            찍어 주시면됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"60\" src=\"/img/posts/site/skill/images/uojobs/mining/m_2.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 \n                            광물을 얻게되면 좌측 그림처럼 포지를 이용하여</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">원하시는 \n                            잉갓을 얻을 수 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"60\" src=\"/img/posts/site/skill/images/uojobs/mining/m_4.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">좌측사진처럼 \n                            광물을 더블클릭하여 타겟이 뜨면 포지를 클릭하여</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">우측의 \n                            잉갓을 얻을 수 있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">높은 \n                            스킬이 요구되는 광물일수록 녹일 때 실패율도 큽니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#E4E4E4\" colspan=\"2\" height=\"30\" width=\"491\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;해상광산</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"491\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"130\" src=\"/img/posts/site/skill/images/uojobs/mining/m_5.gif\" width=\"250\"></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/mining/m_6.gif\" width=\"100\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일명 \n                            해상광산이라고 하는 것으로 배를 타고</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">광석을 \n                            채취하는 방법입니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">위에 \n                            그림처럼 미녹북쪽,코브,셔펜홀드지역에 있고</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 \n                            T2A지역에도 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">예전 \n                            피케이가 광산에서 끊임없이 출몰하였을 때는</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">광물을 \n                            얻기에 더없이 좋은 장소 였습니다.</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" cellpadding=\"1\" cellspacing=\"1\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"356\">\n<tbody><tr>\n<td bgcolor=\"#E4E4E4\" colspan=\"4\" height=\"30\" width=\"348\">\n<p><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>스킬별 \n                            색잉갓 획득</b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"30\" width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>잉갓</b></font></p>\n</td>\n<td height=\"30\" width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>갑옷</b></font></p>\n</td>\n<td height=\"30\" width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>색깔</b></font></p>\n</td>\n<td height=\"30\" width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>스킬</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/ingot_1.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/ingot.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일반잉갓</font></p>\n</td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">-</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/dull_1.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/dull.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">덜쿠퍼</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">65</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/shadow_1.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/shadow.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">쉐도우</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">70</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/cooper.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/gold.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">구리</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">75</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/bronze_1.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/bronze.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">청동</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">80</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/gold_ingot.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/gold_1.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">골드</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">85</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"76\" width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/agapite_1.gif\" width=\"50\"></font></p>\n</td>\n<td height=\"76\" width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/agapite.gif\" width=\"70\"></font></p>\n</td>\n<td height=\"76\" width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아가파이트(아가)</font></p></td>\n<td height=\"76\" width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">90</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/vet_1.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/vet.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">베리테</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">95</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/val_1.gif\" width=\"50\"></font></p>\n</td>\n<td width=\"71\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/mining/val.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">발로라이트(발로)</font></p></td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">99</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\" width=\"348\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">각각의 \n                            색깔잉갓은 해당스킬 때 땅을파서 얻을 수도 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">녹일 \n                            수도 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">각각의 \n                            광산위치마다 색잉갓의 리스펀자리가 있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">해당스킬이하일 \n                            때는 물론 일반광석이 나옵니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">만든갑옷을 \n                            녹여서 다시 잉갓으로 환원하는 스킬은</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">스미스가아닌 \n                            마이닝이라는점을 상기하시길.</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" cellpadding=\"1\" cellspacing=\"1\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"499\">\n<tbody><tr>\n<td bgcolor=\"#E4E4E4\" colspan=\"2\" height=\"30\" width=\"491\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;가고일곡갱이</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"130\" src=\"/img/posts/site/skill/images/uojobs/mining/val_ele_4.gif\" width=\"250\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">윈드던전 \n                            또는 히스로스또는 숲주변에 가고일과스톤가고일이 \n                            있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이것을 \n                            잡게되면 운좋을 때는</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가고일의 \n                            곡갱이를 얻을 수 있습니다</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/mining/val_ele_3.gif\" width=\"250\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">좌측의 \n                            사진은 가고일의 곡갱이 입니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가고일의 \n                            곡갱이를 가지고 원하는</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">광산의 \n                            포인트에서 땅을 파게되면</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">여러 \n                            가지 엘리멘탈이 나오게됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/mining/val_ele.gif\" width=\"250\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일반잉갓이상의 \n                            엘리가 나옵니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">:일반잉갓포인트는 \n                            덜쿠퍼엘리</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아가파이트포인트는 \n                            베리테엘리</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">베리테포인트는 \n                            발로엘리</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">발로포인트는 \n                             발로엘리</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">총 \n                            8개종류의 엘리멘탈이 나옵니다</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/mining/val_ele_1.gif\" width=\"250\"></font></p>\n</td>\n<td width=\"394\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">각엘리멘탈은 \n                            특수능력을 지니고 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">발로엘리의 \n                            경우는 물리적데미지만 받습니다. 전사와광부의파티가 \n                            효과적입니다.물론 테이머의용도 안됩니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">오직 \n                            전사^^</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"491\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/mining/val_ele_2.gif\" width=\"100\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">위에 \n                            사진은 발로엘리가 특수 공격을 하는 사진입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">하얀칼바라고 \n                            하더군영-\"-</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_jobs_mining/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a>&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>"
