  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_3.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_alchemy/\"><img alt=\"연금술[포션제작]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_a.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_poisoning/\"><img alt=\"독바르기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_p.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_taste/\"><img alt=\"맛감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tid.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_blacksmith/\"><img alt=\"대장장이\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_b.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_mining/\"><img alt=\"광부\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_m.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tailor/\"><img alt=\"재단사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ta.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_thinker/\"><img alt=\"팅거링[기계공]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_bow/\"><img alt=\"활제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_bow.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_car/\"><img alt=\"목공\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_c.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_begging/\"><img alt=\"구걸\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_be.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_cooking/\"><img alt=\"요리사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cook.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_ins/\"><img alt=\"마법스크롤제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_i.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anit/\"><img alt=\"동물길들이기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ani.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anil/\"><img alt=\"동물지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_al.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_vet/\"><img alt=\"수의학\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_v.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_carto/\"><img alt=\"보물사냥꾼\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_car.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lock/\"><img alt=\"자물쇠열기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lock.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_fishing/\"><img alt=\"낚시\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_f.gif\" width=\"110\"></a><a href=\"/site/skill/uo_jobs_ss/\"><img alt=\"심령술[죽은자와대화]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_sp.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_camping/\"><img alt=\"야영\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cam.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lumber/\"><img alt=\"나무패기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lum.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_detect/\"><img alt=\"숨은물체찿기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_d.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tracking/\"><img alt=\"추적\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tra.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_armslore/\"><img alt=\"장비지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_arm.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_item/\"><img alt=\"아이템감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_id.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/j_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;Fishing</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><table border=\"\" bordercolor=\"silver\" bordercolordark=\"silver\" cellspacing=\"0\" height=\"28\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td class=\"top\" height=\"66\" width=\"550\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"120\" src=\"/img/posts/site/skill/images/uojobs/fish/logo.gif\" width=\"200\"></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>낚시</b>는 \n                레어급아이템을 얻을 수 있다는 큰장점이 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">우선 \n                스킬별로 무엇을 낚을 수 있는지 알아봅시다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p><table align=\"center\" border=\"\" bordercolor=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"silver\" colspan=\"2\" width=\"546\">\n<p><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>스킬별 \n                            아이템</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"28\" src=\"/img/posts/site/skill/images/uojobs/fish/boots.gif\" width=\"18\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill/images/uojobs/fish/sandals.gif\" width=\"20\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill/images/uojobs/fish/shoes.gif\" width=\"19\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill/images/uojobs/fish/thighboots.gif\" width=\"26\"></font></p></td>\n<td width=\"422\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">낚시 스킬 전체를 통틀어 계속 나오는 신발입니다.</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">해안가 근처에서는 더 빈번하게 나옵니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_brown.gif\" width=\"40\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_green.gif\" width=\"41\"><img border=\"0\" height=\"40\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_blue.gif\" width=\"38\"><img border=\"0\" height=\"40\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_yellow.gif\" width=\"41\"></font></p>\n</td>\n<td width=\"422\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">주로 \n                            낚아지는 고기입니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">물론 \n                            이것도 낚시 스킬 전체를 통해 계속 나오게 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">단검을 \n                            이용하여 고기를짤라</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">불에 \n                            굽게 되면 스테이크가됩니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">기본적인 \n                            쿠킹스킬만으로도 몇 번의실패만</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">허용한다면 \n                            맛잇게 구울 수 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_highly_peculiar.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_prize.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_truly_rare.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_wondrous.gif\" width=\"30\"></font></p>\n</td>\n<td width=\"422\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">스킬 \n                            80부터 낚아지는 고기로 더블클릭으로 먹게되면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">고기마다 \n                            각종 스탯이 오르게 됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"39\" src=\"/img/posts/site/skill/images/uojobs/fish/bigfish.gif\" width=\"41\"></font></p>\n</td>\n<td width=\"422\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">스킬 \n                            80부터 낚아지는 고기로낚게되면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">바로 \n                            발밑으로 떨어지게 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">박제의재료로도 \n                            널리 쓰입니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon_1/\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>UO.Tip</b></font></a>란에 \n                            하우스애드온을 참조하시길.</p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill/images/uojobs/fish/map.gif\" width=\"32\"></font></p></td>\n<td width=\"422\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">90부터 건질 수 있으며 1렙지도입니다</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">물뱀을 처리하면 랜덤하게 나옵니다</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill/images/uojobs/fish/rolled_map.gif\" width=\"20\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill/images/uojobs/fish/bottle_of_ale.gif\" width=\"9\"></font></p></td>\n<td width=\"422\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">100부터 건질 수 있으며 병을 2번클릭 하면 맨좌측 \n            스크롤 그림이 됩니다,스크롤그림을 2번클릭하면 좌표가 나옵니다</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">스킬이 지엠일때 낚인 물뱀을  처리하면 랜덤하게 \n                            나옵니다.</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"51\" width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill/images/uojobs/fish/specialnet.gif\" width=\"44\"></font></p></td>\n<td height=\"51\" width=\"422\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">물뱀을 처리하면 랜덤하게 나옵니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">[그물이지만 장식용으로 많이 쓰입니다]</font></p></td>\n</tr>\n<tr>\n<td height=\"51\" width=\"122\">\n<p align=\"center\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"47\" src=\"/img/posts/site/skill/images/uojobs/fish/metalchest.gif\" width=\"38\"></font></p>\n</td>\n<td height=\"51\" width=\"422\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">메탈체스트로 \n                            SOS병을 건졋을 때 랜덤으로나옵니다. 보통은 나무상자가 \n                            나옵니다.물론 상자안에는아이템이 가득 차있습니다</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#666666\" face=\"돋움\" size=\"2\">위에서 보시다시피 \n                <b>1렙지도,그물,sos병</b>은 셔펜이라는 물뱀을 주기고</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">룻을 \n                해야만 합니다.물론 랜덤이므로 물뱀을 죽여도 안나올 때가 많습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">일반적으로 \n                물뱀을 낚을대 물뱀이 무엇을 가지고 나오는지 좌측에 메시지를</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">보시면 \n                알 수 있습니다 net이라는 단어가 있으면 그물,</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">bottle이라는단어가 \n                있으면 sos병이런 식입니다..</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"549\">\n<tbody><tr>\n<td bgcolor=\"silver\" colspan=\"2\" width=\"545\">\n<p><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>그물던지기</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/net.gif\" width=\"150\"></font></p>\n</td>\n<td width=\"352\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">얻은 \n                            그물을 더블클릭하고 물을 찍으면 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">몇십초후에 \n                            물뱀2마리,크라켄1마리가</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">나옵니다,물론 \n                            랜덤이므로 워터,물뱀섞여서 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">나올 수도 있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">나오는 \n                            마리수는 그물하나당 (1-3마리입니다)</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">포인트를 \n                            되도록 잘잡으셔셔 던지시길.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">바다깊은곳이 \n                            더 크라켄이 잘나오는 것 같습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">크라켄은 \n                            sos병을 가지고 나올 확률이 큽니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">물론 \n                            낚시 스킬 없이도 그물을 던질 수 있으니</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">되도록 \n                            전투캐릭을 이용하시길 바랍니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" colspan=\"2\" width=\"545\">\n<p><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>SOS병 좌표찿기</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"191\">\n<p align=\"center\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/map_sos.gif\" width=\"200\"></font></p>\n</td>\n<td width=\"352\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">메시지를 클릭하면 좌측사진처럼 \n                            좌표가 나옵니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>1</b>.UOAM을 \n                            사용하시면 더욱 편리하게 찿으실수 있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">UO.TIP란에 <a href=\"/site/skill/uo_knowhow_place/\">\n<b>UOAM</b></a>을 \n                            참조하시길.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>2</b>.일반지도를 \n                            보고 찾는방법은 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">일단 \n                            지도를 \n                            받으실려면 여기를 <a href=\"/img/posts/site/fishmap.gif\" target=\"_blank\"><b>Click</b></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>:::예제:::</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">지도를 보시면 \n                            6시방향제일하단에 \n                            히스로스섬좌측에</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">문어그림이 \n                            보이실겁니다.그쪽 좌표를 알아보겠습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">좌측에 \n                            빨간막대 North즉 N135-180사이</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">우측상단 \n                            빨간막대 EAST 즉E135-180사이</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">라는 \n                            것을 알 수 있습니다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">근처의 \n                            지리를 아셨으면 그좌표근처로 가셔셔 좌표계로</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">조금씩 \n                            다가가시면됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">SOS병또한 \n                            낚시 스킬이 필요없습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">하지만 \n                            높은 스킬일수록 찾는 지역이 넓어집니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" colspan=\"2\" width=\"545\">\n<p><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>스킬별 낚시 \n                            올리기</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"191\">\n<p align=\"center\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/fish/map_skill.gif\" width=\"200\"></font></p>\n</td>\n<td width=\"352\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;좌측사진에서 \n                            빨간선라인에서 육지쪽으로가는 지역이</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">스킬이 \n                            낮은 분들이 낚시를 해야할 선입니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">스킬이 \n                            오를수록 바다쪽으로 가시면됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">초기에는 \n                            빨간선라인즉 해안가에서 바다쪽으로 왕복항해 하시면서 \n                            고기를 잡으셔도 됩니다</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/box.gif\" width=\"250\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>SOS병</b>을 \n                많이 모아 한꺼번에 찾는것이 시간이 덜 걸린다는점을...</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">1개의 \n                sos병이 1000-3000Gp까지 주며</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">낚을 \n                때는 상자가 바로 나오거나 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">초상화,해골뼈,돌,지구본,시계,조개등이 먼저 낚일 수 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/fish/gift.gif\" width=\"300\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">위에 \n                열거된 아이템이 나오면 그포인트가 맞는 포인트이므로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">계속 \n                그 자리에서 낚으시길</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">최후에는 \n                상자가 통째로 건져 올려집니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/monster.gif\" width=\"250\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>마지막</b>으로 \n                낚시는 물뱀을 죽여서 1렙지도,SOS병,그물을 얻어야 함으로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">근접 \n                공격의 전투스킬보다는 원거리 공격의 전투스킬을 권장합니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">원거리공격의 \n                전투스킬은 메절,이벨,메디의 조합과</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">아쳐,택틱의조합이 \n                있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">어떤 \n                조합을 하시든지 마지막결정은 여러분이~</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;Written \n                By Forg</b></font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_jobs_fishing/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>"
}
