  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_3.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_alchemy/\"><img alt=\"연금술[포션제작]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_a.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_poisoning/\"><img alt=\"독바르기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_p.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_taste/\"><img alt=\"맛감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tid.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_blacksmith/\"><img alt=\"대장장이\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_b.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_mining/\"><img alt=\"광부\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_m.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tailor/\"><img alt=\"재단사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ta.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_thinker/\"><img alt=\"팅거링[기계공]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_bow/\"><img alt=\"활제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_bow.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_car/\"><img alt=\"목공\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_c.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_begging/\"><img alt=\"구걸\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_be.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_cooking/\"><img alt=\"요리사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cook.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_ins/\"><img alt=\"마법스크롤제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_i.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anit/\"><img alt=\"동물길들이기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ani.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anil/\"><img alt=\"동물지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_al.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_vet/\"><img alt=\"수의학\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_v.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_carto/\"><img alt=\"보물사냥꾼\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_car.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lock/\"><img alt=\"자물쇠열기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lock.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_fishing/\"><img alt=\"낚시\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_f.gif\" width=\"110\"></a><a href=\"/site/skill/uo_jobs_ss/\"><img alt=\"심령술[죽은자와대화]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_sp.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_camping/\"><img alt=\"야영\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cam.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lumber/\"><img alt=\"나무패기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lum.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_detect/\"><img alt=\"숨은물체찿기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_d.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tracking/\"><img alt=\"추적\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tra.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_armslore/\"><img alt=\"장비지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_arm.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_item/\"><img alt=\"아이템감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_id.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/j_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;<a href=\"/site/skill/uo_jobs_tailor/\"><font color=\"black\" face=\"돋움\" size=\"2\">테일러(재단사)</font></a>/<a href=\"/site/skill/uo_jobs_tailor_1/\"><font color=\"black\" face=\"돋움\" size=\"2\">스킬도표</font></a></b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999999\" bordercolordark=\"#999999\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"503\">\n<tbody><tr>\n<td bgcolor=\"silver\" colspan=\"4\" height=\"58\" width=\"499\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_logo.gif\" width=\"200\"></font> </p></td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" colspan=\"4\" width=\"499\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>필요재료</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_9.gif\" width=\"70\"></font></p>\n</td>\n<td colspan=\"3\" width=\"427\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">단검을 \n                            2번클릭 후 타켓이 뜨면 양을 클릭합니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">좌측에 \n                            사진처럼 왼쪽-양털이 다 벗겨진 양이 아닌 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">오른쪽-양털이 \n                            있는 양만이 양털을 줍니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" colspan=\"4\" width=\"499\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;&nbsp;양털로 \n                            두루마기천 만들기 순서</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_1.gif\" width=\"70\"></font></p>\n</td>\n<td colspan=\"3\" width=\"427\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.좌측에 \n                            양털은 단검으로 양털을 깍았을대 나오는양털이고</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">우측3개의뭉치로 \n                            되있는양털은 양을 죽이고 단검으로 시체를</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">뜯었을대 \n                            나오는 양털입니다.즉 1개(단검으로깍았을때)=3개입니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_2.gif\" width=\"70\"></font></p>\n</td>\n<td colspan=\"3\" width=\"427\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.다음은 \n                            얻은 양털을 가지고 물레앞에 서서</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">양털을 \n                            2번클릭후 물레를 클릭하시면 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">잠시후 \n                            3번좌측의 실뭉치가 백팩안으로 들어오게 됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"62\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_3.gif\" width=\"70\"></font></p>\n</td>\n<td colspan=\"3\" height=\"62\" width=\"427\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3.좌측에 \n                            실뭉치는 양털1개당 1개의실뭉치가 나옵니다,</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">깍은 \n                            양털은 1개가 3개의 실뭉치가 나옵니다.</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"60\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_4.gif\" width=\"70\"></font></p>\n</td>\n<td colspan=\"3\" height=\"60\" width=\"427\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">4.이제 \n                            얻은 실뭉치를 더블클릭을 한 후 타겟이 뜨면 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">베틀(룸)에다가 \n                            클릭하시면됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">5개의 \n                            실뭉치는 1개의 두루마기 천이 됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_8.gif\" width=\"70\"></font></p>\n</td>\n<td colspan=\"3\" width=\"427\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">5.완성된 \n                            두루마기 천입니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" colspan=\"4\" width=\"499\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;&nbsp;목화로 \n                            두루마기천 만들기 순서</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_6.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"160\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.농장에 \n                            있는 목화를</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">더블클릭합니다</font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_7.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"203\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.면화를 \n                            따게 됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_2.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"160\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3.면화를 \n                            더블클릭후</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">타겟이 \n                            뜨면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물레를 \n                            클릭합니다</font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_5.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"203\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">4.잠시후 \n                            실타래(스폴)가 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">만들어집니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_4.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"160\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">5.만들어진 \n                            스폴을</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"> \n                            더블클릭 후</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">타겟이 \n                            뜨면 베틀을 클릭</font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/tailor_8.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"203\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">6.두루마기 \n                            천이 만들어집니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">5개의스폴은 \n                            </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1개의두루마기천이됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"silver\" colspan=\"4\" width=\"498\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"gray\" face=\"돋움\" size=\"2\"><b>&nbsp;테일러 \n                            도구</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/sil.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"160\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.천이나가죽을</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가지고 \n                            있다면 좌측에</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">실패를 \n                            더블클릭하면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">메뉴가 \n                            나옵니다.</font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/uojobs/tailor/s.gif\" data-recovery=\"missing\" height=\"70\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:70/70\" width=\"70\"></font></p>\n</td>\n<td width=\"203\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.통가죽을 \n                            가벼운 가죽으로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">만들어 \n                            줍니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/le.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"160\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3.단검으로 \n                            더블클릭한후</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">타겟이 \n                            뜨면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동물이나 \n                            몬스터의시체를</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"> \n                            클릭한후 얻을수있습니다.</font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill/images/uojobs/tailor/le_1.gif\" width=\"70\"></font></p>\n</td>\n<td width=\"203\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">4.얻은 \n                            통가죽을 가위로이용하여</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가벼운가죽으로 \n                            바꾸어줍니다.</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">p.s : 가죽을 얻는 장소는 델루시아목장,젤롬목장,눈섬등이 \n                있으며 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">몬스터에서는 리자드맨,석상을 구하시는분은 요정에게서도 \n                가죽을 모을수있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>"
}
