  "css": "A.b:link,a:link,a:visited{font-family:\"굴림\"; color:#0000ff;text-decoration:none}\na:hover{font-family:\"굴림\";color: #ff0000;text-decoration: underline}",
  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_anit/\"><font color=\"black\" face=\"Verdana\">길들이기(Taming)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_vet_anit_1/\"><font color=\"black\" face=\"Verdana\">테이밍스킬수치표</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_vet_anit_2/\"><font color=\"black\" face=\"Verdana\">주요스폰장소</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_vet_anil/\"><font color=\"black\" face=\"Verdana\">동물지식(Animal Lore)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_vet/\"><font color=\"black\" face=\"Verdana\">동물붕대힐(Veterinary)</font></a><font color=\"black\" face=\"Verdana\"> l 목동술(Herding)</font></span></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"505\">\n<tbody><tr>\n<td colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;유니콘 \n                            리스폰 장소(일쉐나)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"240\" src=\"/img/posts/site/skill_index/images/uojobs/animal/unicorn.gif\" width=\"250\"></span></font></p>\n</td>\n<td width=\"249\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"240\" src=\"/img/posts/site/skill_index/images/uojobs/animal/unicorn_1.gif\" width=\"245\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">숭고함의 \n                            게이트를 선택해서 나오는 길에 보이는 숲전체에 유포되어있습니다</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">약 \n                            2-3마리가 리젠이됩니다. 테임후 게이트로 들어가셔셔 \n                            </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">다른 \n                            서버구역으로 유니콘을 이동하셔야 유니콘이 다시 리젠됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">p.s \n                            : 테이머가 여성 캐릭이어야 합니다. 카르마가 너무 \n                            낮으믄 주위의</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">요정들이 \n                            공격을 가하므로 염두해두시길..</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">일쉐나대륙(서드돈)으로 \n                            가는길은 각종유용한정보란에 문게이트위치편을 보시길...</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;나이트메어,기린,스웜프드래곤 \n                            리스폰장소(일쉐나)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/kirin.gif\" data-recovery=\"missing\" height=\"300\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:500/300\" width=\"500\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">정직의 \n                            게이트로 이동합니다. 기린과나메의 리스폰장소는 2가지 \n                            길이 있습니다</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">A포인트와 \n                            B포인트, B포인트로 가시면 바로 리스펀장소로 갈 수 \n                            있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지도에서 \n                                        보시면 정직게이트와 B포인트 가는 늪지대에서</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스웜프드래곤</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                                        만나실 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/kirin_1.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/240\" width=\"250\"></span></font></p>\n</td>\n<td width=\"249\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/kirin_2.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:245/240\" width=\"245\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/kirin_4.gif\" data-recovery=\"missing\" height=\"260\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/260\" width=\"250\"></span></font></p>\n</td>\n<td width=\"242\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">A포인트를 \n                            가시게 되면 요정과 동양용의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">리스펀장소가 \n                            보이고 C포인트로 이동</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">하면 \n                            Ankh던전이라는곳으로 워프됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Ankh던전에서 \n                            빠르게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\">\n<font face=\"Verdana\"><span style=\"font-size:9pt;\">D포인트로 이동합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그러면 \n                            이제 최종 목적지인 좌측사진의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">장소로 \n                            이동하게됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">사진에서와 \n                            같이 기린의 리스펀장소와</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">나이트메어의 \n                            리스펀 장소가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">구분되어져 \n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            되돌아 가실 때는 템한 것을 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">타고 \n                            가시는게 편합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/kirin_3.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/240\" width=\"250\"></span></font></p>\n</td>\n<td width=\"242\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">기린의 \n                            리스펀 장소입니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지도를 \n                            보시면 아시겠지만 땅에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그려진 \n                            동물의 문양이 인상적입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">p.s \n                            : 기린은 유니콘과 반대로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">오직 \n                            남성캐릭만이 테임할 수 있고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                            탈 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"500\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;탈 \n                            수 있는 라마,광폭,색오타(T2A지역)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/tame_11.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></span></font></p>\n</td>\n<td width=\"245\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/tame_12.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">델루시아마을에서 \n                            북쪽이나 동쪽으로 쭉가시다보면 군데군데 리스펀장소가 \n                            있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">라마는 \n                            </span><b><span style=\"font-size:9pt;\">a ridable llama</span></b><span style=\"font-size:9pt;\">라는 것만 오직 탈 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">화이트웜(아이스던전)과 \n                                        나이트메어(T2A-테라산킵)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"250\" src=\"/img/posts/site/skill_index/images/uojobs/animal/wdragon.gif\" width=\"248\"></span></font></p>\n</td>\n<td width=\"245\">\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/animal/night_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">좌측 \n                            사진에 빨간점이 화이트웜의 리스펀 지역입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테라산킵에서 \n                            남쪽방향끝부근에서 리스펀 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">근처에 \n                            드레이크와옵피디언도 리젠되니 주의하시길..</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n"
}
