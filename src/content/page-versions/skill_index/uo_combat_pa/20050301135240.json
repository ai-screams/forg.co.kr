  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<table align=\"center\" border=\"\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" height=\"28\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"499\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">패링스킬</span></font></p></td>\n<td align=\"center\" background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어성공율증가(방패)</span></font></p></td>\n<td align=\"center\" background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어성공율증가(양손무기)</span></font></p></td>\n</tr>\n<tr>\n<td><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">1.5%</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">0.75%</span></font></p></td>\n</tr>\n<tr>\n<td><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">25</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">7.5%</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3.75%</span></font></p></td>\n</tr>\n<tr>\n<td><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">50</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15%</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">7.5%</span></font></p></td>\n</tr>\n<tr>\n<td><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">75</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">22.5%</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">11.25%</span></font></p></td>\n</tr>\n<tr>\n<td><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">30%</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15%</span></font></p></td>\n</tr>\n<tr>\n<td><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">120</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">36%</span></font></p></td>\n<td align=\"center\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">18%</span></font></p></td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">패링은</span></b><span style=\"font-size:9pt;\"> 전사의 상징으로도 \n\n                대변되는 방패기술입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물리적타격의 데미지를 \n\n                감소 할 수 있는 장점으로 강한 적을 위해 대비를 할 수 있는스킬입니다. \n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            양손무기로도 패링스킬이 적용이 됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:20;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>계산방법</b>:</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어성공율증가(방패) \n                            = 패링스킬 * 0.3</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어성공율증가(양손무기) \n                            = 패링스킬 * 0.15</span></font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">최종적인 \n                            방어성공율증가수치= 방어성공율증가(방패,양손무기)+방어성공율이 \n                            붙어있는 악세사리류</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">P.S : 드래곤의 브레스계열의 \n\n                데미지는 레지와 패링기술과 상관이 없습니다</span></font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">출처 \n                            :  </span></font><a href=\"http://uo.stratics.com/\" target=\"_blank\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">UOSS</span></b></font></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n"
