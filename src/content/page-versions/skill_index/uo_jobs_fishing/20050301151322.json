  "css": "A.b:link,a:link,a:visited{font-family:\"굴림\"; color:#0000ff;text-decoration:none}\na:hover{font-family:\"굴림\";color: #ff0000;text-decoration: underline}",
  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith) \n                            l&nbsp;광부(Mining) \n                            l&nbsp;장비지식(Arms Lore)</font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry) \n                            l&nbsp;나무꾼(Lumberjacking)</font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor) \n                            l 구걸(Begging) l 기계공(Tinkering) l 낚시(Fishing) \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a></span></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:25; margin-bottom:0; margin-left:25;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"120\" src=\"/img/posts/site/skill_index/images/uojobs/fish/logo.gif\" width=\"200\"></span><b><span style=\"font-size:9pt;\">낚시</span></b><span style=\"font-size:9pt;\">는 \n                레어급아이템을 얻을 수 있다는 큰장점이 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:25; margin-bottom:0; margin-left:25;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">우선 \n                스킬별로 무엇을 낚을 수 있는지 알아봅시다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:25; margin-bottom:0; margin-left:25;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">현재는 \n                            낚시중에 물뱀이라는 몹이 스펀되고, sos병에서 얻을 \n                            수 있는 매직 아이템들이 거의 메리트가 없기때문에 \n                            사장되어 가는분위기 입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:25; margin-bottom:0; margin-left:25;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">하지만 \n                            색그물,메탈상자,(돌)방석,그림은 하우스인테리어</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:25; margin-bottom:0; margin-left:25;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">작업에 \n                            필요한 것이기 때문에 인기가 많습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"\" bordercolor=\"#A0965A\" bordercolordark=\"#999933\" bordercolorlight=\"#A0965A\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" colspan=\"2\" height=\"30\" width=\"546\">\n<p><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;스킬별 \n                            아이템</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"28\" src=\"/img/posts/site/skill_index/images/uojobs/fish/boots.gif\" width=\"18\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill_index/images/uojobs/fish/sandals.gif\" width=\"20\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill_index/images/uojobs/fish/shoes.gif\" width=\"19\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill_index/images/uojobs/fish/thighboots.gif\" width=\"26\"></span></font></p></td>\n<td width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">고기와 \n                                        함께 많이 나오는 신발입니다.</span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">해안가 근처에서는 더 빈번하게 나옵니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_brown.gif\" width=\"40\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_green.gif\" width=\"41\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/fish/fish_blue.gif\" data-recovery=\"missing\" height=\"40\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:38/40\" width=\"38\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/fish/fish_yellow.gif\" data-recovery=\"missing\" height=\"40\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:41/40\" width=\"41\"></span></font></p>\n</td>\n<td width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">주로 \n                            낚아지는 고기입니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            이것도 낚시 스킬 전체를 통해 계속 나오게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">단검을 \n                            이용하여 고기를 짤라 불에 \n                            굽게 되면 스테이크가됩니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">기본적인 \n                            쿠킹스킬만으로도 맛있게 구울 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_highly_peculiar.gif\" width=\"30\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/fish/fish_prize.gif\" data-recovery=\"missing\" height=\"36\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/36\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_truly_rare.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_wondrous.gif\" width=\"30\"></span></font></p>\n</td>\n<td width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            80부터 낚아지는 고기로 더블클릭으로 먹게되며</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">각종 스탯이 오르게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"39\" src=\"/img/posts/site/skill_index/images/uojobs/fish/bigfish.gif\" width=\"41\"></span></font></p>\n</td>\n<td width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            80부터 낚아지는 고기로 바로 \n                            발 밑으로 떨어지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">박제의재료로도 \n                            널리 쓰입니다 </span></font><a href=\"/site/skill/uo_knowhow/\"><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">UO.Tip</span></b></font></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">란에 \n                            하우스애드온을 참조하시길.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill_index/images/uojobs/fish/map.gif\" width=\"32\"></span></font></p></td>\n<td width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">90부터 건질 수 있으며 1렙지도로 \n                                        물뱀을 처리하면 랜덤하게 나옵니다</span></font></p></td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill_index/images/uojobs/fish/rolled_map.gif\" width=\"20\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill_index/images/uojobs/fish/bottle_of_ale.gif\" width=\"9\"></span></font></p></td>\n<td width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">100부터 건질 수 있으며 물뱀을  처리하면 랜덤하게 \n                            나옵니다.</span></font></p></td>\n</tr>\n<tr>\n<td height=\"51\" width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/specialnet.gif\" width=\"44\"></span></font></p></td>\n<td height=\"51\" width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">80부터 \n                                        건질 수 있으며 물뱀을 처리하면 랜덤하게 나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">[그물이지만 색이 \n                                        여러종류가 있기에 장식용으로 많이 쓰입니다]</span></font></p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_iceblue.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_neonpurple.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_purple.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_red.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_shadow.gif\" width=\"44\"></span></font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_turquoise.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_bronze.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_blue.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_teal.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_fire.gif\" width=\"44\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"51\" width=\"122\">\n<p align=\"center\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"47\" src=\"/img/posts/site/skill_index/images/uojobs/fish/metalchest.gif\" width=\"38\"></span></font></p>\n</td>\n<td height=\"51\" width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">메탈체스트로 \n                            SOS병을 건졌을 때 랜덤으로나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">다소 \n                                        높은가격으로 다른 플레이어에게 매매하실 \n                                        수 있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td> <p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/fish/net.gif\" data-recovery=\"missing\" height=\"150\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:150/150\" width=\"150\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><b>그물 \n                                        사용법</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">얻은 \n                            그물을 더블클릭하고 타겟을 바다에 선택하시면 몇초 \n                                        후에 \n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">물뱀과 \n                                        크라켄이 랜덤하게 스펀되어 집니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">나오는 \n                            마리수는 그물하나당 (1-3마리입니다)</span></font></p>\n<p style=\"line-height:50%; margin:0;\"><font color=\"black\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">바다 \n                                        깊은곳이 \n                            더 크라켄이 잘 나옵니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">크라켄은 \n                            sos병을 가지고 나올 확률이 큽니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            낚시 스킬 없이도 그물을 던질 수 있으니 되도록 \n                            전투캐릭을 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">이용하시길 바랍니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td> <p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><b>SOS병 \n                                        찿기</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">메시지를 클릭하면 좌측사진처럼 \n                            좌표가 나옵니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">UOAM을 \n                            사용하시면 더욱 편리하게 찿으실수 있습니다. </span></font><a href=\"/site/skill/uo_knowhow_place/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><b>각종유용한정보-</b></font></span><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">UOAM</span></b></font></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                            참조하시길.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"150\" src=\"/img/posts/site/skill_index/images/uojobs/fish/map_sos.gif\" width=\"200\">지도를 보시면 \n                            6시방향제일하단에 \n                            히스로스섬좌측에</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">문어그림이 \n                            보이실겁니다.그쪽 좌표를 알아보겠습니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">좌측에 \n                            빨간막대 North즉 N135-180사이</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">우측상단 \n                            빨간막대 EAST 즉E135-180사이</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">라는 \n                            것을 알 수 있습니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">근처의 \n                            지리를 아셨으면 그좌표근처로 가셔셔 좌표계로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">조금씩 \n                            다가가시면됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">SOS병또한 \n                            낚시 스킬이 필요없습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">하지만 \n                            높은 스킬일수록 찾는 지역이 넓어집니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/fish/map_skill.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:200/100\" width=\"200\">\n<img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><b>스킬 \n                                        올리기</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">빨간선라인에서 육지쪽으로가는 지역이 \n                                        스킬이 \n                            낮을때 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚시를 해야할 선입니다 \n                                        스킬이 \n                            오를수록(</span><b><span style=\"font-size:9pt;\">약 \n                            65이상</span></b><span style=\"font-size:9pt;\">) </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">바다쪽으로 가시면됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">초기에는 \n                            빨간선라인즉 해안가에서 바다쪽으로 왕복항해 &nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">하시면서 \n                            고기를 잡으셔도 됩니다</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"150\" src=\"/img/posts/site/skill_index/images/uojobs/fish/box.gif\" width=\"250\"></span><b><span style=\"font-size:9pt;\">SOS병</span></b><span style=\"font-size:9pt;\">을 \n                많이 모아 한꺼번에 찾는것이 시간을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">절약할 \n                                        수 있는 방법입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">1개의 \n                sos병이 1000-3000Gp까지 주며</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚을 \n                때는 상자가 바로 나오거나 초상화,해골뼈,돌,</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">지구본,시계,조개등이 먼저 낚일 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:120%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"right\" border=\"1\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/fish/monster.gif\" data-recovery=\"missing\" height=\"150\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/150\" width=\"250\"></span><b><span style=\"font-size:9pt;\">마지막</span></b><span style=\"font-size:9pt;\">으로 \n                낚시는 물뱀을 죽여서 1렙지도,</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">SOS병,그물을 얻어야 함으로 \n                                        근접 \n                공격의 전투스킬보다는 원거리 공격의 전투스킬을 권장합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">원거리공격의 \n                전투스킬은 메절,이벨,메디의 조합과</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">아쳐,택틱의조합이 \n                있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n"
}
