  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_4.gif\" width=\"110\"></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hdecoration/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_house/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_hou.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_houseadd.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hoption/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_sign.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_command/\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_com.gif\" data-recovery=\"missing\" style=\"width:110px;height:20px;line-height:20px\">울온 명령어</span></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_vendor/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_vendor.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_moon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_moon.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_fame/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_f.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_runebook/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_rune.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_secret/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mw/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uosu/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_u.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mirc/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_mirc.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;UOAM_LINK</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"60%\">\n<tbody><tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/uoam_link.gif\" data-recovery=\"missing\" height=\"357\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:393/357\" usemap=\"#ImageMap1\" width=\"393\"></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">창에서보면 \n                    자신이 사용할 이름<b>[닉]</b>과 <b>IP 포트 패스워드</b>란이 \n                    보일 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">IP란은 \n                    링크를 하려는 사람만 입력하면 되고 패스워드또한 사용하지 \n                    않아도 무방하다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">먼저 \n                    한명이 서버를 만들도록 한다. &nbsp;start server를 &nbsp;선택하면 \n                    IP 란에 자신의 IP번호가 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">자동입력되고 \n                    UOAM 상에 자신의 닉이 표시될 것이다. 또한 Player 란에 가보면 \n                    자신이 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">등록된 \n                    것을 볼수 있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">근처에 \n                    위치한 마을과 위도경도등도 같이 표시된다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이제 \n                    서버에 연결하고자 하는 플레이어는 뭐 전화나 아알씨상으로 \n                    IP &nbsp;주소 알아낸후 IP</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">주소란에 \n                    번호를 입력하고 Link to server를 클릭하면 된다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">자 \n                    이제 링크가 되었다. &nbsp;여기서부터 많은 기능을 활용할수 \n                    있게 되는 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Written \n                    By </b></font><font color=\"#666666\" face=\"돋움\" size=\"2\">HolyPink</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</ul>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><map name=\"ImageMap1\">\n<area coords=\"312, 10, 356, 23\" href=\"/site/skill/uo_knowhow_uoam/\" shape=\"rect\">\n<area coords=\"212, 11, 274, 24\" href=\"/site/skill/uo_knowhow_ass/\" shape=\"rect\">\n<area coords=\"115, 10, 170, 23\" href=\"/site/skill/uo_knowhow_files/\" shape=\"rect\">\n<area coords=\"29, 9, 83, 23\" href=\"/site/skill/uo_knowhow_mark/\" shape=\"rect\">\n<area coords=\"23, 27, 71, 39\" href=\"/site/skill/uo_knowhow_place/\" shape=\"rect\">\n<area coords=\"97, 27, 138, 40\" href=\"/site/skill/uo_knowhow_filter/\" shape=\"rect\">\n<area coords=\"172, 27, 222, 40\" href=\"https://web.archive.org/web/20010709180746/http://forg.co.kr/skill/uo_knowhow_player.htm\" shape=\"rect\" target=\"_blank\">\n<area coords=\"250, 27, 287, 40\" href=\"/site/skill/uo_knowhow_map/\" shape=\"rect\">\n<area coords=\"324, 28, 361, 40\" href=\"/site/skill/uo_knowhow_link/\" shape=\"rect\">\n</map></font></p>",
