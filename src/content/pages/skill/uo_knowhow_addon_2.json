  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_4.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hdecoration/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_h.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_house/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_hou.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_houseadd.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hoption/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_sign.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_command/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_com.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_vendor/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_vendor.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_moon/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_moon.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_r.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_fame/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_f.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_runebook/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_rune.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_secret/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_s.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mw/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_m.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uosu/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_u.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mirc/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_mirc.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;</b></font><a href=\"/site/skill/uo_knowhow_addon/\"><font color=\"black\" face=\"돋움\" size=\"2\">House-Add On</font></a> /<a href=\"/site/skill/uo_knowhow_addon_1/\"><font color=\"black\" face=\"돋움\" size=\"2\">박제</font></a>/<a href=\"/site/skill/uo_knowhow_addon_2/\"><font color=\"black\" face=\"돋움\" size=\"2\">케그통</font></a></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><table align=\"center\" border=\"\" bordercolor=\"silver\" bordercolordark=\"silver\" cellspacing=\"0\" height=\"28\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td class=\"top\" height=\"28\" width=\"550\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/houseon/keg_logo.gif\" data-recovery=\"missing\" height=\"80\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/80\" width=\"250\"></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>케그통</b>은 포션이 100개가 들어 갑니다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 한종류이어야 하고 같은 종류라도</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">같은 등급(그레이트힐포션, 힐포션...등등)으로 저장할 수 \n                    있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>장점은 </b>우선 인테리어를 할 수 있을정도로 이쁘다는 \n                    것과 락다운갯수나</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">시큐어 갯수를 줄일 수 있다는 것입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 알케미에게 있어서도 중요한 아이템이 됩니다...종류별로 \n                    집에 장식겸</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">실용적으로 써보시는 것을 권장 합니다...</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>케그통</b>을 만들기 위해서는 카펜과팅거스킬이 필요합니다..</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">만드는 순서는 아래 도표를 참조하시길..</font></p>\n</ul>\n<table align=\"center\" border=\"1\" bordercolor=\"#999999\" bordercolordark=\"#999999\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"504\">\n<tbody><tr>\n<td bgcolor=\"silver\" colspan=\"4\" width=\"500\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;필요재료와 \n                            해당 스킬치</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/houseon/keg.gif\" data-recovery=\"missing\" height=\"70\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:130/70\" width=\"130\"></font></p>\n</td>\n<td width=\"167\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.통널 \n                            3개 (카펜스킬 : 11)</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.통뚜껑 \n                            1개</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3.통 \n                            고리테 (팅거스킬 :28)</font></p>\n</td>\n<td width=\"40\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/houseon/keg_1.gif\" data-recovery=\"missing\" height=\"70\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:50/70\" width=\"50\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">카펜메뉴에서</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">빈통이 \n                            만들어집니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">(카펜스킬 \n                            : 57.8)</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/houseon/keg_2.gif\" data-recovery=\"missing\" height=\"70\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:130/70\" width=\"130\"></font></p>\n</td>\n<td width=\"167\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.빈통</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.통뚜껑1개</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3.케그꼭지(팅거스킬 \n                            :50.1)</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">4.빈병 \n                            10개</font></p>\n</td>\n<td width=\"40\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/houseon/keg_3.gif\" data-recovery=\"missing\" height=\"70\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:50/70\" width=\"50\"></font></p>\n</td>\n<td width=\"156\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">팅거도구를 \n                            더블클릭후</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">통뚜껑을 \n                            클릭하시면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">케그통이 \n                            완성됩니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">(팅거스킬 \n                            : 52).</font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>&nbsp;</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>&nbsp;</b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n",
