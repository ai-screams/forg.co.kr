  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow/\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_1.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_1/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/l_logo_rare_3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_2/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_2.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_3/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_5.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_4/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_4.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_5/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_6.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_b.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;Sever_Up Rare</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/rare_3.gif\" data-recovery=\"missing\" height=\"28\" src=\"/img/placeholder/missing.svg\" width=\"170\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"\" bordercolordark=\"#999999\" bordercolorlight=\"#999999\" width=\"80%\">\n<tbody><tr>\n<td colspan=\"4\" height=\"14\" width=\"493\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"돋움\" size=\"2\"><b>섭업레어</b></font></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그림</font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이름</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">설명</font></p></td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사진</font></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"26\" src=\"/img/posts/site/skill/images/rare/fruitbasket.gif\" width=\"26\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Fruit Basket </font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Yew마을에서 West방향으로 </font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">끝쪽 엔피시집</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101021652/http://forg.co.kr/skill/images/rare/r1.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"27\" src=\"/img/posts/site/skill/images/rare/basket.gif\" width=\"28\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">빈바구니</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3곳에서 리스폰됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">[부케와미르2곳]</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 공복상태를 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">유지해야만합니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">미르사진에서 바로위층으로 가시면 하나더 있습니다^^</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">과일이 든 상태로는 안집어지므로 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2번클릭으로 \n            드신후 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">빈바구니만 챙기심됩니다.</font></p></td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101021652/http://forg.co.kr/skill/images/rare/r3.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill/images/rare/cbarrel.gif\" width=\"29\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Barrel[Closed]</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Deceit던전 2군데서 나옵니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">[1.디싯입구,2,본나방 \n            바로옆]</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">락다운된곳에 겹쳐서 나옵니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">안집어지면 누군가 집어간 것입니다.</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r2/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"46\" src=\"/img/posts/site/skill/images/rare/barrel.gif\" width=\"31\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Barrel</font></p></td>\n<td width=\"419\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">빈염색통약과 함께<b>무한리젠</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">되는 아템입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Pitcher of \n            water(여관에서사서)</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">보통 마을에 있는 것은 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물병에 물을 빼고 배럴에다 채운후 물을 다시 \n                            빼시면 들립니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">길가나 던전에 널려 잇는 것은</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그냥 집으시면됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">잠긴배럴은 락픽이나 매직언락</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">으로 여시면됩니다.</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"돋움\" size=\"2\">-</font></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"24\" src=\"/img/posts/site/skill/images/rare/fulljars.gif\" width=\"19\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Full Jars </font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Ocello은행에서 West방향으로 </font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">바로옆 사진에 보이는 오븐 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">반쪽을 들어 버리면 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">풀자가 보입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">힘드신분은 Kal Ort Por란에</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>UO자료실</b>에 있는 파일을 받아서 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">오븐을 투명 처리하시면 됩니다.</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r7/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"45\" src=\"/img/posts/site/skill/images/rare/bucket.gif\" width=\"70\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Bucket</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Pitcher of \n            water로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물을 빼서 집어들엇지만</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이젠 <b>전설</b>이 되 버린 레어-\"-</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사진은 보시다시피 집을 수 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">있던 때입니다..</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">미로에 있습니다.</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101021652/http://forg.co.kr/skill/images/rare/r5.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\">\n<p align=\"center\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/bushel.gif\" data-recovery=\"missing\" height=\"26\" src=\"/img/placeholder/missing.svg\" width=\"27\"></p>\n</td>\n<td width=\"205\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\">Bushel</font></p>\n</td>\n<td width=\"419\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이것또한 \n                            전설이 되어 버린레어로 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">예전 \n                            마젠시아 부둣가에서 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">높낮이 \n                            버그로 얻을 수 있었다 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">현재 \n                            사진은 통나무로 부두밑을 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">막아 \n                            버린 엽기장면-\"-</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r22/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"34\" src=\"/img/posts/site/skill/images/rare/rocks.gif\" width=\"38\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Rock</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">부케마을에서 나옵니다</font></p></td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r4/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/rock_A.gif\" data-recovery=\"missing\" height=\"51\" src=\"/img/placeholder/missing.svg\" width=\"51\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Rock</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">T2A지역테라산Keep </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">UOAM: x5513, y3121 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Sextant: 0o 47'S x 290 44'W</font></p></td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r20/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"11\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/wheatsheaf.gif\" data-recovery=\"missing\" height=\"61\" src=\"/img/placeholder/missing.svg\" width=\"34\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Wheat Sheaf</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">르네이후 거의 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>쓰레기</b>가 되버린 것으로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마우스 2번클릭으로 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">집을 수 있습니다 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Moobglow정문에서</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">South방향 10초거리에서 </font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">쏟아져나옵니다</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r6/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"29\" src=\"/img/posts/site/skill/images/rare/candle.gif\" width=\"20\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Candle</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">코베던전에서 나옵니다</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/images/rare/r8/\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/blood.gif\" data-recovery=\"missing\" height=\"24\" src=\"/img/placeholder/missing.svg\" width=\"46\"></font></p></td>\n<td width=\"205\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Bloodpool</font></p></td>\n<td width=\"419\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">메이지캠프에서 리스폰</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">블튼동쪽에서 롱던전 가는길</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">한때 나왔지만 이젠 <b>전설?</b></font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">-</font></p></td>\n</tr>\n<tr>\n<td width=\"95\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"53\" src=\"/img/posts/site/skill/images/rare/hay.gif\" width=\"52\"></font></p>\n</td>\n<td width=\"205\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Hay</font></p>\n</td>\n<td width=\"419\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">건초더미로 \n                            여러 가지 종류가</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">많이 \n                            있습니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">칼둔던전 \n                            입구에서 리젠</font></p>\n</td>\n<td width=\"32\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101021652/http://forg.co.kr/skill/images/rare/hay_1.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"red\" face=\"돋움\" size=\"2\"><b>&nbsp;</b></font></p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"red\" face=\"돋움\" size=\"2\"><b>p.s </b></font><font face=\"돋움\" size=\"2\">: \n서버다운 후 서버업시 언제 서버가 열리느냐가 제일 중요한 요소가 됩니다.</font></p>\n</ul>\n<ul>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>1</b>.서버가 언제 열리는지 알려주는 유용한 것이 있습니다 여기를 <a href=\"http://ultima.lightning.net/en/\" target=\"_blank\">\n</a></font><a href=\"http://ultima.lightning.net/en/\" target=\"_blank\"><font color=\"blue\" face=\"돋움\" size=\"2\"><b>Click</b></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사용법 : Configuration에 들가셔셔 몇초마다 감시를 하는지 \n정해주심됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">설절을 하신후 Save하시면 됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">위에 열거된레어들은 스틸링없이 그냥 집으시면됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>2</b>.서버가 열리는 상태를 감시할수 있는 프로그램이 있습니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Kal Ort Por란에 UO자료실에 </font><font color=\"purple\" face=\"돋움\" size=\"2\"><b>UO</b></font><font color=\"purple\" face=\"돋움\" size=\"2\"><b>모니터</b></font><font face=\"돋움\" size=\"2\">를 받으시길...</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">[자신이 속해있지 않는 서버는 해당서버 한번클릭후 \n마우스오른족버튼]</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Log server는체크하지 마시고 Hide Server만 체크해주심됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">정기다운타임이외에 예정되지 않는 백타임이 가끔식 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">간혹 백타임시 서버리셋이 들어가는 경우에도 리젠이 됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>3</b>.장소중에 미로는 본홈 노하우란에 비밀장소를 보시길.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare_1/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/wyrmsheart.gif\" data-recovery=\"missing\" height=\"42\" src=\"/img/placeholder/missing.svg\" width=\"30\"></font></a></p>\n</ul>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_knowhow_rare_1/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a></font></p></td>\n</tr>\n</tbody></table></div>\n",
