  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\">Catalog*******</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_vet_mu/\" title=\"뮤지션[음악연주]\">Musicianship+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_pro/\" title=\"프로보케이션[전투도발]\">Provocation</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_peace/\" title=\"피스메이킹[평화연주]\">Peacemaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_ent/\" title=\"유혹\">Enticement</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_anit/\" title=\"애니멀테이밍[길들이기]\">Animal Taming+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_anil/\" title=\"애니멀로어[동물지식]\">Animal Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_vet/\" title=\"베너터리[수의학]\">Veterinary</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_herding/\" title=\"허딩[목동술]\">Herding</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_carto/\" title=\"카토그라피[지도제작술]\">Cartography+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_lock/\" title=\"락픽킹[자물쇠열기]\">Lockpicking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_remove/\" title=\"리무브트랩[함정해제]\">Remove Trap</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_detect/\" title=\"디텍트히든[은폐탐지]\">Detect Hidden</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_ss/\" title=\"스피리트스피킹[심령술]\">Sprit Speaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_camping/\" title=\"캠핑[야영]\">Camping</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_tracking/\" title=\"트랙킹[추적하기]\">Tracking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_forensic/\" title=\"포렌식[해부학]\">Forensic EV.</a><br><br>\n</div><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/vet_logo.gif\" data-recovery=\"missing\" height=\"17\" src=\"/img/placeholder/missing.svg\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"363\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td>\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/p.gif\" data-recovery=\"missing\" height=\"30\" src=\"/img/placeholder/missing.svg\" width=\"30\">EACEMAKING</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"530\">\n<tbody><tr>\n<td class=\"top\" width=\"654\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">■ 평화연주 <img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/musicsheet.gif\" data-recovery=\"missing\" height=\"25\" src=\"/img/placeholder/missing.svg\" width=\"21\"></span></b></font></p>\n</td>\n</tr>\n<tr>\n<td class=\"top\" width=\"654\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uocombat/bard_3.gif\" data-recovery=\"missing\" height=\"198\" src=\"/img/placeholder/missing.svg\" width=\"227\"></span></font></p></td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" width=\"595\"><ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">피스메이킹은</span></b></font><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\"> 말그대로 \n                            화면상에서의 몬스터나 플레이어들의 전투모드를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">순간적으로 \n                            해제 시키는 스킬입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">1</span></b></font><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">.몬스터의 \n                            경우는 타겟이 잃어 버렷기 때문에 잠시 정지상태에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">빠지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 공격모드에 \n                            돌입되지 않은 몬스터는 제 갈길대로 갈 것이고여</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">2</span></b></font><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">.플레이어의 \n                            경우 무기로 공격모드를 한사람은 다시 공격모드를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">취하고 타겟을 \n                            찍어줘야 할 것이고 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">마법주문을 \n                            외우고 있던 사람은 정신적인 방해로 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">다시 주문을 \n                            외워야 할것입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">이러한 매력있는 \n                            스킬인 피스메이킹은 여러 가지 유용한</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬로서 널리 \n                            쓰입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">친구가 드래곤을 \n                            테임할 때도 옆에서 피스를 걸어주면서 한다든지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">친구의 시체를 \n                            룻하게 근처의 몬스터들에게 피스를 걸어준다든지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">몬스터가 많은 \n                            던전에서 유유히 상자를 딸수도 있고 지나갈수 있다든지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">많은곳에 적용을 \n                            시키실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">하지만 그룹으로 \n                            사냥시에는 능숙치못한 평화연주는 그룹멤버에게도</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">나쁜 영향력을 \n                            취할수 있을 것입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">애써 몬스터끼리 \n                            싸움을 붙히는 프로보가 성공했는데</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">옆에서 피스를 \n                            걸어준다든지 하는 행위등이 있을 것입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><span style=\"font-size:9pt;\">피스는 말그대로 \n                            전투상태를 평화상태로 만드는 것이기 때문에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">위급한 상황에서 \n                            성공률이 높아야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">그러므로 스킬이 \n                            어느정도는 만족스럽게 높여야 한다고 볼수 있고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">이런 피스스킬은 \n                            스킬의 높음보다는 적절한 시기에 쓸 수 있는 판단력이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">더 중요합니다.</span></font></p>\n</ul>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"#top\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></span></font></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
