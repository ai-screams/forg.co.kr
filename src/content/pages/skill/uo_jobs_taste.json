  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\">Catalog*******</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_jobs_alchemy/\" title=\"연금술[포션제작]\">Alchemy+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_poisoning/\" title=\"포이즈닝[독바르기]\">Poisoning</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_taste/\" title=\"맛감정\">Taste ID</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_jobs_blacksmith/\" title=\"스미스[대장장이]\">Black Smith+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_mining/\" title=\"광부[광물캐기]\">Mining</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_armslore/\" title=\"암즈로어[장비지식]\">Arms Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_item/\" title=\"아이템ID[아이템감정]\">Item ID</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_jobs_car/\" title=\"카펜터리[목공술]\">Carpentry</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_lumber/\" title=\"럼버잭[나무하기]\">Lumberjacking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_thinker/\" title=\"팅거링[기계공기술]\">Tinkering</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_bow/\" title=\"보우크래프트[활제작술]\">Bowcraft</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_fishing/\" title=\"피싱[낚시]\">Fishing</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_ins/\" title=\"인스크립션[기록술]\">Inscription</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_tailor/\" title=\"재단사[재봉술]\">Tailor</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_cooking/\" title=\"쿠킹[요리]\">Cooking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_begging/\" title=\"베깅[구걸]\">Begging</a><br><br>\n</div><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/jobs_logo.gif\" data-recovery=\"missing\" height=\"17\" src=\"/img/placeholder/missing.svg\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td height=\"30\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"30\" src=\"/img/posts/site/skill/images/left_menu/alpha/t.gif\" width=\"30\">ASTE \n                            ID.</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"22\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#A0965A\" bordercolordark=\"#999933\" bordercolorlight=\"#A0965A\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"500\">\n<tbody><tr>\n<td colspan=\"2\" height=\"30\" width=\"494\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">■ &nbsp;맛감정 \n                                        <img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/cookies.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"18\"></span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"80\" src=\"/img/posts/site/skill/images/uojobs/poison/t_4.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"330\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Taste \n                            Idenfication(맛감정)스킬을 구동하여</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">케그통에 \n                            무엇이 들어 있는지 감별합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"80\" src=\"/img/posts/site/skill/images/uojobs/poison/t_3.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"330\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Taste \n                            Idenfication(맛감정)스킬을 구동하여</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">포션이 \n                            어떤 형태인지를 감별합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"80\" src=\"/img/posts/site/skill/images/uojobs/poison/t_2.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"330\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">독이 \n                            묻어 잇는(포이즈닝 스킬로 빵에 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">독을 \n                            바를 수 있습니다) 빵을 맛감정을</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이용하여 \n                            독의 여부를 알 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"80\" src=\"/img/posts/site/skill/images/uojobs/poison/t_1.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"330\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">독이 \n                            묻어 있는 음식을 맛감정을 이용하여</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">식별할려고 \n                            할 때 실패햇을 경우</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자신이 \n                            독에 중독이 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">맛감정은 \n                            스킬이 낮아도 여러번의 실패를 감수만 한다면</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">케그통에 \n                            무엇이 들어있는지 알 수가 있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">예를들면 \n                            같은 종류의 포션을 담아야 하는 케그통은</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">다른이가 \n                            담아놓은 케그통을 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">어느정도 \n                            쓴 것을 자신이 직접 채울려고 할 때 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아주 \n                            유용한 스킬이 될 수 있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><a href=\"#top\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
