  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"741\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"111\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_2.gif\" width=\"110\"></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/newbie_history/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/n_history.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_i/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_i.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_make/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_m.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_l/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_l.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_faq/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_faq.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_f/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_f.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_m/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/n_ma.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_meet/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_meet.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_j/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/n_j.gif\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/newbie_s/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/n_app.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></font></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/n_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;&nbsp;울티마의역사</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"584\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ </b></font><b><font color=\"#333333\" face=\"돋움\" size=\"2\">오리진과 울티마 온라인의 역사</font></b></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ 1977년</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">리차드 게리엇(Richard Garriott)과 </font><font face=\"돋움\" size=\"2\">몇몇 친구들이 클리어 크릭(Clear Creak) 고등학교에서 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;자신들만의 컴퓨터 프로그래밍 \n코스를 시작하다. 그들이 스스로 정한 프로젝트는 팬터지 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;컴퓨터 게임을 쓰는 것이었다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ 1979년 여름</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;</b></font><font color=\"black\" face=\"돋움\" size=\"2\">리차드는 고</font><font face=\"돋움\" size=\"2\">향의 '컴퓨터랜드'라는 상점에서 일자리를 찾았다. 그곳에서는 Apple II 홈컴퓨터를 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;팔고 있었다. 그는 상점에서 남는 시간에 \n프로그램을 쓰면서 애플 컴퓨터에 대해 공부하기로 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;결심했다. 여름이 끝날 무렵, 그는 애플 소프트 베이직으로 쓰고, 카세트 테이프로 컴퓨터로 \n</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;불러들여 읽는 Akalabeth라고 명명한 게임을 만들어냈다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;매니저는 이 게임의 카피를 좀 만들어서 상점에서 팔 것을 제안했다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"black\" width=\"290\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_Aka.gif\" data-recovery=\"missing\" style=\"width:169px;height:200px\">이것이 상점표 테이프에 넣어 팔던 어캐러버쓰</span></font></p>\n</td>\n<td bgcolor=\"black\" width=\"290\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_Aka3.gif\" data-recovery=\"missing\" height=\"200\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:154/200\" width=\"154\"></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" height=\"25\" width=\"290\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&lt;이것이 바로 상점표 어캐러버쓰! \n&gt;</font></p></td>\n<td bgcolor=\"#FFFFCC\" height=\"25\" width=\"290\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&lt;나중 CPC판은 이렇게 멋지게 \n변했다&gt;</font></p></td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">리처드에게는 알리지 않고, 상점매니저는 그 게임 한부를 컴퓨터 게임 판매사인 캘리포니아 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;퍼시픽 컴퓨터(California Pacific \nComputer) 컴퍼니에게 보냈다. 리차드는 그 회사와 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;게임 배급계약에 서명했고, CPC는 5.25인치 디스켓에 게임을 저장해 판매했으며 3만 \n카피 이상이 &nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;팔리게 되었다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;줄거리 \n                            : 암흑의 군주 몬데인이 창조되었으며 땅전체에 어둠의 추종자들을 만들어내었다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;주인공인 &nbsp;당신은 로드 브리티쉬의 \n부름에 대답하여 이 땅에서 사악한 생명체들이 사는 어두운 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;장소를 제거해 \n                            야만 하는 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;그 해 가을... &nbsp;리차드는 텍사</font><font face=\"돋움\" size=\"2\">스 대학에 입학하였다. </font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;리차드는 친구인 켄 아놀드(Ken Arnold)와 울티마에 대해 작업을 시작하였다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ 1980년 겨울</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">리처드는 텍사스 대학의 Creative Anachronism(창조적 시대착오주의)클럽에 합류해서 이후 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;게임에 함께할 친구들을</font><font face=\"돋움\" size=\"2\"> 만나게 \n된다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>여름</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>CPC에서</b></font><font face=\"돋움\" size=\"2\"> </font><font color=\"#6666FF\" face=\"돋움\" size=\"2\"><b>울티마 Ⅰ</b></font><font face=\"돋움\" size=\"2\">이 출시된다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<font color=\"maroon\" face=\"돋움\" size=\"2\"><b>울티마 1 \n                             (첫번째 어둠의 시대 : The \nFirst Dark Age)의 줄거리이다.:</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#6666FF\" face=\"돋움\" size=\"2\">브리티쉬가 샤미노를 \n만났을 때 즈음 소서리아에는 몬데인이라는 마법사가 살았다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;그는 암흑의 힘에 깊이 매료되어 있었고 이로 인해 높은 명성을 가진 아버지와 분쟁을 \n피할 수 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;없었다. 그 분쟁은 결국 몬데인으로 하여금 아버지를 살해하게 만들었으며, </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;몬데인은 이를 기점으로 완전한 악의 세계로 빠지게 되었다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;몬데인은 아버지를 살해하고 얻게 된 보석으로 악의 상징인 검은 보석을 만들었고 &nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;이는 소서리아에 심각한 위협으로 다가왔다. 로드 브리티쉬는 \n몬데인을 없애고자 다른 세계에서 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;이방인을 소환하였다. 문게이트를 통해서 온 이방인은 진실과 정의에 대한 끝없는 노력으로 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;위대한 영웅으로 \n성장하여, 결국 악의 보석을 파괴하고 몬데인을 죽여 소서리아에 평화를 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;가져다 주었다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"585\">\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"500\">\n<tbody><tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_U1.gif\" data-recovery=\"missing\" style=\"width:165px;height:213px\">이것이 울티마 시리즈 원본</span></font></p>\n</td>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_U1Sierra.gif\" data-recovery=\"missing\" style=\"width:142px;height:188px\">이것이 천지도를 넣어준 시에라사의 울티마!</span></font></p>\n</td>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_U1Remake.gif\" data-recovery=\"missing\" style=\"width:151px;height:213px\">이것이 오리진사에서 나온 울티마1</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&lt;최초의 울티마 애플버전&gt; </font> </p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이것은 리얼레어이다! </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">무지무지 비싸다고 한다.</font></p>\n</td>\n<td bgcolor=\"#FFFFCC\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&lt;시에라사의 울티마&gt;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Atari-8비트 용이다. \n</font></p>\n</td>\n<td bgcolor=\"#FFFFCC\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&lt;오리진사에서 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다시 나온 울티마 1&gt;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동전에다 하드보드, 지도에다 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">책까지 주었다고 한다.</font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ 1981년</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">타임 밴디츠(Time Bandits)라는 영화가 나왔다. 리차드와 친구들은 극장에 가서 그 영화를 반복해서 &nbsp;본다음에 그 영화에 나온 지도들을 \n베끼려고 하였으며 그 아이디어를 울티마 II의 디자인에 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;사용하였다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;California Pacific사가 망했다. 리차드는 새로 시작한 시에라 온라인(Sierra Online)과 게임 배급 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;계약을 맺었다. 그 \n회사를 선택한 이유는 그 회사가 게임카피마다 천지도를 같이 넣어주기로 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;동의한 유일한 회사였기 때문이다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;최초의 IBM PC컴퓨터가 판매된다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ 1982년 여름</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#6666FF\" face=\"돋움\" size=\"2\"><b>울티마 Ⅱ</b></font><font face=\"돋움\" size=\"2\">가 애플 2 용으로 나왔다.</font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b>&nbsp;울티마 2&nbsp; (첫번째 \n                            어둠의 시대 : The \nRevenge of &nbsp;the Encantress)의 줄거리이다.:</b></font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;<b>몬데인이 사라진 후</b>, 소서리아에는 평화가 깃든 \n듯 했다. 하지만 몬데인의 연인이자 제자인 </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;미낵스는 검은 보석의 파괴와 몬데인의 죽음에 분노하였으며, 복수를 위해 증오심을 키우기 </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;시작했다. \n그녀는 어렴풋한 기억속의 검은 보석을 스스로의 힘으로 재창조하고자 했다. </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;비록 검은 보석을 만드는 데에는 실패했으나, 미낵스는 자신의 놀라운 \n힘으로 보석 없이도 세상을 &nbsp;</font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;악의 힘으로 뒤덮을 수 있게 되었다. 미낵스의 위협은 몬데인에 비할 바가 아니었다. 소서리아는 </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;일찍이 겪은 적이 없는 \n대혼란에 휩싸였다. 모든 이가 불안과 공포에 떨며 하루하루를 보냈다. </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;결국 로드 브리티쉬는 이번에도 자신의 세계에 도움을 요청하게 되었다. \n브리티쉬의 소환에 응한 </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;영웅은 시간과 공간을 초월한 모험 끝에 미낵스를 찾아 그녀를 그녀의 창조물들과 함께 영원히 </font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;파괴시켜 버렸다. 미낵스의 \n죽음으로 인해 소서리아는 멸망의 위기에서 벗어날 수 있었다.</font></p>\n<p style=\"font-family:굴림,serif; line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">시에라사는 울티마 II의</font><font face=\"돋움\" size=\"2\"> PC포트 판에 대한 로얄티에 대해 리차드에게 불만족스러운 조건을 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;제시하였고 리차드는 새로운 배급업자를 찾을 생각을 \n하게 된다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"520\">\n<tbody><tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_U2.gif\" data-recovery=\"missing\" style=\"width:185px;height:250px\">울티마2</span></font></p>\n</td>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_U2Origin.gif\" data-recovery=\"missing\" style=\"width:100px;height:144px\">오리진 버젼</span></font></p>\n</td>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><span class=\"forg-missing\" data-original-src=\"http://forg.co.kr:80/skill/images/uohistory/Title_U3.gif\" data-recovery=\"missing\" style=\"width:178px;height:250px\">엑소더스</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&lt;울티마 2: 마녀의 복수&gt;</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">( Revenge of the Enchantress)</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">공상과학만화같지 않은가?</font></p>\n</td>\n<td bgcolor=\"#FFFFCC\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&lt;오리진 버전&gt; </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">멋지게 바뀌었다</font></p>\n</td>\n<td bgcolor=\"#FFFFCC\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&lt;울티마 3: 엑소더스&gt;</font></p></td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;가을</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">리차드는 </font><font face=\"돋움\" size=\"2\">텍사스 대학의 풀타임 학업을 중단하고 울티마 3에 전념하기로 한다. 여전히 그는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;휴스턴의 부모님 집에서 작업을 했다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;척 뷔쉬가 시에라사에서 울티마 2의 Atari 800 port작업을 했고 리차드를 만났다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>■ 1983년 봄</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">오리진 시스템즈(Origin Systems)가 리차드 게리엇, 로버트 게리엇, 오웬 게리엇(둘의 아버지), </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;척 뷔쉬(Chuck Bueche)에 \n의해 설립되었다. 개발은 휴스턴에서 이루어 졌고 재정적인 문제는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;매사츄세츠, 앤도버에 있는</font><font face=\"돋움\" size=\"2\"> 로버트의 사무실에서 다루어졌다. 오리진사의 공식 \n주소는 PO Box 99, &nbsp;Andover MA 01845.이 되었다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;오리진사가 최초로 외부 직원을 고용했는데 그는 제프 힐하우스였다. (Jeff Hillhouse).</font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;이 제프가 이후 게임에서 제프리 경(Sir \nGeoffrey)의 모델이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<b>가을</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"black\" face=\"돋움\" size=\"2\">로버트가 아내가 직업을 가진 뉴햄프셔주 런던베리로 이사를 함으로서 오리진사의 공식 주소가 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;340 &nbsp;Harvey Road, Mancester NH \n03103가 되었다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>오리진은</b></font><font face=\"돋움\" size=\"2\"> 애플2용의 </font><font color=\"#6666FF\" face=\"돋움\" size=\"2\"><b>울티마 Ⅲ</b></font><font face=\"돋움\" size=\"2\">을 발표하였다. </font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b>&nbsp;울티마 3&nbsp; (엑소더스&nbsp;: Exdous)의 줄거리이다.:</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#6666FF\" face=\"돋움\" size=\"2\"><b>위험이 사라진 소서리아는</b> 평화로운 시간 속에서 20여년이라는 세월을 보냈다. 당시 도시 국가의 \n</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;형태를 취하고 있던 소서리아는 점차 로드 브리티쉬를 정점으로 통일의 움직임을 보였다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;이는 현명한 도시 국가의 지도자들의 자발적인 복속으로 인해 \n심각한 전쟁의 위험없이 이루어 졌다. &nbsp;로드 브리티쉬의 독재에 반대하는 세력은 앰브러시아라는 대륙으로 떠나갔다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;겉보기엔 평화로와 보였지만 사실 \n소서리아는 심각한 위험 요소를 가지고 있었다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;몬데인과 미낵스의 삶을 종식시킨 이방인의 영웅적인 행위는 결과적으로 인간도 기계도 아닌 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;몬데인과 \n미낵스의 아이인 엑소더스를 고아로 만들었다. 분노와 복수에 가득찬 엑소더스는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;대양의 바닥으로부터 솟아 올라와 소서리아 전체에 복수와 파괴를 \n시작했다. 로드 브리티쉬는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;다시 영웅을 불렀고, 이번에 4명의 이방인이 나타나 거대한 공포와 악 아래서 신비한 타임로드의 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;도움으로 엑소더스가 \n있는 비밀 요새의 섬을 찾아내어 엑소더스를 몬데인과 미낵스와 같은 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;운명으로 만들었다. 소서리아를 위협하던 거대한 3개의 악은 파멸되었고, 큰 \n축제가 열렸다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;이 날을 기념해 사람들은 새로운 세계를 브리타니아(Britannia)라 부르기 시작했고, </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;또 다른 대륙 앰브러시아는 전설 속에 \n잊혀져 갔다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFCC00\" colspan=\"2\" height=\"28\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>&nbsp;■ 1984년</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>오리진</b></font><font face=\"돋움\" size=\"2\">은 Electronic Arts(EA)와 배급계약을 맺는다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"584\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#6666FF\" face=\"돋움\" size=\"2\"><b>울티마 스토리 출처</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;울티마 1-5&nbsp;: 영진출판사의 \"불후의 명작게임 모음집\"</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;울티마 6-8 :  이우영씨의 글</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#6666FF\" face=\"돋움\" size=\"2\">&nbsp;울티마 \n9 : 일간스포츠 기사</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font face=\"돋움\" size=\"2\">&nbsp;</font></b></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">[</font><a href=\"/site/skill/newbie_history/\"><b><font color=\"red\" face=\"돋움\" size=\"2\">1</font></b></a><font face=\"돋움\" size=\"2\">][</font><a href=\"/site/skill/newbie_history_1/\"><font color=\"black\" face=\"돋움\" size=\"2\"><b>2</b></font></a><font face=\"돋움\" size=\"2\">][</font><font color=\"black\" face=\"돋움\" size=\"2\"><b>3</b></font><font face=\"돋움\" size=\"2\">]</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By </b></font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>녕이</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</p></td>\n</tr>\n</tbody></table></div>\n",
