e/skill/images/left_menu/k_mirc.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;<a href=\"/site/skill/uo_knowhow_fame/\"><font color=\"black\" face=\"돋움\" size=\"2\">FAME &amp; KARMA</font></a>/<a href=\"/site/skill/uo_knowhow_fame_1/\"><font color=\"black\" face=\"돋움\" size=\"2\">명성얻기</font></a>/<a href=\"/site/skill/uo_knowhow_fame_2/\"><font color=\"black\" face=\"돋움\" size=\"2\">카르마잠그기</font></a></b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp; \n            \n            </p><table border=\"\" bordercolor=\"silver\" bordercolordark=\"silver\" cellspacing=\"0\" height=\"28\" width=\"550\">\n<tbody><tr>\n<td class=\"top\" height=\"28\" width=\"550\"><center>\n<center>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">악한 \n                                    카르마를 얻게 하기 위하여 카르마를 이제 \n                                    잠글 수 있습니다..</font></p></center>\n</center>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">예전에는 \n                            드레드를 달기위해선 어쩔 수 없이 글로리아스레디 \n                            또는 로드가된후 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">몬스터를 \n                            피해 다니며 악한 행동으로 카르마를 떨어뜨리는방법뿐이 \n                            없었습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">하지만 \n                            이제는 그럴 필요 없이 카르마를 잠그면됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\"><b>1</b>.카오스사원에 \n                            가셔셔 \"<b>BAL</b>\"이라고 외치면 간단히 \n                            카르마는 더 이상 오르지</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">않게 \n                            됩니다 물론 강한 몬스터를 죽이면 명성은 올라 갑니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\"><b>2</b>.카르마가 \n                            처음수준의 플레이어가 카르마를 \n                            잃게되는행위를 하게되면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">그플레이어는 \n                            자동으로 카르마가 잠김상태가 됩니다.</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">일단 \n                잠긴 카르마를 다시 <b>푸는 방법</b>은 아래 도표에 있는 사원에가셔셔</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움,Arial\" size=\"2\">고대주문을 \n                외치면 됩니다.</font></p>\n<table align=\"center\" border=\"1\" bordercolorlight=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"299\">\n<tbody><tr>\n<td bgcolor=\"silver\" height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>사원</b></font></p>\n</td>\n<td bgcolor=\"silver\" height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>장소</b></font></p>\n</td>\n<td bgcolor=\"silver\" height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>주문</b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Compassion</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/com.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">desert \nwest of Covetous</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">mu</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Honesty</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/ho.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">Ice \nIsle</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">ahm</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Honor</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/honor.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">south \nof Trinsic</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">summ</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Humility</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/hu.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">Fire \nIsle</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">lum</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Justice</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/ju.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">east \nof Yew moongate</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">beh</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Sacrifice</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/sac.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">north \nof Vesper</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">cah</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Spirituality</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/sp.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">northwest \nof Trinsic</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">om</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Valor</font></p></td>\n<td height=\"25\" width=\"169\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20010709180136/http://forg.co.kr/skill/images/uotip/fame/va.htm\" target=\"_blank\"><font face=\"돋움\" size=\"2\">southwest \nof Serpent's Hold</font></a></p></td>\n<td height=\"25\" width=\"48\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">ra</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">좌측에&nbsp;Your \n                repentance seems honest and you may walk the virtuous path again.라는</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">메시지가뜨면 \n                카르마가 풀린것입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Wrritten \n                    By </b></font><font color=\"#666666\" face=\"돋움\" size=\"2\">Forg</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n",
