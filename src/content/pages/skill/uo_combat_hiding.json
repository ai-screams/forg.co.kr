  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ana/\"><img alt=\"아나토미\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_a.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mace/\"><img alt=\"메이스\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mace.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_sw/\"><img alt=\"스워드\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sw.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_fe/\"><img alt=\"펜싱\" border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/left_menu/c_fe.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ar/\"><img alt=\"궁수\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ar.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_wr/\"><img alt=\"레스링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_wr.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ta/\"><img alt=\"택틱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_t.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pa/\"><img alt=\"패링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_p.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_he/\"><img alt=\"힐링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_m/\"><img alt=\"메저리\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mad/\"><img alt=\"메디테이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ma.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ev/\"><img alt=\"이벨\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_e.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_re/\"><img alt=\"레지\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mu/\"><img alt=\"뮤지션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mu.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pro/\"><img alt=\"프로보케이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pro.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_peace/\"><img alt=\"피스메이킹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ent/\"><img alt=\"유혹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_en.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_steal/\"><img alt=\"스틸링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_snooping/\"><img alt=\"스누핑\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sn.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_hiding/\"><img alt=\"하이딩\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_hi.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_stealth/\"><img alt=\"스텔스\" border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/left_menu/c_st.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"3\" src=\"/img/posts/site/skill/images/left_menu/c_line.gif\" width=\"110\"></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><b>&nbsp;하이딩</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp; </font>\n</p><table border=\"\" cellspacing=\"0\" height=\"85\" width=\"600\">\n<tbody><tr>\n<td bgcolor=\"white\" class=\"top\" height=\"71\" width=\"654\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"142\" src=\"/img/posts/site/skill/images/uocombat/hiding.gif\" width=\"198\"></font></p></td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" width=\"595\"><ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><b>하이딩</b></font><font color=\"#262626\" face=\"돋움\" size=\"2\">은 화면상에서 \n                            다른플레이어나 몬스터의 시야에서 사라지는 것을 말합니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마법하이딩의 주문동작딜레이와는 \n                            달리 스킬발동시 성공하자마자 사라지게 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이때 행동하지 않고 말등을 \n                            하지 않는다면 영원히 그 자리에서 보이지</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">않게 된다는 메리트가 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 굶어 주글수는 없으니 \n                            먹을 것을 먹는등의 행위는 숨어있는 것에</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">영향을 미치지 않습니다-\"-.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>하지만</b></font><font face=\"돋움\" size=\"2\"> 딜레이가 10-11초이기 때문에 한번 실패할 \n                            경우 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그시간만큼 기다려야 한다는 \n                            가장큰 단점이 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이러한 단점은 높은 스킬로서 \n                            커버를 해야 한다는 부담감이 생기겠져.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이유는 다들 아시다시피 하이딩하는 \n                            상항은 긴박한 상황입니다-_-;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그런 긴박감속에 실패를 한다면 \n                            거의 힐러집을 찾든지 헬프메뉴를</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">써야 한다든지 하는 경우의 \n                            확률을 높게 만들어 줍니다--;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">믿엇던 하딩이 실패할 때 더 \n                            당황스러울테니까여..</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 성공한다면 그만큼 쾌감은 \n                            이루말할수 없을것입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><b>하이딩</b></font><font color=\"#262626\" face=\"돋움\" size=\"2\">은 여러 가지 \n                            상황에서 널리 쓰이게 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">도둑직업을 \n                            가진다든지.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">던전이나 숲에서 \n                            가끔 주무시는 분이라든지-_-;;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">광부가 땅파다가 \n                            긴박한 순간에 광물을 들고 서있는다든지</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">던전사냥을 \n                            거의 혼자 주로하시는분이라든지.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">물론 단체사냥이나 \n                            단체워 중에 하딩하는분이 있지여-\"-</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">그리고 모닥불 \n                            피어놓고 캠핑하시는분도.....</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><b>또한</b></font><font color=\"#262626\" face=\"돋움\" size=\"2\"> 하이딩은 \n                            도둑스킬과 연관 되어지므로 몰래 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">남의가방을 \n                            뒤질 때 유용하게 쓰이기도합니다 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">방어구(AR)나 \n                            사람들이나 몬스터가 많은 곳은 더욱 성공시키기 힘듭니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마지막으로 스킬이 높을수록 \n                            공격을 하는 대상에서</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가까운거리에도 하이딩이 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그럼 이번에는 상대방이 하이딩에 \n                            돌입햇을 때 어떻게 하이딩한상태를 해제시키는지를</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">알아봅시다-_-</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*마법으로는 독필드, 파이어필드를 \n                            하이딩한 곳에다 깔아줍니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*리빌마법으로 예상장소를 찍어줍니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*디텍히든이라는 스킬로서 예상장소를 \n                            찍어준다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*펠루카 본대륙에서는 사람끼리 \n                            지나갈 수 없으니 예상장소를 뛰어다닙니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;민첩이 줄어들고 좌측에 \n                            메시지가 뜨면 바로 그장소에 하이딩을 하는것이겟지여</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*하딩한 장소에서 죽치고 기다립니다-_-;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">위상황 때문에 \n                            하이딩한채로 이동하는 스텔스를 키우시는분들도 있습니다.</font></p>\n</ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><b>Written By \n                        Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p><font color=\"#262626\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n",
