  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\">Catalog*******</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_vet_mu/\" title=\"뮤지션[음악연주]\">Musicianship+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_pro/\" title=\"프로보케이션[전투도발]\">Provocation</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_peace/\" title=\"피스메이킹[평화연주]\">Peacemaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_ent/\" title=\"유혹\">Enticement</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_anit/\" title=\"애니멀테이밍[길들이기]\">Animal Taming+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_anil/\" title=\"애니멀로어[동물지식]\">Animal Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_vet/\" title=\"베너터리[수의학]\">Veterinary</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_herding/\" title=\"허딩[목동술]\">Herding</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_carto/\" title=\"카토그라피[지도제작술]\">Cartography+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_lock/\" title=\"락픽킹[자물쇠열기]\">Lockpicking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_remove/\" title=\"리무브트랩[함정해제]\">Remove Trap</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_detect/\" title=\"디텍트히든[은폐탐지]\">Detect Hidden</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_ss/\" title=\"스피리트스피킹[심령술]\">Sprit Speaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_camping/\" title=\"캠핑[야영]\">Camping</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_tracking/\" title=\"트랙킹[추적하기]\">Tracking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_forensic/\" title=\"포렌식[해부학]\">Forensic EV.</a><br><br>\n</div><img border=\"0\" height=\"17\" src=\"/img/posts/site/skill/images/left_menu/vet_logo.gif\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"363\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td>\n<p>&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"30\" src=\"/img/posts/site/skill/images/left_menu/alpha/c.gif\" width=\"30\">ARTOGRAPHY \n                            - 1&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/1.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:19/20\" width=\"19\"></b></span></font><a href=\"/site/skill/uo_vet_carto/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/alpha/car_1.gif\" width=\"50\"></font></b></span></a><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\">\n</font></b></span><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/alpha/2.gif\" width=\"19\"></b></span></font><a href=\"/site/skill/uo_vet_carto_1/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/car_2.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:50/20\" width=\"50\"></font></b></span></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>\n<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:19/20\" width=\"19\"></b></span></font><a href=\"/site/skill/tmap/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/car_3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:50/20\" width=\"50\"></font></b></span></a><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\">\n<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/4.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:19/20\" width=\"19\"></font><a href=\"/site/skill/imap/\"><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/car_4.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:50/20\" width=\"50\"></font></a></b></span></p>\n</td>\n</tr>\n<tr>\n<td>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;&nbsp;<font color=\"#333333\">&nbsp;</font>&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"500\">\n<tbody><tr>\n<td colspan=\"2\" height=\"30\" width=\"492\">\n<p><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>&nbsp;■ \n                                        기초지식 <img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/maptrain.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:300/100\" width=\"300\"></span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"492\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;지도 \n                            그리는 과정</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">항구근처에 \n                            있는 상점에서 빈지도나 일반 지도를 판매 합니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">일단 \n                            그곳에 가셔셔 지도를 대량으로 구입합니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            UOA를 쓰시는분은 빈스크롤,빈지도만을 구입하셔야 하지만</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">손으로 \n                            그리시는분은 또한 자금의 여유가 있으신분은</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그려진지도를 \n                            구입하셔도 무방합니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">상점에서 \n                            파는 그려진 지도는 다시 그릴 수 있기 때문입니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">빈스크롤은 각 마을&nbsp;시약상점이나 도서관에서 \n                            구입하실 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"99\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/tamap.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"389\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;[지도제작자의펜]을 항구상점에서 구입하셔서 </span></font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;이도구를 이용 빈지도나 스크롤에다가 그리셔야 합니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;펜을 더블클릭한다면 그릴 지도를 \n                            선택 할 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;지도를 \n                            선택후 그리고 싶은 지도를 체크해주시고 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;확인해주시면 \n                            지도가 그려집니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ 현재 \n                            스킬 99.5부터 지도를 그리는 방법으로는 스킬이 올라가지를 \n                            않습니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;4렙지도를 모아두시고 스킬타임시간에 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;연이어 \n                            해독하시는방법으로 올리시길 바랍니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            보물을 찿을 때 관련된 스킬은 락픽(상자따기)기술입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;보물을 \n                            해독하고나서 찿을 때에는 자신의 락픽 스킬에 맞추어서</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;보물을 \n                            찾으시길 바랍니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            각 스킬도표를 참조 하실려면 본란 맨상단의 </span></font><a href=\"/site/skill/uo_jobs_carto_1/\"><b><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">스킬도표</span></font></font></b></a><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">를 \n                            클릭 해주십시요.</span></font></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"500\">\n<tbody><tr>\n<td colspan=\"2\" height=\"30\" width=\"492\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;1단계[보물지도수집]</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"43\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/gain.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"445\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">좌측에 \n                            그림처럼 던전에서 사냥을 하다보면 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">랜덤하게 \n                            보물지도가 나옵니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            낚시로도 1렙지도를 얻을 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"492\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;2단계[보물지도위치파악]</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"43\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/tmap.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"445\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보물지도를 \n                            한번 클릭하게되면 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Trammel(르네)지역과 \n                            본대륙지역으로 \n                            구분이 됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            지도가 몇정도의 렙으로 구성이</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">되어있는지 \n                            또한 알 수 있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">다른사람이 \n                            읽은지도도 해석이 된다면 찿을 수 있습니다</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            파티를 해야 헌터이외에 사람들도 상자룻을 할 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"492\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;3단계[해독후 \n                            위치 찿기]</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/l_map.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:240/240\" width=\"240\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/r_map.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:240/240\" width=\"240\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            위의 \n                            사진처럼 보물지도를 해독하게되면</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;상세한 \n                            지도가 나오게 됩니다.우측 맵지도와 연관성을 생각하시길.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;즉,카토의 \n                            핵심스킬은 지도와 월드맵과의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;연관성을 \n                            파악하는데 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;자세히 \n                            보시면 월드맵의 쉐임던전 부근이라는 것을 알 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;p.s \n                            : 월드맵은 Kal Ort Por란에 울온 자료실에서 받으시길.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;대충 \n                            어느정도 위치를 파악하셧다면 99%는 찿으신 것입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;이제 \n                            상세지도를 보신후 보물을 파러 가시면됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            자세한 상세지도를 보실려면 본란의 맨상단 </span></font><a href=\"/site/skill/images/tmap/\"><font face=\"Verdana\"><b><font color=\"black\"><span style=\"font-size:9pt;\">보물지도</span></font></b></font></a><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">를 \n                            클릭해주십시요.</span></font></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            보물을 찿을 때 도와주는 UOAM프로그램도 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;&nbsp;&nbsp;UO.TIP란에 \n                            있는 </span></font><a href=\"/site/skill/uo_knowhow_place/\"><b><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">UOAM</span></font></font></b></a><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">을 \n                            참조하시길.</span></font></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"492\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;4단계[보물상자를 \n                            파기]</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"43\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/se.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"445\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">순서 : </span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">일단 삽을 더블클릭-지도를클릭-땅을 \n                            클릭</span></b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">장소가 \n                            정확하다면 땅을 파는 소리가 나게됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마이닝 \n                            스킬이 높을수록 찾는 지역이 넓게 되어서 편하지만</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">정확한 \n                            포인트를 찿을 수 있으시다면 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마이닝스킬은 \n                            전무하셔도 무방합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"43\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/rel.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"445\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">땅을 \n                            파면서 상자가 \n                            올라올 때 하이딩마법이나</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3써클 랄포마법을 외워둡니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">몹이 \n                            올라올 때 최대한 멀리있는지점으로</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">순간이동을 \n                            합니다. </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">대량의 \n                            몹이 올라오면 약간의 랙이 발생합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"43\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/chest.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"445\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">하이딩을 \n                            외우신분은 제자리에서 하이딩마법구동,</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">랄포를 \n                            외우신분은 랄포후 \n                            마법하이딩이나 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아이템하이딩 혹은 몬스터가 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">없는방향으로 \n                            빠르게 이동하시면됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"43\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/carto/chest_1.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/100\" width=\"100\"></span></font></p>\n</td>\n<td width=\"445\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">저렙의 \n                            상자는 약한 몬스터가 나오므로 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자신의 \n                            전투수준에 맞게 몬스터를 처리하신후</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">상자의 \n                            아이템을 획득하시면됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">처치하기 \n                            힘든 몬스터는 상자에서 멀리떨어진곳으로 유인후</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">룻을 \n                            할 때 나오는 몬스터와 프로보를 시키시는게 좋습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"492\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            각 스킬도표를 참조 하실려면 본란 맨상단의 </span></font><a href=\"/site/skill/uo_jobs_carto_1/\"><b><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">스킬도표</span></font></font></b></a><font face=\"Verdana\"><font color=\"black\"><span style=\"font-size:9pt;\">를 \n                            클릭 해주십시요.</span></font></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            손쉽게 몬스터를 잡으시려면 바드스킬을 고려하시는게 \n                            좋습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;■ \n                            고렙의 상자일수록 좋은 아이템이 나옵니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"#top\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
