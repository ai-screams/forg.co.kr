  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow/\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_1.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_1/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/l_logo_rare_3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_2/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_2.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_3/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_5.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_4/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_4.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_knowhow_rare_5/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_6.gif\" width=\"110\"></a></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/rare/l_logo_rare_b.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;Monster Rare</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/rare_6.gif\" data-recovery=\"missing\" height=\"30\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:150/30\" width=\"150\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"\" bordercolordark=\"#999999\" bordercolorlight=\"#999999\" width=\"504\">\n<tbody><tr>\n<td colspan=\"4\" height=\"26\" width=\"494\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"돋움\" size=\"2\"><b>몬스터 레어</b></font><font color=\"#999999\" face=\"돋움\" size=\"2\">[각종 몬스터에 의해 얻어지는 \n                            아이템들]</font></p></td>\n</tr>\n<tr>\n<td width=\"160\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그림</font></p></td>\n<td width=\"94\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이름</font></p></td>\n<td width=\"199\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">설명</font></p></td>\n<td width=\"23\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사진</font></p></td>\n</tr>\n<tr>\n<td width=\"160\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"26\" src=\"/img/posts/site/skill/images/rare/rope.gif\" width=\"24\"></font></p>\n</td>\n<td width=\"94\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Rope</font></p></td>\n<td width=\"199\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;쉐임4층 윈드-동물원과</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">바다에 잇는 크라켄을 잡는다</font></p>\n</td>\n<td width=\"23\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101022640/http://forg.co.kr/skill/images/rare/rope.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"160\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/sta.gif\" data-recovery=\"missing\" height=\"45\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:160/45\" width=\"160\"></font></p></td>\n<td width=\"94\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Statues</font></p></td>\n<td width=\"199\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일쉐나의 숭고함의 지역에서</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">요정을 잡으시거나</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아이스던전에 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">빨간쥐돌이도 줍니다.</font></p>\n</td>\n<td width=\"23\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101022640/http://forg.co.kr/skill/images/rare/sta.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"160\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"50\" src=\"/img/posts/site/skill/images/rare/demon_ar.gif\" width=\"130\"></font></p></td>\n<td width=\"94\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Demon_Armor</font></p></td>\n<td width=\"199\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">델루위의 지역에서</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"> 엘리프리트를 죽이면 획득</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">머리,팔뚝,몸통,다리,손</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">총5개로 머리가 구하기 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">제일 어려움</font></p>\n</td>\n<td width=\"23\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101022640/http://forg.co.kr/skill/images/rare/demon.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n<tr>\n<td width=\"160\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"50\" src=\"/img/posts/site/skill/images/rare/ice.gif\" width=\"130\"></font></p></td>\n<td width=\"94\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Ice Staff</font></p></td>\n<td width=\"199\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아이스던전이나,T2A지역에 있는</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아이스 큰뱀을</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">죽이면 획득</font></p>\n</td>\n<td width=\"23\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20011101022640/http://forg.co.kr/skill/images/rare/ice.htm\" target=\"_blank\"><font color=\"maroon\" face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"18\" src=\"/img/posts/site/skill/images/rare/dd.gif\" width=\"13\"></b></font></a></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"red\" face=\"돋움\" size=\"2\"><b>&nbsp;</b></font></p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"red\" face=\"돋움\" size=\"2\"><b> \np.s</b></font><font face=\"돋움\" size=\"2\"> : 위에 열거한 레어들은 개인적으로는 \n                    이벤트 성향이 강하다고 볼 수 있습니다....</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이벤트가 \n                    끝나는 날이 위에 열거된 레어들은 전설이 됩니다-_-;;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 \n                    기존 로프같은 경우는 이미 나왔던 것이므로 기존보다 가격이 \n                    더 하락 되었습니다..</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">인삼의 \n                    충격보다는 덜 하겠지만여.....-\"-</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n</ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_knowhow_rare_1/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/wyrmsheart.gif\" data-recovery=\"missing\" height=\"42\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/42\" width=\"30\"></a></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p>&nbsp;</p>\n",
