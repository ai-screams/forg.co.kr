  "html": "\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"750\">\n<tbody><tr>\n<td valign=\"top\" width=\"80\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/Image/skill_1.gif\" data-recovery=\"missing\" height=\"500\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:80/500\" usemap=\"#skill_1\" width=\"80\"></font></p></td>\n<td nowrap=\"\" valign=\"top\" width=\"670\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/Image/t_ana.gif\" data-recovery=\"missing\" height=\"28\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:142/28\" width=\"142\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>:::</b></font><font face=\"바탕체\" size=\"2\">상대방의 민첩과 체력을 알수 있게 하는 스킬입니다</font><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>:::</b></font>\n</p><table border=\"\" bordercolor=\"silver\" width=\"550\">\n<tbody><tr>\n<td colspan=\"3\" height=\"28\" width=\"540\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">(해부학 스킬에 따른 메시지 분석표)</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">Skill Response (DEX)</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">Skill Response (STR)</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">Stats</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"like they barely manage to stay standing.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"like they would have trouble lifting \n                        small objects.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">1-9</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Very clumsy.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Rather Feeble.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">10-19</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Somewhat uncoordinated.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Somewhat weak.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">20-29</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Moderately dextrous.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"To be of normal strength.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">30-39</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Somewhat agile.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Somewhat strong.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">40-49</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Very agile.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Very strong.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">50-59</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Extremely agile.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Extremely strong.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">60-69</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Extraordinarily agile.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Extraordinarily strong.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">70-79</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Moves like quicksilver.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Strong as an ox.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">80-89</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"One of the fastest people you have ever \n                        seen.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"One of the strongest people you have \n                        ever seen.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">90-99</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"247\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Superhumanly agile.\"</font></p></td>\n<td height=\"28\" width=\"225\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">\"Superhumanly strong.\"</font></p></td>\n<td height=\"28\" width=\"56\"><p align=\"center\"><font face=\"바탕체\" size=\"2\">100+</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;p.s : 스킬의 성공여부와 관계없이 스킬수치에 \n            따라 최대 20%까지</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">적에게 추가 데미지를 입힐 수 있습니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">-아나토미스킬 65이상부터 상대방의 스테미나를 \n            볼 수 있습니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">-힐링과 연관된 스킬로서 부활이나 독치료 \n            힐을 할수 있게 해줍니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">자세한 정보는 힐링스킬란에서 보시길.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0px; margin-bottom:0px;\"><font face=\"바탕체\" size=\"2\">&nbsp;&nbsp;이표는 </font><a href=\"http://uo.stratics.com/\" target=\"_blank\"><font color=\"teal\" face=\"바탕체\" size=\"2\"><b>UOSS</b></font></a><font face=\"바탕체\" size=\"2\">에서 나온표입니다.</font></p></td>\n</tr>\n<tr>\n<td width=\"74\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p></td>\n<td width=\"676\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p><map name=\"skill_1\">\n<area coords=\"0, 32, 80, 44\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/ar.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 46, 79, 58\" href=\"/site/skill/mac/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 60, 79, 73\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/sw.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 75, 79, 90\" href=\"/site/skill/fe/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 92, 78, 106\" href=\"/site/skill/wr/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 108, 77, 120\" href=\"/site/skill/an/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 122, 79, 135\" href=\"/site/skill/he/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 182, 79, 196\" href=\"/site/skill/ma/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 198, 79, 211\" href=\"/site/skill/mad/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 213, 79, 226\" href=\"/site/skill/re/\" shape=\"rect\" title=\"\">\n<area coords=\"0, 286, 79, 301\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/ta.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 303, 79, 315\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/bl.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 317, 79, 330\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/mi.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 332, 79, 346\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/ca.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 348, 79, 361\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/bo.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"1, 363, 79, 375\" href=\"https://web.archive.org/web/20010128121800/http://www.forg.co.kr/skill/al.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 377, 79, 390\" href=\"https://web.archiv