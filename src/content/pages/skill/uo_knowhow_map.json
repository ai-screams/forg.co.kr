  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_4.gif\" width=\"110\"></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hdecoration/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_house/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_hou.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_houseadd.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hoption/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_sign.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_command/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_com.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_vendor/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_vendor.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_moon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_moon.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_fame/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_f.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_runebook/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_rune.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_secret/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mw/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uosu/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_u.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mirc/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_mirc.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;UOAM_MAP</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"60%\">\n<tbody><tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/uoam_map.gif\" data-recovery=\"missing\" height=\"357\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:393/357\" usemap=\"#ImageMap1\" width=\"393\"></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Topmost \n                    </b>: 항상 화면상에 위치하게 한다. 엠아이알씨의 On &nbsp;top \n                    기능과 같은것이라 생</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">각하면 \n                    된다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_1.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/100\" width=\"250\"></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Tilt-map</b> \n                    : 정북이 1시 방향에서 12시 방향으로 &nbsp;변한다. &nbsp;왜 \n                    만들었는지는 모를거도 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">같지만 \n                    필자의 예상이 맞다면 트레저 헌터들을 위해 만들었지 &nbsp;않나 \n                    싶다. &nbsp;보물지도를 해</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">석하면 \n                    바로 이런식으로 나오기 때문이다. &nbsp;&nbsp;UOAM을 1/2로 \n                    축소하고 보물지도를 &nbsp;옆에 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가져다 \n                    대면 아주 똑같은 것을 볼수 있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_2.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:226/304\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Icons</b> : 아이콘을 표시해준다. &nbsp;던젼은 해골모양으로 \n                    마을은 집모양 기타 문게이트</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">등이 \n                    아이콘으로 나와준다. &nbsp;예쁘기는 하다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Linked Players</b> : 링크된 &nbsp;플레이어의 위치를 나타낸다. \n                    이기능을 &nbsp;활용하기위해선 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">먼저 \n                    타 플레이어와의 링크가 필요하다. &nbsp;아래에 설명하기로 \n                    하겠다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_3.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:226/304\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Server Boundaries</b> : 문제의 서버 경계선 ㅡ.ㅡ 바로 이서버 \n                    경계선을 표시해주는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">기능이다. \n                    &nbsp;수많은 버그가 이 써버 경계선... &nbsp;한번 왔다 갔다 \n                    해보면 상당히 &nbsp;버벅거리는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">것을 \n                    볼수 있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">몹들은 \n                    써버 경계선을 넘어올수 없고 &nbsp;또한 힐러들의 블루 엔피씨등도 \n                    다른써버에서 &nbsp;볼 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">경우 \n                    그래이로 보일때가 많아 혼란을 야기한다. &nbsp;공격하지 말길 \n                    바란다. &nbsp;그넘덜 알고보</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">면 \n                    블루다. &nbsp;또한 경계선상 밖에 있는 몹에겐 공격이 불가능하다. \n                    &nbsp;프로보도 안되고 모두</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">들 \n                    좋아하는 익스코포 콤보또한 안먹힌다. &nbsp;활도 안맞는다. \n                    &nbsp;혹시 공격방법을 찾아냈다면 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">필자에게 \n                    메일을 보내기 바란다. &nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">한예로 \n                    예전에 서버 경계선에 집을 지어놨다가 집이 없어진 바람에 \n                    엄청난 &nbsp;보상을 받은 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">올드비가 \n                    있었다. &nbsp;어디 스크린샷이 있었는데 죄송하지만 너무 오래되놔서 \n                    까먹었다. &nbsp;지</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">금은 \n                    물론 불가능할 것이다. &nbsp;하지만 한번 시도해보는것도 괜찬을 \n                    것이다. &nbsp;혹시 또 없어</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">져서 \n                    겜마불렀다가 할수없다 다시 사서 맹글어라. &nbsp;뭐 이런소리 \n                    하더라도 필자를 원망하</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">지 \n                    말았음 좋겠다. &nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Cursor Coordinates</b> : 지도의 &nbsp;왼쪽 상단에 위도와 \n                    경도로 현재 &nbsp;위치가 표시된다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">또한 \n                    브리타냐는 B, T2A(The Second Age : Lost Land) 는 &nbsp;L로 \n                    표시됨을 잊어선 안된</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_4.gif\" data-recovery=\"missing\" height=\"200\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:300/200\" width=\"300\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Full \n                    Map </b>: 울온의 전 대륙을 Tilt Map 으로 보여준다. &nbsp;1/8 \n                    축소기능과는 다른 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Statics</b> : 지형을 자세하게 보여준다. 보통 이옵션이 기본이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Hide \n                    Statics</b> : 지형을 간단하게 보여준다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Nomal \n                    View</b> : 기본적인 지도를 보여준다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_7.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:150/100\" width=\"150\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_8.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/100\" width=\"250\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>X-ray \n                    View</b> : 근처 광산을 가보면 지도상에서 &nbsp;뻥뚫린채로 \n                    보일 것이다. 마을에선 지붕</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이 \n                    없어진 채로 보여서 그리 &nbsp;좋아보이진 않을 것이다. &nbsp;유나 \n                    벅스덴의 &nbsp;숨겨진 위치 또 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">블튼 \n                    머덜캠프위의 숨겨진 광산등도 이기능으로 보면 표시가 된다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">혹시 \n                    블튼위 숨겨진 광산에 들어간분 계시다면 방법좀 소개해주길 \n                    바란다. &nbsp;아무리 들어</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가보려고 \n                    발버둥을 쳐봐도 들어가지지가 않는다. &nbsp;혹시 &nbsp;발러오어만 \n                    대량 스펀이 된다든</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">지 \n                    거기서 캐내는건 모두다 금화라던쥐 하는 궁금증이 들어서 별짓을 \n                    다 &nbsp;해봤지만 아직</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도 \n                    들어가보는데 실패했다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>World \n                    view</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">트라멜,펠루카,일쉐나대륙을 \n                    선택할수 있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_5.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:226/304\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Zoom \n                    </b>: 8배부터 1/8 배까지 확대,축소</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Track \n                    Playe</b>r : 선택한 플레이어를 화면의 중앙에 동그랗게 표시해준다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/map_6.gif\" data-recovery=\"missing\" height=\"375\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:362/375\" width=\"362\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Cailbrate</b> \n                    : 가끔 패치가 되면 맵상에 자신의 위치가 &nbsp;표시되지 않고 \n                    엉뚱한 곳으로 이동</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">해 \n                    있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">팅커샵이나 \n                    아니면 간단히 만들어도 좋고 좌표기를 이용해 위치를 알아낸다음 \n                    대륙과 위</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도 \n                    경도를 기입해주면 다시 화면의 중앙에 위치한 자신을 볼수 \n                    있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</ul>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Written \n                    By </b></font><font color=\"#666666\" face=\"돋움\" size=\"2\">HolyPink</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</ul>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_knowhow_map/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a>&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><map name=\"ImageMap1\">\n<area coords=\"312, 10, 356, 23\" href=\"/site/skill/uo_knowhow_uoam/\" shape=\"rect\">\n<area coords=\"212, 11, 274, 24\" href=\"/site/skill/uo_knowhow_ass/\" shape=\"rect\">\n<area coords=\"115, 10, 170, 23\" href=\"/site/skill/uo_knowhow_files/\" shape=\"rect\">\n<area coords=\"29, 9, 83, 23\" href=\"/site/skill/uo_knowhow_mark/\" shape=\"rect\">\n<area coords=\"23, 27, 71, 39\" href=\"/site/skill/uo_knowhow_place/\" shape=\"rect\">\n<area coords=\"97, 27, 138, 40\" href=\"/site/skill/uo_knowhow_filter/\" shape=\"rect\">\n<area coords=\"172, 27, 222, 40\" href=\"https://web.archive.org/web/20010709181617/http://forg.co.kr/skill/uo_knowhow_player.htm\" shape=\"rect\" target=\"_blank\">\n<area coords=\"250, 27, 287, 40\" href=\"/site/skill/uo_knowhow_map/\" shape=\"rect\">\n<area coords=\"324, 28, 361, 40\" href=\"/site/skill/uo_knowhow_link/\" shape=\"rect\">\n</map></font></p>",
