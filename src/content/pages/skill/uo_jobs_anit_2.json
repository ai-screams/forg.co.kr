  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_3.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_alchemy/\"><img alt=\"연금술[포션제작]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_a.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_poisoning/\"><img alt=\"독바르기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_p.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_taste/\"><img alt=\"맛감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tid.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_blacksmith/\"><img alt=\"대장장이\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_b.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_mining/\"><img alt=\"광부\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_m.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tailor/\"><img alt=\"재단사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ta.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_thinker/\"><img alt=\"팅거링[기계공]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_bow/\"><img alt=\"활제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_bow.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_car/\"><img alt=\"목공\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_c.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_begging/\"><img alt=\"구걸\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_be.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_cooking/\"><img alt=\"요리사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cook.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_ins/\"><img alt=\"마법스크롤제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_i.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anit/\"><img alt=\"동물길들이기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ani.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anil/\"><img alt=\"동물지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_al.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_vet/\"><img alt=\"수의학\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_v.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_carto/\"><img alt=\"보물사냥꾼\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_car.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lock/\"><img alt=\"자물쇠열기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lock.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_fishing/\"><img alt=\"낚시\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_f.gif\" width=\"110\"></a><a href=\"/site/skill/uo_jobs_ss/\"><img alt=\"심령술[죽은자와대화]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_sp.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_camping/\"><img alt=\"야영\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cam.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lumber/\"><img alt=\"나무패기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lum.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_detect/\"><img alt=\"숨은물체찿기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_d.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tracking/\"><img alt=\"추적\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tra.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_armslore/\"><img alt=\"장비지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_arm.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_item/\"><img alt=\"아이템감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_id.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/j_line.gif\" width=\"110\"></font></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;<a href=\"/site/skill/uo_jobs_anit/\"><font color=\"black\">동물훈련기초</font></a>/<a href=\"/site/skill/uo_jobs_anit_1/\"><font color=\"black\"><font color=\"black\">스킬도표</font></font></a><font color=\"black\"><font color=\"black\"><font color=\"black\">/<font color=\"black\"><a href=\"/site/skill/uo_jobs_anit_2/\"><font color=\"black\"><font color=\"black\">주요리스폰장소</font></font></a></font></font></font></font></b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" cellpadding=\"1\" cellspacing=\"1\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"505\">\n<tbody><tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;유니콘 \n                            리스폰 장소(일쉐나)</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/unicorn.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:250/240\" width=\"250\"></font></p>\n</td>\n<td width=\"249\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/unicorn_1.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:245/240\" width=\"245\"></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">숭고함의 \n                            게이트를 선택해서 나오는 길에 보이는 숲전체에 유포되어있습니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">약 \n                            2-3마리가 리젠이됩니다. 테임후 게이트로 들어가셔셔 \n                            </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다른 \n                            서버구역으로 유니콘을 이동하셔야 유니콘이 다시 리젠됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">p.s \n                            : 테이머가 여성 캐릭이어야 합니다. 카르마가 너무 \n                            낮으믄 주위의</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">요정들이 \n                            공격을 가하므로 염두해두시길..</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>일쉐나대륙(서드돈)으로 \n                            가는길은 UO.Tip란에 문게이트위치편을 보시길...</b></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#EEEEED\" colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;나이트메어,기린 \n                            리스폰장소(일쉐나)</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/kirin.gif\" data-recovery=\"missing\" height=\"300\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:500/300\" width=\"500\"></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">정직의 \n                            게이트로 이동합니다. 기린과나메의 리스폰장소는 2가지 \n                            길이 있습니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">A포인트와 \n                            B포인트, B포인트로 가시면 바로 리스펀장소로 갈 수 \n                            있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/kirin_1.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:250/240\" width=\"250\"></font></p>\n</td>\n<td width=\"249\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"240\" src=\"/img/posts/site/skill/images/uojobs/animal/kirin_2.gif\" width=\"245\"></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/kirin_4.gif\" data-recovery=\"missing\" height=\"260\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:250/260\" width=\"250\"></font></p>\n</td>\n<td width=\"242\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">A포인트를 \n                            가시게 되면 요정과 동양용의</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">리스펀장소가 \n                            보이고 C포인트로 이동</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">하면 \n                            Ankh던전이라는곳으로 워프됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Ankh던전에서 \n                            빠르게</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"> \n                            D포인트로 이동합니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그러면 \n                            이제 최종 목적지인 좌측사진의</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">장소로 \n                            이동하게됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사진에서와 \n                            같이 기린의 리스펀장소와</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">나이트메어의 \n                            리스펀 장소가</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">구분되어져 \n                            있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 \n                            되돌아 가실 때는 템한 것을 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">타고 \n                            가시는게 편합니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"240\" src=\"/img/posts/site/skill/images/uojobs/animal/kirin_3.gif\" width=\"250\"></font></p>\n</td>\n<td width=\"242\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">기린의 \n                            리스펀 장소입니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">지도를 \n                            보시면 아시겠지만 땅에</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그려진 \n                            동물의 문양이 인상적입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">p.s \n                            : 기린은 유니콘과 반대로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">오직 \n                            남성캐릭만이 테임할 수 있고</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">또한 \n                            탈 수 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"500\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;탈 \n                            수 있는 라마,광폭,색오타(T2A지역)</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_11.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></font></p>\n</td>\n<td width=\"245\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_12.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">델루시아마을에서 \n                            북쪽이나 동쪽으로 쭉가시다보면 군데군데 리스펀장소가 \n                            있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">라마는 \n                            <b>a ridable llama</b>라는 것만 오직 탈 수 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">우측에 \n                            광폭은 5써클 패럴로 얼리게 한후 테임하면 보다 쉽게 \n                            테임할 수  있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>화이트웜(아이스던전)</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/wdragon.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></font></p>\n</td>\n<td width=\"245\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/wdragon_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:247/250\" width=\"247\"></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;좌측 \n                            사진에 빨간점이 화이트웜의 리스펀 지역입니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;드래곤(윈드던전,히스로스섬,코베던전,데스타드던전)</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/dragon.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></font></p>\n</td>\n<td width=\"248\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">윈드던전으로서 \n                            용을 이리로 끌고온후 건너편으로 3써클 텔레포트마법으로</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이동 \n                            하시면 됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 \n                            텔레포트를 하실 때는 바로보이는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">대리석을 찍어주심됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가드지역이라 \n                            위험할 때 가드를</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">부르셔도 \n                            됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이곳말고도 \n                            바로밑에도 테임하실수</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">있는 \n                            장소가 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"253\" width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/dragon_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></font></p>\n</td>\n<td height=\"253\" width=\"248\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">히스로스섬(울온전체지도 \n                            맨우측하단의섬)으로 가시면 데몬 템플이 있습니다. \n                            </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사진과같이 \n                            용암으로</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">텔레포트를 \n                            하실수 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">비교적 \n                            안전하게 테임할 수 있는</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">인기있는 \n                            장소중에 하나입니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"white\" colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;나이트메어(T2A-테라산킵)</b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"253\" width=\"250\">\n<p><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/night_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></p>\n</td>\n<td height=\"253\" width=\"248\">\n<p><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/night.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">테라산킵에서 \n                            남쪽방향끝부근에서 리스펀 됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">근처에 \n                            드레이크와옵피디언도 리젠되니 주의하시길..</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_jobs_anit_2/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a>&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>",
