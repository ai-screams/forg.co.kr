  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\">Catalog*******</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_jobs_alchemy/\" title=\"연금술[포션제작]\">Alchemy+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_poisoning/\" title=\"포이즈닝[독바르기]\">Poisoning</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_taste/\" title=\"맛감정\">Taste ID</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_jobs_blacksmith/\" title=\"스미스[대장장이]\">Black Smith+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_mining/\" title=\"광부[광물캐기]\">Mining</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_armslore/\" title=\"암즈로어[장비지식]\">Arms Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_item/\" title=\"아이템ID[아이템감정]\">Item ID</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_jobs_car/\" title=\"카펜터리[목공술]\">Carpentry</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_lumber/\" title=\"럼버잭[나무하기]\">Lumberjacking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_thinker/\" title=\"팅거링[기계공기술]\">Tinkering</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_bow/\" title=\"보우크래프트[활제작술]\">Bowcraft</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_fishing/\" title=\"피싱[낚시]\">Fishing</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_ins/\" title=\"인스크립션[기록술]\">Inscription</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_tailor/\" title=\"재단사[재봉술]\">Tailor</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_cooking/\" title=\"쿠킹[요리]\">Cooking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_begging/\" title=\"베깅[구걸]\">Begging</a><br><br>\n</div><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/jobs_logo.gif\" data-recovery=\"missing\" height=\"17\" src=\"/img/placeholder/missing.svg\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\">&nbsp;</font>&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td height=\"30\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"30\" src=\"/img/posts/site/skill/images/left_menu/alpha/b.gif\" width=\"30\">EGGING</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"22\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#A0965A\" bordercolordark=\"#999933\" bordercolorlight=\"#A0965A\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"530\">\n<tbody><tr>\n<td colspan=\"2\" height=\"31\" width=\"498\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">■ 구걸 <img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/spotowax.gif\" data-recovery=\"missing\" height=\"18\" src=\"/img/placeholder/missing.svg\" width=\"19\"></span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"58\" width=\"498\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">구걸은 어떠한 \n                            재료도 없이 유일하게 지피를 만질 수 있는 스킬입니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">일반 플레이어에게 \n                            구걸을 하는 것은 뛰어난 화술이 필요 하지만</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">NPC에게 구걸을 \n                            하는 것은 베깅스킬 하나로 구걸을 하실수 있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">4타일 떨어진데 \n                            까지 베깅이 됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">구걸스킬을 구동한후 \n                            원하시는 엔피씨를 클릭해주면 됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"498\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;구걸 \n                            상세정보</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"100\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/beg/beg_3.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"396\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">구걸이 \n                            실패하였을 때 나오는 메세지입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"100\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/beg/beg_2.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"296\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">NPC가 \n                            수중에 금화가 19-10골드 이하이었을 때</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">나오는 \n                            메시지입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">즉 \n                            1골드를 줍니다-_-;;</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"100\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/beg/beg_1.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"296\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">NPC가 \n                            100골드 이상을 수중에 가지고 있을 때</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">구걸이 \n                            성공하면 10골드를 줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">90-99는 \n                            9골드,80-89는8골드이런식으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">구걸한번에 \n                            한번씩 배분을 받습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"100\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/beg/beg_4.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"296\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">9골드이하일 \n                            때 즉 1골드밑으로 줄 수 없으므로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">나오는 \n                            메시지 입니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;p.s : NPC의 소유지피의 비율에따라 \n                구걸성공시 금화를 획득할 수</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">있으므로 스누핑(가방뒤지기)스킬도 올리시면 \n                NPC가 얼마나 많은 금화를 가지고 있는지도</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">알 수 있을 것입니다.NPC는 대부분 NOBLE정도의 \n                페임을 가진 NPC들이</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">많은 금화를 가지고 있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><a href=\"#top\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
