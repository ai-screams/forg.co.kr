  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\">Catalog*******</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_vet_mu/\" title=\"뮤지션[음악연주]\">Musicianship+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_pro/\" title=\"프로보케이션[전투도발]\">Provocation</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_peace/\" title=\"피스메이킹[평화연주]\">Peacemaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_ent/\" title=\"유혹\">Enticement</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_anit/\" title=\"애니멀테이밍[길들이기]\">Animal Taming+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_anil/\" title=\"애니멀로어[동물지식]\">Animal Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_vet/\" title=\"베너터리[수의학]\">Veterinary</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_herding/\" title=\"허딩[목동술]\">Herding</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_carto/\" title=\"카토그라피[지도제작술]\">Cartography+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_lock/\" title=\"락픽킹[자물쇠열기]\">Lockpicking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_remove/\" title=\"리무브트랩[함정해제]\">Remove Trap</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_detect/\" title=\"디텍트히든[은폐탐지]\">Detect Hidden</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_ss/\" title=\"스피리트스피킹[심령술]\">Sprit Speaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_camping/\" title=\"캠핑[야영]\">Camping</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_tracking/\" title=\"트랙킹[추적하기]\">Tracking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_forensic/\" title=\"포렌식[해부학]\">Forensic EV.</a><br><br>\n</div><img border=\"0\" height=\"17\" src=\"/img/posts/site/skill/images/left_menu/vet_logo.gif\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"1083\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td>\n<p>&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"30\" src=\"/img/posts/site/skill/images/left_menu/alpha/a.gif\" width=\"30\">NIMAL \n                            TAMING - 3&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/1.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:19/20\" width=\"19\">\n</b></span></font><a href=\"/site/skill/uo_vet_anit/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/taming_1.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:80/20\" width=\"80\"></font></b></span></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/alpha/2.gif\" width=\"19\"></b></span></font><a href=\"/site/skill/uo_vet_anit_1/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/taming_2.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:50/20\" width=\"50\"></font></b></span></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>\n<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:20/20\" width=\"20\"></b></span></font><a href=\"/site/skill/uo_vet_anit_2/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/taming_3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:90/20\" width=\"90\"></font></b></span></a></p>\n</td>\n</tr>\n<tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"505\">\n<tbody><tr>\n<td colspan=\"2\" height=\"30\" width=\"497\">\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">■ 주요리스펀장소<img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/bottleswine.gif\" data-recovery=\"missing\" height=\"28\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:18/28\" width=\"18\"></span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;유니콘 \n                            리스폰 장소(일쉐나)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/unicorn.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/240\" width=\"250\"></span></font></p>\n</td>\n<td width=\"249\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/unicorn_1.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:245/240\" width=\"245\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">숭고함의 \n                            게이트를 선택해서 나오는 길에 보이는 숲전체에 유포되어있습니다</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">약 \n                            2-3마리가 리젠이됩니다. 테임후 게이트로 들어가셔셔 \n                            </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">다른 \n                            서버구역으로 유니콘을 이동하셔야 유니콘이 다시 리젠됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">p.s \n                            : 테이머가 여성 캐릭이어야 합니다. 카르마가 너무 \n                            낮으믄 주위의</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">요정들이 \n                            공격을 가하므로 염두해두시길..</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">일쉐나대륙(서드돈)으로 \n                            가는길은 UO.Tip란에 문게이트위치편을 보시길...</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;나이트메어,기린 \n                            리스폰장소(일쉐나)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/kirin.gif\" data-recovery=\"missing\" height=\"300\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:500/300\" width=\"500\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">정직의 \n                            게이트로 이동합니다. 기린과나메의 리스폰장소는 2가지 \n                            길이 있습니다</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">A포인트와 \n                            B포인트, B포인트로 가시면 바로 리스펀장소로 갈 수 \n                            있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/kirin_1.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/240\" width=\"250\"></span></font></p>\n</td>\n<td width=\"249\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"240\" src=\"/img/posts/site/skill/images/uojobs/animal/kirin_2.gif\" width=\"245\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/kirin_4.gif\" data-recovery=\"missing\" height=\"260\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/260\" width=\"250\"></span></font></p>\n</td>\n<td width=\"242\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">A포인트를 \n                            가시게 되면 요정과 동양용의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">리스펀장소가 \n                            보이고 C포인트로 이동</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">하면 \n                            Ankh던전이라는곳으로 워프됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Ankh던전에서 \n                            빠르게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\">\n<font face=\"Verdana\"><span style=\"font-size:9pt;\">D포인트로 이동합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그러면 \n                            이제 최종 목적지인 좌측사진의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">장소로 \n                            이동하게됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">사진에서와 \n                            같이 기린의 리스펀장소와</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">나이트메어의 \n                            리스펀 장소가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">구분되어져 \n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            되돌아 가실 때는 템한 것을 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">타고 \n                            가시는게 편합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"240\" src=\"/img/posts/site/skill/images/uojobs/animal/kirin_3.gif\" width=\"250\"></span></font></p>\n</td>\n<td width=\"242\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">기린의 \n                            리스펀 장소입니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지도를 \n                            보시면 아시겠지만 땅에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그려진 \n                            동물의 문양이 인상적입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">p.s \n                            : 기린은 유니콘과 반대로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">오직 \n                            남성캐릭만이 테임할 수 있고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                            탈 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"500\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;탈 \n                            수 있는 라마,광폭,색오타(T2A지역)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_11.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></span></font></p>\n</td>\n<td width=\"245\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_12.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">델루시아마을에서 \n                            북쪽이나 동쪽으로 쭉가시다보면 군데군데 리스펀장소가 \n                            있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">라마는 \n                            </span><b><span style=\"font-size:9pt;\">a ridable llama</span></b><span style=\"font-size:9pt;\">라는 것만 오직 탈 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">우측에 \n                            광폭은 5써클 패럴로 얼리게 한후 테임하면 보다 쉽게 \n                            테임할 수  있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">화이트웜(아이스던전)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/wdragon.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></span></font></p>\n</td>\n<td width=\"245\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/wdragon_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:247/250\" width=\"247\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;좌측 \n                            사진에 빨간점이 화이트웜의 리스펀 지역입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;드래곤(윈드던전,히스로스섬,코베던전,데스타드던전)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/dragon.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></span></font></p>\n</td>\n<td width=\"248\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">윈드던전으로서 \n                            용을 이리로 끌고온후 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">건너편으로 3써클 텔레포트마법으로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이동 \n                            하시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            텔레포트를 하실 때는 바로보이는 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">대리석을 찍어주심됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가드지역이라 \n                            위험할 때 가드를</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">부르셔도 \n                            됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이곳말고도 \n                            바로밑에도 테임하실수</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있는 \n                            장소가 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"253\" width=\"250\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/dragon_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></span></font></p>\n</td>\n<td height=\"253\" width=\"248\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">히스로스섬(울온전체지도 \n                            맨우측하단의섬)으로 가시면 데몬 템플이 있습니다. \n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">사진과같이 \n                            용암으로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">텔레포트를 \n                            하실수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">비교적 \n                            안전하게 테임할 수 있는</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">인기있는 \n                            장소중에 하나입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"503\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;나이트메어(T2A-테라산킵)</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"253\" width=\"250\">\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/night_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:250/250\" width=\"250\"></span></font></p>\n</td>\n<td height=\"253\" width=\"248\">\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/night.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:248/250\" width=\"248\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"503\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테라산킵에서 \n                            남쪽방향끝부근에서 리스펀 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">근처에 \n                            드레이크와옵피디언도 리젠되니 주의하시길..</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"#top\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
