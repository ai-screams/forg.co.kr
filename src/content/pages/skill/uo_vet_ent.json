  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\" title=\"원래 표기: Catalog*******\">Catalog</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_vet_mu/\" title=\"뮤지션[음악연주]\">Musicianship+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_pro/\" title=\"프로보케이션[전투도발]\">Provocation</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_peace/\" title=\"피스메이킹[평화연주]\">Peacemaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_ent/\" title=\"유혹\">Enticement</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_anit/\" title=\"애니멀테이밍[길들이기]\">Animal Taming+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_anil/\" title=\"애니멀로어[동물지식]\">Animal Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_vet/\" title=\"베너터리[수의학]\">Veterinary</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_herding/\" title=\"허딩[목동술]\">Herding</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_carto/\" title=\"카토그라피[지도제작술]\">Cartography+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_lock/\" title=\"락픽킹[자물쇠열기]\">Lockpicking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_remove/\" title=\"리무브트랩[함정해제]\">Remove Trap</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_detect/\" title=\"디텍트히든[은폐탐지]\">Detect Hidden</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_ss/\" title=\"스피리트스피킹[심령술]\">Sprit Speaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_camping/\" title=\"캠핑[야영]\">Camping</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_tracking/\" title=\"트랙킹[추적하기]\">Tracking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_forensic/\" title=\"포렌식[해부학]\">Forensic EV.</a><br><br>\n</div><img border=\"0\" height=\"17\" src=\"/img/posts/site/skill/images/left_menu/vet_logo.gif\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"426\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td>\n<p>&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/e.gif\" data-recovery=\"missing\" height=\"30\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/30\" width=\"30\">NTICEMENT</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"304\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;&nbsp;<font color=\"#333333\">&nbsp;</font>&nbsp;&nbsp;</p>\n<table align=\"center\" border=\"\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"500\">\n<tbody><tr>\n<td class=\"top\" height=\"28\" width=\"654\">\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">■ 유혹 <img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/u_7.gif\" data-recovery=\"missing\" height=\"19\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:19/19\" width=\"19\"></span></b></font></p>\n</td>\n</tr>\n<tr>\n<td class=\"top\" width=\"654\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"71\" src=\"/img/posts/site/skill/images/uocombat/enticement.gif\" width=\"170\"></span></font></p></td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" width=\"595\"> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">유혹이란</span></b><span style=\"font-size:9pt;\"> 말그대로 \n                            음악으로서 타겟팅된 대상물을 자기 근처로 이끌리게 \n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">하는 것입니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">유혹을 발동 \n                            한후 타겟이 뜨면 대상물을 지정함으로서 스킬이 발동이 \n                            됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">이런 유혹 \n                            기술로서 상대방을 끈임없이 원하는 장소로 끌고 가야 \n                            하기 때문에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">딜레이는 약1초간격으로 \n                            하실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 다 되는 것이 아니고 상식적으로 \n                            여러 플레이어에게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">해가 되는 행위인 벤더나 가드를 \n                            이끌고 다른곳으로 간다는 행위는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">할수가 없음을 알 수 있을겁니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">만약 그런 류의 플레이가 가능하다면 \n                            현존하는 잡질 스킬도 될 수 있을겁니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">유혹도 마찬가지로 심금을 울리는 음악으로 상대방을 유혹해야 함으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">뮤지션 즉, 악기를 다루는 기술이 \n                            먼저 기반이 되어야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">유혹의 이런 \n                            것이외엔 별다른 메리트가 없으므로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:20px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">울온상 거의 \n                            사장되다 시피한 스킬중의 한 스킬입니다.</span></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"#top\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
