  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_3.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_alchemy/\"><img alt=\"연금술[포션제작]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_a.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_poisoning/\"><img alt=\"독바르기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_p.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_taste/\"><img alt=\"맛감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tid.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_blacksmith/\"><img alt=\"대장장이\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_b.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_mining/\"><img alt=\"광부\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_m.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tailor/\"><img alt=\"재단사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ta.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_thinker/\"><img alt=\"팅거링[기계공]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_t.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_bow/\"><img alt=\"활제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_bow.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_car/\"><img alt=\"목공\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_c.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_begging/\"><img alt=\"구걸\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_be.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_cooking/\"><img alt=\"요리사\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cook.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_ins/\"><img alt=\"마법스크롤제작자\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_i.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anit/\"><img alt=\"동물길들이기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_ani.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_anil/\"><img alt=\"동물지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_al.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_vet/\"><img alt=\"수의학\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_v.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_carto/\"><img alt=\"보물사냥꾼\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_car.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lock/\"><img alt=\"자물쇠열기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lock.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_fishing/\"><img alt=\"낚시\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_f.gif\" width=\"110\"></a><a href=\"/site/skill/uo_jobs_ss/\"><img alt=\"심령술[죽은자와대화]\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_sp.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_camping/\"><img alt=\"야영\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_cam.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_lumber/\"><img alt=\"나무패기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_lum.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_detect/\"><img alt=\"숨은물체찿기\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_d.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_tracking/\"><img alt=\"추적\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_tra.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_armslore/\"><img alt=\"장비지식\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_arm.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"/site/skill/uo_jobs_item/\"><img alt=\"아이템감정\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/j_id.gif\" width=\"110\"></a></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/j_line.gif\" width=\"110\"></font></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;<a href=\"/site/skill/uo_jobs_anit/\"><font color=\"black\">동물훈련기초</font></a>/<a href=\"/site/skill/uo_jobs_anit_1/\"><font color=\"black\"><font color=\"black\">스킬도표</font></font></a><font color=\"black\"><font color=\"black\"><font color=\"black\">/<font color=\"black\"><a href=\"/site/skill/uo_jobs_anit_2/\"><font color=\"black\"><font color=\"black\">주요리스폰장소</font></font></a></font></font></font></font></b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" cellpadding=\"1\" cellspacing=\"1\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"505\">\n<tbody><tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>&nbsp;애니멀테이밍</b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/animal/tame_8.gif\" width=\"300\"></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">동물을 \n                            테임할 때는 테임스킬을 일단 구동 하시고 타겟이 뜨면 \n                            </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">원하는 \n                            동물을 찍어 주시면 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">테임중에 \n                            공격적인 동물은 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">\"<b>당신은 그동물을 화나게 하는 것 같습니다</b>\"라는 \n                            메시지가 보입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">무시하시고 \n                            계속 시도 하시면 됩니다. 이때는 스킬딜레이가 거의 \n                            없으니</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">계속 \n                            테임을 시도 하시면 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">물론 \n                            드래곤의 블레스(아머와 레지에 관계없이 약 40정도의 \n                            데미지,</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">드레이크는약 \n                            20정도의데미지를 줍니다)를 조심하시면 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">테이머는 \n                            마사테이머,바드테이머,전사테이머등 많은 스킬을</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">조합할 \n                            수 있지만 일단은 애니멀로어,메저리,메디는 기본적으로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">추가되야 \n                            한다는 사실을 명심하시길 바랍니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">p.s \n                            : 예전에는 로어스킬까지 제외시키고 오로지 테이밍만 \n                            키우는</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">분들이 \n                            많았습니다. 이것은 동물을 다른분에게 팔아서 돈을 \n                            버는 분들이었지만</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">패치이후에는 \n                            마굿간의 맡길수있는 수패치와 리스폰의 수등으로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">메리트가 \n                            없어졌습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/uojobs/animal/tame_4.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></font></p>\n</td>\n<td width=\"242\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">좌측에 \n                            그림은 여러분도 잘아시는</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">디싯눈섬입니다. \n                            </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">처음 \n                            하시는분부터 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마스터수준이상까지도 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가능한 \n                            동물이 모여 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이곳말고도 \n                            T2A지역에도 눈섬이 있어서</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">화이트울프가 \n                            있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">(UO.Tip란 \n                            레어란에 아이스봉관련참조)</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이곳말고도 \n                            처음하시는분들은 베스퍼동쪽숲이나 문글로우 남쪽 \n                            숲등에서</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">기본적으로 \n                            테임이 가능한 동물을</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">시도 \n                            하시면 됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"250\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/uojobs/animal/tame_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></font></p>\n</td>\n<td width=\"242\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\n                            젤롬마을에 젤롬 목장이 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">황소가 \n                            몇마리 젠이되니 이곳도</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">놓칠 \n                            수 없는 지역입니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"250\" src=\"/img/posts/site/skill/images/uojobs/animal/tame_3.gif\" width=\"250\"></font></p>\n</td>\n<td width=\"249\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">약 \n                            90이상부터 주로 가게 되는 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">델루시아 \n                            목장입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">황소로 \n                            충분히 100까지 올릴 수 있는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">최강의 \n                            동물입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">황소가 \n                            약 4-5마리정도 리젠이 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">물론 \n                            베스퍼 동쪽 숲에서도 황소를</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">보실수 \n                            있습니다..</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F8F8F8\" colspan=\"2\" height=\"30\" width=\"497\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>공격적인 \n                            동물길들이는 방법</b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"237\" width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"250\" src=\"/img/posts/site/skill/images/uojobs/animal/tame_7.gif\" width=\"250\"></font></p>\n</td>\n<td height=\"237\" width=\"242\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">테이밍은 \n                            원하는 동물이나 몬스터를 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">자신의명령을 듣게 하는 \n                            </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">매력적인 스킬입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">어렵다고 \n                            생각하시는분들은 스킬을 신경쓰지 마시고 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">꾸준히 \n                            그리고 천천히 올리시는 것이 가장 좋은 방법입니다..</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">좌측사진은 \n                            테임의 기본적인 워킹테임</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">이라는 \n                            것으로 걸어다니면서 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">드래곤을 \n                            꼬시는 방법입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">물론 \n                            기본적이지만 가장 난이도가</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\">있는 \n                            테임 방법입니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/uojobs/animal/tame_9.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></font></p>\n</td>\n<td width=\"242\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;패럴필드를 \n                            깔고 용을 유인한후</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">테임을 \n                            시도 하는 방법입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">워킹테임보다 \n                            비교적 안전하게</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1-2번정도 \n                            테임시도를 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">하실수 \n                            있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"243\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/uojobs/animal/tame_10.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></font></p>\n</td>\n<td width=\"242\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">천연의 \n                            장소를 이용하여</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">안전하게 \n                            용을 유인하는 방법입니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3써클의 \n                            텔레포트마법을 이용하여</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">건너편으로 \n                            이동 테임하는 것으로</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">울온에서는 \n                            여러곳에 \n                            </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">블록 \n                            장소가 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 \n                            공격적인 동물은</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">테임이 \n                            성공한후 먹이를 주고</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">바로 \n                            하이딩을 하시고 그레이가 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">풀릴 \n                            때까지 기다리셨다가 원하는 장소로</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이동시켜주시면 \n                            됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"497\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">말,오타,라마,짐말,광폭등은 \n                            야채를 주시면 됩니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">야채는 \n                            마을외곽 엔피씨들이 많이 팔며 물론 잡화점에서도 \n                            사실수 있습니다, </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">급하신분은 \n                            1써클 음식만들기 마법으로 만드셔도 됩니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">곰종류,드래곤,나메,유니콘등은 \n                             생고기를 잘먹습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다른동물의 \n                            시체를 해부하여 생고기를 뜯어내 얻을 수 있으며 푸줏간에서도</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">구입하실수 \n                            있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">p.s \n                            : 각종 동물을 명령내릴 때 쓰는 명령어는 UO.Tip란에 \n                            명령어사전을 찿아보시길..</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"silver\" cellpadding=\"1\" cellspacing=\"1\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"400\">\n<tbody><tr>\n<td bgcolor=\"#EEEEED\" colspan=\"2\" width=\"392\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동물을 \n                            맡길 때는 \"<b>stable</b>\"을 마굿간에서 \n                            외치시면 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동물을 \n                            찿을 때는 \"<b>claim</b>\"을 마굿간에서 \n                            외치시면 됩니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F8F8F8\" width=\"179\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>마굿간에 \n                            맡길 수 있는</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>동물의 \n                            수</b></font></p>\n</td>\n<td bgcolor=\"#F8F8F8\" width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>스킬합</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"179\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2마리</font></p>\n</td>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">-</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"179\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3마리</font></p>\n</td>\n<td width=\"158\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">159.8</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"179\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">4마리</font></p>\n</td>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">199.8</font></p>\n</td>\n</tr>\n<tr>\n<td width=\"179\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">5마리</font></p>\n</td>\n<td width=\"158\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">240</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">위의 \n                스킬합은 &nbsp;: 애니멀테이밍+애니멀로어+베테리너리의 총합입니다.</font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"gray\" face=\"돋움\" size=\"2\"><b>Written By Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;<a href=\"/site/skill/uo_jobs_anit/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>",
