\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>동물지식 구동시 메시지의 여부</b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"wonderfully happy\" </b></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">최상의 \n                            충성심</font></p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"extremely happy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"very happy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"rather happy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"happy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"content\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"content, I suppose\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"unhappy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"rather unhappy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"extremely unhappy\" </b></font></p></td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>\"confused\"</b></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">곧 \n                            테임이 풀릴시기.</font></p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"wonderfully happy\" 에서부터 \n                            \"confused\"라는 메시지로 갑니다.</font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">먹이를 \n                            안주거나 무리한 반복된 명령을 하게 되면 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">복종심의 \n                            수치가 급격히 떨어집니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그 \n                            수치와시간은 테임된 동물마다 다른 것으로 보여집니다.</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" cellspacing=\"0\" width=\"398\">\n<tbody><tr>\n<td bgcolor=\"#EEEEED\" width=\"92\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\"><b>애니멀테이밍</b></font></p>\n</td>\n<td bgcolor=\"#EEEEED\" width=\"97\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\"><b>애니멀로어</b></font></p>\n</td>\n<td bgcolor=\"#EEEEED\" height=\"30\" width=\"195\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\"><b>명령을 \n                            성공시킬확율</b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"92\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\">0</font></p>\n</td>\n<td width=\"97\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\">0</font></p>\n</td>\n<td width=\"195\">\n<p align=\"center\"><font face=\"돋움\" size=\"2\">0%</font></p>\n</