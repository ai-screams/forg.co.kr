in-bottom:0;\"><font face=\"바탕체\" size=\"2\">Fencing</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"550\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Short Spear </font><font color=\"#000066\" face=\"바탕체\" size=\"2\">(2-H)</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">15</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">2d15+2 (4-32)</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">50</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">31-70</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Fencing</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"550\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Spear </font><font color=\"#000066\" face=\"바탕체\" size=\"2\">(2-H)</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">30</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">2d18 (2-36)</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">46</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">31-80</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Fencing</font></p></td>\n</tr>\n<tr>\n<td height=\"28\" width=\"550\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>War Fork</b></font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">35</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">1d29+3 (4-32)</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">45</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">31-110</font></p></td>\n<td align=\"center\" height=\"28\" width=\"550\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Fencing</font></p></td>\n</tr>\n</tbody></table></td>\n</tr>\n<tr>\n<td width=\"74\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p></td>\n<td width=\"676\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>:::</b></font><font face=\"바탕체\" size=\"2\">펜싱은 가장 빨리 휘둘수 잇는 무기라는 매력이 있다. 무기의 \n            이미지도 아기자기한</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">것들이 많지만 단점으로 파워와 매직무기가 \n            희소하다는점을 꼽을 수 있다</font><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>:::</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<font face=\"바탕체\" size=\"2\">데미지의 보너스타격인 Tatics와Str(체력)은 \n            이도표에선 포함하지 않았고 Dex(민첩)와 연관된 무기를</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">휘둘르는 속도도 포함시키지 않앗다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;&nbsp;이표는 </font><a href=\"http://uo.stratics.com/\" target=\"_blank\"><font color=\"teal\" face=\"바탕체\" size=\"2\"><b>UOSS</b></font></a><font face=\"바탕체\" size=\"2\">에서 나온표입니다.</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p><map name=\"skill_1\">\n<area coords=\"0, 32, 80, 44\" href=\"https://web.archive.org/web/20010128154700/http://www.forg.co.kr/skill/ar.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 46, 79, 58\" href=\"/site/skill/mac/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 60, 79, 73\" href=\"https://web.archive.org/web/20010128154700/http://www.forg.co.kr/skill/sw.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"0, 75, 79, 90\" href=\"/site/skill/fe/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 92, 78, 106\" href=\"/site/skill/wr/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 108, 77, 120\" href=\"/site/skill/an/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 122, 79, 135\" href=\"/site/skill/he/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 182, 79, 196\" href=\"/site/skill/ma/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 198, 79, 211\" href=\"/site/skill/mad/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 213, 79, 226\" href=\"/site/skill/re/\" shape=\"rect\" title=\"\">\n<area coord