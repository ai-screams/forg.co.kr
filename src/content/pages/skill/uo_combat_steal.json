  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo.gif\" width=\"110\"></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ana/\"><img alt=\"아나토미\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_a.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mace/\"><img alt=\"메이스\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mace.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_sw/\"><img alt=\"스워드\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sw.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_fe/\"><img alt=\"펜싱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_fe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ar/\"><img alt=\"궁수\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ar.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_wr/\"><img alt=\"레스링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_wr.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ta/\"><img alt=\"택틱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_t.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pa/\"><img alt=\"패링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_p.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_he/\"><img alt=\"힐링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_m/\"><img alt=\"메저리\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mad/\"><img alt=\"메디테이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ma.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ev/\"><img alt=\"이벨\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_e.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_re/\"><img alt=\"레지\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mu/\"><img alt=\"뮤지션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mu.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pro/\"><img alt=\"프로보케이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pro.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_peace/\"><img alt=\"피스메이킹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ent/\"><img alt=\"유혹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_en.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_steal/\"><img alt=\"스틸링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_snooping/\"><img alt=\"스누핑\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sn.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_hiding/\"><img alt=\"하이딩\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_hi.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_stealth/\"><span class=\"forg-missing\" data-original-src=\"http://www.forg.co.kr:80/skill/images/left_menu/c_st.gif\" data-recovery=\"missing\" style=\"width:110px;height:20px;line-height:20px\">스텔스</span></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"3\" src=\"/img/posts/site/skill/images/left_menu/c_line.gif\" width=\"110\"></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;스틸링</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font>\n</p><table border=\"\" cellspacing=\"0\" height=\"85\" width=\"600\">\n<tbody><tr>\n<td bgcolor=\"white\" class=\"top\" height=\"71\" width=\"654\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/uocombat/steal_4.gif\" data-recovery=\"missing\" height=\"85\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:255/85\" width=\"255\"></font></p></td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" width=\"595\"><ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\"><b>스틸링</b></font><font color=\"#262626\" face=\"돋움\" size=\"2\">은 도둑이라는 \n                            머드게임상 흔히 볼 수 없는 엽기적인 스킬입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">스틸링의 장점은 \n                            플레이어나 몬스터에게 다가가서 타겟팅된 아이템을</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">자신의 것으로 \n                            가지고 올 수 있다는 것과 세미레어를 얻을 수 있다는 \n                            메리트가 있지만</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">르네 패치후 \n                            본대륙(펠루카)에서 주로쓰는 스킬이 되어 버렷습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"돋움\" size=\"2\"><b>1</b></font><font color=\"#262626\" face=\"돋움\" size=\"2\">.플레이어의 \n                            경우는 일단 상대방의 캐릭창을 연후 가방을 더블클릭함(스누핑스킬)</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">으로서 원하는 \n                            아이템을 스틸링 기술로서 뺏어 올수 있든지 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">스틸링 스킬을발동하자마자 \n                            타겟이 뜨면 상대방을 찍으면 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">랜덤하게 물건을 \n                            뺏어 올 수 있는 2가지 방법이 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">하지만 선자가 \n                            더좋은 방법이라는 것은 글을 읽어 보시면 아실겁니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"돋움\" size=\"2\"><b>2</b></font><font color=\"#262626\" face=\"돋움\" size=\"2\">.몬스터의 \n                            경우는 캐릭창이 없기 때문에 바로 스틸링발동을 하고 \n                            </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">타겟이 뜨면 \n                            몬스터를 찍어 주심됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">이렇게 다 \n                            빼먹은 몬스터는 다른플레이어가 잡을시 거지몬스터라는-\"-</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">엽기적인 몬스터로 \n                            변신 될수 잇습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"돋움\" size=\"2\">3</font><font color=\"#262626\" face=\"돋움\" size=\"2\">.세미레어만 \n                            전문적으로 모으는 플레이어에게도 이러한</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">스틸링은 어느정도 \n                            필수 스킬입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">도시내에 있는 \n                            상자를 열고 세미레어를 훔치는 것이 그예이고</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"돋움\" size=\"2\">이러한 세미레어에 \n                            대한 자세한 내용은 Knowhow란에 레어편을 보시길.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>진정한 \n                            도둑이 되기 위해서</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">, 즉 일반 플레이어의 아이템을 훔치기 \n                            위해선</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">도둑길드에 \n                            들어야 합니다 물론 플레이어 길드에 든상태라도 괜찮습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">도둑길드는 \n                            npc길드기 때문이져.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">도둑길드에 \n                            들지 않으면 같은길드,적길드,몬스터등은 훔칠수 잇고</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">스킬향상도 \n                            될수 잇지만 최종목표는 불특정다수(블루플레이)를 \n                            대상으로 하는 것이기</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">때문에 드셔야 \n                            합니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">물론 세미레어 \n                            헌터를 위한 분들은 안드셔도 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>도둑길드를 \n                            들기위한 제한</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">은 스틸링 60이상에 캐릭을 만든후 \n                            플레이한시간이</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">48시간이 자나야 \n                            합니다</font>\n</p><table border=\"\" bordercolor=\"#494949\" cellpadding=\"0\" cellspacing=\"0\" width=\"80%\">\n<tbody><tr>\n<td width=\"177\"><p align=\"center\"><img border=\"0\" height=\"102\" src=\"/img/posts/site/skill/images/uocombat/steal_2.gif\" width=\"230\"></p></td>\n<td width=\"292\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도둑길드에 드실 \n                                        때는</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마을에서 단검을 \n                                        들고 있는 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도둑길드마스터를 \n                                        찾으셔야 합니다</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 찾으셨으면 \n                                        (</font><font face=\"돋움\" size=\"2\"><b>길마이름) \n                                        Join</b></font><font face=\"돋움\" size=\"2\">하시고</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">원하는 금액을 \n                                        npc머리위에 얹어주면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">간단히 가입이 \n                                        됩니다.</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>*</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">도둑길드마스터는 \n                            베스퍼,스카라,브리튼등에서 찿으실수 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>다음은 \n                            </b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">도둑의 \n                            재미있는 것중의 하나인 변장도구를 사실 차례입니다.</font>\n</p><table border=\"\" bordercolor=\"#494949\" cellpadding=\"0\" cellspacing=\"0\" width=\"80%\">\n<tbody><tr>\n<td width=\"177\"><p align=\"center\"><img border=\"0\" height=\"77\" src=\"/img/posts/site/skill/images/uocombat/steal_3.gif\" width=\"180\"></p></td>\n<td width=\"292\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도둑길드마스터옆에서</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Disguise라고 외친후</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">화면상의 금액을 \n                                        npc머리위에</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">얹어주면 자신의 \n                                        백팩으로 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">변장도구가 들어옵니다</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">*변장도구를 \n                            더블클릭하시면 자신의 머리모양을 바꾸실수 있고</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;이름은 \n                            랜덤하게 바뀝니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>스틸링 \n                            스킬</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">은 \n                            스킬수치에 따라 훔칠수 있는 스톤수가 증가하게 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">울온에서 한칸한칸을 \n                            타일이라고 부르는데 훔쳐도 걸리지 않는 타일수또한</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">늘어나게 됩니다. \n                            물론 스킬수치보다 큰 스톤을 훔치게되면 더욱 타일수가 \n                            좁아진다고</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">생각하시면됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">그러므로 위에서 \n                            언급햇듯이 플레이어의 아이템을 훔칠시에는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">랜덤하게 훔치는 \n                            캐릭에게 찍는 타겟스틸링보다 백팩을 뒤진후 아이템을 \n                            타겟팅하는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">것이 더욱 \n                            유리합니다. 값나가는 매직무기등을 들수가 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">일단 훔치고 \n                            싶은 아템을 단검등을 더블클릭 타겟이 뜨면 훔칠아이템을 \n                            클릭하여</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">타겟을 저장해둡니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이제는 상대방의 \n                            백팩을 닫아두셔도 됩니다 근처에 가셔셔 스틸링을 \n                            발동한후</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">상대방을 스치듯이 \n                            달려가면서 last target키를 살며시 누르시면서 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">앞으로 달려 \n                            가면됩니다-\"-(키매크로는 Knowhow란 참조하시길)</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">*서두가 길엇지만 \n                            스틸 또한 여러 가지 방법과 엽기적인 행동이 가능합니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">일단 마을에서는 \n                            훔치게 되면 최악의 경우 가드의 할바드-_-;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">또다른상황은 \n                            상대방이 알게되어 가드를 부르는 경우</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">주위의 사람들은 \n                            전혀모르는 경우입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">상대방과 주위사람 \n                            다 모르는경우입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>하지만</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\"> 어떤 경우이든지 \n                            스틸당한사람은 스틸한사람이 범죄자인 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이름이 회색으로 \n                            보입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이런 애매한 \n                            경우가 엽기의 대상입니다-_-;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">나중에 알게되어 \n                            가드를 불러도 안오니까</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">쫓아가서 죽일려고 \n                            치다가 도리어 전투력이 있는 도둑플레이어에게</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">죽임을 당한후 \n                            룻까지 당하는 어이없는 경우도 종종있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이럴 때는 \n                            죽어도 머카를 먹일수 없는 경우이고 다른 플레이어에게는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이미 그도둑은 \n                            시간이 지났으므로</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">그레이가 풀린상태입니다. \n                            스틸당한사람만 그레이로 보일뿐입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">던전에서는 \n                            마법을 주로하는 플레이어에게 다가가 블랙펄만 훔치게되면-_-;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">그 황당함도 \n                            이루말할수 없습니다 공격마법은 전혀 못쓰게 되는 \n                            경우이니까여</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">전사는 인로어를 \n                            해달라면서 주문외울 때 무기를 터는 엽기맨들도 종종있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이러한 여러 \n                            가지 랜덤한 경우가 잇으므로 일단 스틸을 한후에는 \n                            하이딩도 좋은</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">관계의 스킬이 \n                            될수 있음을 주지 하시면됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">물론 리빌마법으로 \n                            하딩한 상대를 볼수 잇다는 것과 그 자리에서 하딩이 \n                            풀릴 때까지</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">기다리는 지독한 \n                            플레이어도 잇으므로 하이딩하면서 몇칸씩 움직일 수 \n                            있는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">스텔스를 키우는 \n                            도둑도 잇습니다.</font></p>\n</ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>해당스킬</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">이 70이면 7스톤을 \n                        훔칠수 있게 됩니다. </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">아래표를 참조하시길..</font>\n</p><table border=\"\" bordercolor=\"#585858\" cellpadding=\"0\" cellspacing=\"0\" width=\"30%\">\n<tbody><tr>\n<td width=\"83\"><p align=\"center\"><font face=\"돋움\" size=\"2\">스킬수치</font></p></td>\n<td width=\"88\"><p align=\"center\"><font face=\"돋움\" size=\"2\">스톤수</font></p></td>\n</tr>\n<tr>\n<td width=\"83\"><p align=\"center\"><font face=\"돋움\" size=\"2\">10</font></p></td>\n<td width=\"88\"><p align=\"center\"><font face=\"돋움\" size=\"2\">1</font></p></td>\n</tr>\n<tr>\n<td width=\"83\"><p align=\"center\"><font face=\"돋움\" size=\"2\">50</font></p></td>\n<td width=\"88\"><p align=\"center\"><font face=\"돋움\" size=\"2\">5</font></p></td>\n</tr>\n<tr>\n<td width=\"83\"><p align=\"center\"><font face=\"돋움\" size=\"2\">100</font></p></td>\n<td width=\"88\"><p align=\"center\"><font face=\"돋움\" size=\"2\">10</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>마지막</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">으로 스틸은 \n                            아머가 낮을수록 민첩이 노플수록</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">훔치기가 수월해 \n                            집니다.</font></p>\n</ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>Written By \n                        Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<a href=\"/site/skill/uo_combat_steal/\"><font face=\"돋움\" size=\"2\"><b><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></b></font></a></p></td>\n</tr>\n</tbody></table></div>\n<p>&nbsp;</p>\n",
