  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_4.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_house/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_house.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hoption/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_sign.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_craft.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_command/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_com.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_vendor/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_vendor.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_moon/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_moon.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_r.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_fame/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_f.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_runebook/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_rune.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_secret/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_s.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mw/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_m.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_party/\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_party.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_puzzle/\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_puzzle.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_old/\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_old.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_option/\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_option.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_order/\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_order.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20020206185740/http://forg.uospace.net:80/skill/uo_knowhow_virtue.html\" target=\"_blank\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_virtue.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uosu/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_u.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mirc/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_mirc.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/left_menu/icon/k_k.gif\" data-recovery=\"missing\" height=\"25\" src=\"/img/placeholder/missing.svg\" width=\"130\"></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<center>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#F8F8F8\" class=\"heading\" height=\"30\" width=\"542\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;■ </font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>영플레이어에 대해서</b></font></p>\n</td>\n</tr>\n<tr>\n<td class=\"heading\" width=\"542\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;A. 게임에 처음 들어가면 새로운 플레이어는 자신의 은행박스 안에 10k(10,000)이상의 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;골드를 지니고 있지 않는 한 Haven(헤이븐)으로 \n초대받게 된다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;B. 영 플레이어는 게임상에서 머리 위에 있는 [Young]마크로 표시가 된다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;(이름 옆에 영이라는 표시가 생긴다)</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"50\" src=\"/img/posts/site/skill/images/uotip/young.gif\" width=\"200\"></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;C. 컴패니언은 영플레이어에게 가서 게임으로 이끌어 줄 수 있다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;D. 영 플레이어는 다른 영 플레이어만 치료해 줄 수 가 있다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;E. 영 플레이어는 다른 영 플레이어에게 말과 같은 아이템만 팔 수 있다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;F. 영 상태를 없애는 방법 : \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;스킬 총합 350이상이 된다(테스트 센터에 가서 스탯/스틸을 조정하는 것도 포함된다) \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;1계정에 5개의 캐릭터를 가지고 있다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;캐릭터를 만들 때 \"전문가용 모드\" 사용 \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;40시간 이상을 플레이한다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;\"I renounce my young player status\"라고 말한다</font></p>\n</td>\n</tr>\n</tbody></table></center>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<center>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#F8F8F8\" class=\"heading\" height=\"30\" width=\"542\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;■ </font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>돈[Gp]에&nbsp;대해서</b></font></p>\n</td>\n</tr>\n<tr>\n<td class=\"heading\" width=\"542\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;A. 골드 코인(지피)는 개당 0.02스톤의 무게가 나간다. 50골드가 1스톤이다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;B. 은행 안에 있는 골드는 은행 박스 안의 어떤 가방 안에 들어있든지 무게가 없다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;C. 골드 한덩이는 6만 지피를 넘을 수 없다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;잉갓,나무등 \n                                쌓을 수 있는 아이템에도 적용됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;D. 상점에서 물건을 살 때는 현금을 지니고 직접 사야하며 구매 금액이 2천지피가 넘으면 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;은행에서 자동적으로 빠진다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;E. 플레이어가 운영하는 벤더에서 물건을 구입할 때는 은행에서 직접 돈이 빠져나간다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;그 가격이 얼마던 간에 플레이어의 벤더에서 물건을 살 \n때는 백팩에 지피를 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;소지할 필요가 없다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;F. 수표를 사용하면 많은 돈을 지닐 수가 있으며 안전한 거래를 보장받게 된다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img border=\"0\" data-original-src=\"http://forg.uospace.net:80/skill/images/uotip/check.gif\" data-recovery=\"missing\" height=\"50\" src=\"/img/placeholder/missing.svg\" width=\"200\"></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;G. 수표를 만드는 방법은 다음과 같다 : \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;은행에 가서 \"check 금액\"이라고 말한다. 금액은 자신이 수표를 만들 금액이다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5천부터 100만 골드까지 수표로 만들 수 있다. \n\"check 10000\" 이면 1만 지피짜리 수표가 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;만들어짐. 한글로은 \"수표 금액\"이라고 하면 된다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;은행 안에 수표로 만들 만큼의 지피가 있으면 해당 가치의 수표가 은행 상자 안에 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;만들어지며 그만큼의 골드는 사라진다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;수표는 디드처럼 생겼다. 한번 클릭하면 얼마짜리 수표인지 보인다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;은행에 있는 돈이 수표로 만들 금액보다 적다면 수표가 만들어지지 않았다는 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;메시지가 뜬다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;H. 수표를 다시 골드로 바꾸려면 \n: \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;수표를 뱅커(또는 민터)에게 드래그한다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;은행 박스 안에 충분한 공간이 있으면 뱅커는 수표를 받아서 그에 해당하는 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;골드를 은행 박스 안에 넣어준다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;은행 박스 안에 공간이 충분하지 못하면 뱅커는 수표를 받아서 가능한 만큼만 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;골드로 바꿔서 은행안에 넣어주며 나머지 금액은 수표로 \n되돌려준다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">I. 모든 은행 수표는 \"블레스\"되어 있으므로 루팅이나 훔치기가 불가능하다. </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;수표로는 NPC나 플레이어가 운영하는 \n벤더에서 물건을 구입할 때 사용할 수가 없다. \n</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;&nbsp;실버 코인(은화)는 당파 제도에서 화폐로 통용된다. </font></p>\n</td>\n</tr>\n</tbody></table></center>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<center><table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody>\n<tr>\n<td bgcolor=\"#F8F8F8\" class=\"top\" colspan=\"2\" height=\"30\" width=\"544\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">■<b> 부패시스템</b></font></p></td></tr>\n<tr>\n<td class=\"top\" colspan=\"2\" height=\"22\" width=\"544\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>집과배</b></font></p></td></tr>\n<tr>\n<td class=\"heading\" height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">간판 표시</font></p></td>\n<td class=\"heading\" height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">기간</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"like new\"</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">약  50 분</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"slightly worn\"</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2,3일정도</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"somewhat worn\"</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2,3일정도</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"fairly worn\"</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2,3일정도</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"greatly worn\"</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2,3일정도</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"in danger of collapsing\"</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">18시간이상</font></p></td></tr>\n<tr bgcolor=\"#dddddd\">\n<td class=\"comment\" colspan=\"2\" height=\"22\" width=\"544\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">\"<b>새것과 같은</b>\" 상태에서 실제로 무너지기까지 걸리는 전체 시간은 11일이다. 일주일에 </font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1번 집을 리프레쉬하면 무너질 염려는 없다. 리프레쉬는 \n서버가 저장을 하는 동안에 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이루어져야 하며(서버 리셋 되기 한참 전이 좋다) </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">리프레쉬 한 것이 저장되지 않아 집이 무너지는 일이 많다.</font></p>\n</td></tr>\n<tr>\n<td class=\"top\" colspan=\"2\" height=\"22\" width=\"544\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>아이템</b></font></p></td></tr>\n<tr>\n<td class=\"heading\" height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아이템</font></p></td>\n<td class=\"heading\" height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">부패시간</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">뉴비아이템</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">90 초</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일반적인 아이템</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">? 분</font></p></td></tr>\n<tr>\n<td class=\"top\" colspan=\"2\" height=\"22\" width=\"544\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>시체류</b></font></p></td></tr>\n<tr>\n<td class=\"heading\" height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">부패형태</font></p></td>\n<td class=\"heading\" height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">부패시간</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동물 시체</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">7 분</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">몬스터 시체</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">7 분</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">NPC 시체</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">7 분</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">플레이어의 시체가 뼈로 될때까지</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">7 분</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">플레이어의뼈(범죄행위 없이 타인이 룻가능)</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">7 분</font></p></td></tr>\n<tr>\n<td height=\"22\" width=\"327\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">짜른 시체 토막</font></p></td>\n<td height=\"22\" width=\"213\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">90 초</font></p></td></tr></tbody></table></center>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#313131\" face=\"돋움\" size=\"2\"><b>Written By \n                        Kritz</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><map name=\"ImageMap1\">\n<area coords=\"328, 261, 456, 289\" href=\"http://my.uo.com/cgi-bin/guilds.pl?g=77d2a7a36171061e:29\" shape=\"rect\" target=\"_blank\">\n<area coords=\"241, 136, 16\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d4956a08b9f3194b05f1931ce91dfb633eb1a1817a7208bae3b9663948c6d36cc4c7750a27f03ad6b6f04f92cd8708a3190a7\" shape=\"circle\" target=\"_blank\">\n<area coords=\"194, 148, 13\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d49567db4fafda13b84f3a66226ceebf82ad24a95710e26c7ccfe121ffac4b41a5ca43506cd2f25b4878440cb3e39b691e987\" shape=\"circle\" target=\"_blank\">\n<area coords=\"131, 117, 13\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d495657dbe98e66269af4a71cde32cf58732a4eddf75fcfb43dc1b7111a16aa307bd8ec663916c383f4169e5746103318fcd6\" shape=\"circle\" target=\"_blank\">\n<area coords=\"126, 167, 14\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d4956a528e99bf39c71a352dc5f096e0140438aa6201d186246545c2dca72d5a4fb86af9d9eeae12c2824\" shape=\"circle\" target=\"_blank\">\n<area coords=\"193, 194, 13\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d49565c6d8ae26de5fa17785f54b10159a07ca53e01f7208f5bd07d8e1fcca04ced64bd4a6cdd84dc3bf2\" shape=\"circle\" target=\"_blank\">\n<area coords=\"282, 186, 13\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d4956f662a4157db00f2c4dede292bd7e195662ca665a2f6485b55d69b7bc42d87bd527415f4437015fb7\" shape=\"circle\" target=\"_blank\">\n<area coords=\"306, 141, 13\" href=\"http://my.uo.com/cgi-bin/my_chars.pl?52616e646f6d49566718020c58310d9cb4200c439eaf79d17934596a955c294de067aa8e486769bfa5e816a96b0a4ad6e02191de53771fb1\" shape=\"circle\" target=\"_blank\">\n</map></font></p>",
