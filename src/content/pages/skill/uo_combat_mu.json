  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo.gif\" width=\"110\"></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ana/\"><img alt=\"아나토미\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_a.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mace/\"><img alt=\"메이스\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mace.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_sw/\"><img alt=\"스워드\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sw.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_fe/\"><img alt=\"펜싱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_fe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ar/\"><img alt=\"궁수\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ar.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_wr/\"><img alt=\"레스링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_wr.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ta/\"><img alt=\"택틱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_t.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pa/\"><img alt=\"패링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_p.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_he/\"><img alt=\"힐링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_m/\"><img alt=\"메저리\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mad/\"><img alt=\"메디테이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ma.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ev/\"><img alt=\"이벨\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_e.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_re/\"><img alt=\"레지\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mu/\"><img alt=\"뮤지션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mu.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pro/\"><img alt=\"프로보케이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pro.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_peace/\"><img alt=\"피스메이킹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ent/\"><img alt=\"유혹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_en.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_steal/\"><img alt=\"스틸링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_snooping/\"><img alt=\"스누핑\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sn.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_hiding/\"><img alt=\"하이딩\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_hi.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_stealth/\"><span class=\"forg-missing\" data-original-src=\"http://www.forg.co.kr:80/skill/images/left_menu/c_st.gif\" data-recovery=\"missing\" style=\"width:110px;height:20px\">스텔스</span></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"3\" src=\"/img/posts/site/skill/images/left_menu/c_line.gif\" width=\"110\"></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;뮤지션</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp; </font>\n</p><table border=\"\" cellspacing=\"0\" width=\"600\">\n<tbody><tr>\n<td bgcolor=\"white\" class=\"top\" width=\"654\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"63\" src=\"/img/posts/site/skill/images/uocombat/bard.gif\" width=\"150\"></font></p></td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" width=\"595\"><ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>연주</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">를 할려면 \n                            우리는 어떻게 해야 하는가-_-;;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">당연히 악기가 \n                            있어야 합니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">위에 그림처럼 \n                            울온상에서는 여러 가지 악기가 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">틀린점은 악기로 \n                            연주할 때에 나오는 음악이 다르다는겁니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">자신의 취향대로 \n                            고르시는 것도 괜찮지만 그래도 뮤지션을 스킬로 잡으실 \n                            때</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">들고 나오는 \n                            악기가 제일 좋습니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이유는 다들 \n                            아실테지만 죽어서 다시 살아나도 들고 있기 때문이져</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">뮤지션은 단순히 \n                            악기를 연주하는 것만으로 스킬을 올릴수 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp; \n                            \n                            </p><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"80%\">\n<tbody><tr>\n<td width=\"108\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"57\" src=\"/img/posts/site/skill/images/uocombat/bard_1.gif\" width=\"85\"></p></td>\n<td width=\"367\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">연주라는 \n                                        개념은 울온상에서는 악기를 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">더블클릭 \n                                        하심됩니다.</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">바드와 연관되어지는 \n                            프로보와피스메이킹그리고 유혹기술은</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">해당란에서 \n                            알아보기로 하고 위에 열거되었던 스킬들의 성패는 \n                            물론 해당 스킬도 중요하지만</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">근본이 되는 \n                            뮤지션의 스킬이 제일 중요하다고 생각하심됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">상식적으로 \n                            연주를 잘 못하는데 어떻게 유혹음악이나평화음악,도발음악을 \n                            연주해</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">몬스터나 npc의 \n                            심금을 울릴수 없다는것은 다들 이해 하실겁니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>부가 스킬</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">로서 바드는 \n                            하이딩이 거의 필수적이라고 할수 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">예를 들어 \n                            닭2마리 싸움을 붙히고 재미있어 하는사람은 드물 듯이</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">아주강한던전에서 \n                            강한 몬스터대 강한몬스터</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">강한몬스터대 \n                            약한몬스터다수를 프로보해줄 때 이러한</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">몬스터는 타겟이 \n                            변하기 쉬운데 이럴 때 메리트가 있는 스킬은 하이딩입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">물론 몬스터가 \n                            1-2마리 나오는 지역은 드물고 밀집해서 있는곳이 많기</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">때문도 그이유중에 \n                            하나입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>하이딩</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">은 해당스킬에서 \n                            보실수 도 있지만</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">크게 스킬로서 \n                            하이딩과 마법으로서 하이딩과 아이템으로서의 하이딩이 \n                            있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"돋움\" size=\"2\"><b>1</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>.</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">스킬하이딩은 \n                            지속시간이 영구적이지만</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">가까운곳에서 \n                            몬스터에게 어택을 당하면 실패율이 커진고 일단 실패햇을 \n                            경우</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">스킬딜레이 \n                            11초의 단점이 있습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">일단 성공하면 \n                            영구적으로 숨을수 잇습니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"돋움\" size=\"2\"><b>2</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>.</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">마법하이딩은 \n                            일단 마법구동이 성공했을시에 100%하이딩이 된다는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">장점이 있습니다 \n                            물론 지속시간에 한계가 있기 때문에</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">그시간안에 \n                            다시 전투를 준비 하시는게 포인트입니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"돋움\" size=\"2\"><b>3</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>.</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\">아이템차지하이딩은 \n                            물론 하이딩 성공률 100%이지만</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">차지된수만큼 \n                            쓰지 못하고 몬스터나 보물사냥,낚시등에서 얻을수밖에 \n                            없다는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">단점이 잇습니다.</font>\n</p><table border=\"\" cellpadding=\"0\" cellspacing=\"0\" width=\"227\">\n<tbody><tr>\n<td width=\"197\"><p align=\"center\"><img border=\"0\" height=\"170\" src=\"/img/posts/site/skill/images/uocombat/bard_2.gif\" width=\"227\"></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>그럼</b></font><font color=\"#333333\" face=\"돋움\" size=\"2\"> 이제 바드의 \n                            마지막 딜레마인 마지막 남은 1마리의 몬스터를 어떻게</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">처리하느냐가 \n                            남았습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">물론 울온은 \n                            자유도가 높기 때문에-_-;;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">전사바드라면 \n                            무기류로 쓸수도 있다고는 하지만</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">고렙몬스터인 \n                            경우 2번 스쳐도 화면이 회색이 뜨는 경우가 다반사이기</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">때문에 근접공격스킬로 \n                            라스트를 한다는것은 권장 해드리고 싶지는 않습니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">아쳐,마법류,테이머(용)등으로 \n                            라스트를 즐기시면 됩니다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">물론 마지막남은 \n                            몬스터가 죽을 때까지 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">근처의 몬스터를 \n                            데리고와 프로보 시키셔도 됩니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">그러므로 바드를 포함한 직업의 \n                            조합에는</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">바드마사,아쳐바드,바드테이머,바드트래져등이 \n                            있습니다</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>Written By \n                        Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</p></td>\n</tr>\n</tbody></table></div>\n",
