e/skill/images/left_menu/k_mirc.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;</b></font><font color=\"black\" face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_knowhow_command/\"><font color=\"black\" face=\"돋움\" size=\"2\">울온 명령어</font></a>/<a href=\"/site/skill/uo_knowhow_command_1/\"><font color=\"black\" face=\"돋움\" size=\"2\">스킬배우기도표와지도</font></a></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"\" bordercolor=\"#CCCCCC\" bordercolordark=\"#CCCCCC\" bordercolorlight=\"#CCCCCC\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"560\">\n<tbody><tr>\n<td bgcolor=\"#F0F0F4\" colspan=\"3\" width=\"550\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/smap.gif\" data-recovery=\"missing\" height=\"400\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:550/400\" width=\"550\"></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F0F0F4\" colspan=\"3\" width=\"550\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">■ \n                            \"NPC이름 TRAIN\"을 치면 해당 NPC가 가르칠 \n                            수 있는 스킬목록이 나옵니다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">원하는 \n                            것을 선택 후 NPC가 요구하는 금액을 NPC머리위에 드래그 \n                            해주시면 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">해당스킬을 \n                            배울 수 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">■ \n                            샤드별로 아래 장소에 나오는 NPC의 훈련시키는 종류가 \n                            다를 수도 있습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">■ \n                            리콜을 하시더라도 최소한 브리튼 지도는 정신건강상 \n                            외우시는게 좋습니다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">■ \n                            몇몇스킬들은 상점이 아닌 길에서 배회하는 NPC에게서 \n                            배울 수 있습니다.</font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#F0F0F4\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>장소</b></font></p>\n</td>\n<td bgcolor=\"#F0F0F4\" width=\"173\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>명령어(영문)</b></font></p></td>\n<td bgcolor=\"#F0F0F4\" height=\"30\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>명령어(한글)</b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;시약상</font></p>\n</td>\n<td height=\"27\" width=\"173\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font face=\"돋움\" size=\"2\">train \n                            alchemy </font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            연금술 </font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;마굿간</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            animal lore</font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            동물 지식(또는, 훈련 동물) </font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;마굿간</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            animal taming</font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            길들이기</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;시약상</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">train \n                            archery</font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;&nbsp;훈련 \n                            궁술 </font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;대장간+갑옷상점</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            armslore</font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">훈련 \n                            무기감정 (또는, 훈련 무기학) &nbsp;</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">길거리</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">(Begger타이틀)</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            begging </font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            거지(또는, 훈련 구걸) </font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;대장간+갑옷상점</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            blacksmith</font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            대장장이(또는, 훈련 대장간)</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;활상점</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            bowcraft</font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            활만들기 (또는, 훈련 활)</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;집시(Npc)</font></p>\n</td>\n<td height=\"27\" width=\"173\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;train \n                            camping </font></p>\n</td>\n<td height=\"27\" width=\"264\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;훈련 \n                            캠핑 (또는, 훈련 야영)</font></p>\n</td>\n</tr>\n<tr>\n<td height=\"27\" width=\"101\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;목공소</font></p>\n</td>\n<td height=\"27\" width=\"173\"><p alig