  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_4.gif\" width=\"110\"></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hdecoration/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_house/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_hou.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_houseadd.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hoption/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_sign.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_command/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_com.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_vendor/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_vendor.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_moon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_moon.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_fame/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_f.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_runebook/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_rune.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_secret/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mw/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uosu/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_u.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mirc/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_mirc.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:110/20\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;UOAMap</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"60%\">\n<tbody><tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"357\" src=\"/img/posts/site/skill/images/uotip/uoam/uoam_info.gif\" usemap=\"#ImageMap1\" width=\"393\"></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<ul>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">먼저 \n                    본 설명서는 UOAM 7.0 을 기본으로 제작되었음을 미리 밝히며 \n                    또한 오리진사에서 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사용이 \n                    허가된 서드 파티 프로그램으로 사용함으로써 플레이어에게 \n                    오는 &nbsp;불이익은 전혀 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">없음을 \n                    알아두길 바란다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>대체적인 \n                    기능</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">자신의 \n                    위치 표시</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">자신과 \n                    동료의 링크 기능을 이용한 유저 위치 표시</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">보물위치 \n                    표시 등이 있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">또 \n                    최근에 8타일 버그가 소개되면서 UOAM 자체적으로 타일수를 \n                    표시해주는 기능을 자</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">주 \n                    사용하기도 한다. 이는 후에 설명하기로 하겠다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>UOAM \n                    설치,설정</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">받으실분은 \n                    여기를 </font><a href=\"http://uo.stratics.com/uoam/uoam.shtml#downloads\" target=\"_blank\"><b><font color=\"fuchsia\" face=\"돋움\" size=\"2\">Click</font></b></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">바탕화면이나 \n                    기타 다운로드 디렉토리에서 다운받은 파일을 찾아 실행을 한다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">여기서 \n                    무슨 체크표시를 하는 창이 뜰것인데 모두 체크 하기를 권한다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">모두 \n                    체크를 하게 되면 레어 아템이나 보물이 묻힌곳 그리고 새로나온 \n                    &nbsp;대륙의 지도또한 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">전부 \n                    받을수 있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Wrritten \n                    By </b></font><font color=\"#666666\" face=\"돋움\" size=\"2\">HolyPink</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Pink \n                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;바드락피커</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Pink \n                    W &nbsp;&nbsp;&nbsp;&nbsp;바바리언 (도끼전사)</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">HolyPink \n                    &nbsp;&nbsp;&nbsp;테이머</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">End \n                    Fisher &nbsp;낚시꾼</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">End \n                    M &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;일꾼</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n</ul>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><map name=\"ImageMap1\">\n<area coords=\"306, 26, 360, 42\" href=\"/site/skill/uo_knowhow_uoam/\" shape=\"rect\">\n<area coords=\"212, 27, 274, 40\" href=\"/site/skill/uo_knowhow_ass/\" shape=\"rect\">\n<area coords=\"116, 28, 171, 41\" href=\"/site/skill/uo_knowhow_files/\" shape=\"rect\">\n<area coords=\"28, 27, 82, 41\" href=\"/site/skill/uo_knowhow_mark/\" shape=\"rect\">\n<area coords=\"23, 11, 71, 22\" href=\"/site/skill/uo_knowhow_place/\" shape=\"rect\">\n<area coords=\"97, 9, 138, 22\" href=\"/site/skill/uo_knowhow_filter/\" shape=\"rect\">\n<area coords=\"173, 9, 223, 22\" href=\"https://web.archive.org/web/20010621213228/http://forg.co.kr/skill/uo_knowhow_player.htm\" shape=\"rect\" target=\"_blank\">\n<area coords=\"252, 11, 289, 24\" href=\"/site/skill/uo_knowhow_map/\" shape=\"rect\">\n<area coords=\"323, 10, 360, 22\" href=\"/site/skill/uo_knowhow_link/\" shape=\"rect\">\n</map></font></p>",
