  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\">Catalog*******</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_vet_mu/\" title=\"뮤지션[음악연주]\">Musicianship+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_pro/\" title=\"프로보케이션[전투도발]\">Provocation</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_peace/\" title=\"피스메이킹[평화연주]\">Peacemaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_ent/\" title=\"유혹\">Enticement</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_anit/\" title=\"애니멀테이밍[길들이기]\">Animal Taming+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_anil/\" title=\"애니멀로어[동물지식]\">Animal Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_vet/\" title=\"베너터리[수의학]\">Veterinary</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_herding/\" title=\"허딩[목동술]\">Herding</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_carto/\" title=\"카토그라피[지도제작술]\">Cartography+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_lock/\" title=\"락픽킹[자물쇠열기]\">Lockpicking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_remove/\" title=\"리무브트랩[함정해제]\">Remove Trap</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_detect/\" title=\"디텍트히든[은폐탐지]\">Detect Hidden</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_ss/\" title=\"스피리트스피킹[심령술]\">Sprit Speaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_camping/\" title=\"캠핑[야영]\">Camping</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_tracking/\" title=\"트랙킹[추적하기]\">Tracking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_forensic/\" title=\"포렌식[해부학]\">Forensic EV.</a><br><br>\n</div><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/vet_logo.gif\" data-recovery=\"missing\" height=\"17\" src=\"/img/placeholder/missing.svg\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"1083\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td>\n<p>&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"30\" src=\"/img/posts/site/skill/images/left_menu/alpha/a.gif\" width=\"30\">NIMAL \n                            TAMING - 1&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/1.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"19\">\n</b></span></font><a href=\"/site/skill/uo_vet_anit/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/taming_1.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"80\"></font></b></span></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/alpha/2.gif\" width=\"19\"></b></span></font><a href=\"/site/skill/uo_vet_anit_1/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/taming_2.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"50\"></font></b></span></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>\n<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"20\"></b></span></font><a href=\"/site/skill/uo_vet_anit_2/\"><span style=\"font-size:9pt;\"><b><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/taming_3.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"90\"></font></b></span></a></p>\n</td>\n</tr>\n<tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"560\">\n<tbody><tr>\n<td colspan=\"2\" height=\"30\" width=\"554\">\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>■ \n                                        동물길들이기<img align=\"absmiddle\" border=\"0\" height=\"21\" src=\"/img/posts/site/skill/images/rare/bowlblood.gif\" width=\"26\"></b></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"554\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_8.gif\" data-recovery=\"missing\" height=\"150\" src=\"/img/placeholder/missing.svg\" width=\"300\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"554\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">동물을 \n\n                            테임할 때는 테임스킬을 일단 구동 하시고 타겟이 뜨면 \n\n                            </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">원하는 \n\n                            동물을 찍어 주시면 됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">테임중에 \n\n                            공격적인 동물은 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"</span><b><span style=\"font-size:9pt;\">당신은 그동물을 화나게 하는 것 같습니다</span></b><span style=\"font-size:9pt;\">\"라는 \n\n                            메시지가 보입니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">무시하시고 \n\n                            계속 시도 하시면 됩니다. 이때는 스킬딜레이가 거의 \n\n                            없으니</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">계속 \n\n                            테임을 시도 하시면 됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n\n                            드래곤의 블레스(아머와 레지에 관계없이 약 40정도의 \n\n                            데미지,</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">드레이크는약 \n\n                            20정도의데미지를 줍니다)를 조심하시면 됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">테이머는 \n\n                            마사테이머,바드테이머,전사테이머등 많은 스킬을</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">조합할 \n\n                            수 있지만 일단은 애니멀로어,메저리,메디는 기본적으로</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">추가되야 \n\n                            한다는 사실을 명심하시길 바랍니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">p.s \n\n                            : 예전에는 로어스킬까지 제외시키고 오로지 테이밍만 \n\n                            키우는</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">분들이 \n\n                            많았습니다. 이것은 동물을 다른분에게 팔아서 돈을 \n\n                            버는 분들이었지만</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">패치이후에는 \n\n                            마굿간의 맡길수있는 수패치와 리스폰의 수등으로</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">메리트가 \n\n                            없어졌습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"222\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_4.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></span></font></p>\n</td>\n<td width=\"328\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">좌측에 \n\n                            그림은 여러분도 잘아시는</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">디싯눈섬입니다. \n\n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">처음 \n\n                            하시는분부터 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">마스터수준이상까지도 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">가능한 \n\n                            동물이 모여 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">이곳말고도 \n\n                            T2A지역에도 눈섬이 있어서</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">화이트울프가 \n\n                            있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">(UO.Tip란 \n\n                            레어란에 아이스봉관련참조)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">이곳말고도 \n\n                            처음하시는분들은 베스퍼동쪽숲이나 문글로우 남쪽 \n\n                            숲등에서</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">기본적으로 \n\n                            테임이 가능한 동물을</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">시도 \n\n                            하시면 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"222\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_1.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></span></font></p>\n</td>\n<td width=\"328\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\">\n<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">젤롬마을에 젤롬 목장이 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">황소가 \n\n                            몇마리 젠이되니 이곳도</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">놓칠 \n\n                            수 없는 지역입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"222\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_3.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></span></font></p>\n</td>\n<td width=\"328\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">약 \n\n                            90이상부터 주로 가게 되는 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">델루시아 \n\n                            목장입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">황소로 \n\n                            충분히 100까지 올릴 수 있는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">최강의 \n\n                            동물입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">황소가 \n\n                            약 4-5마리정도 리젠이 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n\n                            베스퍼 동쪽 숲에서도 황소를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">보실수 \n\n                            있습니다..</span></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"30\" width=\"554\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">■ </span><b><span style=\"font-size:9pt;\">공격적인 \n\n                            동물길들이는 방법</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"237\" width=\"222\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_7.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></span></font></p>\n</td>\n<td height=\"237\" width=\"328\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">테이밍은 \n\n                            원하는 동물이나 몬스터를 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">자신의명령을 듣게 하는 \n\n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">매력적인 스킬입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">어렵다고 \n\n                            생각하시는분들은 스킬을 신경쓰지 마시고 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">꾸준히 \n\n                            그리고 천천히 올리시는 것이 가장 좋은 방법입니다..</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">좌측사진은 \n\n                            테임의 기본적인 워킹테임</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">이라는 \n\n                            것으로 걸어다니면서 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">드래곤을 \n\n                            꼬시는 방법입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n\n                            기본적이지만 가장 난이도가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">있는 \n\n                            테임 방법입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"222\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_9.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></span></font></p>\n</td>\n<td width=\"328\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">패럴필드를 \n\n                            깔고 용을 유인한 후</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">테임을 \n\n                            시도 하는 방법입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">워킹테임보다 \n\n                            비교적 안전하게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">1-2번정도 \n\n                            테임시도를 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">하실수 \n\n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">또한 5써클 패럴을 이용하여</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">테임을 할 수도 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"222\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uojobs/animal/tame_10.gif\" data-recovery=\"missing\" height=\"250\" src=\"/img/placeholder/missing.svg\" width=\"250\"></span></font></p>\n</td>\n<td width=\"328\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">천연의 \n\n                            장소를 이용하여</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">안전하게 \n\n                            용을 유인하는 방법입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">3써클의 \n\n                            텔레포트마법을 이용하여</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">건너편으로 \n\n                            이동 테임하는 것으로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">울온에서는 \n\n                            여러곳에 \n\n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">블록 \n\n                            장소가 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">일단 \n\n                            공격적인 동물은</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">테임이 \n\n                            성공한후 먹이를 주고</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">바로 \n\n                            하이딩을 하시고 그레이가 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">풀릴 \n