  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\" title=\"원래 표기: Catalog*******\">Catalog</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_vet_mu/\" title=\"뮤지션[음악연주]\">Musicianship+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_pro/\" title=\"프로보케이션[전투도발]\">Provocation</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_peace/\" title=\"피스메이킹[평화연주]\">Peacemaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_ent/\" title=\"유혹\">Enticement</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_anit/\" title=\"애니멀테이밍[길들이기]\">Animal Taming+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_anil/\" title=\"애니멀로어[동물지식]\">Animal Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_vet/\" title=\"베너터리[수의학]\">Veterinary</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_herding/\" title=\"허딩[목동술]\">Herding</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_carto/\" title=\"카토그라피[지도제작술]\">Cartography+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_lock/\" title=\"락픽킹[자물쇠열기]\">Lockpicking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_remove/\" title=\"리무브트랩[함정해제]\">Remove Trap</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_detect/\" title=\"디텍트히든[은폐탐지]\">Detect Hidden</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_vet_ss/\" title=\"스피리트스피킹[심령술]\">Sprit Speaking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_camping/\" title=\"캠핑[야영]\">Camping</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_tracking/\" title=\"트랙킹[추적하기]\">Tracking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_vet_forensic/\" title=\"포렌식[해부학]\">Forensic EV.</a><br><br>\n</div><img border=\"0\" height=\"17\" src=\"/img/posts/site/skill/images/left_menu/vet_logo.gif\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td height=\"363\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td>\n<p><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/m.gif\" data-recovery=\"missing\" height=\"30\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/30\" width=\"30\">USICIANSHIP</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"530\">\n<tbody><tr>\n<td class=\"top\" width=\"654\"> <p align=\"left\" style=\"margin-top:0px; margin-bottom:0px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">■ \n                                        음악연주<img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/rare/u_16.gif\" data-recovery=\"missing\" height=\"26\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/26\" width=\"30\"></span></font></b></p>\n</td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" width=\"595\"> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">연주를</span></b><span style=\"font-size:9pt;\"> 하실려면 \n                            우리는 어떻게 해야 하는가?</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">당연히 악기가 \n                            있어야 합니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">위에 그림처럼 \n                            울온상에서는 여러 가지 악기가 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">틀린점은 악기로 \n                            연주할 때에 나오는 음악이 다르다는겁니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">자신의 취향대로 \n                            고르시는 것도 괜찮지만 그래도 뮤지션을 스킬로 잡으실 \n                            때</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">들고 나오는 \n                            악기가 제일 좋습니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">이유는 다들 \n                            아실테지만 죽어서 다시 살아나도 들고 있기 때문이져</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">뮤지션은 단순히 \n                            악기를 연주하는 것만으로 스킬을 올릴수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font>\n</p><div align=\"left\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\" width=\"80%\">\n<tbody><tr>\n<td width=\"63\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"57\" src=\"/img/posts/site/skill/images/uocombat/bard_1.gif\" width=\"85\"></span></font></p></td>\n<td width=\"332\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">연주라는 \n                                        개념은 울온상에서는 악기를 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">더블클릭 \n                                        하시면 됩니다.</span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">악기에따라 \n                                                        다른 음이 나오게 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</div>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">바드와 연관되어지는 \n                            프로보와피스메이킹그리고 유혹기술은</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">해당란에서 \n                            알아보기로 하고 위에 열거되었던 스킬들의 성패는 \n                            물론 해당 스킬도 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">중요하지만 근본이 되는 \n                            뮤지션의 스킬이 제일 중요하다고 생각하심됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">상식적으로 \n                            연주를 잘 못하는데 어떻게 유혹음악이나 평화음악,도발음악을 \n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">연주해 몬스터나 npc의 \n                            심금을 울릴수 없다는것은 다들 이해 하실것입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">부가 스킬로서</span></b><span style=\"font-size:9pt;\"> 바드는 \n                            하이딩이 거의 필수적이라고 할수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">예를 들어 \n                            닭2마리 싸움을 붙히고 재미있어 하는사람은 드물 듯이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">아주강한던전에서 \n                            강한 몬스터대 강한몬스터</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">강한몬스터대 \n                            약한몬스터다수를 프로보해줄 때 이러한</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">몬스터는 타겟이 \n                            변하기 쉬운데 이럴 때 메리트가 있는 스킬은 하이딩입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 몬스터가 \n                            1-2마리 나오는 지역은 드물고 밀집해서 있는곳이 많기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">때문도 그이유중에 \n                            하나입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">하이딩은</span></b><span style=\"font-size:9pt;\"> 해당스킬에서 \n                            보실수 도 있지만</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">크게 스킬로서 \n                            하이딩과 마법으로서 하이딩과 아이템으로서의 하이딩이 \n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"fuchsia\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">1</span></b></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">.</span></b><span style=\"font-size:9pt;\">스킬하이딩은 \n                            지속시간이 영구적이지만</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">가까운곳에서 \n                            몬스터에게 어택을 당하면 실패율이 커지고 일단 실패했을 \n                            경우</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬딜레이 \n                            11초의 단점이 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">일단 성공하면 \n                            영구적으로 숨을수 있습니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"fuchsia\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">2</span></b></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">.</span></b><span style=\"font-size:9pt;\">마법하이딩은 \n                            일단 마법구동이 성공했을시에 100%하이딩이 된다는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">장점이 있습니다 \n                            물론 지속시간에 한계가 있기 때문에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">그시간안에 \n                            다시 전투를 준비 하시는게 포인트입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"fuchsia\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">3</span></b></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">.</span></b><span style=\"font-size:9pt;\">아이템차지하이딩은 \n                            물론 하이딩 성공률 100%이지만</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">차지된수만큼만 \n                            쓰고 몬스터나 보물사냥,낚시등에서 얻을 수 밖에 \n                            없다는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">단점이 있습니다.</span></font></p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"170\" src=\"/img/posts/site/skill/images/uocombat/bard_2.gif\" width=\"227\"></span></font> </p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">마지막으로</span></b><span style=\"font-size:9pt;\"> 이제 바드의 \n                            딜레마인 마지막 남은 1마리의 몬스터를 어떻게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">처리하느냐가 \n                            남았습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 울온은 \n                            자유도가 높기 때문에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">전사바드라면 \n                            무기류로 쓸수도 있다고는 하지만</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">고렙몬스터인 \n                            경우 2번 스쳐도 화면이 회색이 뜨는 경우가 많기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">때문에 근접공격스킬로 \n                            라스트를 한다는것은 권장 해드리고 싶지는 않습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">아쳐,마법류,테이머(용)등으로 \n                            라스트를 즐기시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 마지막남은 \n                            몬스터가 죽을 때까지 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">근처의 몬스터를 \n                            데리고와 프로보 시키셔도 됩니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">그러므로 바드를 포함한 직업의 \n                            조합에는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">바드마사,아쳐바드,바드테이머,바드트래져등이 \n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">참고로 스폰이 빠른 던전지역에서는 라스트를 \n                            고려하는 것은 필요 없게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">계속 몬스터가 빠른 속도로 스폰이 되기 때문입니다</span></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"#top\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></span></font></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
