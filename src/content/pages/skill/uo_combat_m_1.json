  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo.gif\" width=\"110\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ana/\"><img alt=\"아나토미\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_a.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mace/\"><img alt=\"메이스\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mace.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_sw/\"><img alt=\"스워드\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sw.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_fe/\"><img alt=\"펜싱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_fe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ar/\"><img alt=\"궁수\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ar.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_wr/\"><img alt=\"레스링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_wr.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ta/\"><img alt=\"택틱\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_t.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pa/\"><img alt=\"패링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_p.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_he/\"><img alt=\"힐링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_m/\"><img alt=\"메저리\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mad/\"><img alt=\"메디테이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_ma.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ev/\"><img alt=\"이벨\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_e.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_re/\"><img alt=\"레지\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_mu/\"><img alt=\"뮤지션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_mu.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_pro/\"><img alt=\"프로보케이션\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pro.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_peace/\"><img alt=\"피스메이킹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_pe.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_ent/\"><img alt=\"유혹\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_en.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_steal/\"><img alt=\"스틸링\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_snooping/\"><img alt=\"스누핑\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_sn.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_hiding/\"><img alt=\"하이딩\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/c_hi.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_combat_stealth/\"><span class=\"forg-missing\" data-original-src=\"http://www.forg.co.kr:80/skill/images/left_menu/c_st.gif\" data-recovery=\"missing\" style=\"width:110px;height:20px\">스텔스</span></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"3\" src=\"/img/posts/site/skill/images/left_menu/c_line.gif\" width=\"110\"></p></td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>&nbsp;&nbsp;</b></font><a href=\"/site/skill/uo_combat_m/\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>8서클</b></font></a><font color=\"#333333\" face=\"돋움\" size=\"2\"><b> / </b></font><a href=\"/site/skill/uo_combat_m_1/\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>마법책만들기</b></font></a></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>&nbsp;</b></font>\n</p><table border=\"\" cellspacing=\"0\" width=\"600\">\n<tbody><tr>\n<td bgcolor=\"white\" class=\"top\" width=\"654\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/8c/spell.gif\" data-recovery=\"missing\" height=\"149\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:220/149\" width=\"220\"></font></p></td>\n</tr>\n<tr>\n<td align=\"right\" class=\"heading\" height=\"286\" width=\"595\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">울온에서는 마법으로 \n                        여러 가지 일들을 할 수 있습니다..</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">예로 리콜마법으로 \n                        몇시간이나 걸리는 대륙을 횡단하지 않고서도 원하는 지점으로</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이동 할수도 있고 \n                        게이트 마법으로 친구들과 같이 이동하실수도 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">그러므로 전사든 \n                        마사든 어느정도의 마법은 익히셔야 울온에서</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">살아남을 수 있을겁니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">위에 마법책은 어질이라는 스크롤을 \n                        한 개만 넣었을 때 사진입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">1.약초상에서 마법책과 스크롤을 \n                        사셔셔 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마법책에다가 스크롤을 넣으시면 \n                        됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">2.가운데 있는 사진은 던전에서 \n                        락픽스킬로 상자를딴후 </font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">스크롤을 얻을 수 있습니다.(8써클은 \n                        최상급 던전의 상자에서만 나옵니다)</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">3.물론 맨오른쪽 사진과같이 몬스터를 \n                        처치한후에도스크롤을 얻을수 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/8c/spell_menu.gif\" data-recovery=\"missing\" height=\"142\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:170/142\" width=\"170\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/8c/spell_chest.gif\" data-recovery=\"missing\" height=\"142\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:170/142\" width=\"170\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/8c/spell_cor.gif\" data-recovery=\"missing\" height=\"142\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:170/142\" width=\"170\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이러한 원하는 \n                        해당 스크롤이 찬 마법책이 준비되셨다면</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">다음에 준비하실 \n                        것이 자신의 능력 즉, 메저리+마나의수치입니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">첫째 조건은 해당 \n                        마법의 마나의 수치만큼은 있어야 마법이 작동하는 것을 \n                        보실수</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">있습니다.다음은 \n                        메저리의 수치로 성공확률로 동작하게 됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이때 중요한 것은 \n                        마법을 구동하실 때 소모되는 마나와 약초가 필요시됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr:80/skill/images/8c/reagents.gif\" data-recovery=\"missing\" height=\"198\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:128/198\" width=\"128\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">울온상에서는 위그림처럼 \n                        8가지 약초가 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">각각의 마법은 \n                        이러한 약초의 조합으로 발동 한다는 것을 이해 하시면됩니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">이러한 약초도 \n                        약초상에서 사실 수 있습니다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">사람들은 Black \n                        Perl(흑진주)을 \"Bp\"나 \"펄\"이라는 \n                        약자로 말한다는 것을 참조 하시길.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\"><b>Written By \n                        Forg</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n",
