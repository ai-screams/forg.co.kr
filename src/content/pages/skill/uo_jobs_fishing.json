  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" background=\"/img/posts/site/skill/images/left_menu/memo_t.gif\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\" title=\"원래 표기: Catalog*******\">Catalog</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"/site/skill/uo_jobs_alchemy/\" title=\"연금술[포션제작]\">Alchemy+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_poisoning/\" title=\"포이즈닝[독바르기]\">Poisoning</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_taste/\" title=\"맛감정\">Taste ID</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_jobs_blacksmith/\" title=\"스미스[대장장이]\">Black Smith+</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_mining/\" title=\"광부[광물캐기]\">Mining</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_armslore/\" title=\"암즈로어[장비지식]\">Arms Lore</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_item/\" title=\"아이템ID[아이템감정]\">Item ID</a><br>\n                        ------------\n\t\t\t<a class=\"com\" href=\"/site/skill/uo_jobs_car/\" title=\"카펜터리[목공술]\">Carpentry</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_lumber/\" title=\"럼버잭[나무하기]\">Lumberjacking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_thinker/\" title=\"팅거링[기계공기술]\">Tinkering</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_bow/\" title=\"보우크래프트[활제작술]\">Bowcraft</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_fishing/\" title=\"피싱[낚시]\">Fishing</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_ins/\" title=\"인스크립션[기록술]\">Inscription</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_tailor/\" title=\"재단사[재봉술]\">Tailor</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_cooking/\" title=\"쿠킹[요리]\">Cooking</a><br>\n<a class=\"com\" href=\"/site/skill/uo_jobs_begging/\" title=\"베깅[구걸]\">Begging</a><br><br>\n</div><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/jobs_logo.gif\" data-recovery=\"missing\" height=\"17\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:200/17\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill/images/left_menu/memo_m.gif\" height=\"39\" width=\"630\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#666666\" face=\"돋움\" size=\"2\">&nbsp;</font>&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background.gif\" height=\"30\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/alpha/f.gif\" data-recovery=\"missing\" height=\"30\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/30\" width=\"30\">ISIHNG</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_1.gif\" height=\"22\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;&nbsp;</p>\n<table align=\"center\" border=\"\" bordercolor=\"#A0965A\" bordercolordark=\"#999933\" bordercolorlight=\"#A0965A\" cellspacing=\"0\" height=\"28\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_2.gif\" class=\"top\" height=\"30\" width=\"550\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">■ &nbsp;낚시</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td class=\"top\" height=\"107\" width=\"550\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img align=\"absmiddle\" border=\"0\" height=\"120\" src=\"/img/posts/site/skill/images/uojobs/fish/logo.gif\" width=\"200\"></span></font></p></td>\n</tr>\n<tr>\n<td class=\"top\" height=\"40\" width=\"550\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">낚시</span></b><span style=\"font-size:9pt;\">는 \n                레어급아이템을 얻을 수 있다는 큰장점이 있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">우선 \n                스킬별로 무엇을 낚을 수 있는지 알아봅시</span></font><font color=\"#666666\" face=\"Verdana\"><span style=\"font-size:9pt;\">다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#666666\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"\" bordercolor=\"#A0965A\" bordercolordark=\"#999933\" bordercolorlight=\"#A0965A\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_2.gif\" colspan=\"2\" height=\"30\" width=\"546\">\n<p><font color=\"#666666\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;</span></b></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">스킬별 \n                            아이템</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"28\" src=\"/img/posts/site/skill/images/uojobs/fish/boots.gif\" width=\"18\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill/images/uojobs/fish/sandals.gif\" width=\"20\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill/images/uojobs/fish/shoes.gif\" width=\"19\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill/images/uojobs/fish/thighboots.gif\" width=\"26\"></span></font></p></td>\n<td width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚시 스킬 전체를 통틀어 계속 나오는 신발입니다.</span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">해안가 근처에서는 더 빈번하게 나옵니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_brown.gif\" width=\"40\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_green.gif\" width=\"41\"><img border=\"0\" height=\"40\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_blue.gif\" width=\"38\"><img border=\"0\" height=\"40\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_yellow.gif\" width=\"41\"></span></font></p>\n</td>\n<td width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">주로 \n                            낚아지는 고기입니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            이것도 낚시 스킬 전체를 통해 계속 나오게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">단검을 \n                            이용하여 고기를짤라</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">불에 \n                            굽게 되면 스테이크가됩니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">기본적인 \n                            쿠킹스킬만으로도 몇 번의실패만</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">허용한다면 \n                            맛잇게 구울 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_highly_peculiar.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_prize.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_truly_rare.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill/images/uojobs/fish/fish_wondrous.gif\" width=\"30\"></span></font></p>\n</td>\n<td width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            80부터 낚아지는 고기로 더블클릭으로 먹게되면</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">고기마다 \n                            각종 스탯이 오르게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"39\" src=\"/img/posts/site/skill/images/uojobs/fish/bigfish.gif\" width=\"41\"></span></font></p>\n</td>\n<td width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            80부터 낚아지는 고기로낚게되면</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">바로 \n                            발밑으로 떨어지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">박제의재료로도 \n                            널리 쓰입니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><a href=\"/site/skill/uo_knowhow_addon_1/\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">UO.Tip</span></b></font></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">란에 \n                            하우스애드온을 참조하시길.</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill/images/uojobs/fish/map.gif\" width=\"32\"></span></font></p></td>\n<td width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">90부터 건질 수 있으며 1렙지도입니다</span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물뱀을 처리하면 랜덤하게 나옵니다</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill/images/uojobs/fish/rolled_map.gif\" width=\"20\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill/images/uojobs/fish/bottle_of_ale.gif\" width=\"9\"></span></font></p></td>\n<td width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">100부터 건질 수 있으며 병을 2번클릭 하면 맨좌측 \n            스크롤 그림이 됩니다,</span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스크롤그림을 2번클릭하면 좌표가 나옵니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬이 지엠일때 낚인 물뱀을  처리하면 랜덤하게 \n                            나옵니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td height=\"51\" width=\"122\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill/images/uojobs/fish/specialnet.gif\" width=\"44\"></span></font></p></td>\n<td height=\"51\" width=\"422\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물뱀을 처리하면 랜덤하게 나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">[그물이지만 장식용으로 많이 쓰입니다]</span></font></p></td>\n</tr>\n<tr>\n<td height=\"51\" width=\"122\">\n<p align=\"center\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"47\" src=\"/img/posts/site/skill/images/uojobs/fish/metalchest.gif\" width=\"38\"></span></font></p>\n</td>\n<td height=\"51\" width=\"422\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">메탈체스트로 \n                            SOS병을 건졋을 때 랜덤으로나옵니다. 보통은 나무상자가 \n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">나옵니다. 물론 상자안에는아이템이 가득 차있습니다</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;위에서 보시다시피 \n                </span><b><span style=\"font-size:9pt;\">1렙지도,그물,sos병</span></b><span style=\"font-size:9pt;\">은 셔펜이라는 물뱀을 주기고</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">룻을 \n                해야만 합니다.물론 랜덤이므로 물뱀을 죽여도 안나올 때가 많습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">일반적으로 \n                물뱀을 낚을대 물뱀이 무엇을 가지고 나오는지 좌측에 메시지를</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">보시면 \n                알 수 있습니다 net이라는 단어가 있으면 그물,</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">bottle이라는단어가 \n                있으면 sos병이런 식입니다..</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#A0965A\" bordercolordark=\"#999933\" bordercolorlight=\"#A0965A\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"549\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_2.gif\" colspan=\"2\" height=\"30\" width=\"545\">\n<p><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;그물던지기</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/net.gif\" width=\"150\"></span></font></p>\n</td>\n<td width=\"352\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">얻은 \n                            그물을 더블클릭하고 물을 찍으면 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">몇십초후에 \n                            물뱀2마리,크라켄1마리가</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">나옵니다,물론 \n                            랜덤이므로 워터,물뱀섞여서 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">나올 수도 있습니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">나오는 \n                            마리수는 그물하나당 (1-3마리입니다)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">포인트를 \n                            되도록 잘잡으셔셔 던지시길.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">바다깊은곳이 \n                            더 크라켄이 잘나오는 것 같습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">크라켄은 \n                            sos병을 가지고 나올 확률이 큽니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            낚시 스킬 없이도 그물을 던질 수 있으니</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">되도록 \n                            전투캐릭을 이용하시길 바랍니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_2.gif\" colspan=\"2\" height=\"30\" width=\"545\">\n<p><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;SOS병 좌표찿기</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"191\">\n<p align=\"center\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/map_sos.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"352\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">메시지를 클릭하면 좌측사진처럼 \n                            좌표가 나옵니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">1</span></b><span style=\"font-size:9pt;\">.UOAM을 \n                            사용하시면 더욱 편리하게 찿으실수 있습니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">UO.TIP란에 \n                            </span></font><a href=\"/site/skill/uo_knowhow_place/\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">UOAM</span></b></font></a><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                            참조하시길.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">2</span></b><span style=\"font-size:9pt;\">.일반지도를 \n                            보고 찾는방법은 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">일단 \n                            지도를 \n                            받으실려면 여기를 </span></font><a href=\"https://web.archive.org/web/20020523121122/http://forg.co.kr:80/skill/fishmap.gif\" target=\"_blank\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Click</span></b></font></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">:::예제:::</span></b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">지도를 보시면 \n                            6시방향제일하단에 \n                            히스로스섬좌측에</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">문어그림이 \n                            보이실겁니다.그쪽 좌표를 알아보겠습니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">좌측에 \n                            빨간막대 North즉 N135-180사이</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">우측상단 \n                            빨간막대 EAST 즉E135-180사이</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">라는 \n                            것을 알 수 있습니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">근처의 \n                            지리를 아셨으면 그좌표근처로 가셔셔 좌표계로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">조금씩 \n                            다가가시면됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">SOS병또한 \n                            낚시 스킬이 필요없습니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">하지만 \n                            높은 스킬일수록 찾는 지역이 넓어집니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_2.gif\" colspan=\"2\" height=\"30\" width=\"545\">\n<p><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">&nbsp;스킬별 낚시 \n                            올리기</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"191\">\n<p align=\"center\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/fish/map_skill.gif\" width=\"200\"></span></font></p>\n</td>\n<td width=\"352\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">좌측사진에서 \n                            빨간선라인에서 육지쪽으로가는 지역이</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬이 \n                            낮은 분들이 낚시를 해야할 선입니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬이 \n                            오를수록(</span><b><span style=\"font-size:9pt;\">약 \n                            65이상</span></b><span style=\"font-size:9pt;\">) 바다쪽으로 가시면됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">초기에는 \n                            빨간선라인즉 해안가에서 바다쪽으로 왕복항해 &nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">하시면서 \n                            고기를 잡으셔도 됩니다</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill/images/left_menu/alpha/alpha_background_2.gif\" colspan=\"2\" height=\"30\" width=\"543\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">기 \n                            타</span></b></font></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"543\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/box.gif\" width=\"250\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">SOS병</span></b><span style=\"font-size:9pt;\">을 \n                많이 모아 한꺼번에 찾는것이 시간이 덜 걸린다는점을...</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">1개의 \n                sos병이 1000-3000Gp까지 주며</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚을 \n                때는 상자가 바로 나오거나 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">초상화,해골뼈,돌,지구본,시계,조개등이 먼저 낚일 수 있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"100\" src=\"/img/posts/site/skill/images/uojobs/fish/gift.gif\" width=\"300\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">위에 \n                열거된 아이템이 나오면 그포인트가 맞는 포인트이므로</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">계속 \n                그 자리에서 낚으시길</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">최후에는 \n                상자가 통째로 건져 올려집니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"150\" src=\"/img/posts/site/skill/images/uojobs/fish/monster.gif\" width=\"250\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">마지막</span></b><span style=\"font-size:9pt;\">으로 \n                낚시는 물뱀을 죽여서 1렙지도,SOS병,그물을 얻어야 함으로</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">근접 \n                공격의 전투스킬보다는 원거리 공격의 전투스킬을 권장합니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">원거리공격의 \n                전투스킬은 메절,이벨,메디의 조합과</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">아쳐,택틱의조합이 \n                있습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">어떤 \n                조합을 하시든지 마지막결정은 여러분이~</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font><a href=\"#top\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/skill/images/left_menu/top_up.gif\" width=\"50\"></a></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill/images/left_menu/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/b_logo.gif\" width=\"100\">&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
