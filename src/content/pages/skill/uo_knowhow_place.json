  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"256\" rowspan=\"4\" valign=\"top\" width=\"115\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img border=\"0\" height=\"90\" src=\"/img/posts/site/skill/images/left_menu/l_bar_logo_4.gif\" width=\"110\"></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hdecoration/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_h.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_house/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_hou.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_addon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_houseadd.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_hoption/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_sign.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_command/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_com.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_vendor/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_vendor.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_moon/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_moon.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_rare/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_r.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_fame/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_f.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_runebook/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_rune.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_secret/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_s.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mw/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_m.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uosu/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_u.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_mirc/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_mirc.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoa/\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/left_menu/k_uoa.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/skill/uo_knowhow_uoam/\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill/images/left_menu/k_uoam.gif\" width=\"110\"></a></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" height=\"5\" src=\"/img/posts/site/skill/images/left_menu/k_line.gif\" width=\"110\"></font></p>\n</td>\n<td height=\"10\" width=\"627\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p></td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>&nbsp;UOAM_PLACES</b></font></p></td>\n</tr>\n<tr>\n<td height=\"39\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"gray\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"60%\">\n<tbody><tr>\n<td> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/uoam_place.gif\" data-recovery=\"missing\" height=\"357\" src=\"/img/placeholder/missing.svg\" usemap=\"#ImageMap1\" width=\"393\"></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Labels</b> : 각 상점명이나 보물의 위치 레어등 시작할 때 \n                    로딩된 레이블을 </font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">마킹해준다.</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_1.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing.svg\" width=\"226\"></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Hide \n                    Labels</b> : 레이블을 감춘다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Drop \n                    or Pick Up Marker : 현재 위치에 하얀색의 포인트가 생기고 \n                    &nbsp;여기를 기준으로 움</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">직이면 \n                    선이 생긴다. &nbsp;*8타일을 사용할 때 바로 이 기능을 사용하는 \n                    것이다. &nbsp;UOAM 화</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">면 \n                    오른쪽 하단에 타일수가 변화하는 &nbsp;것을 볼수 있을 것이다. \n                    &nbsp;이 &nbsp;기능을 잘 활용해서 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">사용하길 \n                    바란다. &nbsp;한번더 선택하게 되면 사라진다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*8타일 \n                    : 배를 타거나 육지에서 이동제한이 적용되는 스킬을 &nbsp;올릴 \n                    경우 어느 한 장소에</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">서 \n                    스킬이 상승됐다고 가정하자. &nbsp;바로 그 자리에서 멈춰선다. \n                    &nbsp;UOAM &nbsp;이나 ART + R </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">키를 \n                    눌러 나오는 지도에서 N 방향으로 표시된 즉 북쪽방향으로 8번만 \n                    움직여라. &nbsp;&nbsp;육지</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일 \n                    경우는 마우스 오른쪽 버튼을 탁탁탁... &nbsp;요렇게 8번, \n                    바다일경우는 One Forward를 8</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">번 \n                    또는 앞서 설명한 타일수 &nbsp;계산으로 8타일을 북쪽으로 \n                    이동한 &nbsp;다음 정지한다. &nbsp;같은 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">기술을 \n                    한번도 그장소에서 반복한다. &nbsp;스킬의 변화가 있다면 &nbsp;다시 \n                    북쪽으로 8타일을 이</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동 \n                    다시 반복 이런식으로 하는 것이 바로 8타일인 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">또한 \n                    스킬이 낮을 경우는 한 자리에서 여러번 사용해도 몇번정도 \n                    올라가지만 &nbsp;높은 스킬</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">을 \n                    가진 경우는 보통 한번밖에 올라가지 않는다. &nbsp;팁이라고 \n                    &nbsp;할수도 있는 것은 리얼스킬</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">(잘 \n                    아시리라 믿음돠)이 올라가고 가시스킬이 올라가지 않은 장소는 \n                    아무리 높은 스킬을 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가지고 \n                    있더라도 그 자리에서 한번 더 올라간다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">바다가 \n                    육지보다 더 좋은 이유는 다 알 &nbsp;것이다. &nbsp;일단 장애물이 \n                    없다는 이점과(요즘 배</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">가 \n                    많긴 하쥐만서두 ㅡ.ㅡ) UOAM 과 같은 써드 파티 &nbsp;프로그램을 \n                    이용한다면 8타일 이</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">동이 \n                    용이하다는 점이다. &nbsp;또한 요즘에 나온 프로그램중 &nbsp;8타일 \n                    자동이동 프로그램도 본</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">적이 \n                    있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"http://kritz.pia.ac.kr\" target=\"_blank\">http://kritz.pia.ac.kr</a> \n                    이 싸이트에 가면 8타일 이동 프로그램과 기타 유용한 프로그램들을 \n                    </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">접할수 \n                    있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Add \n                    New Label</b> : 새로운 레벨을 만들어 맵상에 추가시킬수 있다. \n                    &nbsp;예를 들어 광부가 오</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">어의 \n                    종류나 기타 스펀 위치를 표시할 때 사용하게 된다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Edit \n                    or Go to Labels</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_2.gif\" data-recovery=\"missing\" height=\"284\" src=\"/img/placeholder/missing.svg\" width=\"279\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>Add</b></font><font face=\"돋움\" size=\"2\"> \n                    : 앞서 설명한 Add New Label.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>Remove</b></font><font face=\"돋움\" size=\"2\"> \n                    : Place 에 위치한 레벨을 선택한후 이버튼을 선택하면 지워진다. \n                    &nbsp;기존에 있는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">레벨은 \n                    가능하면 지우지 않는 것이 &nbsp;좋을 것이다. &nbsp;사용자가 \n                    잘못만들었을 &nbsp;경우 지울수 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">있게 \n                    해준다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>Edit</b></font><font face=\"돋움\" size=\"2\"> \n                    : 레벨을 편집할수 있다. 이름과 타입 위치등을 설정 변경할수 \n                    있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>Maker</b></font><font face=\"돋움\" size=\"2\"> \n                    : 그 위치에 마크를 해주고 현재 자신의 위치와의 거리를 타일수로 \n                    계산해준다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_3.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing.svg\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">*</font><font color=\"#666666\" face=\"돋움\" size=\"2\"><b>Locate</b></font><font face=\"돋움\" size=\"2\"> \n                    : 선택된 레벨로 이동한다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_4.gif\" data-recovery=\"missing\" height=\"133\" src=\"/img/placeholder/missing.svg\" width=\"278\">\n</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Go \n                    to Location</b> : 좌표를 적어주면 그장소로 이동한다. &nbsp;예전 \n                    UOE를 쓸 때 카토 플러그</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">인을 \n                    설치하면 지도해석과 동시에 빨간색으로 이 &nbsp;좌표가 표시된적이 \n                    있었다. 물론 지금</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">은 \n                    사용이 불가능하지만 프리서버의 트레저 헌터들은 UOE 와 더불어 \n                    &nbsp;UOAM 사용한다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">면 \n                    찾는 것은 식은죽 먹기가 될 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_5.gif\" data-recovery=\"missing\" height=\"185\" src=\"/img/placeholder/missing.svg\" width=\"276\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">실제 \n                    필자도 사용해본적이 있지만 1렙의 경우 3인 1조가 되서 찾는다면 \n                    &nbsp;1시간에 50장정</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도까지 \n                    캘수 있다. &nbsp;1명은 지도들고 찾으러 다니고 1명은 &nbsp;상자에서 \n                    아템건지고 또 한명</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">은 \n                    집에서 기다린다. &nbsp;먼저 찾으러 다니는 사람이 그장소를 \n                    &nbsp;찾아 보물을 파놓고 집으로 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">게이트... \n                    대기하던사람은 들어가서 루팅...루팅 끝낸 사람은 또 집에서 \n                    대기... 또 게이트... </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이런식으로 \n                    정말 초고속으로 브리타냐의 보물의 파헤치고 다니던 Pink 와 \n                    그의 친구들이 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">존재 \n                    했던 것이다. [아참 전 발해에서 &nbsp;섭초기에 잠깐하고 타샤드에서 \n                    했다가 다시 발해</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">로 \n                    왔음돠. 발해가 생긴지 얼마 안됐죠? ㅡ,.ㅡ &nbsp;]</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_6.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing.svg\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Shops by Name</b> : 원래의 상점명을 보여준다. 이 옵션을 \n                    켜놓으면 상당이 어지러</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">워 \n                    보인다. &nbsp;왠만하면 아래의 Show Shops by Category 기능만 \n                    켜놓고 사용하길 권장한</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다. \n                    &nbsp;가끔 가게의 원래 이름이 궁금하다면 켜고 다녀도 좋다. \n                    &nbsp;참고로 스카라브래의 술집</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이름은 \n                    \"박살난 해골\"이란 뜻을 가지고 있다. ㅡ,.ㅡ 별에 \n                    별이름이 다 있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/place_7.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing.svg\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    Shops by Category</b> : &nbsp;상점의 대체적인 기능만 표시한다. \n                    &nbsp;여관, &nbsp;은행, 마법상점, </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">잡화상... \n                    이런식으로</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Show \n                    All</b> : 모든 정보를 표시한다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Hide \n                    Shop</b> : 상점의 레이블을 숨긴다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/skill/images/uotip/uoam/tip.gif\" data-recovery=\"missing\" height=\"304\" src=\"/img/placeholder/missing.svg\" width=\"226\"></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>SoS \n                    병 쉽게 건지기</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 \n                    <b>Edit or Go to Lebel</b>을 선택한다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">왼쪽 \n                    하단에 Add 버튼을 선택</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">이름을 \n                    입력한다 [예 : SOS1, SOS2, ...]</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Type \n                    란에는 Treasure을 선택하는게 편할 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">Position \n                    에 SOS 병을 더블클릭하면 나오는 좌표를 입력한다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">아래에 \n                    Land 와 File 은 손대지 안아도 무방하다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">위의 \n                    작업들을 끝내고 나면 새로운 레벨이 추가된 것이 보일 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">SOS \n                    병이 여러개 있다면 한꺼번에 전부 입력한다음 이동하면서 자신과 \n                    제일 가까운 &nbsp;곳</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">부터 \n                    차례대로 건지면서 이동할수 있게 된다. </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">같은자리를 \n                    반복해서 돌아다니지 않아도 된다는 이점이 있으므로 상당한 \n                    &nbsp;시간이 단축되</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">는 \n                    것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">또 \n                    건지면서 그 위치는 REMOVE 시켜서 후에 다시할 때 겹치는 일이 \n                    없도록 해야 하겠</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>보물쉽게 \n                    찾기</b></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 \n                    필자의 경우는 경험이 조금은 있으므로 지도만 봐도 거기가 \n                    어딘지 알고 있다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">하지만 \n                    트레저를 처음 시작하는 분이라면 작은 지도한장으로는 부족할것이고 \n                    &nbsp;또한 대충</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">의 \n                    위치라도 모를듯하다. 일단 1/4로 맵을 축소한다음 Map 매뉴에가서 \n                    Tilt Map을 끈다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">음 \n                    지도창을 조금 키워서 찾아보라.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">보물이 \n                    뭍힌곳은 하늘색점으로 표시되므로 하나하나씩 맞춰볼수가 있다. \n                    &nbsp;실제 브리타냐</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">의 \n                    보물들은 몇몇군데 집중적으로 모여있으므로 얼마안가서 찾을수 \n                    있을 것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">일단 \n                    위치가 확인되면 그곳으로 간다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">다시 \n                    지도를 2배로 확대한후 하늘색 점이 표시된 정확한위치에서 \n                    보물을 &nbsp;건져내면 되는 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">것이다.</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">도움이 \n                    되었길 바란다.</font></p>\n</ul>\n<ul>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><b>Written \n                    By </b></font><font color=\"#666666\" face=\"돋움\" size=\"2\">HolyPink</font></p>\n</ul>\n</td>\n</tr>\n<tr>\n<td height=\"20\" width=\"627\"><p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\">&nbsp;<a href=\"/site/skill/uo_knowhow_place/\"><img border=\"0\" height=\"15\" src=\"/img/posts/site/skill/images/left_menu/top.gif\" width=\"50\"></a>&nbsp;</font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><map name=\"ImageMap1\">\n<area coords=\"312, 10, 356, 23\" href=\"/site/skill/uo_knowhow_uoam/\" shape=\"rect\">\n<area coords=\"212, 11, 274, 24\" href=\"/site/skill/uo_knowhow_ass/\" shape=\"rect\">\n<area coords=\"115, 10, 170, 23\" href=\"/site/skill/uo_knowhow_files/\" shape=\"rect\">\n<area coords=\"29, 9, 83, 23\" href=\"/site/skill/uo_knowhow_mark/\" shape=\"rect\">\n<area coords=\"23, 27, 71, 39\" href=\"/site/skill/uo_knowhow_place/\" shape=\"rect\">\n<area coords=\"97, 27, 138, 40\" href=\"/site/skill/uo_knowhow_filter/\" shape=\"rect\">\n<area coords=\"172, 27, 222, 40\" href=\"https://web.archive.org/web/20010709182823/http://forg.co.kr/skill/uo_knowhow_player.htm\" shape=\"rect\" target=\"_blank\">\n<area coords=\"250, 27, 287, 40\" href=\"/site/skill/uo_knowhow_map/\" shape=\"rect\">\n<area coords=\"324, 28, 361, 40\" href=\"/site/skill/uo_knowhow_link/\" shape=\"rect\">\n</map></font></p>",
  "redirectTo": null,
  "baseTarget": null
}
