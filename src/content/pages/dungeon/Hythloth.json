on/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" data-original-src=\"http://hosting27.interpia98.net:80/~forg/dungeon/image/r_line.gif\" data-recovery=\"missing\" height=\"16\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/16\" width=\"30\"></span></font></p>\n<table align=\"center\" bordercolordark=\"white\" bordercolorlight=\"black\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"499\">\n<tbody><tr>\n<td width=\"287\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" data-original-src=\"http://hosting27.interpia98.net:80/~forg/dungeon/image/dungeon/hyth_2.gif\" data-recovery=\"missing\" height=\"180\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:200/180\" usemap=\"#ImageMap3\" width=\"200\"></span></font></p>\n</td>\n<td valign=\"top\" width=\"212\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:10pt;\"><b>지하 \n                                        2층</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><b>주요 \n                                        몬스터 :</b></font></span><a href=\"https://web.archive.org/web/20020805094053/http://hosting27.interpia98.net:80/~forg/dungeon/Lizard%20man.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><b>\n</b></font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20020805094053/http://hosting27.interpia98.net:80/~forg/dungeon/Imp.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">Imp(임프)</font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20020805094053/http://hosting27.interpia98.net:80/~forg/dungeon/Hell%20Hound.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">Hell \n                                        Hound(헬하운드)</font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/dungeon/Gargoyle/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">Gargoyle(가고일)</font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"https://web.archive.org/web/20020805094053/http://hosting27.interpia98.net:80/~forg/