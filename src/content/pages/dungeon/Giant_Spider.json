g/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/r_line.gif\" data-recovery=\"missing\" height=\"16\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/16\" width=\"30\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absbottom\" border=\"0\" height=\"30\" src=\"/img/posts/site/dungeon/image/h.gif\" width=\"30\">ISTORY(</b>by<b>\n</b></span></font><font color=\"#3333FF\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>SIRL</b></span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>)</b></span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">거미도 \n            100% 모두 거대해져버린 생명체중 하나이다. 곤충만 잡아먹던 이 거미들도</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">몸집이 \n            거대해 지니 인간, 동물, 몬스터등을 거미줄로 칭칭 감아 잡아먹기 시작하면서 \n            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">조심스럽게 \n            퇴치가 시작되었다.</span></font></p>\n<p style=\"line-height:70%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n            거대한 거미들은 거미줄 말고도 독을 감염 시킬 수 있어서 꼭 거미줄에 \n            걸리지 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">않았다고 \n            다행스러워 하지말고 거미가 사는 주위에는 주변을 잘 감시할 필요가 \n            있다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:5; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그러나 \n            이들은 그리 강한 편에 속하지 않아서 숙련된 여행자라면 쉽게 처치할 \n            수 있다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/l_line.gif\" width=\"30\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/r_line.gif\" data-recovery=\"missing\" height=\"16\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/16\" width=\"30\"></span></font></p>\n<p style=\"line-height:120%; margin-top:0; margin-bottom:2; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Comment \n                                        by </span></font><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Pink</b></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;: \n                                        </span></font></p>\n<table align=\"center\" bordercolordark=\"white\" bordercolorlight=\"black\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"470\">\n<tbody><tr>\n<td width=\"26\"> <p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/pink.gif\" data-recovery=\"missing\" height=\"65\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:40/65\" width=\"40\"></b></span></font></p>\n</td>\n<td width=\"424\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">거미류의 돌연변이로 그 몸집이 엄청나게 커졌으며 독성또한 강해졌다. <br>브리타니아 세계엔 독을 이용해 공격하는 생물체나 몬스터들이 꽤 있다.</span></font> </p></td>\n</tr>\n</tbody></table>\n<p style=\"line-height:20%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\">\n<font face=\"Verdana\"><span style=\"font-size:9pt;\">이것또한 그중하나이고 치유는 가능하지만 꽤 강한 독으로 여행자를 공격하며 많은 </span></font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">발을 이용해 재빠르게 물리공격을 가하기도 한다. <br></span></font></p>\n<p style=\"line-height:70%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:5; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">치료포션을 \n늘 가지고 다녀야 하는 이유는 바로 이런것들때문이다. <br>하지만 그 독만 조심한다면 그리 어렵지 않은 몬스터이다. <br>마법저항력과 \n물리저항력 모두 형편없는 수준이다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/l_line.gif\" width=\"30\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/r_line.gif\" data-recovery=\"missing\" height=\"16\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/16\" width=\"30\"></span></font></p>\n<p style=\"line-height:120%; margin-top:0; margin-bottom:2; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Comment \n                                        by </span></font><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Keme</b></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;: \n                                        </span></font></p>\n<table align=\"center\" bordercolordark=\"white\" bordercolorlight=\"black\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"470\">\n<tbody><tr>\n<td width=\"26\"> <p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/keme.gif\" data-recovery=\"missing\" height=\"65\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/65\" width=\"30\"></b></span></font></p>\n</td>\n<td width=\"424\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2~3랩의 독을 걸고 체력은 낮습니다. 그리고 공격력 보다는 공격 스피드가 </span></font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">빠릅니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:20%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:5; margin-left:15;\"> <font face=\"Verdana\"><span style=\"font-size:9pt;\">그래서 중급 전사일경우 낮은 힐링 스킬로 인해서 해독을 \n하지 못해. 중독으로 죽는 경우가 많습니다. 종종 트래져 헌팅을 하기 위해서 숲에 가면 자주 봅니다. ^^</span></font> </p><p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">\n</p><p align=\"center\" style=\"line-height:20%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
