/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/r_line.gif\" data-recovery=\"missing\" height=\"16\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/16\" width=\"30\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absbottom\" border=\"0\" height=\"30\" src=\"/img/posts/site/dungeon/image/h.gif\" width=\"30\">ISTORY(</b>by<b>\n</b></span></font><font color=\"#3333FF\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>SIRL</b></span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>)</b></span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">몽벳은 \n            작은 생명체로 박쥐의 날개가 있으며 생김새는 원숭이와 비슷하다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이들은 \n            날개가 있지만 크기가 작아서 오래 날 수 없으며 보통 걸어다니는데 \n            육식보다 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">채소를 \n            더 좋아한다고 전해진다.</span></font></p>\n<p style=\"line-height:70%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">채소를 \n            좋아하는 이들이 브리타니안을 공격하는 건 몽벳의 영역을 침범했을 \n            때라고 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">학자를 \n            밝히고 있다.</span></font></p>\n<p style=\"line-height:70%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아주 \n            약한 생명체라서 숙련된 전사의 한방에 죽기도 하는데 간혹 쎈 몽벳을 \n            만날 수도 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:5; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있는데 \n            이들을 '스트롱 몽벳'으로 불리기 시작하였다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/l_line.gif\" width=\"30\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" height=\"16\" src=\"/img/posts/site/dungeon/image/line.gif\" width=\"16\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/r_line.gif\" data-recovery=\"missing\" height=\"16\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:30/16\" width=\"30\"></span></font></p>\n<p style=\"line-height:120%; margin-top:0; margin-bottom:2; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Comment \n                                        by </span></font><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Pink</b></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;: \n                                        </span></font></p>\n<table align=\"center\" bordercolordark=\"white\" bordercolorlight=\"black\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"470\">\n<tbody><tr>\n<td width=\"26\"> <p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/dungeon/image/pink.gif\" data-recovery=\"missing\" height=\"65\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:40/65\" width=\"40\"></b></span></font></p>\n</td>\n<td width=\"424\">\n<p style=\"margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">날개가 달린 이 귀여운 몬스터는 초반에 수련하기에 매우 적합한 몬스터입니다. 공격력도 약하고 체력도 약하거든요. 마을에 돌아다니는 \n개한테도 물려 죽기도 합니다.</span></font> </p></td>\n</tr>\n</tbody></table>\n<p style=\"line-height:20%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">T2A 몽뱃&gt;&gt;<br></span></font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">트라멜 대륙이나 펠루카 대륙에 서식하는 그런 약한 몽뱃이 아닌 차원의 진화를 거듭한 보통 몽뱃보다 쎈 몽뱃입니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">중급 주문인 \n에너지볼트(Energy Bolt,6서클 중급주문)도 막아내는 표피를 가지고 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있지만 숙련된 전사에게는 그리 강력한 몬스터가 아닙니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">역시 체력이 \n떨어질 경우 날개를 이용해 도망치는 비굴함을 보이기도 합니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">\n</p><p align=\"center\" style=\"line-height:20%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n",
