  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/uocraft/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/uocraft/images/u.gif\" width=\"24\">O. \n                            Craft - Resoures</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/uocraft/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/uocraft/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/uocraft/images/alpha_background.gif\">\n<p>&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><a href=\"/site/uocraft/uo_craft/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">ML크랩에대해서</font></span></a><span style=\"font-size:9pt;\"><a href=\"https://web.archive.org/web/20071130221935/http://www.forg.co.kr/uocraft/uo_knowhow_addon.html\" target=\"_blank\"><font color=\"black\" face=\"Verdana\">\n</font></a><font color=\"black\" face=\"Verdana\">l&nbsp;</font></span><a href=\"/site/uocraft/uo_craft_1/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">크랩재료리스트</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font></span><a href=\"/site/uocraft/uo_craft_2/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">대장장이</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/uocraft/uo_craft_3/\"><font color=\"black\" face=\"Verdana\">테일러</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/uocraft/uo_craft_4/\"><font color=\"black\" face=\"Verdana\">보우크래프트</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><a href=\"/site/uocraft/uo_craft_5/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">팅거링</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"> \n                            \n                             \n                            l&nbsp;</font></span><a href=\"/site/uocraft/uo_craft_6/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">목공술</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/uocraft/uo_craft_7/\"><font color=\"black\" face=\"Verdana\">인스크립션</font></a></span></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#C9BA93\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"570\">\n<tbody><tr>\n<td width=\"564\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">A. \n                                        </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>ML던전 보스에게 얻을 수 있는 재료</b></span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" width=\"96%\">\n<tbody><tr>\n<td bgcolor=\"#CCCCCC\" width=\"157\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보스명</span></font></p>\n</td>\n<td bgcolor=\"#CCCCCC\" width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주재료</span></font></p>\n</td>\n<td bgcolor=\"#CCCCCC\" width=\"171\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">공통재료</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" width=\"157\"> <p align=\"center\" style=\"line-height:100%; margin-top:3; margin-bottom:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/dungeon/ML_paroxysmus/\" target=\"_blank\"><font color=\"black\" face=\"Verdana\"><b>Chief \n                            Paroxysmus</b></font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:3; margin-bottom:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">(격노의 번데기)</font></span></p>\n</td>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/uocraft/images/mlitem/b_2.gif\" data-recovery=\"missing\" height=\"26\" src=\"/img/placeholder/missing.svg\" width=\"24\">Lard \n                                                    of Paroxysmus</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(번데기보스의 \n                                                    기름)</span></font></p>\n</td>\n<td rowspan=\"6\" width=\"171\">\n<table align=\"center\" border=\"1\" bordercolordark=\"black\" bordercolorlight=\"black\" cellspacing=\"0\" width=\"94%\">\n<tbody><tr>\n<td bgcolor=\"#CCCC99\" width=\"161\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"26\" src=\"/img/posts/site/uocraft/images/mlitem/b_1.gif\" width=\"24\">Muculent</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/b_6.gif\" width=\"30\">Blight</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"36\" src=\"/img/posts/site/uocraft/images/mlitem/b_8.gif\" width=\"34\">Corruption</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/uocraft/images/mlitem/b_9.gif\" data-recovery=\"missing\" height=\"18\" src=\"/img/placeholder/missing.svg\" width=\"34\">Putrefaction<img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/uocraft/images/mlitem/b_10.gif\" width=\"34\">Scourge</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/uocraft/images/mlitem/b_12.gif\" width=\"34\">Taint</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/uocraft/images/point.gif\" width=\"15\"></span></font><font color=\"#003333\" face=\"Verdana\"><span style=\"font-size:9pt;\">위의 \n                                                    공통재료는 보스의</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"#003333\" face=\"Verdana\"><span style=\"font-size:9pt;\">종류와는 \n                                                    상관없이</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"#003333\" face=\"Verdana\"><span style=\"font-size:9pt;\">랜덤하게 \n                                                    획득됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" width=\"157\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><a href=\"https://web.archive.org/web/20071130221935/http://www.forg.co.kr/dungeon/ML_Shimmering.html\" target=\"_blank\"><font color=\"black\" face=\"Verdana\"><b>Shimmering \n                            Efussion</b></font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">(쉬머링 이퓨젼)</font></span></p>\n</td>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"26\" src=\"/img/posts/site/uocraft/images/mlitem/b_3.gif\" width=\"24\">Captured \n                                                    Essence</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(포획된 \n                                                    에센스)</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" width=\"157\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/dungeon/ML_grizzle/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><b>Monstrous \n                            Interred</b></font></span></a><a href=\"https://web.archive.org/web/20071130221935/http://www.forg.co.kr/uocraft/ML_grizzle.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\"> </font></span></a><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">Grizzle(그리즐)</font></span></p>\n</td>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/uocraft/images/mlitem/b_7.gif\" data-recovery=\"missing\" height=\"34\" src=\"/img/placeholder/missing.svg\" width=\"40\">Grizzled \n                                                    Bones</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(그리즐의 \n                                                    뼈)</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" width=\"157\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><a href=\"https://web.archive.org/web/20071130221935/http://www.forg.co.kr/dungeon/ML_Dreadhorn.html\" target=\"_blank\"><font color=\"black\" face=\"Verdana\"><b>Dread \n                            Horn</b></font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">(드레드혼)</font></span></p>\n</td>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"26\" src=\"/img/posts/site/uocraft/images/mlitem/b_5.gif\" width=\"30\">Dread \n                                                    Horn Mane</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(드래드혼의 \n                                                    갈기)</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" width=\"157\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/dungeon/ML_Travisty/\" target=\"_blank\"><font color=\"black\" face=\"Verdana\"><b>Travesty</b></font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">(트라비스티)</font></span></p>\n</td>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"10\" src=\"/img/posts/site/uocraft/images/mlitem/b_4.gif\" width=\"10\">Eye \n                                                    of the Travesty</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(트라비스티의 \n                                                    눈)</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" width=\"157\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/dungeon/ML_Melisande/\" target=\"_blank\"><font color=\"black\" face=\"Verdana\"><b>Lady \n                                                    Melisande</b></font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">(멜리사)</font></span></p>\n</td>\n<td width=\"191\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/b_11.gif\" width=\"46\">DiseasedBark</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(썩은나무껍질)</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;<font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/uocraft/images/point.gif\" width=\"15\"> \n                                        주재료는 해당 보스만 주어지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">B. \n                                        </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>광부(마이닝)이&nbsp;얻을 수 있는 재료</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">광부가 \n                                        오어를 캐낼때, 여러가지 재료를&nbsp;얻을 \n                                        수 있는데, 흔히 알고 있는 기본적인것으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">일반 \n                                        오어와 색오어(덜쿱,쉐도우등)을 얻을 \n                                        수 있으며 SHIFT키+삽원클릭으로 화강암을 \n                                        얻을 수 있습니다. 여기에 ML버젼이 업그레이드 \n                                        되어 레어보석이 추가되었습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">레어보석은 \n                                        팅거링 스킬로 반들 수 있는 레어반지등을 \n                                        만들때 유용하게 쓰입니다.</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"maroon\" face=\"Verdana\">플레이어의 \n                                                    종족은 휴먼과 엘프로 나뉘어 \n                                                    지는데, 색오어를 획득 할 \n                                                    수 있는 확율은 두 종족 모두 \n                                                    동일 하지만, 레어보석을 \n                                                    얻는 확율은 엘프가 월등히 \n                                                    높습니다.</font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"maroon\" face=\"Verdana\">아래는 \n                                                    광부가 오어를 캘때 랜덤으로 \n                                                    나오는 보석들입니다.</font></span></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"black\" bordercolorlight=\"black\" cellspacing=\"0\" width=\"94%\">\n<tbody><tr>\n<td bgcolor=\"#CCCC99\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/m_1.gif\" width=\"16\">Blue \n                                                                Diamond(블루다이아몬드)<img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/m_2.gif\" width=\"16\">Dark \n                                                                Sapphire(다크사파이어)</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/m_3.gif\" width=\"16\">Ecru \n                                                                Citrine(황수정)<img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/m_4.gif\" width=\"16\">Fire \n                                                                Ruby(파이어루비)</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/m_6.gif\" width=\"16\">Turquoise(터키옥)<img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/m_5.gif\" width=\"16\">Perfect \n                                                                Emerald(퍼펙트에머랄드)</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                                    보석의 포인트는 정해진 곳이 \n                                                    없으며 랜덤하게 나오게 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">C. \n                                        </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>나무꾼(럼잭)이&nbsp;얻을 수 있는 재료</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">나무꾼이 \n                                        나무를 얻을때는 기본적으로 통나무가 \n                                        나오지만, ML버젼이 추가되면서 색나무와</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">기타 \n                                        부스러기재료들이 랜덤하게 나오게 됩니다. \n                                        색나무는 색오어처럼 일정한 나무에게서</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">나오게 \n                                        되며 부스러기재료들은 정해진곳이 없으며 \n                                        랜덤하게 얻을 수 있습니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">색나무중 \n                                        얼음나무는 아주 드문 장소의 나무에서만 \n                                        얻을 수 있으며 그 하위단계인 블러드등으로&nbsp;내려갈수록 \n                                        많은 장소에 분포되어 있습니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">색나무는 \n                                        일반적으로 카펜이 만들 수 있는 방호구등에 \n                                        쓰이게 되거나, 색을 넣는 장식품에</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">쓰이게 \n                                        되며, 부스러기재료들은 알케미재료등에 \n                                        쓰이게 됩니다.</font></span></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"maroon\" face=\"Verdana\">플레이어의 \n                                                    종족은 휴먼과 엘프로 나뉘어 \n                                                    지는데, 색나무와 부스러기재료들을&nbsp;</font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"maroon\" face=\"Verdana\">획득 \n                                                    할 수 있는 확율은 엘프가 \n                                                    월등히 높습니다.</font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"maroon\" face=\"Verdana\">아래는 \n                                                    나무꾼이 나무를 얻을때 랜덤으로 \n                                                    나오는 색나무와 부스러기재료들입니다.</font></span></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"black\" bordercolorlight=\"black\" cellspacing=\"0\" width=\"94%\">\n<tbody><tr>\n<td bgcolor=\"#CCCC99\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/bo_6.gif\" width=\"30\">Oak(65)<img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/uocraft/images/mlitem/bo_4.gif\" data-recovery=\"missing\" height=\"30\" src=\"/img/placeholder/missing.svg\" width=\"30\">Ash(80)</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/bo_5.gif\" width=\"30\">Yew(95)<img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/bo_1.gif\" width=\"30\">Heartwood(100)</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/bo_3.gif\" width=\"30\">Bloodwood(100)<img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/bo_2.gif\" width=\"30\">Frostwood(100)</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                                    괄호안에 숫자는 해당 아이템을 \n                                                    얻을 수 있는 필요 럼잭스킬입니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                                    색나무로 방호구나 무기를 \n                                                    만들때 부가옵은<a href=\"/site/skill_knowhow/uo_knowhow_mw_3/\">&nbsp;</a></span></font><a href=\"/site/skill_knowhow/uo_knowhow_mw_3/\"><span style=\"FONT-SIZE: 9pt\"><font color=\"green\" face=\"Verdana\"><b>재료보너스</b></font></span></a><span style=\"FONT-SIZE: 9pt\"><font color=\"navy\" face=\"Verdana\">를 참조하시길 바랍니다.</font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"navy\" face=\"Verdana\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"black\" bordercolorlight=\"black\" cellspacing=\"0\" width=\"94%\">\n<tbody><tr>\n<td bgcolor=\"#CCCC99\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"34\" src=\"/img/posts/site/uocraft/images/mlitem/lum_1.gif\" width=\"40\">Parasitic \n                                                                Plant(100)<img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/uocraft/images/mlitem/lum_2.gif\" data-recovery=\"missing\" height=\"42\" src=\"/img/placeholder/missing.svg\" width=\"40\">Bark \n                                                                Fragment(100)</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/lum_3.gif\" width=\"18\">Luminescent \n                                                                Fungi(100)<img align=\"absmiddle\" border=\"0\" height=\"30\" src=\"/img/posts/site/uocraft/images/mlitem/bo_7.gif\" width=\"30\">Switch(100)<img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/lum_4.gif\" width=\"16\">Brilliant \n                                                                Amber(100)</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                                    괄호안에 숫자는 해당 아이템을 \n                                                    얻을 수 있는 필요 럼잭스킬입니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;<font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/uocraft/images/point.gif\" width=\"15\">\n</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">색나무로 \n                                        인챈트를 하거나 아이템을 만들때 부여되는 \n                                        </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">마법속성은 \n                                        </span></font><span style=\"font-size:9pt;\"><b><a href=\"/site/skill_knowhow/uo_knowhow_mw_3/\"><font color=\"green\" face=\"Verdana\">각종유용한정보-재료보너스</font></a></b></span><font color=\"black\" face=\"Verdana\"><span style=\"FONT-SIZE: 9pt\"> 를 참조하시길 바랍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">D. \n                                        </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>낚시(피싱)이 얻을 수 있는 재료</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">낚시꾼이 \n                                        고기를 잡을때 랜덤하게 해당 보석을 얻을 \n                                        수 있게됩니다.</font></span></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"16\" src=\"/img/posts/site/uocraft/images/mlitem/fishing.gif\" width=\"16\">White \n                                                    Pearl(진주)</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                                    보석의 포인트는 정해진 곳이 \n                                                    없으며 랜덤하게 나오게 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:14; margin-bottom:0; margin-left:14;\">&nbsp;</p>\n<hr color=\"white\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\" width=\"98%\">\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:40%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"https://web.archive.org/web/20071130221935/http://www.forg.co.kr/uocraft/uo_knowhow.html\" target=\"_blank\"><b><span style=\"font-size:9pt;\"><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/uocraft/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/uocraft/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/uocraft/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/uocraft/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
