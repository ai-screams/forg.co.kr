  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_blacksmith/\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_mining/\"><font color=\"black\" face=\"Verdana\">광부(Mining)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_armslore/\"><font color=\"black\" face=\"Verdana\">장비지식(Arms Lore)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_tailor/\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">\n<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_lum/\"><font color=\"black\" face=\"Verdana\">나무꾼(Lumberjacking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_car/\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry)</font></a><font color=\"black\" face=\"Verdana\">  \n                            l </font><a href=\"/site/skill_index/uo_jobs_bow/\"><font color=\"black\" face=\"Verdana\">활제작자(Bowcraft)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_thinker/\"><font color=\"black\" face=\"Verdana\">기계공(Tinkering)</font></a><font color=\"black\" face=\"Verdana\"> </font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_fishing/\"><font color=\"black\" face=\"Verdana\">낚시(Fishing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_begging/\"><font color=\"black\" face=\"Verdana\">구걸(Begging)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_alchemy/\"><font color=\"black\" face=\"Verdana\">포션제작자(Alchemy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_ins/\"><font color=\"black\" face=\"Verdana\">스크롤제작자(Inscription)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>BLACKSMITHY</b></span></font><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\"><b>\n</b></font></span><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_smith.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Smith</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">None</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당스킬사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Armourer, \n                            Blacksmith, Blacksmith Guildmaster, Weaponsmith \n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(제품별)</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            대장장이란</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">대장장이는 \n                            각종 갑옷과 무기류, 드래곤스웜프라는 탈 것에 입히는 \n                            드래곤바딩디드를 만들 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">해당 \n                            대장장이는 지엠(스킬수치 100)일 경우 플레이어의 \n                            이름이 각종 방호구나 무기에 새겨지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">광부가 \n                            잉갓을 공급하며 이 잉갓을 가지고 대장장이가 제품을 \n                            만드는데, 색잉갓의 경우에는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">해당 \n                            광부의 색오어를 캘 수 있는 스킬수치에 의해 </span></font><font color=\"purple\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">대장장이도 \n                            해당 스킬이 되어야만 색오어로 된</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">각종 \n                            제품을 만드실 수 있습니다. </span></font><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">물론 \n                            만든 제품을 다시 녹일때에도 대장장이 스킬이 아닌 \n                            마이닝스킬이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">요구됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">즉, \n                            대장장이는 제품을 만드는것에 대해 스킬적용이 되고, \n                            마이닝은 제품을 녹일때 스킬적용이 됩니다.</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" width=\"98%\">\n<tbody><tr height=\"19\" style=\"height:14.25pt\">\n<td class=\"xl22\" height=\"19\" style=\"height:14.25pt;width:60pt\" width=\"80\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">색잉갓</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">덜쿠퍼</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">쉐도우</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">쿠퍼</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">브론즈</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">골드</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아가파이트</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">베라이트</span></font></p></td>\n<td class=\"xl22\" style=\"width:59pt\" width=\"79\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">발러라이트</span></font></p></td>\n</tr>\n<tr height=\"19\" style=\"height:14.25pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" height=\"19\" style=\"height:14.25pt\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬수치</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">65</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">70</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">75</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">80</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">85</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">90</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">95</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl23\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">99</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            대장장이의 도구</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/smith/1.gif\" width=\"100\">제품을 \n                            만들려면  \n                            도구가 필요합니다. 기계공스킬을 가진 플레이어가 \n                            만들 수 있으며 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">일반 \n                            도구상점이나 </span></font><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana,굴림체\"><b>스미스상점</b></font></span></a><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">에서 \n                            판매를 하고 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">도구로는 \n                            부젓가락,슬레지해머,대장장이해머를 이용하여 만들게 \n                            되며 재료는 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">마이닝 \n                            스킬을 가진 광부가 채굴하는 잉갓을 이용하게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">이때 \n                            대장장이근처에는 항상 포지와 엔빌이 있어야 합니다. \n                            포지와 엔빌은 목공술을 가진 플레이어가 만들 수 있으며 \n                            자신의 집에서만 설치가 가능합니다. </span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            대장장이의 벌크디드</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">제품을 \n                            팔거나 NPC메뉴(쉬프트+NPC원클릭)을 하시게 되면 대량주문서라는 \n                            메뉴가 나오고 해당</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">메뉴를 \n                            선택하시면 벌크디드를 \n                            받으실 수 있습니다. (</span></font><a href=\"/site/bod/bod/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>벌크디드보정보란</b></font></span></a><span style=\"font-size:9pt;\"><font face=\"Verdana\">)참조.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">해당 \n                            벌크디드보상품으로 스미스스킬을 120까지 올리실 수도 \n                            있습니다.</font></span></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            대장장이의 작업메뉴</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">A. \n                            상단 메뉴에 있는 선택란들</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            각종 제품의 하위메뉴로 들어가게 됩니다. (선택란에서는 \n                            해당 제품을 만들게 됩니다)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_2.gif\" width=\"26\"> \n                            해당 제품의 상세정보로 들어가게 됩니다. (제품의 \n                            최소스킬치,요구재료,성공기회,고급기회 정보)</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">B. \n                            하단 메뉴에 있는 선택란들</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            아이템녹이기 : 제품을 잉갓으로 환원시킵니다.(마이닝스킬요구)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            철&nbsp;: 잉갓의 색 종류를 선택합니다. 철에서부터 \n                            발로라이트까지 선택</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            붉은 비늘&nbsp;: 비늘의 색 종류를 선택합니다. (비늘은 \n                            드래곤종류, 시서펜등 시체해부시 획득)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            아이템수리 : 제품의 내구력을 원상복귀해줍니다. 단 \n                            랜덤하게 내구도가 1씩 줄어들게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스크롤을 \n                            이용하면 수리디드가 만들어 집니다. 아이템수리선택 \n                            후 시약상점에서 파는 빈스크롤을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">클릭하시면 \n                            해당 스크롤이 수리디드로 변환됩니다. 해당 수리디드는 \n                            스미스가 없는 캐릭이라도 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">NPC상점(스미스)에서 \n                            사용하면 제품을 수리하실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            물건이름표시&nbsp;: 스킬 100일 경우 제품에 이름을 \n                            표시해 줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            아이템개량 : 몬스터에게서 얻은 매직제품을 개량합니다. \n                            (</span></font><a href=\"/site/skill_knowhow/uo_knowhow_mw_3/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>재료보너스</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">)참조</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\">\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By \n\n                        Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
