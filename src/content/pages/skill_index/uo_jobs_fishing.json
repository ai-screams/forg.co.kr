  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_blacksmith/\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_mining/\"><font color=\"black\" face=\"Verdana\">광부(Mining)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_armslore/\"><font color=\"black\" face=\"Verdana\">장비지식(Arms Lore)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_tailor/\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">\n<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_lum/\"><font color=\"black\" face=\"Verdana\">나무꾼(Lumberjacking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_car/\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry)</font></a><font color=\"black\" face=\"Verdana\">  \n                            l </font><a href=\"/site/skill_index/uo_jobs_bow/\"><font color=\"black\" face=\"Verdana\">활제작자(Bowcraft)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_thinker/\"><font color=\"black\" face=\"Verdana\">기계공(Tinkering)</font></a><font color=\"black\" face=\"Verdana\"> </font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_fishing/\"><font color=\"black\" face=\"Verdana\">낚시(Fishing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_begging/\"><font color=\"black\" face=\"Verdana\">구걸(Begging)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_alchemy/\"><font color=\"black\" face=\"Verdana\">포션제작자(Alchemy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_ins/\"><font color=\"black\" face=\"Verdana\">스크롤제작자(Inscription)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>FISHING \n                             \n                            <img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_fishing.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Fisherman</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 도구를 이용(낚시대)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Fisherman, Fisher Guildmaster, Harbor \n                            Master</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(해안선에서부터 깊은바다까지)</span></font></p>\n<p style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"right\" border=\"1\" height=\"120\" src=\"/img/posts/site/skill_index/images/uojobs/fish/logo.gif\" width=\"200\"></span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"></span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚시는 \n                레어급아이템을 얻을 수 있다는 큰장점이 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">우선 \n                스킬별로 무엇을 낚을 수 있는지 알아봅시다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">현재는 \n                            낚시중에 물뱀이라는 몹이 스펀되고, sos병에서 얻을 \n                            수 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">있는 매직 아이템들이 거의 메리트가 없기때문에 \n                            사장되어 가는 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">분위기 입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">하지만 \n                            색그물,메탈상자,(돌)방석,그림은 하우스인테리어</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">작업에 \n                            필요한 것이기 때문에 아직은 인기가 많습니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">스킬별 \n                            아이템</span></font></p>\n<table align=\"center\" border=\"\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"96%\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"28\" src=\"/img/posts/site/skill_index/images/uojobs/fish/boots.gif\" width=\"18\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill_index/images/uojobs/fish/sandals.gif\" width=\"20\"><img border=\"0\" height=\"22\" src=\"/img/posts/site/skill_index/images/uojobs/fish/shoes.gif\" width=\"19\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill_index/images/uojobs/fish/thighboots.gif\" width=\"26\"></span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">고기와 \n                                        함께 많이 나오는 신발입니다.</span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">해안가 근처에서는 더 빈번하게 나옵니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_brown.gif\" width=\"40\"><img border=\"0\" height=\"38\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_green.gif\" width=\"41\"></span></font></p>\n</td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">주로 \n                            낚아지는 고기입니다 물론 \n                            이것도 낚시 스킬 전체를 통해 계속 나오게 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">됩니다. \n                                        단검을 \n                            이용하여 고기를 짤라 불에 \n                            굽게 되면 스테이크가됩니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">기본적인 \n                            쿠킹스킬만으로도 맛있게 구울 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_highly_peculiar.gif\" width=\"30\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/uojobs/fish/fish_prize.gif\" data-recovery=\"missing\" height=\"36\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:30/36\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_truly_rare.gif\" width=\"30\"><img border=\"0\" height=\"36\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fish_wondrous.gif\" width=\"30\"></span></font></p>\n</td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">색이 \n                                        있는 고기로 더블클릭으로 먹게되며 각종 스탯이 오르게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"39\" src=\"/img/posts/site/skill_index/images/uojobs/fish/bigfish.gif\" width=\"41\"></span></font></p>\n</td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            80</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">부터 낚아지는 고기로 바로 \n                            발 밑으로 떨어지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">박제의재료로도 \n                            널리 쓰입니다 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_addon/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>박제에대해서</b></font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">편을 참조하시길.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"31\" src=\"/img/posts/site/skill_index/images/uojobs/fish/map.gif\" width=\"32\"></span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                                        90</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">부터 건질 수 있으며 1렙지도로 \n                                        </span></font><a href=\"https://web.archive.org/web/20071121215221/http://www.forg.co.kr/skill_index/Sea%20Serpent.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Sea \n                                        Serpent(시서펜)</b></font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">을 처리하면 </span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">랜덤하게 나옵니다</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill_index/images/uojobs/fish/rolled_map.gif\" width=\"20\"><img border=\"0\" height=\"19\" src=\"/img/posts/site/skill_index/images/uojobs/fish/bottle_of_ale.gif\" width=\"9\"><img align=\"absmiddle\" border=\"0\" height=\"26\" src=\"/img/posts/site/skill_index/images/uojobs/fish/ancientsos.gif\" width=\"25\"></span></font></p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"47\" src=\"/img/posts/site/skill_index/images/uojobs/fish/ancientchest.gif\" width=\"38\"><img align=\"absmiddle\" border=\"0\" height=\"54\" src=\"/img/posts/site/skill_index/images/uojobs/fish/fablednet.gif\" width=\"57\"></span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                                        100</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">부터 건질 수 있으며 </span></font><a href=\"https://web.archive.org/web/20071121215221/http://www.forg.co.kr/skill_index/Sea%20Serpent.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Sea \n                                        Serpent(시서펜)</b></font></span></a><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>\n</b></font></span><a href=\"https://web.archive.org/web/20071121215221/http://www.forg.co.kr/skill_index/Kraken.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Kraken(크라켄)</b></font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">을  </span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">처리하면 랜덤하게 \n                            나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">화이트 \n                                        SOS쪽지는 일반 SOS병중에서 약 4%의 확율로 \n                                        나오게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">체감상 \n                                        약 30장의 일반 SOS병을 읽어야 1개의 \n                                        고대SOS병이 나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">고대 \n                                        SOS병은 크라켄의 상위몹인 </span></font><span style=\"font-size:9pt;\"><a href=\"https://web.archive.org/web/20071121215221/http://www.forg.co.kr/skill_index/Leviathan.html\" target=\"_blank\"><font color=\"green\" face=\"Verdana\"><b>Leviathan(레비아단)</b></font></a><font color=\"black\" face=\"Verdana\">이 \n                                        나오는데</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">해당 \n                                        몹을 잡게 되면 랜덤으로 </font><a href=\"/site/skill_knowhow/uo_knowhow_mw_8/\"><font color=\"green\" face=\"Verdana\"><b>마이너(Minor \n                            Artifact)</b></font></a><font color=\"black\" face=\"Verdana\">나 \n                                        </font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">화이트그물을 \n                                        얻을 수 있습니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">SOS병을 \n                                        모아서 한번에 찾는것이 편하지만 이때는 \n                                        </font><font color=\"purple\" face=\"Verdana\">낚시스킬이 \n                                        최소 65</font><font color=\"black\" face=\"Verdana\">가</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">필요합니다.</font></span></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/specialnet.gif\" width=\"44\"></span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                                        80부터</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                        건질 수 있으며 </span></font><a href=\"https://web.archive.org/web/20071121215221/http://www.forg.co.kr/skill_index/Sea%20Serpent.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Sea \n                                        Serpent(시서펜)</b></font></span></a><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>\n</b></font></span><a href=\"https://web.archive.org/web/20071121215221/http://www.forg.co.kr/skill_index/Kraken.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Kraken(크라켄)</b></font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">을 처리하면 랜덤하게 나옵니다. \n                                        그물을 모아 낚시 스킬이 없는 바드나 \n                                        전투캐릭</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">으로 \n                                        몬스터를 잡을 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">[그물이지만 색이 \n                                        여러종류가 있기에 장식용으로 많이 쓰입니다]</span></font></p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_iceblue.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_neonpurple.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_purple.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_red.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_shadow.gif\" width=\"44\"></span></font>\n</p><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_turquoise.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_bronze.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_blue.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_teal.gif\" width=\"44\"><img border=\"0\" height=\"43\" src=\"/img/posts/site/skill_index/images/uojobs/fish/net_fire.gif\" width=\"44\"></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"47\" src=\"/img/posts/site/skill_index/images/uojobs/fish/metalchest.gif\" width=\"38\"><img border=\"0\" height=\"45\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/box_4.gif\" width=\"45\"></span></font></p>\n</td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">메탈체스트나 \n                                        나무상자로 \n                            SOS병을 건졌을 때 랜덤으로나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:5px;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">메탈체스트는 \n                                        다소 \n                                        높은가격으로 다른 플레이어에게 매매하실 \n                                        수 있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">그물 \n                                        사용법</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">얻은 \n                            그물을 더블클릭하고 타겟을 바다에 선택하시면 몇초 \n                                        후에 \n                            물뱀과 \n                                        크라켄이 랜덤하게 스펀되어 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">집니다. \n                            나오는 \n                            마리수는 그물하나당 (1-3마리입니다)</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">바다 \n                                        깊은곳이 \n                            더 크라켄이 잘 나옵니다. 크라켄은 \n                            sos병을 가지고 나올 확률이 큽니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            낚시 스킬 없이도 그물을 던질 수 있으니 되도록 \n                            전투캐릭을 이용하시길 바랍니다.</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"96%\">\n<tbody><tr>\n<td> <p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">SOS병 \n                                        찿기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">메시지를 클릭하면 좌측사진처럼 \n                            좌표가 나옵니다</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">UOAM을 \n                            사용하시면 더욱 편리하게 찿으실수 있습니다. </span></font><a href=\"/site/skill/uo_knowhow_place/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>각종유용한정보-</b></font></span><font color=\"green\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">UOAM</span></b></font></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                            참조하시길.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"right\" border=\"1\" height=\"150\" src=\"/img/posts/site/skill_index/images/uojobs/fish/map_sos.gif\" width=\"200\">SOS병을 \n                                        찾을때에는 (</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">최소 \n                                        낚시스킬 65</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">)가 \n                                         필요합니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">개인벤더에서 \n                                        SOS병을 구입하시는 분들은 자신의 계정에 \n                                        낚시 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬을 \n                                        가진 캐릭이 있는지 확인이 필요합니다.</span></font></p>\n<p style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">스킬 \n                                        올리기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">빨간선라인에서 육지쪽으로가는 지역이 \n                                        스킬이 \n                            낮을때 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚시를 해야할 선입니다 \n                                        스킬이 \n                            오를수록(</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">약 \n                            65이상</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">) </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">바다쪽으로 가시면됩니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">초기에는 \n                            빨간선라인 즉 해안가에서 바다쪽으로 왕복항해 &nbsp;</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">하시면서 \n                            고기를 잡으셔도 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">SOS병을 \n                많이 모아 한꺼번에 찾는것이 시간을 절약할 \n                                        수 있는 방법입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"right\" border=\"1\" height=\"150\" src=\"/img/posts/site/skill_index/images/uojobs/fish/box.gif\" width=\"250\">1개의 \n                sos병이 1000-3000Gp까지 주며</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">낚을 \n                때는 상자가 바로 나오거나 초상화,해골뼈,돌,</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">지구본,시계,조개등이 먼저 낚일 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">마지막으로 \n                낚시는 물뱀을 죽여서 1렙지도,</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">SOS병,그물을 얻어야 함으로 \n                                        근접 \n                공격의 전투스킬보다는 원거리 공격의 전투스킬을 권장합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">원거리공격의 \n                전투스킬은 메절,이벨,메디의 조합과</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">아쳐,택틱의조합이 \n                있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">몬스터끼리 \n                            공격하게 하는&nbsp;프롭(도발)바드와의 조합도 상당히 \n                            좋습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
  "redirectTo": null,
  "baseTarget": null
}
