  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_steal/\"><font color=\"black\" face=\"Verdana\">훔치기(Stealing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_hiding/\"><font color=\"black\" face=\"Verdana\">숨기(Hiding) \n                             \n                            </font></a><font color=\"black\" face=\"Verdana\">l&nbsp;</font><a href=\"/site/skill_index/uo_combat_stealth/\"><font color=\"black\" face=\"Verdana\">은폐이동(Stealth)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_snooping/\"><font color=\"black\" face=\"Verdana\">훔쳐보기(Snooping)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_detect/\"><font color=\"black\" face=\"Verdana\">은폐탐지(Detect Hidden)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_combat_tracking/\"><font color=\"black\" face=\"Verdana\">트랙킹(Tracking)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>STEALTH</b></span></font><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\"><b>&nbsp;</b></font></span><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/logo_stealth.gif\" data-recovery=\"missing\" height=\"60\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/60\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Rogue</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: -</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당스킬사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Thief, Thief Guildmaster, Ranger Guildmaster</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(갑옷에 의한)와 이동제한</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            스텔스의 장점</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스텔스(은폐이동)스킬을 이용하면 \n                            다른 플레이어에게 모습을 감춘 채 이동이 가능합니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">위험한 \n                            던전지역이나 플레이어간의 워중에도 해당장소를 무사히 \n                            빠져나갈 수 있게 해줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana,굴림체\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            스텔스 사용하기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하이딩 \n                            상태 80이상일때 해당스킬을 배울 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">일단 \n                            하이딩을 한 채로 스텔스를 구동하면 숨은 채로 움직일수 \n                            있게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스텔스는 \n                            이때부터 자동으로 구동되며 다른 스킬과 연계되지않으므로 \n                            11초의 딜레이를 갖지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">않게 \n                            됩니다. 이동시 계속 오토로 발동이 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스킬이 \n                            높을수록 짧은거리를 뛰거나 다른 플레이어와의 충돌에도 \n                            숨은채로 있을 확율이 높아집니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            스텔스 수련</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스텔스는 \n                            아머수치에 의해 제한이 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">AR이라고 \n                            하는데 현재 스텟창에는 사라진 상태입니다. 보통 가죽(스텃)갑옷과 \n                            체인,플레이트를 많이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">입을 \n                            수록 스텔스 실패가 높아지게됩니다. 역으로 말하자면&nbsp;어느정도 \n                            스킬이 향상되면 플레이트 갑옷으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">투구나 \n                            몸통등에 착용을 하시어 수련 해야만 합니다. 약 74정도 \n                            부터 플레이트류를 입으셔야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            스텔스 발각되기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스텔스상태로 \n                            이동시 근처에 디텍트히든스킬을 올린 플레이어가 있다면 \n                            발각되어 모습을 드러낼 확율이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">커지게 \n                            됩니다.</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By \n\n                        Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
