  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_bard/\"><font color=\"black\" face=\"Verdana\">연주(Musicianship)</font></a><font color=\"black\" face=\"Verdana\">\n                            l </font><a href=\"/site/skill_index/uo_bard_1/\"><font color=\"black\" face=\"Verdana\">도발(Provocation)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_bard_2/\"><font color=\"black\" face=\"Verdana\">평화연주(Peacemaking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_bard_3/\"><font color=\"black\" face=\"Verdana\">불협화음(Discordance)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_bard_cal/\"><font color=\"black\" face=\"Verdana\">바드 \n                            난이도 도표(Barding Difficulty)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>PROVOCATION<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_provo.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Bard</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 도발스킬 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Bard, Bard Guildmaster</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<center>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td class=\"top\" width=\"523\">\n<p style=\"line-height:100%; margin-top:3; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/combat/bard/b_1.gif\" width=\"100\">&nbsp;도발(프롭)은 \n                                            몬스터끼리 서로 공격을 하게 만드는 \n                                            기술 입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;플레이어는 \n                                            몬스터의 싸움을 보면서 사냥하시면 \n                                            됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;이때 \n                                            도발술이 유리한 장소를 터특하시는것이 \n                                            좋습니다. 유리한 장소란</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;몹의 \n                                            스폰이 너무 많은 지역을 배제 시키시고 \n                                            2마리정도 나오는 장소,</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;몹끼리 \n                                            싸울때 공격력이 높아 빨리 죽는곳을 \n                                            선호하시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;일예로 \n                                            데스타드같은곳도 프롭사냥하기 좋은 \n                                            장소입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;프롭은 \n                                            스킬 1이 오를때마다 2%의 성공율이 \n                                            증가되게 됩니다. 이때 2마리를 계산하게 \n                                            되므로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;A라는 \n                                            몹과 B라는 몹의 성공율을 더해서 \n                                            반으로 나누시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;예로 \n                                            바론 2마리를 프롭 시킨다면 프롭 \n                                            지엠100일때(보통악기,뮤지션100) \n                                            성공율이 30%라고 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;한다면 \n                                            레전인 스킬 120 즉,+20이 추가된다면 \n                                            성공율이 40%증가되어 70%가 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>&nbsp;스킬 \n                                            키우기</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">우선 \n                                            뮤지션을 90이상올리시는게 좋습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;프롭 \n                                            스킬이 0인 상태에선 우선 </span></font><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"FONT-SIZE: 9pt\"><b><font color=\"#006600\" face=\"Verdana\">악기상</font></b></span></a><font face=\"Verdana\"><span style=\"FONT-SIZE: 9pt\">에 \n                                            있는 </span><span style=\"font-size:9pt;\">NPC에게 \n                                            스킬을 배우러 갑니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;해당 \n                                            스킬을 배우게 되면 30정도 스킬을 \n                                            올리실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;이때 \n                                            바드난이도 도표에 있는 것을 참조하여 \n                                            도발이 약 30-50%정도의 성공율을 보이게되는</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;몹이나 \n                                            동물을 선택하시어 수련하시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;예로 \n                                            스킬 30일경우 델루시아에 있는 COW정도로 \n                                            수련하시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;요점만 \n                                            말하자면 원하시는 사냥터 데스파이즈의 \n                                            리자드맨을 사냥하고 싶은데.. 스킬이 \n                                            되지</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;않는다면 \n                                            익셉악기를 이용하시던지 팔찌와 반지에 \n                                            프롭옵이 추가되는 것을 착용하시어</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;리자드맨의 \n                                            스킬(30-50%성공율)에 마추시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;그리고 \n                                            어느정도 스킬이 되면 착용했던 악세사리를 \n                                            벗으시던지 보통악기를 이용하시어 \n                                            다시</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;올리시면 \n                                            됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;이런 \n                                            방법으로 올리시면 실제 스킬 60정도만 \n                                            되시어도 각종 악세사리와 익셉악기를 \n                                            이용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;데스타드에서 \n                                            드래곤으로도 올리실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;물론 \n                                            악세사리구입과 익셉악기가 구하기 \n                                            어려우신분이 계신다면 정석대로 해당 \n                                            스킬에 맞게</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;해당 \n                                            몹이나 동물을 이용하여 한단계씩 \n                                            올리시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">테이머가 \n                                            있으신분은 배 3개를 이용하여 스킬을 \n                                            간편하게 올리실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;좌우 \n                                            2개의 \n                                            배에는 드레이크 2마리를 1개는 \n                                            자신이 서있게 됩니다. 자신이 타고있는 \n                                            &nbsp;배와 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;드레이크가 \n                                            &nbsp;타고 있는 배와의 거리는 브레스공격을 \n                                            피할정도로 나두시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;익셉악기와 \n                                            악세사리를 \n                                            이용하면 처음부터 </span></font><a href=\"/site/dungeon/Drake/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Drake(드레이크)</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">를 이용하실 \n                                            수 있습니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;다음엔 </span></font><a href=\"/site/dungeon/Dragon/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Dragon(드래곤)</b></font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">, \n                                            </font></span><a href=\"/site/dungeon/S_Hyru/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Hiryu(히류</b></font><font color=\"black\" face=\"Verdana\">)</font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">를 \n                                            이용하여 레전까지 갈 수 있습니다. \n                                            110이 넘어서</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:3; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;스킬이 \n                                            잘 오르지 않으시는분은 </span></font><a href=\"/site/dungeon/S_RuneBeetle/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Rune \n                            Beetle(룬비틀)</b></font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">을 \n                                            이용하셔도 됩니다.</font></span></p>\n</td>\n</tr>\n</tbody></table>\n</center>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
