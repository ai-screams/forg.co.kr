  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_steal/\"><font color=\"black\" face=\"Verdana\">훔치기(Stealing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_hiding/\"><font color=\"black\" face=\"Verdana\">숨기(Hiding) \n                             \n                            </font></a><font color=\"black\" face=\"Verdana\">l&nbsp;</font><a href=\"/site/skill_index/uo_combat_stealth/\"><font color=\"black\" face=\"Verdana\">은폐이동(Stealth)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_snooping/\"><font color=\"black\" face=\"Verdana\">훔쳐보기(Snooping)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_detect/\"><font color=\"black\" face=\"Verdana\">은폐탐지(Detect Hidden)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_combat_tracking/\"><font color=\"black\" face=\"Verdana\">트랙킹(Tracking)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>HIDING</b></span></font><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\"><b>\n</b></font></span><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_hiding.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Rogue</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당스킬사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: </span></font><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\">Thief \n                            Guildmaster</font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(갑옷에 의한)와 이동제한</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"580\">\n<tbody><tr>\n<td> <p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            하이딩(은폐)의 종류</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하이딩은 \n                                        크게 마법 하이딩과 스킬 하이딩이 있습니다. \n                                        마법하이딩은 주위의 간섭에 상관없이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">100% \n                                        하이딩이 되는 반면 스킬하이딩은 주변에서 \n                                        어택을 받을 때 100% 실패하게 됩니다. \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">(이때는 \n                                        공격자와의 거리를 두고 재 시도를 해야 \n                                        합니다)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하지만 \n                                        이런 상황에서도 스킬하이딩의 메리트가 \n                                        되는것은 그 지속성에 있습니다. 메저리 \n                                        120을 가진</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">플레이어가 \n                                        해당 마법하이딩을 하게되면 144초의 지속성을 \n                                        가지지만, 스킬 하이딩은 영구적으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">지속되며 \n                                        심지어 로그아웃을 한 후 로그인을 다시해도 \n                                        하이딩한 채로 캐릭터가 서 있게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하이딩 \n                                        실패 후 다음 재 시도까지는 딜레이가 \n                                        약 11초정도 걸리게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">*인비차지아이템을 \n                                        착용 시 100% 하이딩이 됩니다. 해당 아이템은 \n                                        현재는 스폰이 안되며</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">*과거에 \n                                        있던 아이템으로 해당 차지수를 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            하이딩(은폐)의 유용성</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">1. \n                                        하이딩은 스틸링과 함께 매우 자주 사용하는 \n                                        스킬입니다. 스틸링은 레어헌터들에게 \n                                        유용한 스킬로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">2. \n                                        각종 아티팩트(</span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_knowhow/uo_knowhow_rare_5/\"><font color=\"green\" face=\"Verdana\"><b>둠,토쿠노섬던전레어</b></font></a><font color=\"black\" face=\"Verdana\">)</font></span><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">들을 \n                                        획득 시 쓰이게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">3. \n                                        스누핑시에도 하이딩을 한채 다른 플레이어의 \n                                        가방을 훔쳐볼수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">4. \n                                        던전이나 기타지역, 다른플레이어의 추격에서 \n                                        한가롭게 숨어 있을 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            하이딩(은폐)한 플레이어를 찾기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하이딩이 \n                                        100%로 안전한것은 아닙니다. 다음과 같은 \n                                        조건에 의해 발각되게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">1. \n                                        근처 선제공격을 하는 몬스터가 있을 시, \n                                        마법하이딩을 시전 완료 후에 몬스터에게 \n                                        자동으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">발각될 \n                                        확율이 커집니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">2. \n                                        6써클(Reveal)마법에 의해 발각되게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">3. \n                                        </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_detect/\"><font color=\"black\" face=\"Verdana\">은폐탐지(Detect Hidden)</font></a><font color=\"black\" face=\"Verdana\"> \n                                        스킬에 의해 발각되게 됩니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">4. \n                                        다른 플레이어가 해당 하이딩상태에 있는 \n                                        플레이어를 지나치게 될때는 플레이화면 \n                                        좌측하단에 </font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">메세지가 \n                                        도출됩니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">5. \n                                        </font><a href=\"/site/skill_index/uo_combat_tracking/\"><font color=\"black\" face=\"Verdana\">트랙킹(Tracking)</font></a><font color=\"black\" face=\"Verdana\"> \n                                        스킬을 시도하는 플레이어는 해당 하이딩한 \n                                        플레이어를 찾을 수 있습니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">하지만 \n                                        어느위치에 있는지만 알고 모습을 드러내게 \n                                        하지는 못 합니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">*2,3,5번은 \n                                        하이딩 스킬이 높을 수록 발각될 확율을 \n                                        낮추어 줍니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font color=\"purple\" face=\"Verdana\">*해당 \n                                        찾기의 경우는 펠루카 지역이나 적대적인 \n                                        길드에서만 가능합니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            하이딩(은폐)한 플레이어를 찾지는 못하지만 데미지를 \n                                        입히기.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하이딩한 \n                                        상태에서 다른플레이어가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">1. \n                                        폭탄포션을 던졌을때 근처에 혹은 자기자신이 \n                                        서 있는 곳에 폭탄포션이 터지면 데미지를 \n                                        입게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">됩니다. \n                                        물론 발각되지는 않지만 폭탄포션을 던진 \n                                        플레이어의 플레이화면상 좌측상단에 데미지표시가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">나오게 \n                                        됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">2. \n                                        독장벽을 깔았을때 하이딩한 상태에서는 \n                                        독 피해를 받게됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By \n\n                        Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
