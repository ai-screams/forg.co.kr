  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_m_1/\"><font color=\"black\" face=\"Verdana\">1써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_2/\"><font color=\"black\" face=\"Verdana\">2써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_3/\"><font color=\"black\" face=\"Verdana\">3써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_4/\"><font color=\"black\" face=\"Verdana\">4써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_5/\"><font color=\"black\" face=\"Verdana\">5써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_6/\"><font color=\"black\" face=\"Verdana\">6써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_7/\"><font color=\"black\" face=\"Verdana\">7써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_8/\"><font color=\"black\" face=\"Verdana\">8써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l&nbsp;</font><a href=\"/site/skill_index/uo_combat_m_s/\"><font color=\"black\" face=\"Verdana\">마법책만들기와 기초운용</font></a></span></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n                        &nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"560\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/mark.gif\" width=\"44\">Mark</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Kal \n                                        Por Ylem&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> 지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Blood Moss, Mandrake Root</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Mark는 장소를 기록하는 마법입니다. \n                                        시약상점에서 룬을 구입하신 후 해당 마법을 \n                                        사용</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">룬을 \n                                        클릭하시면 해당 룬에 현재 서 있는 위치가 \n                                        기록됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n                                        룬을 이용하여 4써클 리콜마법이나 팔라의 \n                                        이동마법으로 다른 곳에서 해당 위치로 \n                                        순간이동</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">하실 \n                                        수 있습니다. 또한 장소가 기록된 룬을 \n                                        더블클릭 하시면 해당 룬에 상세설명을 \n                                        플레이어가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">직접 \n                                        기입하실 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/invisibility.gif\" width=\"44\">Invisibility</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">An \n                                        Lor Xen</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">\n</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 메저리스킬의 120%&nbsp;(최고 144초)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Blood \n                                        Moss, Nightshade</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Invisibility은 주문으로 플레이어를 \n                                        하이딩(숨기)상태로 만들어 줍니다. 위급한 \n                                        상황에서</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">유용하게 \n                                        쓰일 수 있으며 펠루에서는 6써클 리빌마법으로 \n                                        공격자가 찾아낼 수 있으며 디텍히든</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬로도 \n                                        찾아낼 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/explosion.gif\" width=\"44\">Explosion</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Vas \n                                        Ort Flam</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;지속시간 \n                                        : 즉시(폭발이 터지는것은 2초 후)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Blood \n                                        Moss, Mandrake Root</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        &nbsp;: Explosion는 시간차 공격을 할 \n                                        때 용이하게 쓰입니다. 힐 타이밍을 흔들어 \n                                        놓는 공격으로 주문시전 후 2초 후 터지면서 \n                                        데미지가 들어가게 됩니다. 즉, 익스를 \n                                        넣고 타 공격마법과 같이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">쓰게 \n                                        되면 한꺼번에 데미지가 들어가게 됩니다. \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주문자는 \n                                        이벨스킬과 인스스킬로 데미지를 증가 \n                                        시킬수 있으며 지엠일경우 51-56의 데미지를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주게 \n                                        되며 방어자는 불저항 속성으로 데미지를 \n                                        감소시킬 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_2/\"><font color=\"teal\" face=\"Verdana\"><b>전투계산공식(스펠데미지)</b></font></a><font color=\"black\" face=\"Verdana\">편 \n                                        참조</font></span></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/reveal.gif\" width=\"44\">Reveal</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Wis \n                                        Quas&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Blood \n                                        Moss, Sulphurous Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Reveal은 숨어있는 몬스터나 플레이어를 \n                                        찾아주는 마법입니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">숨어있는 \n                                        사람의 하이딩 스킬,스텔스스킬과 주문자의 \n                                        메저리 스킬의 비교로 해당 지역의 리빌을 \n                                        광범위하게 찾아낼 수 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높은 \n                                        하이딩스킬을 가진 플레이어는 해당 서 \n                                        있는 위치에 리빌을 찍어주어야만 찾을 \n                                        수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">리빌과 \n                                        같은 원리의 스킬로는 디텍히든이 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">단, \n                                        자신의 집에서는 스킬0으로도 100% 디텍히든을 \n                                        하실 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/paralyze.gif\" width=\"44\">Energy \n                                        Bolt</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Corp \n                                        Por&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Nightshade</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Energy Bolt은 주문자가 에너지속성으로 \n                                        공격하는 마법입니다. 해당 방어자는 에너지 \n                                        저항으로 데미지를 감소 시킬 수 있습니다. \n                                        예전 이 마법을 갈매기라고도 불렀습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주문자는 \n                                        이벨스킬과 인스스킬로 데미지를 증가 \n                                        시킬수 있으며 지엠일경우 51-56의 데미지를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주게 \n                                        됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_2/\"><font color=\"teal\" face=\"Verdana\"><b>전투계산공식(스펠데미지)</b></font></a><font color=\"black\" face=\"Verdana\">편 \n                                        참조</font></span></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/dispel.gif\" width=\"44\">Dispel</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        :</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\"> An \n                                        Ort</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, \n                                        Mandrake Root, Sulphurous Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Dispel는 마법으로 소환된 정령이나 \n                                        동물등을 소멸시키는 마법입니다. 또한 \n                                        마법 장벽(불,독,에너지,돌)등을 소멸 \n                                        시킬 수도 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/mass_curse.gif\" width=\"44\">Mass \n                                        Curse</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Vas \n                                        Des Sanct&nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;지속시간 \n                                        : 메저리스킬의 120%&nbsp;(최대144초)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, \n                                        Mandrake Root, Nightshade, Sulphurous \n                                        Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Mass Curse은 4써클의 저주마법과 효과가 \n                                        동일하며 광역으로 해당 지역에 광역저주를 \n                                        걸게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Curse는 일시적으로 목표물의 Str, Dex, \n                                        Int 수치를 낮추는 마법입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">저주는 \n                                        또한 목표물의 최대 원소 저항력을 60% \n                                        감소 시킵니다. 이 효과는 주문자의 이벨스킬이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높을수록 \n                                        높아지며 \n                                        주의할점은 낮은 이벨을 \n                                        가진 주문자가 이효과를 주었을때 높은 \n                                        이벨을 가진 주문자의 해당 효과는 무시됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : (주문자의 메저리수치/10)+1</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메저리 \n                                                    100을 가진 주문자는 11%적용 \n                                                    합니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/paralyze_field.gif\" width=\"44\">PARALYZE \n                                        FIELD </b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In \n                                        Ex Grav</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;지속시간 \n                                        : 메저리스킬의 33%&nbsp;+3 (최고&nbsp;42.6 \n                                        초) </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Ginseng, Spider's Silk </span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : PARALYZE FIELD 는 접근하는 목표물의 \n                                        5써클 패럴의 효과를 줍니다. 움직이지 \n                                        못하는 효과는 (공격자의이벨/10-방어자의레지/10)*3</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n<font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"29\" src=\"/img/posts/site/skill_index/images/combat/8c/Spellbook.gif\" width=\"26\"></b></span></font><font color=\"#003300\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>6Circle</b></span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">(시전가능 \n                        메져리 : 52.1, 마나소비 : 20, &nbsp;100%성공스킬수치 : </span></font><font color=\"#CC3300\" face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
