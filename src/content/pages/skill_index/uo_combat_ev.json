  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><a href=\"/site/skill_index/uo_combat_meditation/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">명상(Meditation)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l&nbsp;</span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_spirit/\"><font color=\"black\" face=\"Verdana\">영혼대화(Spirit \n                            Speaking)</font></a></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;l \n                            </span></font><a href=\"/site/skill_index/uo_combat_ev/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">지능평가(Eval. Int)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> l </span></font><a href=\"/site/skill_index/uo_combat_resist/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">마법저항(Resist Spells)</font></span></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><a href=\"/site/skill_index/uo_combat_ev/\"><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\"><b>Eval. Int</b></font></span></a><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_eval.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Scholar </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: 없음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : Automatic(또는 해당스킬사용)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: City Mage, Gambler, Judge, Mage Guildmaster, \n                            Mage Shopkeeper, Magincia Councilmember, Mayor, \n                            Monk, Scribe, Wandering Mage </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:30; margin-bottom:0; margin-left:30;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 마법(Magery)사용</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<div align=\"center\"><table border=\"\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"3\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"530\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"heading\" width=\"444\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">스킬 구동시 상대방의 지능(마력)설명</span></b></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"heading\" width=\"95\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">상대방의 마력</span></b></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"그는 \n                                            돌머리 수준을 벗어났지만 아직 밥통이야.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">0*</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            돌보다 약간 멍청해 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">1-9</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            좀 멍청해 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">10-19</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            전혀 똑똑해 보이지 않습니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">20-29</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            평균 지능은 가진것으로 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">30-39</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            보통 지능을 가진것으로 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">40-49</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            높은 지능을 가진것으로 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">50-59</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            아주 높은 지능을 가진것으로 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">60-69</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            엄청나게 높은 지능을 가진것으로 \n                                            보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">70-79</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            경이로운 지능을 가진것으로 보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">80-89</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            천재라고 할만한 지능을 가진것으로 \n                                            보입니다.\"</span></font></p></td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">90-99</span></font></p></td>\n</tr>\n<tr>\n<td width=\"444\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">\"(그/그녀/그것)은 \n                                            당신이 감히 알수 없을 만큼 높은 \n                                            지능을 가진것으로</span></font>\n</p><p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">보입니다.\"</span></font></p>\n</td>\n<td align=\"center\" width=\"95\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">100+</span></font></p></td>\n</tr>\n<tr>\n<td class=\"comment\" colspan=\"2\" width=\"543\"> <p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                                            지능평가 실패시에는 \"당신은 \n                                            (그/그녀/그것)의 정신적인 능력을 \n                                            알&nbsp;수 없습니다\"라는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메시지를 \n                                            보게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> 이벨은 마법공격시 메저리와 \n                                            함께 마법공격의 데미지를 높여주는 역할을 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">즉 \n                                            상대방의 마법저항을 무시하여 데미지를 \n                                            높게 하는 역할 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그러므로 마법공격위주 플레이어는 \n\n            이벨은 필수적 스킬입니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                                            이벨스킬 76이상부터 상대방의 \n\n                        마나의 현 상태가 표시됩니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">\"</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n                                            대상의 정신력은 100퍼센트입니다.\"</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이표시는 상대방의 마나가 100%로 \n\n                        차있다는 표시입니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">*실제적으로 \n                                            마나가 0을 가진 생물체는 없습니다. \n                                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">즉, \n                                            무생물(상자나 돌 등등)에서 이러한 \n                                            메시지를 보게 됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10px;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">\n</span></font><span style=\"FONT-SIZE: 9pt\"><font face=\"Verdana\"><b>지능 평가 보너스</b></font></span></p>\n<p style=\"MARGIN: 0px 0px 0px 10px; LINE-HEIGHT: 100%\"><span style=\"FONT-SIZE: 9pt\"><font face=\"Verdana\">각 마법 주문의 피해는 시전자의 지능 평가(이하 이벨) 수치에 따라 \n영향을 받습니다.</font></span></p>\n<p style=\"MARGIN: 0px 0px 0px 10px; LINE-HEIGHT: 100%\"><span style=\"FONT-SIZE: 9pt\"><font face=\"Verdana\">이벨 보너스 계산법은 다음과 \n같습니다.</font></span></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"MARGIN: 0px; LINE-HEIGHT: 100%\" width=\"500\">\n<tbody>\n<tr>\n<td bgcolor=\"#ffffcc\">\n<p style=\"MARGIN: 0px; LINE-HEIGHT: 100%\"><span style=\"FONT-SIZE: 9pt\"><font face=\"Verdana\">이벨 보너스 = ( (이벨스킬 * 3) / 100 ) + \n1</font></span></p></td></tr></tbody></table>\n<p style=\"MARGIN: 0px 0px 0px 10px; LINE-HEIGHT: 100%\"><span style=\"FONT-SIZE: 9pt\"><font face=\"Verdana\">이벨 보너스는 기본 피해에 곱하게 \n되므로</font></span></p>\n<p style=\"MARGIN: 0px 0px 0px 10px; LINE-HEIGHT: 100%\"><span style=\"FONT-SIZE: 9pt\"><font face=\"Verdana\">이벨 스킬 1 증가 때 마다 3%의 피해 증가 효과가 \n있습니다.<br>이벨 스킬이 100일 경우 기본 피해에 4 배의 피해 증가가 있습니다.<br>이벨 스킬이 110일 경우 기본 피해에 4.3배의 \n피해 증가가 있습니다.<br>이벨 스킬이 120일 경우 기본 피해에 4.6배의 피해 증가가 있습니다.</font></span></p>\n<p style=\"line-height:50%; margin-top:0px; margin-right:0px; margin-bottom:0px; margin-left:10px;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:5; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">\n</span></b><span style=\"font-size:9pt;\">자세한 \n                                            사항은 </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_2/\"><font color=\"green\" face=\"Verdana\"><b>전투계산공식(스펠데미지)</b></font></a><font color=\"black\" face=\"Verdana\">을 \n                                            참조 하시기 바랍니다.</font></span></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table></div>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
