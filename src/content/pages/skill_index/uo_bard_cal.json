n<tr>\n<td bgcolor=\"#CCCC99\" valign=\"middle\">\n<p align=\"center\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>&nbsp;&nbsp;Peacemaking(평화유지)</b></span></font> </p></td>\n<td bgcolor=\"#CCCC99\" valign=\"middle\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"></span></font> </td>\n<td bgcolor=\"#CCCC99\" valign=\"middle\">\n<p align=\"center\"><font color=\"#EC2E00\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"11\" src=\"/img/posts/site/skill_index/images/ball.gif\" width=\"11\">Success(성공율%)</b></span></font> </p></td>\n<td bgcolor=\"#CCCC99\" valign=\"middle\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"></span></font> </td>\n</tr>\n<tr>\n<td bgcolor=\"#CCCC99\" valign=\"middle\">\n<p align=\"center\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>&nbsp;&nbsp;Provocation(도발술)</b></span></font></p></td>\n<td bgcolor=\"#CCCC99\" valign=\"middle\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"></span></font> </td>\n<td bgcolor=\"#CCCC99\" valign=\"middle\">\n<p align=\"center\"><font color=\"#EC2E00\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"11\" src=\"/img/posts/site/skill_index/images/ball.gif\" width=\"11\">Success(성공율%)</b></span></font></p></td>\n<td bgcolor=\"#CCCC99\" valign=\"middle\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"></span></font></td>\n</tr>\n<tr>\n<td align=\"middle\" bgcolor=\"#FFFFCC\" colspan=\"4\" valign=\"middle\">\n<p style=\"line-height:100%; margin-top:3; margin-bottom:0;\">&nbsp;<font face=\"Verdana\"><span style=\"font-size:9pt;\"></span></font> </p></td></tr>\n<tr>\n<td bgcolor=\"#FFFFCC\" colspan=\"4\" valign=\"middle\">\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">\n</p></td>\n</tr>\n</tbody></table>\n</center>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<center>\n<table align=\"center\" border=\"1\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"550\">\n<tbody><tr>\n<td class=\"top\" width=\"523\">\n<p style=\"line-height:100%; margin-top:3; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/music_3.gif\" width=\"30\">&nbsp;&nbsp;몬스터는 \n                                                기본적으로 해당 스킬,스탯,저항치를 \n                                                가지고 있습니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;이것을 \n                                                계산하여 해당몹의 바딩난이도가 \n                                                나오게 됩니다. 바딩난이도의 \n                                                최고치는 160을 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;넘지 \n                                                못합니다.(160이상은 \n                                                160으로 설정)&nbsp;위의 공식대로 \n                                                바딩난이도가 나오기 때문에 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;같은 \n                                                몹이라도 수치가 \n                                                틀리게 나오게 됩니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;같은 몹마다 \n                                                스탯이나 스킬수치가 다르게 스폰되기 \n                                                때문입니다. 애니멀 \n                                                로어를 이용하면</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;해당몹의 상세정보를 \n                                                알 수 있는데 테이머는 이것으로 \n                                                좋은 능력치를 가진 \n                                                애완동물만 골라 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;길들이기를 하게 \n                                                됩니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">파라곤은 \n                                                @표시를 해두었습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<b>바딩 \n                                                계산 수식</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">각 \n                                                바드의 스킬에서 우리는 바드공식계산에 \n                                                대해 어느정도 배웠습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;아래수식은 \n                                                참고만 하시고 각 스킬별로의 \n                                                설명드린 성공율에 관한것을 익히시는게 \n                                                좋습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;1. \n                                                뮤지션 스킬 : 100이상일때 (뮤지션스킬-100)x2의 \n                                                값 추가</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;2. \n                                                악기류에 대해</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;-익셉악기일때 \n                                                : 5추가</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;-해당몹에 \n                                                대해 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_mw_1/\"><span style=\"font-size:9pt;\"><font color=\"#006600\" face=\"Verdana\"><b>슬레이어</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">악기일때 10추가</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;-해당몹에 \n                                                대해 역슬레이어악기일때 -10감소</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;3. \n                                                프롭 적용일때 스킬+5추가, 디스코 \n                                                피스 적용일때는 해당스킬+10추가</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;다음과 \n                                                같은 공식으로 계산됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;성공율(%)=50+2x(1,2,3번의 \n                                                총합-몹의바딩수치)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;해당 \n                                                스킬을 배우게 되면 30정도 스킬을 \n                                                올리실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;예로 \n                                                뮤지션이 110, 익셉악기이용, \n                                                프롭스킬 90, 디스코 스킬 80, \n                                                피스스킬 80일때</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;바롱이(Balron)-바딩난이도 \n                                                115일때의 해당 스킬 성공율은 \n                                                다음과 같습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;1,2,3번의 \n                                                총합=1번(5)+2번(5)+3번(95)=105</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;프롭의 \n                                                성공율(%)=50+2x(105-115)=30%가됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;프롭일경우는 \n                                                해당몹 2마리를 각각 계산하여 \n                                                성공율을 합산하여 2로 나누시면 \n                                                됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;1,2,3번의 \n                                                총합=1번(5)+2번(5)+3번(90)=100</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:3; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;디스코,피스의 \n                                                성공율(%)=50+2x(100-115)=20%가됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</center>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"></p>\n",
