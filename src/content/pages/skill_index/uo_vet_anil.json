  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_anit/\"><font color=\"black\" face=\"Verdana\">길들이기(Taming)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_vet_anit_1/\"><font color=\"black\" face=\"Verdana\">테이밍스킬수치표</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_vet_anit_2/\"><font color=\"black\" face=\"Verdana\">주요스폰장소</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_vet_anil/\"><font color=\"black\" face=\"Verdana\">동물지식(Animal Lore)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_vet/\"><font color=\"black\" face=\"Verdana\">동물붕대힐(Veterinary)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_vet_he/\"><font color=\"black\" face=\"Verdana\">목동술(Herding)</font></a></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>ANIMAL LORE<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_al.gif\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Scholar</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: None</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당 스킬 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Animal Trainer, Rancher, Ranger, Ranger \n                            Guildmaster, Vegetable Seller</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: -</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\">\n<tbody><tr height=\"26\" style=\"mso-height-source:userset;height:20.1pt\">\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" height=\"26\" style=\"height:20.1pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물의 \n                                        상태표시</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물의 \n                                        충성심</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Wonderfully\n  happy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Extremely high</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Extremely\n  happy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Very high</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Very\n  happy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">High</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Rather\n  happy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Good</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Happy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Good</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Content</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Neutral</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Content,\n  I suppose</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Neutral</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Unhappy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Low</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Rather\n  unhappy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Low</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Extremely\n  unhappy</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Very low</span></font></p></td>\n</tr>\n<tr height=\"24\" style=\"mso-height-source:userset;height:18.0pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl23\" height=\"24\" style=\"height:18.0pt;width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Confused</span></font></p></td>\n<td class=\"xl23\" style=\"width:140pt\" width=\"187\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Extremely low</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> 애완동물의 \n                            부활시 적어도 동물치료(베네터리)와 \n                            동물지식(애니멀로어)의 스킬이 \n                            각 80이상이 되어야 하며 애완동물의 독치료시에는 \n                            각 60이상이 되어야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> 애니멀로어의 \n                            스킬을 구동 하신 후 몬스터나 동물을 타겟클릭하시면, \n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애니멀로어가 \n                            110이하일경우에는 테임할 수 있는 몬스터나 동물의 \n                            각종 수치를 도표로 보실 수</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있습니다. \n                            110이상일경우에는 테임되지 않는 몬스터의 각종 수치를 \n                            보실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물을 \n                            통솔할 수 있는 능력은 애니멀테이밍:애니멀로어의 \n                            비율이 8:2로 분포됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물의 \n                            상태표시(Wonderfully\n  happy)일때는 기분이 최고조로 되어있고, &nbsp;(Confused)일때는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테임이 \n                            풀리는 상황이므로 먹이를 주셔야 합니다. (먹이의 \n                            종류는 테이밍스킬수치표 참조)</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;                            </p><table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
