  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"center\" style=\"MARGIN-TOP: 0px; MARGIN-BOTTOM: 0px; MARGIN-LEFT: 0px; LINE-HEIGHT: 100%\"><span style=\"FONT-SIZE: 9pt\"><a href=\"/site/skill_index/uo_combat_m_1/\"><font color=\"black\" face=\"Verdana\">1써클</font></a><font color=\"black\" face=\"Verdana\"> l \n</font><a href=\"/site/skill_index/uo_combat_m_2/\"><font color=\"black\" face=\"Verdana\">2써클</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_m_3/\"><font color=\"black\" face=\"Verdana\">3써클</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_m_4/\"><font color=\"black\" face=\"Verdana\">4써클</font></a><font color=\"black\" face=\"Verdana\"> l \n</font><a href=\"/site/skill_index/uo_combat_m_5/\"><font color=\"black\" face=\"Verdana\">5써클</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_m_6/\"><font color=\"black\" face=\"Verdana\">6써클</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_m_7/\"><font color=\"black\" face=\"Verdana\">7써클</font></a><font color=\"black\" face=\"Verdana\"> l \n</font><a href=\"/site/skill_index/uo_combat_m_8/\"><font color=\"black\" face=\"Verdana\">8써클</font></a><font color=\"black\" face=\"Verdana\"> l&nbsp;</font><a href=\"/site/skill_index/uo_combat_m_s/\"><font color=\"black\" face=\"Verdana\">마법책만들기와 \n기초운용</font></a></span></p> </td>\n</tr>\n</tbody></table>\n<table align=\"center\" border=\"\" bordercolor=\"#999933\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"580\">\n<tbody><tr>\n<td align=\"right\" class=\"heading\" height=\"286\" width=\"595\">\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;\n                                        </p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"171\" src=\"/img/posts/site/skill_index/images/combat/8c/spell.gif\" width=\"250\"></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">울온에서는 마법으로 \n                        여러 가지 일들을 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">할 수 있습니다. \n                                        예로 리콜마법으로 \n                        몇시간이나 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">걸리는 대륙을 횡단하지 않고서도 원하는 지점으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이동 할수도 있고 \n                        게이트 마법으로 친구들과 같이 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이동하실수도 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                        그럼 마법을 쓸 때 무엇이 필요한지 알아 봅시다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:150%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">필요재료</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>1</b>. \n                                        해당마법을 쓰게 되는 스크롤(우리는 이미 \n                                        8써클란에서 각 마법을 대충 알아보았습니다. \n                                        )</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">1써클의 \n                                        매직애로우라는 공격마법을 쓰기위해서는 \n                                        매직애로우라는스크롤을 자신이 가지고 \n                                        있는 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마법책에 \n                                        드래그해서 넣어줘야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                                        해당 매직애로우라는 스크롤을 더블 클릭 \n                                        시 바로 사용 할 수 있지만 스크롤이 사라지기 \n                                        때문에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">1회용으로 \n                                        쓸 수밖에 없습니다. 하지만 해당 마법 \n                                        스크롤을 마법책에 넣어 준다면 약초와 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자신의 \n                                        마나만을 소비하여 계속 해당 마법을 쓸 \n                                        수 있게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그렇다면 \n                                        해당 스크롤은 어떻게 얻을 수 있는지 \n                                        알아 봅시다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-</span></font><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><b><font color=\"green\" face=\"Verdana\">마법(시약)상점</font></b></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">에서 \n                                        스크롤과 마법책을 구입 하실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-가운데 있는 사진은 던전에서 \n                        락픽스킬로 상자를딴 후 스크롤을 얻을 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(8써클은 \n                        최상급 던전의 상자나 최상급 몬스터에서만 나옵니다)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-맨 \n                                        오른쪽 사진과같이 몬스터를 \n                        처치한후에도 스크롤을 얻을수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-일반 \n                                        플레이어에게 구입하실수 있습니다. 울온직업스킬란-인스크립션편 \n                                        참조.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"1\" height=\"142\" src=\"/img/posts/site/skill_index/images/combat/8c/spell_menu.gif\" width=\"170\"><img border=\"1\" height=\"142\" src=\"/img/posts/site/skill_index/images/combat/8c/spell_chest.gif\" width=\"170\"><img border=\"1\" height=\"142\" src=\"/img/posts/site/skill_index/images/combat/8c/spell_cor.gif\" width=\"170\"></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>2</b>. \n                                        이제 마법과 스크롤이 준비되었다면 8써클에란을 \n                                        보시고 해당 마법을 쓰기위한</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        약초와 자신이 가지고 있는 마나수치가 \n                                        충족되었는지 확인해 봅시다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마나 \n                                        수치를 높이실려면 지능에 관련된 스킬(마법사용,이벨,명상등)을 \n                                        꾸준히 사용하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">3. \n                                        </span></b><span style=\"font-size:9pt;\">이제 \n                                        약초에 대해서 알아봅시다. 8써클란에서 \n                                        우린 이미 해당마법에 해당약초가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">무엇이 \n                                        필요한지 알 수 있었습니다. 물론 울온상에서 \n                                        마법책을 펼치고 해당 마법을 클릭하면</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">소요되는 \n                                        약초가 상세히 나옵니다. 약초를 구입할려면 \n                                        각 던전이나 숲에서 자라고 있는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">약초(시약)을 \n                                        줏어서 쓸 수 있지만 간편하게 시약(마법)상점에서 \n                                        구입하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"#108000\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>중요시약은 \n                                        다음과 같습니다.</b></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"198\" src=\"/img/posts/site/skill_index/images/combat/8c/reagents.gif\" width=\"128\"></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Black \n                                        Perl(흑진주) : 약 6Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Blood \n                                        Moss(피이끼) : 약 5Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Mandrake \n                                        Root(맨드레이크 뿌리)&nbsp;: 약 3Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Spider's \n                                        Silk(거미줄) : 약 3Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Sulphurous \n                                        Ash(유황가루) : 약 3Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;NightShade(독풀) \n                                        : 약 3 Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Ginseng(인삼) \n                                        : 약 3Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Garlic(마늘) \n                                        : 약 3Gp</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">4. \n                                        이제 모든 준비가 완료 되었을 것입니다. \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">마법스크롤이 \n                                        저장된 마법책+해당 약초+마나수치의충족</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n                                        상태에서 마법을 구동하면 마법을 쓰실 \n                                        수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5. \n                                        주의할점은 해당 마법의 1-8써클은 메저리 \n                                        수치에 의해 성공여부의 확률이 들어가게 \n                                        됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높은 \n                                        써클의 마법을 쓰실려면 메저리를 올리셔야 \n                                        합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메저리를 \n                                        올리실려면 8써클란에서 보신대로 자신이 \n                                        가지고 있는&nbsp;메저리 수치일 때 해당 \n                                        써클의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마법중 \n                                        하나를 계속 쓰시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">이제 \n                                        그림과 함께 해당 마법을 쓰는 방법에 \n                                        대해서 알아봅시다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">A.<img border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/ins/fullbook.gif\" width=\"25\">자신이 \n                                        가지고 있는 마법책을 더블클릭 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">B. \n                                        아래 그림과 같이 펼쳐진 마법책이 나옵니다.</span></font><img align=\"left\" border=\"0\" height=\"195\" src=\"/img/posts/site/skill_index/images/combat/8c/fullbook_1.gif\" width=\"320\"></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">1.책을 \n                                        접는 아이콘입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마우스 \n                                        오른쪽 버튼을 누르면 마법책이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">화면에서 \n                                        사라지지만 이 버튼은 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">화면상에 \n                                        작은&nbsp;마법책으로 남게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2.해당 \n                                        마법의 상세목록으로 들어갑니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3.해당 \n                                        써클의 상세목록으로 들어갑니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(8써클에 \n                                        무엇이 있는지 볼려면 8번을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">누르시면 \n                                        바로가게 됩니다)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">4. \n                                        써클별로 순차적으로 넘어가게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(책장을 \n                                        넘긴다고 생각하시면 됩니다)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">C.이제 \n                                        2번을 눌렀을 때 나오는 마법책을 알아봅시다.<img align=\"left\" border=\"0\" height=\"180\" src=\"/img/posts/site/skill_index/images/combat/8c/fullbook_2.gif\" width=\"320\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        상세 마법 목록이 나옵니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보시는 \n                                        그림과 같이 해당 마법의 필요한</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">약초리스트를 \n                                        알 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마법을 \n                                        구동 하실 때에는 간단히</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        마법그림을 더블 클릭 하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        편하게 계속 쓰고 싶다면 그림과</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">같이 \n                                        해당마법을 드래그하여 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">울온상 \n                                        화면에다 놓아주시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p></td>\n</tr>\n</tbody></table>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
