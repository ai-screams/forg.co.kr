  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_m_1/\"><font color=\"black\" face=\"Verdana\">1써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_2/\"><font color=\"black\" face=\"Verdana\">2써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_3/\"><font color=\"black\" face=\"Verdana\">3써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_4/\"><font color=\"black\" face=\"Verdana\">4써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_5/\"><font color=\"black\" face=\"Verdana\">5써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_6/\"><font color=\"black\" face=\"Verdana\">6써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_7/\"><font color=\"black\" face=\"Verdana\">7써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_8/\"><font color=\"black\" face=\"Verdana\">8써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l&nbsp;</font><a href=\"/site/skill_index/uo_combat_m_s/\"><font color=\"black\" face=\"Verdana\">마법책만들기와 기초운용</font></a></span></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n                        &nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>MAGERY<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_magery.gif\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Mage</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: None</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당 마법 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Mage Guildmaster, Mage</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"560\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/Clumsy.gif\" width=\"44\">Clumsy</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Uus Jux \n                                        &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : (((이벨 / 5) + 1) * 6)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Bloodmoss, Nightshade</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Clumsy는 일시적으로 적의 Dex를 감소시키는 \n                                        마법입니다. 이 효과는 공격자의 이벨이 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높을수록 \n                                        더 많은 감소효과를 발생시킵니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        효과지속시간 중 재시도를 하게되면 해당 \n                                        시간이 처음부터 다시 지속됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어자는 \n                                        자신의 레지스킬로 이 효과를 감소시킬 \n                                        수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : (공격자의이벨/10) + 8 \n                                                    ) - ( 방어하는 자의 레지/10 \n                                                    )</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이벨 \n                                                    100을 가진 공격자가 레지 \n                                                    100을 가진 적을 공격시 &nbsp;8%의 \n                                                    민첩 감소를 발생</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/Clumsy.gif\" width=\"44\">Create Food</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In Mani Ylem \n                                        &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, Ginseng, Mandrake \n                                        Root</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : </span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">Create Food</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">는 \n                                        랜덤하게 음식을 만드는 마법입니다.&nbsp;가능한 \n                                        음식은 다음과 같습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(grapes, \n                                        ham, cheese, muffins, fish, ribs, chicken, \n                                        sausage, apple or peach)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        마법은 애완동물에게 음식을 먹일때 유용하게 \n                                        쓰입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/feeblemind.gif\" width=\"44\">FEEBLEMIND</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Rel \n                                        Wis &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : (((이벨 / 5) + 1) * 6)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Nightshade, Ginseng</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">FEEBLEMIND</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">는 \n                                        일시적으로 적의 Int를 감소시키는 마법입니다. \n                                        이 효과는 공격 받는자의 </span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마나뿐만이 \n                                        아니라 마나재생도 감소시킵니다. 다른 \n                                        마사나 네크로멘서, 특수기를 사용하는 \n                                        팔라딘등과의 전투에서 유용하게 쓰일 \n                                        수 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n                                        효과는 공격자의 이벨이 높을수록 더 많은 \n                                        감소효과를 발생시킵니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        효과지속시간 중 재시도를 하게되면 해당 \n                                        시간이 처음부터 다시 지속됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어자는 \n                                        자신의 레지스킬로 이 효과를 감소시킬 \n                                        수 있습니다</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : (EVAL/10) + 8 ) - ( RESIST/10 \n                                                    )</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이벨 \n                                                    100을 가진 공격자가 레지 \n                                                    100을 가진 적을 공격시 &nbsp;8%의 \n                                                    민첩 감소를 발생</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/nightsight.gif\" width=\"44\">Night \n                                        Sight</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In \n                                        Lor &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 다음 해질녘이나 해뜰때까지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Spider’s Silk, Sulphurous \n                                        Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Clumsy는 야간에 시야를 밝게 비칠때 \n                                        사용하는 마법으로 자신에게 직접 사용하거나</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">타인에게 \n                                        사용할 수 있으며 어느정도 효과를 보실려면 \n                                        필요 메저리는 10이상입니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그 \n                                        이하의 메절 수치라면 대단히 어둡게 될것입니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/magic_arrow.gif\" width=\"44\">Magic \n                                        Arrow</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In \n                                        Por Ylem &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Sulphurous Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Clumsy는 목표물에 불화살을 날리는 \n                                        마법공격을 합니다. 당연히 방어자는 불속성 \n                                        저항에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">의해 \n                                        데미지 계산을 받게 됩니다. 해당 마법은 \n                                        이벨과 인스크립션 스킬 향상을 통해 데미지가 \n                                        증가될 수 있습니다. </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_2/\"><font color=\"teal\" face=\"Verdana\"><b>전투계산공식(스펠데미지)</b></font></a><font color=\"black\" face=\"Verdana\">편 \n                                        참조</font></span></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/reactive_armor.gif\" width=\"44\">Reactive \n                                        Armor</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : Flam Sanct &nbsp;지속시간 \n                                        : 마법 재 사용까지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, Spider's Silk, Sulphurous \n                                        Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Reactive Armor는 주문자의 물리적 저항을 \n                                        높여 주는 조건으로 다른 원소 저항을 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-5 \n                                        낮춰 줍니다. 주문 발생시 영구히 유지되며 \n                                        재 주문을 하시면 효과가 사라지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물리적 \n                                        피해만을 주는 몬스터 등에게 유용하게 \n                                        사용하실 수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    :15 + (인스크립션/20)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">인스크립션 \n                                                    100을 가진 주문자가 리엑 \n                                                    시도시 +20의 물리적저항 \n                                                    상승과 각 원소저항들이 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-5씩 \n                                                    줄어들게 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/heal.gif\" width=\"44\">Heal</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In Mani</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                        &nbsp;지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, Ginseng, Spider's \n                                        Silk</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Heal은 4써클 그레이트힐의 하위 마법으로 \n                                        소량의 데미지를 치료합니다. 만약 주문자나</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">다른 \n                                        플레이어, 애완동물등이 독이 걸려 있다면 \n                                        우선 해독부터해야 해당마법이 적용됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : (주문자의 메저리수치/10) \n                                                    + (1 에서 3)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메저리 \n                                                    100을 가진 주문자가 힐을 \n                                                    했을 경우 11-13포인트의 \n                                                    힐의 양이 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/Clumsy.gif\" width=\"44\">Weaken</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Des Mani \n                                        &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : (((이벨 / 5) + 1) * 6)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, Nightshade</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Weaken는 일시적으로 적의 Str을 감소시키는 \n                                        마법입니다. 이 효과는 공격자의 이벨이 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높을수록 \n                                        더 많은 감소효과를 발생시킵니다. Str를 \n                                        감소시키므로 당연히 공격자의 히트포인트도 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">줄게되며 \n                                        공격데미지(무기류)도 줄어들게 됩니다. \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        효과지속시간 중 재시도를 하게되면 해당 \n                                        시간이 처음부터 다시 지속됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어자는 \n                                        자신의 레지스킬로 이 효과를 감소시킬 \n                                        수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : ((이벨/10) + 8 ) - (레지/10 \n                                                    )</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이벨 \n                                                    100을 가진 공격자가 레지 \n                                                    100을 가진 적을 공격시 &nbsp;8%의 \n                                                    힘  감소를 발생</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n<font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"29\" src=\"/img/posts/site/skill_index/images/combat/8c/Spellbook.gif\" width=\"26\"></b></span></font><font color=\"#003300\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>1Circle</b></span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">(시전가능 \n                        메져리 : 0.1, &nbsp;마나소비 : 4, 100%성공스킬수치 : </span></font><font color=\"#CC3300\" face=\"Verdana\"><span style=\"font-size:9pt;\">22</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
