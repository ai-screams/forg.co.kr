  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_m_1/\"><font color=\"black\" face=\"Verdana\">1써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_2/\"><font color=\"black\" face=\"Verdana\">2써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_3/\"><font color=\"black\" face=\"Verdana\">3써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_4/\"><font color=\"black\" face=\"Verdana\">4써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_5/\"><font color=\"black\" face=\"Verdana\">5써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_6/\"><font color=\"black\" face=\"Verdana\">6써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_7/\"><font color=\"black\" face=\"Verdana\">7써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_8/\"><font color=\"black\" face=\"Verdana\">8써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l&nbsp;</font><a href=\"/site/skill_index/uo_combat_m_s/\"><font color=\"black\" face=\"Verdana\">마법책만들기와 기초운용</font></a></span></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n                        &nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"560\">\n<tbody><tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/magic_reflection.gif\" width=\"44\">Magic \n                                        Reflection</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In Jux Sanct \n                                         </span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 마법 재 사용까지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, \n                                        Mandrake Root, Spider's Silk </span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Magic Reflection은 주문자의 \n                                        물리적저항력을 감소시키며(마이너스로도 \n                                        됩니다.)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">대신에 \n                                        다른 원소 저항력을 높여 줍니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주문 발생시 영구히 유지되며 \n                                        재 주문을 하시면 효과가 사라지게 됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : 물리적저항감소 = 25-(인스스킬/20), \n                                                    다른원소저항력증가 = +10</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지엠인스스킬을 \n                                                    가진 주문자는 -20의 물리적저항이 \n                                                    감소, 다른 원소저항은 +10 \n                                                    증가</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/mind_blast.gif\" width=\"44\">MIND \n                                        BLAST</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Por Corp Wis \n                                        </span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Mandrake Root, Nightshade, Sulphurous \n                                        Ash \n                                        &nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : MIND BLAST은 목표물에 \n                                        냉기데미지를 줍니다. 해당 데미지는 오직 \n                                        주문자의 메저리</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬+INT에만 \n                                        영향을 받고 방어자는 냉기저항수치에 \n                                        의해 데미지를 감소 시킬 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_2/\"><font color=\"teal\" face=\"Verdana\"><b>전투계산공식(스펠데미지)</b></font></a><font color=\"black\" face=\"Verdana\">편 \n                                        참조</font></span></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/blade_spirits.gif\" width=\"44\">Blade \n                                        Spirits</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In Jux Hur Ylem</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                        &nbsp;지속시간 \n                                        : 120초</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black Pearl, \n                                        Mandrake Root, Nightshade</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        &nbsp;: Blade Spirits는 \n                                        날카로운 칼날의 소환물로 근처에(반경 \n                                        6타일에서 목표물을 찾음)&nbsp;있는 적에게 \n                                        데미지를 줍니다. 칼날이 1번째 목표물로 \n                                        대상을 찾는 것은 해당 목표물의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Str+택틱)/근접한 \n                                        타일수의 수치로 정하게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">에너지볼텍스는 팻이 아니므로 \n                                        공격이나</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">팔로우등의 \n                                        명령에 따르지 않습니다. 컨트롤이 되지 \n                                        않기 때문에 디스펠에 대한 마법저항력이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높습니다</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        소환물은 6써클 디스펠로 없앨 수 있으며 \n                                        애완동물의 슬롯수의 2을 차지하게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        5x5타일안에 해당 볼텍스나 블레이드스피릿이 \n                                        연속적으로 여러 플레이어들이 풀었을때 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">총 \n                                        6마리까지 마리 수 제한이 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/combat/8c/incognito.gif\" data-recovery=\"missing\" height=\"44\" src=\"/img/placeholder/missing.svg\" width=\"44\">INCOGNITO</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Kal In Ex \n                                        </span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;지속시간 \n                                        : 120 메저리 스킬일때 (144초)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Blood Moss, \n                                        Garlic, Nightshade</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : INCOGNITO은 일시적으로 \n                                        주문자의 외모와 이름을 바꾸게 해줍니다. \n                                        </span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/paralyze.gif\" width=\"44\">PARALYZE</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">An Ex Por \n                                        </span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : (공격자의이벨/10-방어자의레지/10)*3</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Mandrake Root, \n                                        Garlic, Spider's Silk \n                                        &nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : PARALYZE은 목표물을 \n                                        일정시간 움직이지 못하게 합니다. 패럴마법을 \n                                        당한 방어자는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">시간이 \n                                        지났을 경우나, 밀리어택이나 공격마법을 \n                                        당했을때 풀리게 되며 주문자의 이벨 스킬로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        시간이 증가되게 됩니다. 방어자는 레지스킬로 \n                                        해당시간을 단축시킬 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">패럴로 \n                                        인하여 블루캐릭이 죽었을경우 머더러 \n                                        카운터를 먹게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/summon_creature.gif\" width=\"44\">Summon \n                                        Creature</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        :</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\"> Kal \n                                        Xen</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                        &nbsp;지속시간 \n                                        : 4 * 메저리스킬&nbsp;(최고 480초)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Blood \n                                        Moss, Spider’s Silk, Mandrake Root</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Summon Creature는 랜덤으로 동물을 \n                                        소환하는 마법입니다. 시간이 지나면 자연적으로 \n                                        소멸되므로 다른 플레이어에게 줄수 없으며 \n                                        테임된 동물처럼 명령에 의해&nbsp;행동합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/poison_field.gif\" width=\"44\">POISON \n                                        FIELD</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In \n                                        Nox Grav </span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;지속시간 \n                                        : 메저리 수치의 40%&nbsp;+3 (최고 51초)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Nightshade, Spider's Silk</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : POISON FIELD은 일시적으로 필드에 독장벽을 \n                                        생성시킵니다. 근처에 접촉하는 플레이어나 \n                                        몬스터, \n                                        생물등은 독의 피해를 입게됩니다. 해당마법은 \n                                        메저리스킬과 포이즈닝스킬에 의존하며 \n                                        포이즈닝 스킬까지 첨부된 플레이어는 \n                                        레벨4의 독으로 장벽을 깔 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/dispel_field.gif\" width=\"44\">Dispel \n                                        Field</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">An \n                                        Grav</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                        &nbsp;지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Garlic, Spider's Silk, Sulphurous \n                                        Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Dispel Field는 필드스펠 즉, 돌장벽,불장벽,독장벽,에너지장벽등의 \n                                        필드마법을 무효화</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">시키는 \n                                        마법입니다. 물론 게이트도 제거 할 수 \n                                        있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">펠루지역에서는 \n                                        다른 플레이어의 마법을 디스펠필드로 \n                                        무효화시킬수 있지만, 르네지역에서는 \n                                        </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">같은 \n                                        길드원이나,길드워중인 플레이어만 적용됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n<font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"29\" src=\"/img/posts/site/skill_index/images/combat/8c/Spellbook.gif\" width=\"26\"></b></span></font><font color=\"#003300\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>5Circle</b></span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">(시전가능 \n                        메져리 : 38.1, 마나소비 : 14, &nbsp;100%성공스킬수치 : </span></font><font color=\"#CC3300\" face=\"Verdana\"><span style=\"font-size:9pt;\">78</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
