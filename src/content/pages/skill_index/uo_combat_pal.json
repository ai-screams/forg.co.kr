  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_pal/\"><font color=\"black\" face=\"Verdana\">팔라딘상세정보</font></a><font color=\"black\" face=\"Verdana\">&nbsp;l \n                            </font><a href=\"/site/skill_index/uo_combat_necro/\"><font color=\"black\" face=\"Verdana\">네크마법상세정보</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_combat_ninja/\"><font color=\"black\" face=\"Verdana\">닌자상세정보</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_combat_busido/\"><font color=\"black\" face=\"Verdana\">무사도상세정보</font></a></span></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Paladin<img align=\"right\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/logo_chi.gif\" data-recovery=\"missing\" height=\"60\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/60\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Paladin</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: 없음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: 없음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당 마법 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Paladins(루나)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"#000066\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(이동스킬)</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"580\">\n<tbody><tr>\n<td bgcolor=\"#CCCC99\" width=\"44\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">표시</span></font></p>\n</td>\n<td bgcolor=\"#CCCC99\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명</span></font></p>\n</td>\n<td bgcolor=\"#CCCC99\" width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬</span></font></p>\n</td>\n<td bgcolor=\"#CCCC99\" width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">십일조</span></font></p>\n</td>\n<td bgcolor=\"#CCCC99\" width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마나</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/closewounds.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">50</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Close \n                                        Wounds</b>: 타겟의 데미지에 대해 7~39 \n                                        포인트 만큼을 회복시킨다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">시전자(팔라딘)의 \n                                        카르마가 높으면 회복량 또한 증가한다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">0</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/cleansebyfire.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">55</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Cleanse \n                                        by Fire</b>: 타겟의 독을 치료하지만 \n                                        시전자에게 13~55포인트의 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">불데미지를 \n                                        입힌다. 만약 시전자의 카르마가 높다면, \n                                        이러한 불데미지 양은 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">줄어든다. 또한 \n                                        이 스펠을 시전하는 시전자가 그러한 불데미지로 \n                                        인해 죽지는 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">않는다. 그러나 최대한 hp가 \n                                        0까지 줄어들 수 있다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(0에는 +0과 -0이 \n                                        있다. -0이 되면 죽는다.)</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/removecurse.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">55</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Remove \n                                        Curse</b>: 타겟의 모든 저주를 제거한다. \n                                        모든 저주란 네크로맨서의 저주뿐만 아니라 \n                                        Clumsy, Weaken, Feeblemind, Paralyze \n                                        같은 마법사의 저주 또한 포함한다. 저주제거의 \n                                        성공정도는 시전자의 카르마에 의해 영향을 \n                                        받는다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/consecrateweapon.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">65</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Consecrate \n                                        Weapon</b>: 일시적으로 시전자가 현재 \n                                        휘두르고 있는 무기에 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마법을 건다. 타겟을 \n                                        공격할 때 무기가 가하는 데미지의 형태는 \n                                        타겟의 가장 낮은 저항의 종류에 따라 \n                                        전환된다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">효과의 \n                                        지속시간은 시전자의 카르마에 의해 영향을 \n                                        받으며, 3~11초 정도 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">유지가 된다. (카르마가 \n                                        높을수록 지속시간 또한 길어짐)</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/sacredjourney.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">65</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Sacred \n                                        Journey</b>: 팔라딘은 신성한 힘을 이용하여 \n                                        스펙트럼 같은 수수께끼의 마법의 길을 \n                                        만들 수 있다. 이 길을 이용하여, 팔라딘은 \n                                        recall과 같이 즉시 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마크된 장소로 이동할 \n                                        수 있다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">그러나 \n                                        이 능력을 사용하기 위해서, 팔라딘은 \n                                        전투상태가 아니어야 한다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">왜냐하면 목적이 \n                                        비겁하고, 비기사도적이라면 팔라딘이 \n                                        필요한 신성한 힘을 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소환할 수 없기 때문이다. \n                                        </span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/divinefury.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">75</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Divine \n                                        Fury</b>: 일시적으로 팔라딘의 무기 사용속도와, \n                                        명중률, 데미지를 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">증가시키지만, 반면에 \n                                        팔라딘의 방어력은 낮춘다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 시전 \n                                        중, 팔라딘의 Stamina는 회복된다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스펠의 \n                                        지속시간은 시전자인 팔라딘의 카르마에 \n                                        영향을 받는다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간은 7~22초간이다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">25</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/dispelevil.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">85</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Dispel \n                                        Evil</b>: 소환된 생명체를 dispel하고 \n                                        전투로부터 다른 나쁜 생명체를 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">도망가도록 \n                                        만든다. 변신한 네크로맨서 또한 Stamina와 \n                                        Mana에 데미지를 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">입는다. 시전자인 팔라딘의 \n                                        카르마와 Chivalry, 그리고타겟인 네크로의 \n                                        명성과 Necromancy는 dispel의 성공정도에 \n                                        영향을 미친다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">35</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/enemyofone.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">95</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Enemy \n                                        of One</b>: 팔라딘이 지정하는 타겟은 \n                                        죽어야 할 운명의 적이 된다. </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지정된 종류의 \n                                        생명체를 타겟으로 할 경우 모든 전투데미지가 \n                                        </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">50%증가 한다. &nbsp;그러나 다른 종류의 생명체일 \n                                        경우 타겟에 의해 팔라딘이 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">입는 데미지가 \n                                        증가한다. 지정된 타겟은 팔라딘에게는 \n                                        밝은 오렌지색으로 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보인다. 효과의 지속시간은 \n                                        시전자인 팔라딘의 카르마에 영향을 받으며 \n                                        1.5~3.5분정도 지속된다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">45</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/holylight.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">105</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Holy \n                                        Light</b>: 시전자 주변의 반경에 있는 \n                                        유효한 타겟에게 energy 데미지를 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">준다. \n                                        데미지의 양은 시전자의 카르마에 의해 \n                                        영향을 받으며, </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">8~24포인트의 데미지를 \n                                        준다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">55</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">15</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"44\"> <p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/pal/noblesacrifice.gif\" width=\"44\"></span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">115</span></font></p>\n</td>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Noble \n                                        Sacrifice</b>: 시전자 주위의 반경에 \n                                        있는 모든 타겟들에게 Resurrect(부활), \n                                        cure(독치료), Heal(hp회복)을 시킨다. \n                                        </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">만약 팔라딘의 이 Noble Sacrifice이 어느 \n                                        한 타겟에라도 성공한다면, 팔라딘의 현 \n                                        hp와 mp, Stamina가 1이 된다. 회복량은 \n                                        시전자인 팔라딘의 카르마에 의해 결정되며, \n                                        이는 9~24 포인트이다.</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">65</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">30</span></font></p>\n</td>\n<td width=\"26\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" colspan=\"5\" width=\"574\"> <p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"65\" src=\"/img/posts/site/skill_index/images/combat/pal/pal_book_s.gif\" width=\"70\">팔라딘의 \n                            능력을 사용하기 위해서는 팔라딘은 반드시 해당 스펠이 \n                            들어있는 팔라딘 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스펠북을 가지고 있어야 하며, 적정수준의 \n                            Chivalry skill과 적정량의 십일조를 가지고 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있어야한다. \n                            십일조 점수는 Shrine(사원)에 기부함으로써 얻을 수 \n                            있다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">십일조 \n                            점수는 기부하는 돈만큼 올라간다.(1 gp=1 point) Shrine's \n                            ankh </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(사원의 십자가)에 뜨는 메뉴를 이용하여, 기부하고자 \n                            하는 돈을 조절할 수 있다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">팔라딘의 \n                            마법효과는 플레이어가 지닌 팔라딘스킬수치로 향상되는것이 \n                            아닌 카르마의 수치로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">강해집니다. \n                            스킬수치는 성공율에 영향을 미칩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">카르마와 \n                            명성에대해서는 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_fame/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>각종유용한정보-명성과카르마편</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                            참조하시길.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">사원은 \n                                        루나은행 2층에 있는 앵크를 이용하시면 \n                                        편합니다. 머더러의 경우는 펠루카지역에 \n                                        있는</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">윈드던전 \n                                        아래의 카오스신전을 이용하실 수 있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:18;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">*보라색 \n                            수치는 해당 스킬 수치일때 100% 시전 성공율을 의미합니다</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">.</span></font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By EZUMAMA</span></b></font></p>\n<p align=\"right\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
