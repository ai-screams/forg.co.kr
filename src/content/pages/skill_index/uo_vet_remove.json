  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_carto/\"><font color=\"black\" face=\"Verdana\">지도해석(Cartograhpy)</font></a></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_index/uo_vet_carto_1/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">스킬도표</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_index/uo_vet_lock/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">자물쇠따기(Lockpicking)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> l </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_remove/\"><font color=\"black\" face=\"Verdana\">트랩해체(Remove \n                            Trap)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><a href=\"/site/skill_knowhow/uo_knowhow_tmap/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도(대륙)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_knowhow/uo_knowhow_tmapi/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도(섬)</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">\n</font></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">l </span></font><a href=\"/site/skill_index/tmap/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도</font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>REMOVE \n                            TRAP<img align=\"right\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/logo_remove.gif\" data-recovery=\"missing\" height=\"60\" src=\"/img/placeholder/missing.svg\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Rogue</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Intelligence </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당 스킬 사용(지팡이-Crook)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Thief, Thief Guildmaster, Tinker, Tinker \n                            Guildmaster</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">(락픽킹과 \n                            디텍히든의 스킬 수치가 50이상일때 배우실 수 있습니다.)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" width=\"560\">\n<tbody><tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>A</b>. \n                                        함정해제는 폭탄이나 독,화살등의 트랩이 \n                                        상자에 설치되어 있는 것을 제거 해주는 \n                                        스킬입니다. 레벨 5등의 보물상자등은 \n                                        직접 열거나 할때 즉사하는 경우가 대부분이기 \n                                        때문에 트랩해제로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주로 \n                                        쓰이는 것인데 메저리에 있는 4써클 텔레키니스(Telekinesis)라는 \n                                        마법으로 원거리에서</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        상자를 건들이면 피해없이 상자가 터지므로, \n                                        폭파 후 다가가서 상자를 여시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>B</b>. \n                                        락픽킹과 디텍히든의 스킬수치가 50이상일때 \n                                        해당 스킬을 NPC에게 배우실 수 있고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        해당 스킬을 쓸 수 있습니다. 2조건이 \n                                        만족하지 않으면 스킬 발동이 되지를 않습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">일단 \n                                        함정해제의 스킬을 구동하시면 잠긴상자를 \n                                        락픽킹으로 열지 않은 채 트랩만 제거하실 \n                                        수</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:30%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
