  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_m_1/\"><font color=\"black\" face=\"Verdana\">1써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_2/\"><font color=\"black\" face=\"Verdana\">2써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_3/\"><font color=\"black\" face=\"Verdana\">3써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_4/\"><font color=\"black\" face=\"Verdana\">4써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_5/\"><font color=\"black\" face=\"Verdana\">5써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_6/\"><font color=\"black\" face=\"Verdana\">6써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_7/\"><font color=\"black\" face=\"Verdana\">7써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l </font><a href=\"/site/skill_index/uo_combat_m_8/\"><font color=\"black\" face=\"Verdana\">8써클</font></a><font color=\"black\" face=\"Verdana\"> \n                                        l&nbsp;</font><a href=\"/site/skill_index/uo_combat_m_s/\"><font color=\"black\" face=\"Verdana\">마법책만들기와 기초운용</font></a></span></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n                        &nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"560\">\n<tbody><tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/recall.gif\" width=\"44\">Recall</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Kal \n                                        Ort Por &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black \n                                        Pearl, Blood Moss, Mandrake Root &nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Recall은 장소이동 마법입니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">플레이어는 \n                                        6써클 마법 Mark를 이용하여 시약상점에서 \n                                        구입한 룬을 마킹합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마킹된 \n                                        룬은 해당장소를 기억하며 4써클 리콜마법으로 \n                                        순간이동하게 됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마킹은 \n                                        특정지역에서 불가능 한데 던전지역,바다나 \n                                        물지역등이고, 리콜할때 해당 장소가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">블럭(돌이나,상자,백볼등으로 \n                                        지나갈 수 없게 아이템을 놓았을때, 사람이나 \n                                        동물이&nbsp;해당지역에 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있을때 \n                                        등은 리콜마법이 \"블럭\"이라는 \n                                        메세지와 함께 불가능하게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">리콜 \n                                        마법은 룬이외에 배키로도 이용이 가능합니다. \n                                        리콜 시전 후 열쇠를 타겟팅하면 해당</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">배로 \n                                        이동하게 됩니다. 물론 이때 배가 이동중에는 \n                                        리콜마법이 적용되지 않습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/archprotection.gif\" width=\"44\">ARCH \n                                        PROTECTION</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Vas \n                                        Uus Sanct &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 마법 재 사용까지</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, \n                                        Ginseng, Mandrake Root, Sulphurous Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : ARCH PROTECTION은 \n                                        목표물의 2타일 근처에 있는 대상물에게 \n                                        광역으로 적용됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        마법은 같은 파티원들에게만 적용되며 \n                                        효과는 2써클의 프로텍션마법과 동일합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/archcure.gif\" width=\"44\">Arch \n                                        Cure</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Vas \n                                        An Nox &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, Ginseng, Mandrake \n                                        Root</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Arch \n                                        Cure는 \n                                        독이 걸려있을때 해독을 해주는 마법으로 \n                                        목표물의 2-3타일 정도로 여러 플레이어들에게 \n                                        광역해독을 해줍니다. 물론 메저리스킬이 높을수록 해독할 확율이 \n                                        더 \n                                        높아지게 됩니다. </span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">독이 걸려있을때 &nbsp;체력을 \n                                        채워 주는 힐 마법은 해독 후 시전해야 \n                                        합니다. 또한 \n                                        독이 걸려 있을때 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주문의 디스텁(간섭)이 \n                                        날 수 있습니다. 해당 광역해독마법은 \n                                        2써클 큐어마법보다 더 큰 확율로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해독 \n                                        할 수 있습니다. 일예로 레벨5의독을 광역큐어할때 \n                                        지엠은 87%의 성공율을 가집니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/lightning.gif\" width=\"44\">Lightning</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Por \n                                        Ort Grav &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Mandrake Root, Sulphurous \n                                        Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Lightning은 타겟에게 에너지 속성으로 \n                                        번개를 내리칩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">에너지속성 공격이므로 \n                                        당연히 방어자는 에너지속성 \n                                        저항에 의해 \n                                        데미지 계산을 받게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지엠이벨,인스스킬일때 \n                                        통상적으로 30-34데미지를 주게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_2/\"><font color=\"teal\" face=\"Verdana\"><b>전투계산공식(스펠데미지)</b></font></a><font color=\"black\" face=\"Verdana\">편 \n                                        참조</font></span></p>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/mana_drain.gif\" width=\"44\">Mana \n                                        Drain</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Ort \n                                        Rel &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Blood \n                                        Pearl, Mandrake Root, Spider's Silk \n                                        &nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Mana Drain은 일시적으로 목표물의 마나를 \n                                        빨아드립니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n                                        효과는 공격자의 이벨이 높을수록 더 많은 \n                                        마나감소효과를 발생시킵니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어자는 \n                                        자신의 레지스킬로 이 효과를 감소시킬 \n                                        수 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마나감소효과가 \n                                        사라지면 방어자의 마나는 원상회복됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : 마나감소량 = (주문자의 \n                                                    이벨 + 40) - 방어자의 레지수치</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/greater_heal.gif\" width=\"44\">Greater \n                                        Heal</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        :</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\"> In \n                                        Vas Mani &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 즉시</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Garlic, Ginseng, Spider’s \n                                        Silk, Mandrake Root</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Greater Heal는 1써클의 힐의 상위 단계의 \n                                        마법으로 대량 치료를 하게 해줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        힐의 양은 메저리스킬에 의존합니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : 주문자의 메저리수치의 \n                                                    40%+(1~10)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메저리 \n                                                    100을 가진 주문자는 약 41~50수치로 \n                                                    치료됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/fire_field.gif\" width=\"44\">Fire \n                                        Field</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">In \n                                        Flam Grav &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 메저리스킬수치의 50%+4</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Black Pearl, Spider's Silk, \n                                        Sulphurous Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Fire Field은 일시적으로 필드에 불장벽을 \n                                        생성시킵니다. 근처에 접촉하는 플레이어나</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">몬스터, \n                                        생물등은 불의 피해를 입게됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : 초당 2데미지</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"left\" border=\"0\" height=\"44\" src=\"/img/posts/site/skill_index/images/combat/8c/curse.gif\" width=\"44\">Curse</b></span></font>\n</p><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Words of Power \n                                        : </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">Des \n                                        Sanct &nbsp;</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">지속시간 \n                                        : 메저리스킬의 120%&nbsp;(최대144초)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소요 약초 : Nightshade, Garlic, Sulphurous \n                                        Ash</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">설명 \n                                        : Curse는 일시적으로 목표물의 Str, Dex, \n                                        Int 수치를 낮추는 마법입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">저주는 \n                                        또한 목표물의 최대 원소 저항력을 60% \n                                        감소 시킵니다. 이 효과는 주문자의 이벨스킬이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">높을수록 \n                                        높아지며 \n                                        주의할점은 낮은 이벨을 \n                                        가진 주문자가 이효과를 주었을때 높은 \n                                        이벨을 가진 주문자의 해당 효과는 무시됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                                        효과지속시간 중 재시도를 하게되면 해당 \n                                        시간이 처음부터 다시 지속됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방어자는 \n                                        자신의 레지스킬로 이 효과를 감소시킬 \n                                        수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"540\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">계산공식 \n                                                    : (주문자의 메저리수치/10)+1</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:5;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메저리 \n                                                    100을 가진 주문자는 11%적용 \n                                                    합니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:15;\">\n<font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"29\" src=\"/img/posts/site/skill_index/images/combat/8c/Spellbook.gif\" width=\"26\"></b></span></font><font color=\"#003300\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>4Circle</b></span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">(시전가능 \n                        메져리 : 24.1, 마나소비 : 11, &nbsp;100%성공스킬수치 : </span></font><font color=\"#CC3300\" face=\"Verdana\"><span style=\"font-size:9pt;\">64</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
