  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_weapon/\"><font color=\"black\" face=\"Verdana\">각종무기류(Sword,Mace,Fencing,Archery)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"https://web.archive.org/web/20071120203141/http://www.forg.co.kr/skill_index/uo_combat_box.html\" target=\"_blank\"><font color=\"black\" face=\"Verdana\">레슬링(Wrestling)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_ta/\"><font color=\"black\" face=\"Verdana\">전술(Tactics)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_ana/\"><font color=\"black\" face=\"Verdana\">해부학(Anatomy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_he/\"><font color=\"black\" face=\"Verdana\">힐링(Healing)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_focus/\"><font color=\"black\" face=\"Verdana\">집중(Focus)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_pa/\"><font color=\"black\" face=\"Verdana\">방패술(Parry)</font></a></span></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Tactics<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_focus.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Warrior</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: 없음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: 없음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : Automatic</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Blacksmith, Fighter, Mercenary, Monk, \n                            Noble, Ocllo Cashual, Paladin, Pirate, Ranger, Sailor, \n                            Warrior, Warrior Guildmaster, Weapons Trainer, Weaponsmith</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            전술(</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">택틱)은 무기의 \n\n                        추가 데미지를 지원하는 스킬로서 무기이므로 마법공격에는 무관합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0px; margin-bottom:0px; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">그러므로 울온상 \n\n                        공격데미지추가는 무기는=택틱, 마법은=이벨이라고 생각하시면 됩니다.</span></font> </p><p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            전술(택틱)은 다음과 같이 무기로 데미지를 줄때 추가 \n                            데미지를 주는데 효과가 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p style=\"line-height:100%; margin:0;\"><span style=\"FONT-SIZE: 9pt\">택틱 피해 보너스 = 택틱 / 1.6 (택틱이 100 이상이면 +6.25 \n추가)</span></p>\n<p style=\"line-height:100%; margin:0;\"><span style=\"FONT-SIZE: 9pt\">택틱은 그 스킬 값 1.6당 1%의 피해 증가가 있고, 100이 넘으면 6.25%의 \n추가 피해를 입힙니다.<br>택틱이 16이면 10%의 피해 증가가 있습니다.<br>택틱이 100이면 68.75%의 추가 피해가 \n있습니다.<br>택틱이 110이면 75%의 추가 피해가 있습니다.<br>택틱이 120이면 81.25%의 추가 피해가 \n있습니다.</span></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"black\" bordercolorlight=\"black\" cellspacing=\"0\" width=\"96%\">\n<tbody><tr height=\"18\" style=\"height:13.5pt\">\n<td class=\"xl24\" colspan=\"15\" height=\"18\" style=\"height:13.5pt;\n  width:508pt\" width=\"682\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">TACTICS</span></font></p></td>\n</tr>\n<tr height=\"18\" style=\"height:13.5pt\">\n<td class=\"xl24\" height=\"18\" style=\"height:13.5pt;border-top:none;\n  width:60pt\" width=\"80\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">SKILL</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">30</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">40</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">50</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">60</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">70</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">80</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">90</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">105</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">110</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">115</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl24\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">120</span></font></p></td>\n</tr>\n<tr height=\"18\" style=\"height:13.5pt\">\n<td class=\"xl26\" height=\"18\" style=\"height:13.5pt;border-top:none;\n  width:60pt\" width=\"80\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">피해증가</span></font></p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">6.25</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">12.50</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">18.75</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">25.00</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">31.25</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">37.50</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">43.75</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">50.00</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">56.25</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">68.75</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">71.88</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">75.00</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">78.13</span></font> </p></td>\n<td class=\"xl25\" style=\"border-top:none;border-left:none;width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">81.25</span></font> </p></td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:5; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><b><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\">\n</span></b><span style=\"font-size:9pt;\">자세한 사항은 \n                            </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_sp_1/\"><font color=\"green\" face=\"Verdana\"><b>전투계산공식</b></font></a><font color=\"black\" face=\"Verdana\">을 \n                            참조 하시기 바랍니다.</font></span></p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
