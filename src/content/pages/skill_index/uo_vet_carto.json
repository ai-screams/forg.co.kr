  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_carto/\"><font color=\"black\" face=\"Verdana\">지도해석(Cartograhpy)</font></a></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_index/uo_vet_carto_1/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">스킬도표</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_index/uo_vet_lock/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">자물쇠따기(Lockpicking)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> l </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_remove/\"><font color=\"black\" face=\"Verdana\">트랩해체(Remove \n                            Trap)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><a href=\"/site/skill_knowhow/uo_knowhow_tmap/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도(대륙)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_knowhow/uo_knowhow_tmapi/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도(섬)</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">\n</font></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">l </span></font><a href=\"/site/skill_index/tmap/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도</font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>CARTOGRAPHY<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_carto.gif\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Cartographer </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당 스킬 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Mapmaker</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" width=\"560\">\n<tbody><tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><img align=\"left\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/carto/carto_s.gif\" width=\"100\"><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>항구근처에 \n                            있는 상점</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">에서 빈지도나 일반 지도를 판매 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">일단 \n                            그곳에 가셔셔 지도를 대량으로 구입합니다. 물론 \n                            UOA를 쓰시는분은 빈스크롤,빈지도만을 구입하셔야 하지만 \n                                        손으로 \n                            그리시는분은 또한 자금의 여유가 있으신분은 그려진지도를 \n                            구입하셔도 무방합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">상점에서 \n                            파는 그려진 지도는 다시 그릴 수 있기 때문입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">빈스크롤은 각 마을&nbsp;시약상점이나 도서관에서 \n                            구입하실 수 있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;[지도제작자의펜]을 항구상점에서 구입하셔서 이 \n                            도구로 빈지도나 스크롤에다가 그리셔야 합니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">펜을 더블클릭하면 \n                             그릴 수 있는 지도를 \n                            선택 할 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지도를 \n                            선택후 그리고 싶은 지도를 체크해주시고 확인해주시면 \n                            지도가 그려집니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지역지도(스킬0)-도시지도(스킬25)-해도(스킬35)-세계지도(스킬50)순으로 \n                                        올려주시면 \n                                        됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 99.5부터 지도를 그리는 방법으로는 스킬이 올라가지를 \n                            않습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                            스킬부터는 보물지도(4렙)을 해독하시면서 올리셔야 \n                            합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보물지도는 \n                            1-5렙까지 몬스터에게서 얻을 수 있으며 6렙을 주는 \n                            일쉐나의 상위 몬스터 파라곤은</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"FONT-SIZE: 9pt\"><a href=\"https://web.archive.org/web/20071123004414/http://www.forg.co.kr/skill_knowhow/paragon.html\" target=\"_blank\"><font color=\"green\" face=\"Verdana\"><b>파라곤 기본지식</b></font></a><font color=\"black\" face=\"Verdana\">을 \n                            참조하시길 바랍니다.</font></span></p>\n<hr color=\"white\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\" width=\"98%\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/carto/3.gif\" width=\"100\">던전이나 \n                            필드에서 몬스터를 잡게 되면 해당 몬스터의 레벨에 \n                            맞게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보물지도가 \n                            랜덤하게 나오게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이때 \n                            보물지도를 \n                            한번 클릭하게되면 르네지역과 \n                            펠루카지역으로 \n                            구분되어지는 것을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">알 \n                            수 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">다른 \n                            플레이어가 이미 해당 보물을 찾게 되었다면 해당지도에 \n                            찾은 사람의 이름이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">기입되게 \n                            됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<hr color=\"white\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\" width=\"98%\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"fuchsia\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"1\" height=\"240\" src=\"/img/posts/site/skill_index/images/uojobs/carto/l_map.gif\" width=\"240\">\n<img border=\"1\" data-original-src=\"http://www.forg.co.kr/skill_index/images/uojobs/carto/r_map.gif\" data-recovery=\"missing\" height=\"240\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:240/240\" width=\"240\"></span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">위의 \n                            사진처럼 보물지도를 해독하게되면 상세한 \n                            지도가 나오게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">우측 맵지도와 연관성을 생각하시면 \n                            45도 돌려보시면 쉐임던전 부근이라는것을 알 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">간편하게 \n                            UOAM을 이용하시거나  \n                            위의 보물지도란을 참조하시면 됩니다.</span></font></p>\n<hr color=\"white\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\" width=\"98%\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">보물상자를 \n                            얻는 순서</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/carto/5.gif\" width=\"100\"><img align=\"right\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/carto/6.gif\" width=\"100\">순서 :</span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\"> 일단 삽을 더블클릭-지도를 \n                            클릭-땅을 \n                            클릭</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">장소가 \n                            정확하다면 땅을 파는 소리가 나게됩니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마이닝 \n                            스킬이 높을수록 찾는 지역이 넓게 되어서 편하지만</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">정확한 \n                            포인트를 찾을 수 있으시다면 &nbsp;마이닝스킬은 \n                            배우지 않아도 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">무방합니다. \n                            이때 \n                            플레이어의 바로 밑에 상자가 숨어있다면 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">방해를 받는 \n                            다는 메세지가 나옵니다. </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이때는 \n                            옆으로 약간 움직인 후&nbsp;시도합니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">땅을 \n                            파면서 상자가 \n                            올라올 때 하이딩마법이나 3써클 텔레포트 마법을 외워둡니다. \n                            몹이 \n                            올라올 때 최대한 멀리있는지점으로 순간이동을 \n                            합니다. 대량의 \n                            몹이 올라오면 약간의 랙이 발생합니다.</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/carto/4.gif\" width=\"100\"><img align=\"right\" border=\"0\" height=\"100\" src=\"/img/posts/site/skill_index/images/uojobs/carto/2.gif\" width=\"100\">하이딩을 \n                            외우신분은 제자리에서 하이딩마법구동, </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">랄포를 \n                            외우신분은 텔레포트 후 \n                            </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마법하이딩이나 아이템하이딩 혹은 몬스터가 없는방향으로 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">\n<font face=\"Verdana\"><span style=\"font-size:9pt;\">빠르게 \n                             이동하시면됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<hr color=\"white\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\" width=\"98%\">\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
