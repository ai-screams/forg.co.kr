  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_blacksmith/\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_mining/\"><font color=\"black\" face=\"Verdana\">광부(Mining)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_armslore/\"><font color=\"black\" face=\"Verdana\">장비지식(Arms Lore)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_tailor/\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">\n<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_lum/\"><font color=\"black\" face=\"Verdana\">나무꾼(Lumberjacking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_car/\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry)</font></a><font color=\"black\" face=\"Verdana\">  \n                            l </font><a href=\"/site/skill_index/uo_jobs_bow/\"><font color=\"black\" face=\"Verdana\">활제작자(Bowcraft)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_thinker/\"><font color=\"black\" face=\"Verdana\">기계공(Tinkering)</font></a><font color=\"black\" face=\"Verdana\"> </font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_fishing/\"><font color=\"black\" face=\"Verdana\">낚시(Fishing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_begging/\"><font color=\"black\" face=\"Verdana\">구걸(Begging)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_alchemy/\"><font color=\"black\" face=\"Verdana\">포션제작자(Alchemy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_ins/\"><font color=\"black\" face=\"Verdana\">스크롤제작자(Inscription)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>CARPENTRY</b></span></font><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\"><b>\n</b></font></span><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/logo_car.gif\" data-recovery=\"missing\" height=\"60\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:100/60\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Carpenter</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 도구를 이용(대패를 이용)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Carpenter, Shipwright</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(제품만들기)</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:100%; margin:0;\" width=\"98%\">\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">목공술도구</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"middle\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/car_logo.gif\" width=\"100\">\n</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">각 마을에 있는 </span></font><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>목공소</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">에서 목공술에 \n                            필요한 \n                                            도구를 \n                                            구입합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">목공술에 \n                            필요한 도구들의 종류는 다음과 같습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_1.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_2.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_3.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_4.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_5.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_6.gif\" width=\"20\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/uojobs/carpentry/c_7.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:20/20\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_8.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_9.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_10.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_11.gif\" width=\"25\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">목공술에 \n                            필요한 도구는 기계공기술(스킬 0일 때 성공기회 16.8%)로도 \n                            플레이어가 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">직접 \n                            만들 수도 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">필요재료</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/bow/bow_3.gif\" width=\"100\"> \n                            나무 : \n                            나무를 구할려면 대장간이나 \n                                            기계공스킬로 도끼나 할버드등 찍어 \n                                            패는 \n                                            류의 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">무기나 \n                                            도구를 구입하여야 합니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">도구를 \n                                            구입하셨다면 \"alt+p\"키를 \n                                            누른 후 자신의 캐릭창이 활성화되면 \n                                            도끼를 자신의 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">캐릭으로 \n                                            드래그하여 쥐어줍니다 (</span></font><span style=\"font-size:9pt;\"><b><a href=\"/site/skill_newbie/lumberjack/\" target=\"_blank\"><font color=\"#990066\" face=\"Verdana\">초보자가이드</font></a></b></span><font face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">도끼를 \n                                            더블클릭 후 타겟이 뜨게된다면 원하시는 \n                                            나무를 찍어주시면 됩니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                                            나무를 패는 스킬은 럼버잭(나무하기)이라는 \n                                            스킬이 필요합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">나무하기가 \n                                            성공한다면 자신의 백팩에 통나무가 \n                                            들어옵니다.<img align=\"baseline\" border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/bow/log.gif\" width=\"25\">&nbsp;<img align=\"baseline\" border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/bow/log_1.gif\" width=\"25\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                                            이 상태로 각종 목공기술로 필요한 \n                            제품을 만드셔도 \n                                            되지만 이 통나무의 무게는 2스톤입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">대패로 \n                                            가공을 한다면 1스톤의 판자로 바꿀 \n                                            수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">제품을 \n                            만드는 방법</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">목공도구를 \n                            더블클릭 하시면 메뉴창이 활성화 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">메뉴창이 \n                            활성화 되면 원하시는 제품을 선택하여 만들어 주시면 \n                            됩니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이때 \n                            자신의 백팩에는 필요 수치만큼의 나무가 있어야 합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                            만드신 제품을 부셔버릴 수도 있습니다. 제품을 부실 \n                            때는 도끼나 할버드등 찍어 \n                                            패는 \n                                            류의 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">무기나 \n                                            도구를 더블클릭 후 타겟이 할성화되면 \n                            해당 제품을 클릭 해 주시면 됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            테일러의 작업메뉴</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">A. \n                            상단 메뉴에 있는 선택란들</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            각종 제품의 하위메뉴로 들어가게 됩니다. (선택란에서는 \n                            해당 제품을 만들게 됩니다)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_2.gif\" width=\"26\"> \n                            해당 제품의 상세정보로 들어가게 됩니다. (제품의 \n                            최소스킬치,요구재료,성공기회,고급기회 정보)</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">B. \n                            하단 메뉴에 있는 선택란들</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            철&nbsp;: 제품의 종류를 선택합니다.(각종 색잉갓)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            아이템수리 : 제품의 내구력을 원상복귀해줍니다. 단 \n                            랜덤하게 내구도가 1씩 줄어들게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스크롤을 \n                            이용하면 수리디드가 만들어 집니다. 아이템수리선택 \n                            후 시약상점에서 파는 빈스크롤을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">클릭하시면 \n                            해당 스크롤이 수리디드로 변환됩니다. 해당 수리디드는 \n                            목공술이 없는 캐릭이라도 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">NPC상점(목공소)에서 \n                            사용하면 제품을 수리하실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/m_1.gif\" width=\"26\"> \n                            물건이름표시&nbsp;: 스킬 100일 경우 제품에 이름을 \n                            표시해 줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">기타애드온,대장장이용품,연습용,재봉용품,요리용품은 \n                                        디드 \n                                        모양으로 자신의 집,</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"0\" height=\"30\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/deed-ticket.gif\" width=\"31\">공동소유주인 \n                                        집에서 애드온디드를 더블클릭 후  타겟이 활성화되면 \n                                        </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">원하는 위치에 클릭하시면 설치할 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">주의할 \n                                        점은 각각의 하우스애드온은 다른 타일수(공간)를 \n                                        가지고 있으므로 해당 타일만큼의 빈공간이</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">있어야 \n                                        합니다. 특히 오븐은 굴뚝이 있으므로 \n                                        거의 집의 옥상위치에서 설치가 가능합니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"580\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                        설치가 확정된 애드온은 디드로 다시 환원이 \n                                        안됩니다. 해당 애드온을 제거하는 방법은 \n                                        도끼류(도끼,할버드)를 \n                                        더블클릭 후 타겟이 활성화되면 해당 애드온을 \n                                        클릭 하시는 방법으로 제거할 \n                                        수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                        하우스애드온의 방향과 사진은 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_addon_2/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>하우스애드온</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                                        참조</span></font></p>\n<p style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                        목공술을 이용한 박제만들기는 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_addon/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>박제에대해서</b></font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">편</font></span><font face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                                        참조</span></font></p>\n<p style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">※ \n                                        모든 \n                                        아이템은 \n                                        목공술의 기술로만 성공기회와 고급기회의 \n                                        영향을 받습니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">요구되는 \n                                        다른 기술(재봉수르대장장이,기계공,악기연주)은 \n                                        오직 해당 아이템을 만들 때의 조건입니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"#990000\" face=\"Verdana\"><span style=\"font-size:9pt;\">즉, \n                                        애드온의 성공기회의 확률은&nbsp;오직 \n                                        목공술에의해서만 변화됩니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"#990000\" face=\"Verdana\"><span style=\"font-size:9pt;\">연환스킬은 \n                                        해당 애드온제품을 만들시 오직 시도에만 \n                                        관여됩니다. 즉 목공술 100을 지닌 </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"#990000\" face=\"Verdana\"><span style=\"font-size:9pt;\">플레이어가 \n                                        메저리 100 혹은&nbsp;50 이나 판타그램을 \n                                        만드는 확률은 50%로 같습니다.</span></font></p>\n<p style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">※통을 \n                                        제외한 모든 컨테이너류의 상자는 기계공기술이 \n                                        있을 때 열쇠와 함께 만들어 집니다.</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">이 \n                                        열쇠는 컨테이너상자를 잠글 수 있습니다. \n                                        잠금의 난이도는 목공술에 의존합니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
