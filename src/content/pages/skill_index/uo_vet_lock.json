  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_carto/\"><font color=\"black\" face=\"Verdana\">지도해석(Cartograhpy)</font></a></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_index/uo_vet_carto_1/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">스킬도표</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_index/uo_vet_lock/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">자물쇠따기(Lockpicking)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> l </span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_remove/\"><font color=\"black\" face=\"Verdana\">트랩해체(Remove \n                            Trap)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><a href=\"/site/skill_knowhow/uo_knowhow_tmap/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도(대륙)</font></span></a><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                            l </span></font><a href=\"/site/skill_knowhow/uo_knowhow_tmapi/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도(섬)</font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">\n</font></span><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">l </span></font><a href=\"/site/skill_index/tmap/\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">보물지도</font></span></a></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>LOCKPICKING \n                            <img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_lock.gif\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Rogue</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: -</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 락픽아이템 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Thief, Thief Guildmaster, Tinker, Tinker \n                            Guildmaster, Gypsy</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(타겟제한)</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"white\" bordercolorlight=\"white\" cellpadding=\"5\" cellspacing=\"0\" width=\"560\">\n<tbody><tr>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>A</b>. \n                                        자물쇠따기는 잠긴 상자를 여는데 유용한 \n                                        스킬입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보물상자나 \n                                        던전상자등의 상자속에는 각종 지피와 \n                                        아이템들이 들어 있지만, 잠겨 있어 플레이어가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        아이템을 획득할 수 없게 됩니다. 물론 \n                                        파라곤이 주는 상자도 잠겨 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이러한 \n                                        것들은 락픽킹스킬로 열어야 하는데 일단 \n                                        상자를 연 후 4써클 텔레키니스마법으로 \n                                        원거리</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">에서 \n                                        트랩제거를 해주거나 리무브스킬로 트랩제거를 \n                                        해주셔야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>B</b>. \n                                        5렙의 보물지도나 상위 파라곤이 주는 \n                                        6렙의 보물지도는 락픽스킬 100으로만 \n                                        열 수 있으므로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지엠까지 \n                                        올리는것이 중요합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>C</b>. \n                                        5락픽킹은 팅거(기계공)스킬로 락픽을 \n                                        만들거나 </span></font><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>팅거(도구점)상점</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">에서 \n                                        구입하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        상자를 열때마다 락픽이 부러지는 경우가 \n                                        있습니다. 이때는 재시도를 하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지엠이라도 \n                                        5,6렙의 보물상자는 많이 부러지는데 계속 \n                                        시도를 하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬수치가 \n                                        상자의 레벨수치보다 낮으면 열 수가 없으므로 \n                                        스킬을 올리시길 바랍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                        레벨별 요구스킬수치는 상단 목록에 있는 \n                                        스킬도표를 참조 하시길 바랍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>D</b>. \n                                        락픽킹 스킬이 있으면 카펜터리(목공술)스킬로 \n                                        만들 수 있는 컨테이너의 상자들 속에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자동으로 \n                                        해당 열쇠가 만들어 집니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><b>E</b>. \n                                        락픽킹 스킬은 타겟제한과 난이도 스킬을 \n                                        기반으로 하기때문에 한개의 상자로 잠금-해제의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">반복으로는 \n                                        스킬이 오르지 않습니다. 지엠 목공술을 \n                                        가진 플레이어가 만든 상자를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">수십개를 \n                                        가지고 반복 하셔야 95까지 올리실 수 \n                                        있습니다. </span></font><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">95이상부터는 \n                                        상위던전에서 스폰되는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">고렙의 \n                                        상자를 반복적으로 열어서 지엠까지 도달 \n                                        하실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                                        NPC에게 기술 습득 후 베스퍼 은행에 있는 \n                                        저렙 상자나 던전상자들부터 시작하셔도 \n                                        됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:30%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
