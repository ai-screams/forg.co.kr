  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_steal/\"><font color=\"black\" face=\"Verdana\">훔치기(Stealing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_hiding/\"><font color=\"black\" face=\"Verdana\">숨기(Hiding) \n                             \n                            </font></a><font color=\"black\" face=\"Verdana\">l&nbsp;</font><a href=\"/site/skill_index/uo_combat_stealth/\"><font color=\"black\" face=\"Verdana\">은폐이동(Stealth)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_snooping/\"><font color=\"black\" face=\"Verdana\">훔쳐보기(Snooping)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_detect/\"><font color=\"black\" face=\"Verdana\">은폐탐지(Detect Hidden)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_combat_tracking/\"><font color=\"black\" face=\"Verdana\">트랙킹(Tracking)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>STEALING</b></span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_steal.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Pickpocket \n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 스킬 시전 후에 타겟 클릭</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: </span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Thief \n                            Guildmaster</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 타겟제한과 난이도</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            스틸링(훔치기)는 르네지역을 제외하고  펠루카에서는 \n                            플레이어나 심지어 몬스터에게서 지피나 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">아이템을 \n                            훔치는 스킬입니다. 소매치기이외에 각종 세미레어는 \n                            둠레어, 마이너아티팩트레어등을 획득할때 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">쓰이는 \n                            스킬입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            플레이어에게 아이템을 스틸하는 방법</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><b>A</b>. \n                            </span></font><font color=\"purple\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">먼저 \n                            양손이 빈 상태에서</span></font><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"> \n                            스틸링 발동 후 플레이어를 바로 타겟팅 해주시면 랜덤으로 \n                            해당 플레이어가 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">가진 \n                            아이템을 가져오실 수 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">지피의 \n                            경우에는 해당 스킬 수치만큼의 지피 스톤 수를 가져오게 \n                            됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">물론 \n                            랜덤으로 아무 아이템이나 가져오므로 지엠일경우 최대 \n                            10스톤인데 무게오버가 되는 경우의</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">아이템을 \n                            가져오는 경우가 많으므로 발각되실 위험이 큽니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><b>B</b>. \n                            스누핑스킬을 이용 상대방의 가방을 볼 수 있습니다. \n                            이때 해당 가방에 원하시는 물건을 직접 선택</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하여 \n                            훔칠 수 있습니다. 스누핑을 이용하실 때에는 다른 \n                            플레이어에게 붙어서 가방을 훔쳐보지 마시고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스쳐 \n                            지나가듯 뛰어가면서 여시면 수상한 자라고 의심을 \n                            가지 않게 해줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">(다른플레이어를 \n                            더블클릭하시면 프로필창이 나오고 해당 가방을 더블클릭하시면 \n                            스누핑이 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">이때 \n                            멀리 있으면 시도가 안되므로 일단 더블클릭후 라스트오브젝트로 \n                            만들어 준 후 스치면서 열어주는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">것이 \n                            키포인트 입니다)</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"560\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">플레이어에게 \n                                        아이템을 훔치기 위새서는 도둑길드에 \n                                        가입하셔야 합니다. 도둑길드에 들기 위해서는</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"purple\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스틸링 \n                                        60이상의 스킬을 보유하고 플레이 하신 \n                                        시간이 48시간이 되어야 합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">해당 \n                                        엔피씨들은 각 마을에서 랜덤으로 출현 \n                                        하며 단검을 소지하고 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">Thief라는 \n                                        타이틀의 NPC가 아닌 Thief Guildmaster의 \n                                        타이틀을 가진 NPC만이 길드가입을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">허가 \n                                        해줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">일단 \n                                        해당 NPC를 발견 하셨다면 NPC의 이름과 \n                                        JOIN이라는 단어로 가입의사를 이야기 \n                                        해줍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">NPC이름이 \n                                        Holy라고 한다면 \"</span></font><font color=\"maroon\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">Holy \n                                        Join</span></font><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">\"이라고 \n                                        외치시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">도둑길마는 \n                                        해당 요건이 충족되면 지피를 요구합니다. \n                                        해당 금액의 지피를 도둑길마에게 드래그해서</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">건네주시면 \n                                        됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">도둑길마는 \n                                        변장도구를 판매하는데 \"</span></font><font color=\"maroon\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">Disguise</span></font><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">\"라고 \n                                        외치시면 700지피에 구입 하실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">해당 \n                                        변장도구는 이름과 모습을 2시간동안 바꾸어 \n                                        주므로 유용하게 쓸 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">도둑길드의 \n                                        탈퇴는 NPC이름과 QUIT를 외치시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">NPC이름이 \n                                        Holy라고 한다면 \"</span></font><font color=\"maroon\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">Holy \n                                        Quit</span></font><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">\"이라고 \n                                        외치시면 됩니다. 또한 머더러가 되면 \n                                        자동적으로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin:0;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">도둑길드에서 \n                                        탈퇴처리 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            몬스터에게 아이템을 스틸하는 방법</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">몬스터는 \n                            프로필창이 없으므로 플레이어에게 시도하는 A방법으로만 \n                            가능합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">&nbsp;스틸 \n                            실패 구분 방법</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">스틸이 \n                            발각되면 그레이 상태가 되어버리고 가드구역에서는 \n                            가드에게 죽을 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">완전성공 \n                            : 아이템을 훔치고 누구에게도 틀키지 않음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">부분성공 \n                            : 아이템을 훔쳤으나 발각되었음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">부분실패 \n                            : 훔치기가 실패했지만 발각되지는 않음</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">완전실패 \n                            : 훔치기도 실패하고 발각되어버림</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            스킬별 훔칠 수 있는 스톤 수</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" width=\"98%\">\n<tbody><tr height=\"18\" style=\"height:13.5pt\">\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" height=\"18\" style=\"height:13.5pt;width:56pt\" width=\"74\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬수치</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">20</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">30</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">40</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">50</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">60</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">70</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">80</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">90</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">110</span></font></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" class=\"xl22\" style=\"width:32pt\" width=\"43\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">120</span></font></p></td>\n</tr>\n<tr height=\"18\" style=\"height:13.5pt\">\n<td bgcolor=\"#CCCCCC\" class=\"xl22\" height=\"18\" style=\"height:13.5pt\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스톤 수</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">1</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">4</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">6</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">7</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">8</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">9</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">10</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">11</span></font></p></td>\n<td bgcolor=\"#CCCCCC\" class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">12</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스틸링은 \n                            타겟제한과 난이도로 스킬이 오르게 됩니다. 타겟제한은 \n                            같은 물건으로는 스킬이 오르지 않고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">난이도로는 \n                            해당 스톤 수 만큼 시도를 해야만 오르게 됩니다. 주로 \n                            짐말이나 비틀에 아이템을 넣고</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">수련을 \n                            하게 되며 이때 타겟제한은 빈병,지피등 뭉쳐있는 아이템으로 \n                            올리게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아이템을 \n                            분활했다가 다시 뭉쳐놓으면 타겟제한이 풀리기 때문입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">또한 \n                            각 상점에 있는 세미레어들을 훔치면서도 올리실 수 \n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">훔칠 \n                            수 있는 각종 레어아이템에 관해서는</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">\n</span></font><a href=\"/site/skill_knowhow/uo_knowhow_rare/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>유용한정보란-레어아이템</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">편을 \n                            참조하여 주시길 바랍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보통 \n                            둠과 토쿠노의 아티팩트들은 최소110을 요구하지만, \n                            실패시를 고려하여 120까지 올리시는것을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10px;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">권장합니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-bottom:0; margin-left:10px;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By \n\n                        Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
