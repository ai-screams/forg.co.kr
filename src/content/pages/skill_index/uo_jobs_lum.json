  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_blacksmith/\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_mining/\"><font color=\"black\" face=\"Verdana\">광부(Mining)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_armslore/\"><font color=\"black\" face=\"Verdana\">장비지식(Arms Lore)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_tailor/\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">\n<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_lum/\"><font color=\"black\" face=\"Verdana\">나무꾼(Lumberjacking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_car/\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry)</font></a><font color=\"black\" face=\"Verdana\">  \n                            l </font><a href=\"/site/skill_index/uo_jobs_bow/\"><font color=\"black\" face=\"Verdana\">활제작자(Bowcraft)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_thinker/\"><font color=\"black\" face=\"Verdana\">기계공(Tinkering)</font></a><font color=\"black\" face=\"Verdana\"> </font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_fishing/\"><font color=\"black\" face=\"Verdana\">낚시(Fishing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_begging/\"><font color=\"black\" face=\"Verdana\">구걸(Begging)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_alchemy/\"><font color=\"black\" face=\"Verdana\">포션제작자(Alchemy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_ins/\"><font color=\"black\" face=\"Verdana\">스크롤제작자(Inscription)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>LUMBERJACKING \n                            <img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_lum.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Lumberjack</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: None</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당스킬사용(도끼를 이용)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Carpenter, Farmer</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: -</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">통나무를 \n                            판자로 만들기</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">\n</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/car_logo.gif\" width=\"100\">각 마을에 있는 </span></font><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>목공소</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">에서 목공술에 \n                            필요한 \n                                            도구를 \n                                            구입합니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">럼버잭(나무패기)를 \n                            위해 대패가 필요합니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">럼버잭을 \n                            이용하여 나무를 패면 통나무가 나오는데 이  통나무의 무게는 2스톤입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">대패로 \n                                            가공을 한다면 1스톤의 판자로 바꿀 \n                                            수 있으므로 많은 양을 백팩에 넣을 \n                            수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">통나무를 \n                            판자로 만드는 필요한 도구들의 종류는 다음과 같습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_1.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_2.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_3.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_4.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_5.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_6.gif\" width=\"20\"><img border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/uojobs/carpentry/c_7.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_8.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_9.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_10.gif\" width=\"20\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/carpentry/c_11.gif\" width=\"25\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">위의 \n                            도구는 기계공기술(스킬 0일 때 성공기회 16.8%)로도 \n                            플레이어가 직접 \n                            만들 수도 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">럼버잭올리기</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/bow/bow_3.gif\" width=\"100\"> \n                            A. 나무 : \n                            나무를 이용하여 럼버잭을 올리려면 대장간이나 \n                                            기계공스킬로 도끼나 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">할버드등 찍어 \n                                            패는 \n                                            류의 무기나 \n                                            도구를 구입하여야 합니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">도구를 \n                                            구입하셨다면 \"alt+p\"키를 \n                                            누른 후 자신의 캐릭창이 활성화되면 \n                                            도끼를 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자신의 캐릭으로 \n                                            드래그하여 쥐어줍니다 (</span></font><span style=\"font-size:9pt;\"><b><a href=\"/site/skill_newbie/lumberjack/\" target=\"_blank\"><font color=\"#990066\" face=\"Verdana\">초보자가이드</font></a></b></span><font face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">도끼를 \n                                            더블클릭 후 타겟이 뜨게된다면 원하시는 \n                                            나무를 찍어주시면 됩니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">나무하기가 \n                                            성공한다면 자신의 백팩에 통나무가 \n                                            들어옵니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물론 \n                                            이 상태로 각종 목공기술로 필요한 \n                            제품을 만드셔도 \n                                            되지만 이 통나무의 무게는 2스톤입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">대패로 \n                                            가공을 한다면 1스톤의 판자로 바꿀 \n                                            수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">B. \n                            몬스터 사냥하기 : 도끼나 할버드등 찍어 \n                                            패는 \n                                            류의 무기로 몬스터를 사냥하시면 \n                            소드무기스킬과</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">럼버잭스킬이 \n                            동시에 오르게 됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">C. \n                            럼버잭이 적용되는 무기는 다음과 같습니다</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Axe</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Battle \n                            Axe</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Double \n                            Axe</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Executioner’s \n                            Axe</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Hatchet</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Large \n                            Battle Axe</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Two-handed \n                            Axe</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">럼버잭스킬의 \n                            추가데미지 보너스</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\"><p style=\"line-height:100%; margin:0;\"><span style=\"FONT-SIZE: 9pt\">럼잭 피해 보너스 = 럼잭 / 5 (럼잭이 100 이상이면 +10)</span></p>\n<p style=\"line-height:100%; margin:0;\"><span style=\"FONT-SIZE: 9pt\">럼잭에 의한 피해 보너스는 \"전투 도끼\"를 제외한 모든 도끼류 아이템을 사용할 경우 \n적용됩니다.<br>럼잭 스킬 5당 1%의 피해 증가가 있고, 100을 넘으면 10%의 추가 피해를 입힙니다.<br>럼잭 스킬이 5이면 도끼류 \n사용시 1%의 피해 증가가 있습니다.<br>럼잭 스킬이 50이면 10%의 피해 증가가 있습니다.<br>럼잭 스킬이 100이면 30%의 피해 \n증가가 있습니다.</span></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"margin-top:5px; margin-bottom:0px;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
