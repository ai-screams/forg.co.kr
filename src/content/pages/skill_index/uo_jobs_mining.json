  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_blacksmith/\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_mining/\"><font color=\"black\" face=\"Verdana\">광부(Mining)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_armslore/\"><font color=\"black\" face=\"Verdana\">장비지식(Arms Lore)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_tailor/\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">\n<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_lum/\"><font color=\"black\" face=\"Verdana\">나무꾼(Lumberjacking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_car/\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry)</font></a><font color=\"black\" face=\"Verdana\">  \n                            l </font><a href=\"/site/skill_index/uo_jobs_bow/\"><font color=\"black\" face=\"Verdana\">활제작자(Bowcraft)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_thinker/\"><font color=\"black\" face=\"Verdana\">기계공(Tinkering)</font></a><font color=\"black\" face=\"Verdana\"> </font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_fishing/\"><font color=\"black\" face=\"Verdana\">낚시(Fishing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_begging/\"><font color=\"black\" face=\"Verdana\">구걸(Begging)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_alchemy/\"><font color=\"black\" face=\"Verdana\">포션제작자(Alchemy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_ins/\"><font color=\"black\" face=\"Verdana\">스크롤제작자(Inscription)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>MINING<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_mining.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Miner</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: None</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당스킬사용(삽을 이용)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Miner, Miner Guildmaster</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(오어색에 따라)</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            오어 획득</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">마이닝스킬은 \n                            각종 도구나 갑옷 무기를 만들때 필요한 잉갓을 얻는 \n                            스킬입니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">광부라고 \n                            흔히 이야기 하며 이러한 잉갓을 얻을려면 삽과 곡괭이가 \n                            필요하게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><a href=\"/site/skill_index/skill_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana,굴림체\"><b>팅거상점(도구점)</b></font></span></a><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">에서 \n                            삽이나 곡괭이를 구입합니다. 물론 팅거(기계공)스킬로 \n                            직접 만들 수 있지만</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">이때는 \n                            잉갓이 필요하게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">광산이나 \n                            돌산으로 이동하여(보통 미녹에서 시작하면 근처에 \n                            어느곳이나 땅을 팔 자리가 많습니다.)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">삽을 \n                            더블클릭 후 타겟을 땅에다 클릭하시면 백팩으로 오어가 \n                            들어오게 됩니다.(</span></font><span style=\"font-size:9pt;\"><b><a href=\"/site/skill_newbie/mining/\" target=\"_blank\"><font color=\"#990066\" face=\"Verdana\">초보자가이드</font></a></b><font color=\"black\" face=\"Verdana\">)</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">일단 \n                            오어(광석)을 얻게되면 무거운 오어를 이동시켜 보다 \n                            가벼운 잉갓으로 바꾸어줍니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">오어는 \n                            재료로 바로 못 쓰고 재료로 쓰는것은 잉갓입니다. \n                            </font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">오어를 \n                            더블클릭 후 타겟을 포지(화로)에다 클릭하시면 잉갓으로 \n                            환원이 됩니다.(</font><b><a href=\"/site/skill_newbie/mining_moving/\" target=\"_blank\"><font color=\"#990066\" face=\"Verdana\">초보자가이드</font></a></b></span><font face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"539\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\" width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">잉갓</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">갑옷</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">색깔</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬수치</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">잉갓</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"55\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">갑옷</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"90\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">색깔</span></font></p>\n</td>\n<td bgcolor=\"#FFFFCC\" width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬수치</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/ingot_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"70\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/ingot.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">일반잉갓</span></font></p>\n</td>\n<td width=\"56\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">-</span></font></p>\n</td>\n<td width=\"50\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/dull_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"55\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/dull.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"90\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">덜쿠퍼</span></font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">65</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/shadow_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/shadow.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">쉐도우</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Shadow)</span></font></p>\n</td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">70</span></font></p>\n</td>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/cooper.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"55\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/gold.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"90\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">구리</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Copper)</span></font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">75</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/bronze_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/bronze.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">청동</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Bronze)</span></font></p>\n</td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">80</span></font></p>\n</td>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/gold_ingot.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"55\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/gold_1.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"90\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">골드</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Gold)</span></font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">85</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/agapite_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/agapite.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아가파이트</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Agapite)</span></font></p>\n</td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">90</span></font></p>\n</td>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/vet_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"55\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/vet.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"90\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">베리떼</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Verite)</span></font></p>\n</td>\n<td width=\"60\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">95</span></font></p>\n</td>\n</tr>\n<tr>\n<td width=\"50\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/val_1.gif\" width=\"50\"></span></font></p>\n</td>\n<td width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img border=\"0\" height=\"70\" src=\"/img/posts/site/skill_index/images/uojobs/mining/val.gif\" width=\"70\"></span></font></p>\n</td>\n<td width=\"74\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">발로라이트</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">(Valorite)</span></font></p>\n</td>\n<td width=\"56\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">99</span></font></p>\n</td>\n<td bgcolor=\"#CCCCCC\" colspan=\"4\" width=\"267\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;만든갑옷을 \n                            녹여서 다시 잉갓으로 환원하는 </span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬은 \n                                        스미스가아닌 \n                            마이닝이기</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">때문에 \n                                        스킬이 높을수록 잉갓환원이</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;더 \n                                        많이 됩니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            마이닝스킬의 적용</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">마이닝스킬은 \n                            오어를 얻을때, 녹일때 쓰이는 스킬로 해당 색오어는 \n                            스킬수치가 되어야만, 광석을 얻을 수 있고 해당 색오어를 \n                            녹여서 잉갓으로 만들 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">참고로 \n                            대장장이는 해당 스킬 수치가 되어야만 색잉갓으로 \n                            해당 제품을 만드실 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">예를들어 \n                            어느 지점에서 발로라이트(스킬요구치 99)가 스폰된다면 \n                            마이닝 50을 가진 광부는 </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">해당 \n                            지점에서는 일반오어만 나오게 됩니다. 스킬 99이상이되어야만 \n                            발로라이트를 얻을 수 있게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">또한 \n                            다른 플레이어가 발로라이트 오어를 땅에 버리고 갔다면 \n                            마이닝 스킬 50을 가진 플레이어가 그것을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">녹일려고해도 \n                            스킬수치가 낮으므로 녹일 수 없게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">일반잉갓에서부터 \n                            발로라이트로 갈수록 대륙(광산,돌산)에 분포되어 있는 \n                            수치가 적어지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"></span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">아래 \n                            도표는 오어를 녹일때의 성공확율입니다.</span></font></p>\n<table border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\">\n<tbody><tr height=\"18\" style=\"height:13.5pt\">\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" height=\"18\" style=\"height:13.5pt;width:53pt\" width=\"70\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬수치</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Ingot</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Dull</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Shadow</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Copper</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Bronze</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Gold</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Agapite</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Verite</span></font></p></td>\n<td bgcolor=\"#FFFFCC\" class=\"xl22\" style=\"width:46pt\" width=\"61\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Valorite</span></font></p></td>\n</tr>\n<tr height=\"18\" style=\"height:13.5pt\">\n<td class=\"xl22\" height=\"18\" style=\"height:13.5pt\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">90</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">80</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">70</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">60</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">52</span></font></p></td>\n</tr>\n<tr height=\"18\" style=\"height:13.5pt\">\n<td class=\"xl22\" height=\"18\" style=\"height:13.5pt\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">105</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">90</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">80</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">70</span></font></p></td>\n<td class=\"xl22\">\n<p align=\"center\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">62%</span></font></p></td>\n</tr>\n</tbody></table>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">*스킬수치 \n                            +5는 </span></font><a href=\"/site/bod/smith_list/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>벌크디드보상품</b></font></span></a><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">으로 \n                            받는 마이닝장갑을 착용하시면 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">*오어를 \n                            녹일 때 실패시에는 해당오어가 반으로 줄어들게 됩니다. \n                            예를들면 오어 6만개의 골드를 녹이다가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">실패한다면 \n                            3만개고 되고 다시 실패한다면 만오천개가 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">*오어를 \n                            녹이면 2배의 잉갓으로 환원됩니다. 예를들어 1만개의 \n                            골드를 녹이는것을 성공하였다면</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2만개의 \n                            골드잉갓이 생기게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">*녹일때 \n                            필요한 화로(집에설치시)는 오직 카펜스킬이 있는 플레이어만이 \n                            만들 수 있습니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">광산에서는 \n                            일반적으로 광산입구에 놓여져 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">*</span></font><a href=\"/site/dungeon/S_firebeettle/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Fire \n                            Beetle(화이어비틀)</b></font></span></a><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\">로 \n                            타고 다니면서 오어를 노기실 수도 있습니다.</font></span></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;<font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"> \n                            가고일 곡괭이의 사용</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><a href=\"/site/bod/smith_list/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>벌크디드보상품</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">으로 \n                            받거나 </span></font><a href=\"/site/dungeon/Gargoyle/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>Gargoyle(가고일)</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                            사냥해서 얻을 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                            가고일 곡괭이를 이용하여 땅을 파게 되면 1단계 위의 \n                            어스엘리멘탈이 스폰됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">예를들어 \n                            쉐도우광석이 스폰되는 지점에서 해당 가고일 곡괭이를 \n                            이용하여 땅을 판다면 쿠퍼엘리멘탈이</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스폰됩니다. \n                            해당 엘리들은 특수능력을 가지고 있습니다. 애완동물의 \n                            용이나 마법에는 데미지를</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">입히지 \n                            못하고 전사의 근접공격에만 데미지를 받는 엘리도 \n                            있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\">&nbsp;</font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"></span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">Prospector's \n                                        Tool(탐광자의도구)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">탐광자의도구는 \n                            </span></font><a href=\"/site/bod/smith_list/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>벌크디드보상품</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">으로 \n                            받는것으로 해당 지역에 스폰되는 오어를 1단계 위의 \n                            오어로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">바꾸어 \n                            스폰되게 해줍니다. 예를들어 일반잉갓이 나오는곳에서 \n                            해당 탐광자의도구를 사용하시면</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">덜쿠퍼오어가 \n                            나오게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가고일곡괭이와 \n                            탐광자를 같이 사용한다면 일반오어 포인트에서 탐광자사용-쉐도우오어스폰, \n                            </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가고일곡괭이사용-쉐도우엘리스폰이 \n                            됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/point.gif\" data-recovery=\"missing\" height=\"15\" src=\"/img/placeholder/missing.svg\" width=\"15\"></span></font><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">화강암 \n                            얻기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">삽자루를 \n                            (shift키+원클릭) 하시면 메뉴가 활성화되고 화강암을 \n                            선택적으로 채취할 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자세한 \n                            사항은 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_addon_4/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>알케미와돌세트</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">를 \n                            참조하여 주시길 바랍니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:15;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"margin-top:5px; margin-bottom:0px;\"><b><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\">Written \n                By Forg</span></font></b></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
