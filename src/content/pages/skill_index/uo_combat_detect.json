  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_steal/\"><font color=\"black\" face=\"Verdana\">훔치기(Stealing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_hiding/\"><font color=\"black\" face=\"Verdana\">숨기(Hiding) \n                             \n                            </font></a><font color=\"black\" face=\"Verdana\">l&nbsp;</font><a href=\"/site/skill_index/uo_combat_stealth/\"><font color=\"black\" face=\"Verdana\">은폐이동(Stealth)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_snooping/\"><font color=\"black\" face=\"Verdana\">훔쳐보기(Snooping)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_detect/\"><font color=\"black\" face=\"Verdana\">은폐탐지(Detect Hidden)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_combat_tracking/\"><font color=\"black\" face=\"Verdana\">트랙킹(Tracking)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>DETECTING \n                            HIDDEN</b></span></font><span style=\"font-size:9pt;\"><font color=\"navy\" face=\"Verdana\"><b>\n</b></font></span><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"right\" border=\"0\" data-original-src=\"http://www.forg.co.kr/skill_index/images/logo_detect.gif\" data-recovery=\"missing\" height=\"60\" src=\"/img/placeholder/missing.svg\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Scout</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Intelligence </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 다른 플레이어의 가방 더블클릭</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Thief guildmaster</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(상자)와 타겟제한</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            은페탐지의 유용성</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">1. \n                            디텍히든은 하이딩한 플레이어나 스텔스로 이동중에 \n                            있는 플레이어를 탐지할 수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">2. \n                            상자에 트랩이 있는것을 발견할 수 있게 됩니다. 스킬이 \n                            성공 시 상자위에 [trapped]라는 글씨가</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">떠 \n                            오르며 트랩의 종류는 색으로 구별 할 수 있게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"green\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">초록색</span></font><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"> \n                            : 독이 들어있는 트랩</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"fuchsia\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">분홍색</span></font><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"> \n                            : 폭탄이 설치되어있는 트랩</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"blue\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">파랑색</span></font><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"> \n                            : 화살이 설치되어있는 트랩</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">3. \n                            스킬 80이상이 되면 각종 챔장소나 던전등, 바닥에 \n                            설치되어 있는 트랩이 표시됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">4. \n                            만약 &nbsp;하이딩 100인 플레어를 디텍히든 100을 \n                            가진 자가 찾는다고 가정한다면,</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">해당 \n                            장소를 정확히 클릭하시면 50%확율로 찾을 수 있게 \n                            됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">1타일 \n                            범위로 떨어질때마다 확율이 줄어들게 됩니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">물론 \n                            하이딩 스킬이 낮은 플레이어는 디텍히든으로 찾을 \n                            수 있는  범위가 넓게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">일예로 \n                            반대편을 검색해도 숨어있는 사람이 나타나게 됩니다.(인비로 \n                            숨거나, 하이딩스킬이 낮은 경우)</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">5. \n                            디텍히든으로 상자의 트랩을 직접 찾을 경우에는 딜레이 \n                            11초를 가지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">그러나 \n                            하이딩한 사람이 있는 해당 지역을 찾을때에는 발견 \n                            시 까지 약 3초의 딜레이를 가지게 됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            디텍히든 수련하기</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">베스퍼은행안에 \n                            스폰되는 상자들로 80까지 올리실 수 있으며 그 이후부터는 \n                            상위 던전의 던전상자들로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">수련하시면 \n                            됩니다. 권해드리는곳은 히스로스섬의 데몬템플안에서 \n                            하이딩 하신 후 스폰되는 상자들로</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">수련하시면 \n                            됩니다.</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            트랙킹과의 관계</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">디텍히든은 트랙킹과의 밀접한 관계를 가지고 있습니다. \n                            해당 트랙킹기술로 사람이나 몬스터등을</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">찾게 \n                            되는데 이때 하이딩한 사람도 찾을 수 있게 됩니다. \n                            디텍히든처럼 하이딩한 사람을 나타내게</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">하지는 \n                            못하지만 어디에 숨어있는지 정확한 위치를 파악하실 \n                            수 있습니다.</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana,굴림체\"><span style=\"font-size:9pt;\">자세한 \n                            정보는 트랙킹란을 참조 하시길 바랍니다.</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#262626\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By \n\n                        Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
