  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"#333333\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p>&nbsp;</p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_blacksmith/\"><font color=\"black\" face=\"Verdana\">대장장이(BlackSmith)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_mining/\"><font color=\"black\" face=\"Verdana\">광부(Mining)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_armslore/\"><font color=\"black\" face=\"Verdana\">장비지식(Arms Lore)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_tailor/\"><font color=\"black\" face=\"Verdana\">재봉사(Tailor)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\">\n<span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_lum/\"><font color=\"black\" face=\"Verdana\">나무꾼(Lumberjacking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_jobs_car/\"><font color=\"black\" face=\"Verdana\">목공술(Carpentry)</font></a><font color=\"black\" face=\"Verdana\">  \n                            l </font><a href=\"/site/skill_index/uo_jobs_bow/\"><font color=\"black\" face=\"Verdana\">활제작자(Bowcraft)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_thinker/\"><font color=\"black\" face=\"Verdana\">기계공(Tinkering)</font></a><font color=\"black\" face=\"Verdana\"> </font></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_jobs_fishing/\"><font color=\"black\" face=\"Verdana\">낚시(Fishing)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_cooking/\"><font color=\"black\" face=\"Verdana\">요리(Cooking)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_begging/\"><font color=\"black\" face=\"Verdana\">구걸(Begging)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_alchemy/\"><font color=\"black\" face=\"Verdana\">포션제작자(Alchemy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_jobs_ins/\"><font color=\"black\" face=\"Verdana\">스크롤제작자(Inscription)</font></a></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>COOKING \n                            &nbsp;&nbsp;<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_cook.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Chef</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Dexterity </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당스킬사용(요리도구 이용)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Vegetable Seller, Baker, Cook, Herbalist</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도(해당 제품 만들기)</span></font></p>\n<hr align=\"center\" color=\"white\" style=\"line-height:50%; margin-top:0; margin-bottom:0;\" width=\"98%\"> <p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">요리에 필요한 도구들</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_1.gif\" width=\"100\">요리를 \n                                            할 때는 다음과 \n                                            같은 도구가 필요합니다. 도구들은 \n                                            마을 술집에서 팝니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"22\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_tool.gif\" width=\"22\">손잡이(기계공기술:30)<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_tool_1.gif\" width=\"20\">밀가루채(기계공기술:50)<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/roll.gif\" width=\"20\">밀대(기계공기술:0)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">우리가 \n                                            요리를 할 수 있게 만들어 줄 요리도구 \n                                            입니다. 각각의 \n                                            요리도구는 해당 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">팅거(기계공기술)스킬이 \n                                            만들 수도 있습니다. 요리의 \n                                            기본이 되는 물<img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/cook/waterp.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:20/20\" width=\"20\">도 \n                                            요리에 따라 필요하게 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">물이채워진 \n                                            물병이 다쓰게 되었다면 빈병을 더블클릭 \n                                            후 타겟이 활성화되면 수조를 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">클릭 \n                                            하시면 다시 채워집니다. 수조는 빵가게에서 \n                                            사용하실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_34gif.gif\" width=\"100\">집이 \n                                            있다면 자신의 집에 수조(목공스킬 \n                                            94.7요구)를 설치하셔도 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;※각종 \n                                            요리재료들은 술집이나 빵가게에서 \n                                            손쉽게 구입 하실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">생고기류의 \n                                            고기들은 정육점이나 해당 동물을</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">요리에 필요한 재료들</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">아래의 \n                                            요리재료는 요리도구를 더블클릭 후 \n                                            메뉴창이 활성화되면 요리재료를 선택하시고</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                                            요리재료를 클릭 하시어 만들어 주시면 \n                                            됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">1. \n                                            &nbsp;<img border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/cook/flour.gif\" width=\"25\">밀가루자루를 \n                                            만들&nbsp;수 있는 방법은</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"80\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_2.gif\" width=\"100\">좌측&nbsp;이미지와 \n                                            같이 밀을 구하는 방법입니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">밀을 \n                                            구하는 방법은 문글로우 정문에서 \n                                            남쪽이나 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스카라브레이스항구에서 \n                                                        바다를 \n                                            건너 동쪽지역에 분포되어 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">자라고 \n                                            있는 밀을 더블클릭하시면 밀이 나옵니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"80\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_3.gif\" width=\"100\">3개의 \n                                            밀은 1개의 밀가루포대를 만들어 줍니다. \n                                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">우선 \n                                             제분기에 붙어서 요리도구를 클릭하여 \n                                                        메뉴창이 \n                                            활성화되면 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">요리재료-밀가루자루를 \n                                            선택하여 줍니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">만드는 \n                                            작업이 성공하였다면 자신의 백팩에 \n                                            밀가루자루가 만들어 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">집니다.제분기는 \n                                            카펜(목공)스킬로서 만들고 집안에 \n                                            설치 가능합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2. \n                                            밀가루 반죽<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/dough.gif\" width=\"20\"> \n                                            : 밀가루 자루<img align=\"absmiddle\" border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/cook/flour.gif\" width=\"25\">+물<img align=\"absmiddle\" border=\"0\" data-original-src=\"http://forg.co.kr:80/skill_index/images/uojobs/cook/waterp.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:20/20\" width=\"20\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3. \n                                            단반죽<img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/cook/honey_dough.gif\" width=\"20\"> \n                                            : 밀가루 반죽<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/dough.gif\" width=\"20\"> \n                                            + 꿀<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/honey.gif\" width=\"20\">(꿀은 \n                                            빵가게 NPC벤더에게서 구입)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">4. \n                                            케이크 믹스<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cookiemix.gif\" width=\"20\"> \n                                            : 밀가루 자루<img align=\"absmiddle\" border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/cook/flour.gif\" width=\"25\"> \n                                            + 단 반죽<img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/cook/honey_dough.gif\" width=\"20\"></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5. \n                                            쿠키 믹스<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cookiemix.gif\" width=\"20\"> \n                                            : 꿀<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/honey.gif\" width=\"20\"> \n                                            + 단 반죽<img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/cook/honey_dough.gif\" width=\"20\"></span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                                        밀가루 자루를 만드는 \n                                                        &nbsp;과정이 \n                                            어려우신 분들은 직접 Gp(돈)을 주고 \n                                            빵가게에서 Npc벤더에게 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">구입하시면 \n                                            됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                                        1개의 밀가루 자루는<img align=\"absbottom\" border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/cook/flour.gif\" width=\"25\"> 20개의 \n                                                        밀가루 반죽<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/dough.gif\" width=\"20\">이 \n                                                        나옵니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">빵집 \n                                             NPC벤더가 파는 밀가루 사발은<img align=\"texttop\" border=\"0\" height=\"25\" src=\"/img/posts/site/skill_index/images/uojobs/cook/flo.gif\" width=\"25\">\n                                            1개의  \n                                            밀가루 반죽이<img align=\"absmiddle\" border=\"0\" height=\"20\" src=\"/img/posts/site/skill_index/images/uojobs/cook/dough.gif\" width=\"20\"> 나옵니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"></span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> \n                                                        계란과 호박등은 \n                                                        </span></font><a href=\"/site/skill_index/images/uojobs/cook/cook_map/\" target=\"_blank\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>마을 근처 외곽 NPC집</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">에 \n                                                        있는 벤더들이 \n                                                        팝니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">\n</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">불이 \n                                                        필요한 요리는 불 근처에서 \n                                                        요리를 해주시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_7.gif\" width=\"100\">1. \n                                                        캠핑 시 피우는 불 \n                                                        : 단검으로 숲에 있는 \n                                                        나무에서 \n                                                        장작을 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">얻은 후 장작을 \n                                                        더블클릭하면 \n                                                        불이 지펴집니다.(</span></font><a href=\"https://web.archive.org/web/20060222154137/http://forg.co.kr:80/skill_index/uo_vet_camping.html\" target=\"_blank\"><span style=\"font-size:9pt;\"><font face=\"Verdana\"><b>캠핑란 \n                                                        참조</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_6.gif\" width=\"100\">2. \n                                                        오븐 : 오븐은 카펜(목공기술68.4 \n                                                        기계공기술50)이 만들 \n                                                        수 있고, </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">집안에 설치가 \n                                                        가능합니다.물론 \n                                                        빵집에서도 이용 하실 \n                                                        수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"left\" border=\"1\" height=\"40\" src=\"/img/posts/site/skill_index/images/uojobs/cook/cook_5.gif\" width=\"100\">3.마법을 \n                                                        이용한 불 :4써클 \n                                                        마법 파이어월이라는 \n                                                        불의 장벽을 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">지피면 됩니다. \n                                                        배안에서도 주로 이용합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">\n</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">야만족 \n                                                        페인트는<img align=\"absmiddle\" border=\"0\" height=\"18\" src=\"/img/posts/site/skill_index/images/uojobs/cook/paint.gif\" width=\"18\"> \n                                                        쿠킹(요리)스킬 \n                                                        80이상으로 부족딸기를 \n                                                        이용하여 만들 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;자세한 \n                                                        <img align=\"absmiddle\" border=\"0\" height=\"12\" src=\"/img/posts/site/skill_index/images/uojobs/cook/fruit.gif\" width=\"12\">부족열매를 얻는것과 \n                                                        설명은 </span></font><a href=\"/site/skill_knowhow/uo_knowhow_addon_5/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>세비지도구</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">참조</span></font></p>\n<center>\n<p style=\"line-height:50%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n</center>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">\n</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">계란폭탄은 \n                             \n                                                        쿠킹(요리)스킬 \n                                                        90이상으로 계란과 밀가루를 \n                            이용하여 만듭니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                            계란폭탄은 닌자술스킬을 배운 플레이어가 연막탄대용으로 \n                            쓰는 아이템입니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">미소(Miso),와사비(Wasabi)등의 \n                            재료는 SE지역의 Makoto-Jima에 있는 요리상점에서 \n                            판매합니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"#333333\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"#333333\" face=\"Verdana\"><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
