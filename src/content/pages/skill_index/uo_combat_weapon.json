  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_weapon/\"><font color=\"black\" face=\"Verdana\">각종무기류(Sword,Mace,Fencing,Archery,Wrestling)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_combat_ta/\"><font color=\"black\" face=\"Verdana\">전술(Tactics)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_ana/\"><font color=\"black\" face=\"Verdana\">해부학(Anatomy)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_combat_he/\"><font color=\"black\" face=\"Verdana\">힐링(Healing)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_focus/\"><font color=\"black\" face=\"Verdana\">집중(Focus)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_combat_pa/\"><font color=\"black\" face=\"Verdana\">방패술(Parry)</font></a></span></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font color=\"black\">&nbsp;</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>Weapons(Sword,Mace,Fencing,Archer,Wrestling)<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_weapon.gif\" width=\"100\">\n</b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Swordsman,Armsman,Fencer,Archer,Wrestler</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Dexterity</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : Automatic(무기나 맨손 사용시)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Warrior Guildmaster, Weapons Trainer, \n                            Mage Guildmaster(레슬링)</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            각종 무기 스킬(소드,메이스,펜싱,궁술,레슬링)은 해당 \n                            몹이나 다른 플레이어를 공격 할때 타겟이 </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">명중했는지에&nbsp;대한 \n                            공격 성공율에 영향을 미칩니다. 또한 각 무기스킬은 \n                            택틱과 마찬가지로 난이도에 </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">기반을 \n                            두어 해당 스킬을 수련할때에는 저렙의 몬스터부터 \n                            수련해야 합니다.</font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">단, \n                            레슬링은 무기를 들지 않고 맨손으로 몬스터를 타격해서 \n                            수련해야 합니다.</font></span></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\"><b><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\"> \n                            무기스킬에 의한 명중 성공율의 결정</b></font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">공격자가 지난 공격 후 얼마나 지난 후에 공격할지가 결정되면 이 공격이 성공할지 실패할지를 \n결정합니다.</font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">공격의 성공은 공격자의 해당 무기의 스킬(각 무기스킬과 레스링)과 공격자의 공격 성공 기회 증가 \n                            </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">아이템의 수치, 방어자의 해당 무기스킬과 방어자의 방어 기회 증가 아이템 수치로 결정 됩니다.<br></font><font color=\"purple\" face=\"Verdana\">공격자와 방어자 모두 아이템에의한 명중 기회 \n증가와 방어 기회 증가는 45%까지로 제한 됩니다.<br>공격자의 명중 기회의 최소값은 2%입니다.</font></span></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">&nbsp;</font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">명중 성공율의 계산 식은 다음과 같습니다.</font></span></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"550\">\n<tbody><tr>\n<td bgcolor=\"#FFFFCC\">\n<p style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">공격자 수치 = [ 공격자 전투 스킬 + 20 ] \n* [ 공격자 명중 기회 증가 아이템 수치 / 100 + 1 ]<br>방어자 수치 = [ 방어자 전투 스킬 + 20 ] * [ 방어자 방어 기회 \n증가 아이템 수치 / 100 + 1 ]<br><br>명중 성공율(%) = ( 공격자 수치 / ( 방어자 수치 * 2 ) ) * \n100</font></span></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">풀어보면<br>공격자가 지금 사용하는 무기의 스킬(카타나라면 소드멘 쉽, 크리스라면 펜싱, \n맨손이라면 레스링)에 </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">20을 더한 값에 공격자의 명중 기회 증가 아이템의 수치를 적용합니다.<br>방어자가 지금 사용하는 무기의 스킬에 20을 \n더한 값에 방어자의 방어기회 증가 아이템의 수치를 </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">적용합니다.<br>공격자의 수치를 방어자의 수치에 두배 값으로 나누고 100을 곱해서 %로 \n명중 성공율이 결정됩니다.<br>공격자와 방어자가 같은 수치의 사용 무기 수치를 가지고 같은 명중 기회 증가와 방어 기회 증가 아이템을 </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">착용하고 \n있을 경우 50%의 확율이 나오게 됩니다.</font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">그러므로 공격자가 명중 성공율이 100%가 되기 위해서는 방어자수치의 두배에 수치가 나와 줘야만 \n합니다. PvP에서는 거의 불가능한 상황이지만 디스암 등을 걸어 방어자가 들고있는 무기를 떨어뜨린다면 상당히 </font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">유리해 질 수 \n있습니다.</font></span></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:0; margin-bottom:0; margin-left:10;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">이렇게 공격 성공 확율이 정해 졌다고 해도 방어자가 패링 등으로 방어할 수도 \n있습니다.</font></span></p>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"silver\" bordercolordark=\"white\" bordercolorlight=\"silver\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\">\n<tbody>\n<tr height=\"18\">\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" height=\"18\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">공격자 스킬</font></span></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">공격자<br>공격 성공</font></span></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">방어자 스킬</font></span></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">방어자<br>방어 증가</font></span></p></td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">공격<br>성공율(%)</font></span></p></td></tr>\n<tr height=\"18\">\n<td align=\"right\" height=\"18\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">100</font></span></p></td>\n<td align=\"right\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">0</font></span></p></td>\n<td align=\"right\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">0</font></span></p></td>\n<td align=\"right\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">0</font></span></p></td>\n<td align=\"right\" bgcolor=\"#FFFFCC\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">100</font></span></p></td></tr>\n<tr height=\"18\">\n<td align=\"right\" height=\"18\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">110</font></span></p></td>\n<td align=\"right\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">0</font></span></p></td>\n<td align=\"right\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">0</font></span></p></td>\n<td align=\"right\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">0</font></span></p></td>\n<td align=\"right\" bgcolor=\"#FFFFCC\" width=\"70\">\n<p align=\"center\" style=\"line-height:100%; margin:0;\"><span style=\"font-size:9pt;\"><font face=\"Verdana\">100</font></span></p></td></tr>\n<tr height=\"18\">\n<td al