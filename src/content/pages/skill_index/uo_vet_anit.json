  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><a name=\"top\"></a></span></font></p></td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_t.gif\" height=\"25\" width=\"630\"> <p><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b><img align=\"absmiddle\" border=\"0\" height=\"24\" src=\"/img/posts/site/skill_knowhow/images/u.gif\" width=\"24\">O. \n                            Combat&amp;Jobs</b></span></font></p>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:60%; margin-top:0; margin-bottom:0;\"><font color=\"black\">&nbsp;</font></p>\n<table align=\"center\" border=\"1\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"600\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background_1.gif\" height=\"22\">\n<table align=\"center\" border=\"0\" bordercolordark=\"#666666\" bordercolorlight=\"black\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"590\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_knowhow/images/alpha_background.gif\">\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><font color=\"black\">&nbsp;</font></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_anit/\"><font color=\"black\" face=\"Verdana\">길들이기(Taming)</font></a><font color=\"black\" face=\"Verdana\"> \n                            l&nbsp;</font><a href=\"/site/skill_index/uo_vet_anit_1/\"><font color=\"black\" face=\"Verdana\">테이밍스킬수치표</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_vet_anit_2/\"><font color=\"black\" face=\"Verdana\">주요스폰장소</font></a><font color=\"black\" face=\"Verdana\"> \n                            l </font><a href=\"/site/skill_index/uo_vet_anil/\"><font color=\"black\" face=\"Verdana\">동물지식(Animal Lore)</font></a></span></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:0;\"><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_vet/\"><font color=\"black\" face=\"Verdana\">동물붕대힐(Veterinary)</font></a><font color=\"black\" face=\"Verdana\"> l </font><a href=\"/site/skill_index/uo_vet_he/\"><font color=\"black\" face=\"Verdana\">목동술(Herding)</font></a></span></p>\n<p align=\"left\" style=\"line-height:50%; margin-top:0; margin-right:20; margin-bottom:0; margin-left:20;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><b>ANIMAL \n                            TAMING<img align=\"right\" border=\"0\" height=\"60\" src=\"/img/posts/site/skill_index/images/logo_at.gif\" width=\"100\"></b></span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">직업 \n                            타이틀: Ranger</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            주 상승 스탯: Strength</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">사용시 \n                            부가 상승 스탯: Intelligence</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬사용 \n                            : 해당 스킬 사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">수련 \n                            가능 NPC: Animal Trainer</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\">스킬 \n                            Up: 난이도</span></font></p>\n<p align=\"center\" style=\"line-height:50%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"580\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">길들이기 \n                                        스킬은 \n                                        애완동물이나 몬스터류의 용을 플레이어의 \n                                        명령을 받는 충직한 애완동물로 만드는</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬입니다. \n                                        몬스터류중에는 화웜,용,룬비틀,히류등의 \n                                        엄청난 힘과 공격력을 가진 것들도 있으므로</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">길들이기는 \n                                        울온 스킬중에서 고급스킬중에 하나라고 말할 \n                                        수 있습니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">테이밍스킬의 \n                            사용</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테임할 \n                            동물에게 2타일 이내로 근접하여&nbsp;테이밍스킬을 \n                            사용 후 해당동물을 찍어주시면 됩니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테임시도시 \n                            약 11초의 딜레이가 발생하며 그 시간동안 테임시도상태를 \n                            유지하셔야 합니다. </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테임시도시에는 \n                            약 4~6타일정도로 거리를 두셔도 시도상태가 유지됩니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">테임 \n                            시도시 실패하는 경우는 다음과 같습니다.</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellpadding=\"5\" cellspacing=\"0\" style=\"line-height:100%; margin:0;\" width=\"580\">\n<tbody><tr>\n<td>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">- \n                                        해당 동물이 테임을 하는 플레이어에게 \n                                        근접할 수 없는경우(이러한 경우를 블럭이라고 \n                                        하는데 눈으로</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;보기에 \n                                        걸어서 플레이어에게 올 수 있는지를 파악하시면 \n                                        됩니다. 에너지필드나 벽을 두고 막거나, \n                                        </span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;&nbsp;다른 \n                                        플레이어가 외길 통로에서 테임을 하는 \n                                        플레이어앞에서 막아버릴때)</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">- \n                                        해당 동물이 데미지를 입는 경우</span></font></p>\n<p style=\"line-height:100%; margin:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">- \n                                        테임을 시도하는 플레이어가 하이딩이나 \n                                        인비마법을 사용하여 모습을 감추는 경우</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\">공격적인 \n                            용이나 룬비틀같은 경우 테임 시도 시 화를 낸다는 \n                            메세지와 함께 도중에 테임 실패가 되는</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\">경우가 \n                            많습니다. 이때는 딜레이가 무시되니 바로 재 테임을 \n                            시도하시면 됩니다.</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> 이러한것에 대비하여</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">울온 \n                            자체매크로 키를 설정하시면 편리합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Use \n                            Skill - Animal Taming</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Last \n                            Target</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">모든 \n                            애완동물은 테임시 10%의 스킬로스가 있습니다. 이것은 \n                            훈련을 통해 해당 스킬을 복구 하실 수 있습니다. 만일 \n                            풀어준 애완동물을 다른 플레이어가 테임 한다고해도 \n                            잃어버린 스킬은 돌려받지 못합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">예로 \n                            레슬링 스킬 70을 가진 룬비틀을 테임했을경우 테임 \n                            성공시 63이 됩니다. 이것을 훈련을 통해</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">100까지 \n                            올리실 수 있습니다.</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">파이어비틀이나 \n                            자이언트비틀은 체력의 약 90%를 소진시켜야 테임시도가 \n                            가능합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물에 \n                            대한&nbsp;명령어</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물의 \n                            명령을 내리기위해서는 애니멀 테이밍이 아닌&nbsp;</span></font><span style=\"font-size:9pt;\"><a href=\"/site/skill_index/uo_vet_anil/\"><font color=\"green\" face=\"Verdana\"><b>동물지식(Animal Lore)</b></font></a></span><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">의 \n                            스킬이 필요하게 됩니다. </span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물에게 \n                            가끔 먹이를 주는 일을 잊지 마시고, 애완동물이 만일 \n                            테임이 풀려버렸을때는 </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">공격적인 \n                            용이나 히류같은 동물은 주인을 공격하는 경우도 생기게 \n                            됩니다.</span></font></p>\n<table align=\"center\" border=\"1\" bordercolor=\"#CCCCCC\" bordercolordark=\"white\" bordercolorlight=\"#CCCCCC\" cellspacing=\"0\" width=\"560\">\n<tbody><tr>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">명령어</span></font></p>\n</td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">\"All\"명령어</span></font></p>\n</td>\n<td background=\"/img/posts/site/skill_index/images/alpha_background_2.gif\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">결 \n                                        과</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Follow</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가능</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물이 \n                                        목표물을 따라가게 합니다. </span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">\"All \n                                        Follow Me\"를 주로 쓰며 해당 애완동물이 \n                                        테이머를 따라다니도록 합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Friend</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">불가</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물이 \n                                        다른 플레이어의 명령을 듣게 합니다. \n                                        이때 Kill이나 Guard등은</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">듣지 \n                                        않으며 오직 Follow정도만 듣게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Guard</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가능</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물이 \n                                        테이머를 보호하게 합니다. \"가드\"된 \n                                        테이머의 이름위에는 가드되고 있다는 \n                                        메세지가 뜨며 주인이 공격을 받게되면 \n                                        자동으로 공격자를 애완동물이 공격하게 \n                                        됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Kill,</span></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Attack</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가능</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물이 \n                                        목표물을 공격하게 만듭니다. 이때 자기 \n                                        자신을 공격하게 만들 수도 있으니 주의하여야 \n                                        하며 펠루지역에서 블루의 애완동물이나 \n                                        플레이어를 공격하게 되면 범죄행위로 \n                                        그레이가 됩니다. 마을에서는 가드의 응징을 \n                                        받게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Release</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가능</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물을 \n                                        풀어줍니다. 이때 공격적인 동물은 테임이 \n                                        풀리면서 그레이가 되므로마을에서는 애완동물이 \n                                        가드의 공격을 받을 수 있습니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Stay</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가능</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물이 \n                                        서있는 장소에 대기상태로 서 있게 됩니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Stop</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">가능</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물의 \n                                        행동을 정지 시킵니다. 가드나 따라오기등.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;Transfer</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">불가</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물을 \n                                        다른 플레이어에게 이전 시킵니다. 이때 \n                                        해당 애완동물의 난이도에</span></font></p>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">따라 \n                                        받는 자의 테임스킬,로어 수치를 고려 \n                                        해야만 합니다.</span></font></p>\n</td>\n</tr>\n<tr>\n<td bgcolor=\"#FFFFCC\">\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">Come</span></font></p>\n</td>\n<td>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">불가</span></font></p>\n</td>\n<td>\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">애완동물이 \n                                        갇혀있을때 유용하게 쓰는 명령어로 애완동물이 \n                                        텔레포트로 테이머에게 순간이동합니다.</span></font></p>\n</td>\n</tr>\n</tbody></table>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">위의 \n                            명령어는 애완동물의 이름이 Holy라고 한다면(애완동물을 \n                            드래그 하시면 이름창이 뜨게 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이때 \n                            해당 이름을 선택하여 바꿀 수 있게 됩니다.) Holy \n                            Transfer,Holy Kill,Holy Guard Me,Holy Follow Me등으로 \n                            명령을 내리실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물을 \n                            다른플레이어에게 이전하기</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">테임된 \n                            동물을 다른 플레이어에게 이전하기위해서는 새로운 \n                            주인의 길들이기스킬이 해당 동물스킬수치에</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">맞게 \n                            </span><span style=\"font-size:8pt;\">높</span><span style=\"font-size:9pt;\">아야 \n                            합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이때 \n                            영플레이어나 소환된 동물, 적대길드등의 플레이어에게는 \n                            이전하기가 되지를 않습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">한번 \n                            테임된 동물은 테임이 풀려도 100%로 재테임이 됩니다. \n                            하지만 이전 받은 동물이라면 재테임시 난이도가 보다 \n                            어렵게 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물의 \n                            슬롯수</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">플레이어는 \n                            기본적으로 5슬롯의 동물의 수를 가질 수 있습니다. \n                            </span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2slots \n                            : hirelings, fire steeds, unicorns, \n                            ki-rin, nightmares, drakes, and imps</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3slots \n                            : white wyrms, dragons, and golems</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">소환된 \n                            동물의 슬롯수는 다음과 같습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">2 control slots: air and earth elementals</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">3 control slots: water elementals</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">4 control slots: fire elementals</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">5 control slots: daemons</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">올드비 \n                            보상품인 천상마는 1슬롯을 차지하게 됩니다. 즉 용과 \n                            드레아크를 조정할려면 천상마에서 내리셔야 5슬롯을 \n                            채울 수 있게 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물의 \n                            본디드</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">본디드라는것은 \n                            주인과 애완동물사이의 밀접한 관게를 의미합니다. \n                            보통 애완동물이 죽으면 사라지지만</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">본디드된 \n                            애완동물은 유령형태로 남아 있게 되고 주인이 살릴 \n                            수 있게 되고 게이트를 이용하지 않아도 리콜시 주인을 \n                            따라 워프하게 됩니다. 또한 </span></font><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\">전송구슬</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">을 \n                            이용하여 애완동물을 주인에게로 소환시킬 수 있습니다. \n                            (</span></font><a href=\"/site/uoquest/Ant_Quest/\"><span style=\"font-size:9pt;\"><font color=\"green\" face=\"Verdana\"><b>UO.퀘스트정보-개미퀘스트참조</b></font></span></a><font face=\"Verdana\"><span style=\"font-size:9pt;\">)</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">본디드가 \n                            될려면 다음과 같은 요건을 충족시켜야 합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"maroon\" face=\"Verdana\"><span style=\"font-size:9pt;\">실제시간으로 \n                            일주일동안 플레이어의 소유여야 하며</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\"> 만일 해당 애완동물이 \n                            최소테임스킬이 29.1이상</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이라면 \n                            해당 애완동물이 본디드가 될려면 해당최소스킬을 가지고 \n                            있어야 합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">29.1이하인 \n                            말이나 오스타드등은 스킬 수치가 없어도 본디드가 \n                            가능하고, 예외로 자이언트비틀,스웜프드래곤,파이어비틀도 \n                            가능합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">보통 \n                            애완동물을 마구간에 놓고 일주일뒤에 꺼낸 후 먹이를 \n                            주시면 본디드가 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">먹이를 \n                            소홀히 주어 테임이 풀리게 되면 본디드도 자동으로 \n                            풀립니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">애완동물의 \n                            죽음 후 부활시키기</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">본디드가 \n                            된 애완동물이 죽게되면 유령상태로 남아있게 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">이때는 \n                            마구간에 보관이 되지를 않지만 소환구슬로 소환을 \n                            하거나 리콜,팔로우등이 가능하므로</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">안전한곳에서 \n                            부활을 시키시면 됩니다. 붕대부활시 적어도 동물치료(베네터리)와 \n                            동물지식(애니멀로어)의</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">스킬이 \n                            각 80이상이 되어야 합니다. 부활시 애완동물은 스킬로스를 \n                            일으키며 각 스킬이 0.1씩 줄어들게</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"navy\" face=\"Verdana\"><span style=\"font-size:9pt;\"><img align=\"absmiddle\" border=\"0\" height=\"15\" src=\"/img/posts/site/skill_index/images/point.gif\" width=\"15\">마구간의 \n                            이용과 최대보관수</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">마을에 \n                            있는 마구간에 자신의 애완동물을 맡기실 수 있으며 \n                            NPC에게 맡기실때는&nbsp;\"</span></font><font color=\"#990033\" face=\"Verdana\"><span style=\"font-size:9pt;\">Stable</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">\" \n                            찾으실때는</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">\"</span></font><font color=\"#990033\" face=\"Verdana\"><span style=\"font-size:9pt;\">Claim</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">\"을 \n                            외치시면 됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">많은 \n                            동물을 보관하고 게신다면 \"</span></font><font color=\"#990033\" face=\"Verdana\"><span style=\"font-size:9pt;\">Claim \n                            List</span></font><font face=\"Verdana\"><span style=\"font-size:9pt;\">\"로 \n                            선택하여 찾으실 수 있습니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">플레이어마다 \n                            보관할 수 있는 마리수가 있는데 그것은 다음과 같은 \n                            수치로 정해집니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font face=\"Verdana\"><span style=\"font-size:9pt;\">해당 \n                            플레이어가 가진 애니멀테이밍,애니멀로어,베네터리의 \n                            총합 스킬수치가</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">160~199.9 \n                            이면 3마리, 200~~239.9이면 4마리, 240이면 5마리까지 \n                            보관이 가능합니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">300일때 \n                            9마리가 보관 가능하며 10씩 오를때마다 1마리씩 추가됩니다.</span></font></p>\n<p style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\"><font color=\"purple\" face=\"Verdana\"><span style=\"font-size:9pt;\">최대 \n                            360일때 14마리 최대 보관이 됩니다.&nbsp;</span></font></p>\n<p style=\"line-height:50%; margin-top:0; margin-right:10; margin-bottom:0; margin-left:10;\">&nbsp;</p>\n<table align=\"center\" bordercolordark=\"#A0965A\" bordercolorlight=\"#999933\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"100%\">\n<tbody><tr>\n<td width=\"298\">\n<p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0; margin-left:8;\"><a href=\"/site/skill_index/uo_skill/\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/menu.gif\" width=\"30\"></font></span></b></a></p>\n</td>\n<td width=\"295\">\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-right:10; margin-bottom:0;\"><a href=\"#top\"><b><span style=\"font-size:9pt;\"><font color=\"black\" face=\"Verdana\"><img border=\"0\" height=\"20\" src=\"/img/posts/site/skill_knowhow/images/top.gif\" width=\"20\"></font></span></b></a></p>\n</td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span><b><span style=\"font-size:9pt;\">Written By Forg</span></b></font></p>\n<p align=\"right\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/skill_knowhow/images/memo_b.gif\" height=\"20\" width=\"630\"><p align=\"left\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;<img border=\"0\" height=\"15\" src=\"/img/posts/site/skill_knowhow/images/b_logo.gif\" width=\"100\"></span></font></p></td>\n</tr>\n</tbody></table></div>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"black\" face=\"Verdana\"><span style=\"font-size:9pt;\">&nbsp;</span></font></p>\n",
