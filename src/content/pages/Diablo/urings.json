  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"745\">\n<tbody><tr>\n<td align=\"left\" height=\"1226\" rowspan=\"4\" valign=\"top\" width=\"115\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Diablo/images/item/l_logo.gif\" data-recovery=\"missing\" height=\"100\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"돋움\" size=\"2\"><a href=\"https://web.archive.org/web/20011220005645/http://www.forg.co.kr/Diablo/item_basic.htm\" target=\"_blank\" title=\"아이템기본지식\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Diablo/images/item/l_item.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></a></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/Diablo/item_gems/\" title=\"젬\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Diablo/images/item/l_gems.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a><a href=\"/site/Diablo/item_jewels/\" title=\"주얼\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Diablo/images/item/l_jewels.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><a href=\"/site/Diablo/item_runes/\" title=\"룬\"><font face=\"돋움\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Diablo/images/item/l_runes.gif\" data-recovery=\"missing\" height=\"20\" src=\"/img/placeholder/missing.svg\" width=\"110\"></font></a></p>\n<p align=\