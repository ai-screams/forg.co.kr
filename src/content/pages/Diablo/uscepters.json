  "html": "\n<div align=\"center\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n<tbody><tr>\n<td height=\"10\" width=\"630\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;</font><font color=\"#333333\"><a name=\"top\"></a></font></p></td>\n</tr>\n<tr>\n<td align=\"left\" background=\"/img/posts/site/Diablo/images/left_menu/memo_t.gif\" height=\"25\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\" width=\"630\">\n\n<font class=\"combo\" id=\"combos\" style=\"cursor:hand;\" title=\"원래 표기: Catalog*******\">Catalog</font>\n<div id=\"myDIV\">\n<a class=\"com\" href=\"https://web.archive.org/web/20020830042522/http://forg.uospace.net:80/Diablo/basic.htm\" target=\"_blank\" title=\"각종팁\">Basic Tips</a><br>\n<a class=\"com\" href=\"/site/Diablo/item_gems/\" title=\"젬\">GEM</a><br>\n<a class=\"com\" href=\"/site/Diablo/item_jewels/\" title=\"주얼\">Jewels</a><br>\n<a class=\"com\" href=\"/site/Diablo/item_charms/\" title=\"참\">Charms</a><br>\n<a class=\"com\" href=\"/site/Diablo/item_runes/\" title=\"룬\">Runes</a><br>\n<a class=\"com\" href=\"/site/Diablo/item_runewords/\" title=\"룬워드공식\">RuneWords</a><br>\n\t\t\t------------\n\t\t\t<a class=\"com\" href=\"/site/Diablo/item_setitems/\" title=\"세트아이템\">Set Item</a><br>\n<a class=\"com\" href=\"/site/Diablo/item_unique/\" title=\"유니크아이템\">Unique Items</a><br><br>\n</div><img border=\"0\" data-original-src=\"http://forg.uospace.net:80/Diablo/images/left_menu/blizzard_logo.gif\" data-recovery=\"missing\" height=\"17\" src=\"/img/placeholder/missing-slot.svg\" style=\"aspect-ratio:200/17\" width=\"200\">\n</td>\n</tr>\n<tr>\n<td background=\"/img/posts/site/Diablo/images/left_menu/memo_m.gif\" height=\"39\" width=\"630\"> <p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"#333333\" face=\"돋움\" size=\"2\">&nbsp;