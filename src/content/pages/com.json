  "html": "\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"80%\">\n<tbody><tr>\n<td valign=\"top\" width=\"80\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Image/know_h.gif\" data-recovery=\"missing\" height=\"500\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:80/500\" usemap=\"#know_h\" width=\"80\"></font></p></td>\n<td nowrap=\"\" valign=\"top\" width=\"670%\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\">&nbsp;</p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"maroon\" face=\"바탕체\" size=\"3\"><b>울온 명령어에 대해 알아보자</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;울온에는 수많은 명령어들이 있다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">하지만 같은 예를들어 중복되는 명령어가 많다.</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">그것들을 왜 다외워야 할까?</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">여기서는 꼭 필요한 것만 나열하도록 하겠다.</font><font face=\"바탕체\"> </font>\n</p><table border=\"\" bordercolor=\"#636363\" bordercolordark=\"#636363\" bordercolorlight=\"#636363\" width=\"80%\">\n<tbody><tr>\n<td width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>장소</b></font></p></td>\n<td width=\"209\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>명령어</b></font></p></td>\n<td width=\"310\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"바탕체\" size=\"2\"><b>설명</b></font></p></td>\n</tr>\n<tr>\n<td width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>은행</b></font></p></td>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Bank</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Vendor Buy</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Vendor Sell</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">은행에 있는 자기 아템을 엽니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">상점에서 물건을 삽니다</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">상점에서 물건을 팝니다</font></p></td>\n</tr>\n<tr>\n<td width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>배(항구)</b></font></p></td>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Dock</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">배를 디드로 바꾸어줍니다</font></p></td>\n</tr>\n<tr>\n<td rowspan=\"11\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>소환한몹이나</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>테임된동물</b></font></p></td>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) Kill</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">목표를 공격하게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) Follow</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">목표를 따라가게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) Follow me</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">자신을 따라오게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) Guard </font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">목표를 방어해줍니다(물건도 됩니다)</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) Guard me</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">자신을 방어하게 해줍니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) stay</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">그 자리에 멈추게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) come</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">자신의위치로 오게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) friend</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">친구도 명령을 따르게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) transfer</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">상대방이 주인이 되게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) goodl,nice</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">칭찬해 줍니다.</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">All(이름) release</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">소환된몹을 사라지게 합니다</font></p></td>\n</tr>\n<tr>\n<td rowspan=\"7\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>집</b></font></p></td>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I wish to lock this down</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">물건을 집에다 안 떨어지게 붙입니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I wish to release this</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">물건을 들고 가질수잇게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I wish to secure this</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">물건을 집에다가 안떨어지게 하고 \n                        도한 가방이나 상자는 프랜드가 아니믄 열수 없게 합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p><font face=\"바탕체\" size=\"2\">I wish to place a trash barrel</font></p></td>\n<td width=\"310\"><p><font face=\"바탕체\" size=\"2\">집안에 쓰레기통을 만듭니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I ban thee</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">집안에 칩입자를 밖으로 내쫓습니다(문앞계단에서부터 \n                        적용)</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Appraise</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">톱그림가게에 있는 브러커에게 \n                        집디드를 팝니다,가격이 맘에 들믄 집디드를 그넘에게 넘기믄 \n                        됩니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p><font face=\"바탕체\" size=\"2\">I wish to place a strongbox</font></p></td>\n<td width=\"310\"><p><font face=\"바탕체\" size=\"2\">공동 소유 상자를 만듭니다(공동소유자가 있어야 \n                        함)</font></p></td>\n</tr>\n<tr>\n<td rowspan=\"3\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>상인(npc)고용:디드를</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>가지고세울자리에서</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>디드2번클릭(자신의</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>위치에서 나옵니다)</b></font></p></td>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) gold</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">자기개인상점에 있는 npc에게서</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">물건 판돈을 수금합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) info</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc가 얼마나 일할수있는지 정보를 \n                        보여줍니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) dismiss</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">고용된npc를 해고시킵니다.그자리에서 \n                        걍 디집니다(물건먹고)</font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">해고시키기전에 물건챙겨야 함</font></p></td>\n</tr>\n<tr>\n<td rowspan=\"5\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>npc</b></font></p></td>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) move</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">문앞이나 길막고 있는 넘을 움직이게 \n                        합니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) join</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">도둑길드같은 길드에 들게 해줍니다</font></p></td>\n</tr>\n<tr>\n<td width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) what town is this</font></p></td>\n<td width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">자신이 어느도시에 있는지 알려줍니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) train</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc에게서 배울수 있는 기술이 \n                        무엇인지를 보여줍니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">npc(이름) train (배울기술)</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">기술을 배웁니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" rowspan=\"2\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>npc 에스코트하기</b></font></p></td>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I will take thee</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">목적지로 데려가준다고 합니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Destination</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">목적지가 어딘지 갈켜줍니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>길드탈퇴하기</b></font></p></td>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I resign from my guild</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">어느장소에서나 길드탈퇴합니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" rowspan=\"2\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>마굿간</b></font></p></td>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Retrieve</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">맡겼던 동물을 찿습니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Stable</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">동물을 맡깁니다</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" rowspan=\"2\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>지하마을로 이동</b></font></p></td>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Recdu</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Moonglow약초상에서Papua약초상으로(판타그램있는데-별모양)</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Recsu</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Papua약초상에서Moonglow약초상으로(판타그램있는데-별모양)</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"156\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>자신의머더러상태</b></font></p></td>\n<td height=\"25\" width=\"209\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">I must consider my sins</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Fear not, thou hast not slain \n                        the innocent(머카도 없고,레드가 아닐때)</font></p></td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"25\" rowspan=\"3\" width=\"371\"><p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\">&nbsp;</font></p></td>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Fear not, thou hast not slain \n                        the innocent in some time(전에 머카가 있었지만현재 머카가 \n                        없을 때,레드상태라도 일케 나옴)</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">Although thou hast slain the \n                        innocent, thy deeds shall not bring retribution upon \n                        thy return to the living(죽어서 다시 살아났을 때 스탯로스가 \n                        없습니다)</font></p></td>\n</tr>\n<tr>\n<td height=\"25\" width=\"310\"><p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">If thou should return to the \n                        land of the living, the innocent shall wreak havoc upon \n                        thy soul(죽어서 다시살아나믄 스탯로스가 있습니다.만약에 \n                        죽엇으믄 유령인채로 </font></p>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">머카를 깍으십시여-\"-)</font></p></td>\n</tr>\n</tbody></table>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font color=\"blue\" face=\"바탕체\" size=\"2\">*이제 실제예로 들어가보자</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">뱅크를 열고 물건을사고 가드를 부르고 파푸아로 \n            텔레포트하고 집에 칩임자를 밴시켜보자</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><b>Bank Vendor Buy Guards Recdu I ban Thee</b></font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">이같은 조합명령어를 자신의취향에 맞게 조합해보세여</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\">&nbsp;&nbsp;</font></p>\n<p align=\"center\" style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\" size=\"2\"><img border=\"0\" data-original-src=\"http://forg.co.kr:80/Image/rare/pcards.gif\" data-recovery=\"missing\" height=\"39\" src=\"/img/placeholder/missing.svg\" style=\"aspect-ratio:44/39\" width=\"44\"></font></p></td>\n</tr>\n<tr>\n<td width=\"74\"><p><font face=\"바탕체\">&nbsp;</font></p></td>\n<td width=\"676\"><p><font face=\"바탕체\">&nbsp;</font></p></td>\n</tr>\n</tbody></table>\n<p style=\"line-height:100%; margin-top:0; margin-bottom:0;\"><font face=\"바탕체\">&nbsp;</font></p><map name=\"know_h\">\n<area coords=\"1, 63, 78, 80\" href=\"/site/house_a/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 82, 78, 100\" href=\"/site/house_add/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 102, 77, 120\" href=\"https://web.archive.org/web/20010124083000/http://forg.co.kr/house_f.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"1, 122, 77, 140\" href=\"https://web.archive.org/web/20010124083000/http://forg.co.kr/fame.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"1, 142, 77, 160\" href=\"/site/m_weapon/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 162, 77, 181\" href=\"https://web.archive.org/web/20010124083000/http://forg.co.kr/rare.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"1, 183, 77, 202\" href=\"https://web.archive.org/web/20010124083000/http://forg.co.kr/g_stone.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n<area coords=\"1, 204, 77, 221\" href=\"/site/runebook/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 223, 77, 241\" href=\"/site/s_p/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 243, 78, 262\" href=\"/site/com/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 264, 78, 281\" href=\"/site/mirc/\" shape=\"rect\" title=\"\">\n<area coords=\"1, 284, 76, 300\" href=\"/site/uosu/\" shape=\"rect\" title=\"\">\n<area coords=\"45, 466, 60, 478\" href=\"/site/knowhow/\" shape=\"rect\" title=\"\">\n<area coords=\"62, 466, 77, 478\" href=\"https://web.archive.org/web/20010124083000/http://forg.co.kr/knowhow_1.htm\" shape=\"rect\" target=\"_blank\" title=\"\">\n</map>\n",
