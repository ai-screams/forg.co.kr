  "html": "\n<a name=\"g4_head\"></a>\n\n\n<div id=\"LayLoginForm\" style=\"display: none; z-index: 2; left: 0px; width: 364px; position: absolute; top: 0px; height: 370px\">\n<table align=\"center\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\" style=\"border: #FFC73B 3px solid;\" width=\"364\">\n\n\n<tbody><tr>\n<td bgcolor=\"#ededed\">\n<table bgcolor=\"#ffffff\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n<tbody><tr>\n<td align=\"left\" style=\"padding:15px 5px 5px 25px;\"><b> Forg's World Login </b></td>\n<td align=\"right\" style=\"padding:5px;\" valign=\"top\"> <a><img align=\"absmiddle\" border=\"0\" height=\"11\" src=\"/img/posts/site/skin/outlogin/forg/img/close.gif\" width=\"11\"></a></td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"400\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#ffffff\" height=\"130\" width=\"400\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"350\">\n<tbody><tr>\n<td width=\"250\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"250\">\n<tbody><tr>\n<td width=\"10\"><img height=\"3\" src=\"/img/posts/site/skin/outlogin/forg/img/icon.gif\" width=\"3\"></td>\n<td align=\"left\" height=\"26\" width=\"90\"><b>아이디</b></td>\n<td width=\"150\"></td>\n</tr>\n<tr>\n<td><img height=\"3\" src=\"/img/posts/site/skin/outlogin/forg/img/icon.gif\" width=\"3\"></td>\n<td align=\"left\" height=\"26\"><b>패스워드</b></td>\n<td></td>\n</tr>\n</tbody></table>\n</td>\n<td valign=\"top\" width=\"100\"></td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"10\">\n\t\t\t\t\tAuto Login \n</td>\n</tr>\n<tr>\n<td align=\"left\" height=\"26\"><img height=\"3\" src=\"/img/posts/site/skin/outlogin/forg/img/icon.gif\" width=\"3\"> 아직 회원이 아니십니까?&nbsp;&nbsp;&nbsp;&nbsp;</td>\n<td align=\"left\"><a href=\"https://web.archive.org/web/20160726201324/http://www.forg.co.kr:80/bbs/register.php\" target=\"_blank\"><img align=\"absmiddle\" border=\"0\" height=\"20\" sr