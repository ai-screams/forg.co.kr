# ╚═══════════════════════════════════════════════════════════════╝

# Go
*.test
*.out
go.work

# Rust
target/
Cargo.lock         # commit if binary, ignore if library
**/*.rs.bk

# Java / Kotlin
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
.gradle/
gradle-app.setting

# Ruby
*.gem
.bundle/
vendor/bundle
log/
spec/reports/

# PHP
vendor/
composer.phar


# ╔═══════════════════════════════════════════════════════════════╗
# ║ Tooling, logs, misc                                           ║
# ╚═══════════════════════════════════════════════════════════════╝

# Logs
*.log
logs/
*.log.*

# Diagnostic / crash reports
crash.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Compressed archives (usually downloaded artifacts)
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Local DB / SQLite (project may not use; safe to ignore)
*.sqlite
*.sqlite3
*.db
*.db-journal

# Direnv / asdf / nvm
.envrc
.tool-versions
.nvmrc       # commit if standardized; remove this line if you do


# ╔═══════════════════════════════════════════════════════════════╗
# ║ Whitelist (re-include things accidentally caught above)       ║
# ╚═══════════════════════════════════════════════════════════════╝

# Always include these even if patterns above match
!.gitkeep
!.gitignore
!.github/
!.editorconfig
!.npmrc
!.nvmrc

# Re-include archive content for the "Vendor" board (forg.co.kr Zeroboard
# board id). The PHP/Composer `vendor/` ignore above is case-insensitive on
# macOS APFS and would otherwise swallow this museum-content directory.
!src/content/posts/Vendor/
!src/content/boards/Vendor/
