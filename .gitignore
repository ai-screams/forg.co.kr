# Dependencies
node_modules/
jspm_packages/
bower_components/
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity

# Lock files (commit ONE of these — do not ignore yours; ignore others' if accidental)
# package-lock.json   # keep if npm
# yarn.lock           # keep if yarn
# pnpm-lock.yaml      # keep if pnpm

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
.vercel/
.netlify/
.turbo/
.output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
*.lcov
.nyc_output/
.jest-cache/
.vitest-cache/
playwright-report/
test-results/
.playwright/

