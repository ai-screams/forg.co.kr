stats.json


# ╔═══════════════════════════════════════════════════════════════╗
# ║ Python                                                        ║
# ╚═══════════════════════════════════════════════════════════════╝

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
.pyenv-version

# Distribution / packaging
.Python
# Python distribution outputs — anchored to project root so they do
# not collide with common src/lib/, etc. names.
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Testing / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.pytest_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Poetry / pipenv / PDM / uv
poetry.lock          # commit if you use poetry — ignore otherwise
Pipfile.lock         # commit if you use pipenv — ignore otherwise
.pdm.toml
__pypackages__/
uv.lock              # commit if you use uv — ignore otherwise


# ╔═══════════════════════════════════════════════════════════════╗
