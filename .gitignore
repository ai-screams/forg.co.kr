# ─────────────────────────────────────────────────────────────────────
#  forg-archive — .gitignore
#  Comprehensive: OS / Editor / Language / Framework / Project
# ─────────────────────────────────────────────────────────────────────


# ╔═══════════════════════════════════════════════════════════════╗
# ║ Project-specific (PROTECT FIRST)                              ║
# ╚═══════════════════════════════════════════════════════════════╝

# Internal docs — explicitly excluded by project rule (never commit)
.docs/
.docs/**

# Tool state directories
.omc/
.serena/
.claude/
.cursor/
.zed/
.aider*
.agents/
skills-lock.json

# Local download artifacts (large, rebuildable from Wayback CDX)
archive/
archive-utf8/
*.run.log
*.run.pid
.summary.json
.progress.jsonl
.errors.jsonl

# ETL pipeline runtime artifacts (regenerable from raw archive)
.parse-summary.json
.parse-summary-*.json
.parse-failures.jsonl
.parse-failures-*.jsonl
.parse-progress.jsonl
.index-summary.json
.image-manifest-summary.json
.image-cdx-summary.json
.chrome-recovery-report.json
.image-recovery-report.json

# Local caches & generated content
.cache/
.tmp/
tmp/
*.tmp
*.bak
*.swp

# Environment / secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.cert


