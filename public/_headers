# Cloudflare Pages custom headers.
#
# Do not set Content-Type here. A path rule applies to every file it matches,
# so `/*` with `Content-Type: text/html` also relabels JS, CSS and SVG. Pages
# sends `X-Content-Type-Options: nosniff`, so browsers then refuse to run the
# scripts or apply the stylesheets.
#
# Pages may omit `charset=utf-8` on HTML (cloudflare/workers-sdk#9599). Korean
# text still decodes correctly because Next.js emits `<meta charSet="utf-8"/>`
# as the first element of every page's <head>.


# Pages' default for every file is `max-age=0, must-revalidate`: each page
# view asked again for the stylesheet, which holds back the first paint by a
# round trip, and for the era pictures (31 on the 2014 home).

# Named by their content: a new build gives a changed file a new name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The era chrome: every URL carries a hash of the file's bytes
# (`versioned` in src/lib/chrome.ts), so a changed picture gets a new URL.
# Safari revalidates every subresource on a reload unless it is immutable
# (WebKit bug 169756), and the chrome blinked on reload while it waited.
/img/chrome/*
  Cache-Control: public, max-age=31536000, immutable

# Emoticons, placeholders and page scripts keep their names when replaced,
# which is rare: a day without asking (a reload included), then a week of
# using the copy while it is checked in the background. Rules do not
# overlap: Pages joins the values of every rule that matches a path.
/img/emoticon/*
  Cache-Control: public, max-age=86400, immutable, stale-while-revalidate=604800

/img/placeholder/*
  Cache-Control: public, max-age=86400, immutable, stale-while-revalidate=604800

/scripts/*
  Cache-Control: public, max-age=86400, immutable, stale-while-revalidate=604800

# The museum's address is forg.co.kr. A preview deployment stays out of
# search engines (Cloudflare Pages docs, "Prevent your pages.dev deployments
# showing in search results"). The production alias forg-archive.pages.dev
# is not marked: its pages name forg.co.kr as canonical, which gathers their
# standing there, and noindex beside a canonical sends search engines two
# signals. A redirect of the alias to forg.co.kr is set in the dashboard.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
